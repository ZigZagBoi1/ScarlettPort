+
+    /// A lane's busy time counts each moment once: a job sent while the
+    /// one before it still ran adds only what came after that one.
+    #[test]
+    fn a_lanes_busy_time_counts_each_moment_once() {
+        let t = Instant::now();
+        let at = |ms: u64| t + std::time::Duration::from_millis(ms);
+        // Alone: from the send to the end.
+        assert_eq!(busy_stretch(None, at(10), at(14)), 4_000);
+        // Sent at 10 while the job before ran until 12: 12 to 14.
+        assert_eq!(busy_stretch(Some(at(12)), at(10), at(14)), 2_000);
+        // Sent after the one before had finished: from the send.
+        assert_eq!(busy_stretch(Some(at(5)), at(10), at(14)), 4_000);
+        // (The clock's own lateness never makes a stretch negative.)
+        assert_eq!(busy_stretch(Some(at(20)), at(10), at(14)), 0);
+    }
+
+    /// A landing buffer is given out again only when the card has passed
+    /// its last use, and the smallest one that holds the bytes is taken.
+    #[test]
+    fn a_landing_buffer_is_free_when_the_card_has_passed_its_use() {
+        // (size, held until this value of the host's fence)
+        let landings = [(4 << 20, 10), (1 << 20, 12), (2 << 20, 7), (8 << 20, 7)];
+        // The card is at 9: the third and fourth are free.
+        assert_eq!(pick_landing(&landings, 1 << 20, 9), Some(2));
+        assert_eq!(pick_landing(&landings, 3 << 20, 9), Some(3));
+        assert_eq!(pick_landing(&landings, 9 << 20, 9), None);
+        // At 10 the first is free too, and is the smallest for 3 MiB.
+        assert_eq!(pick_landing(&landings, 3 << 20, 10), Some(0));
+        // At 6 none is: a use that the card has not passed holds its buffer.
+        assert_eq!(pick_landing(&landings, 1, 6), None);
+        // The value itself frees it (the signal is behind the read).
+        assert_eq!(pick_landing(&landings, 1, 7), Some(2));
+        assert_eq!(pick_landing(&[], 1, u64::MAX), None);
+    }
+
+    /// A shader of the direct queue that takes a while and then stores a
+    /// dword: `at` (bytes) gets `value`.
+    const SLOW_STORE: &str = r#"
+#define RS "RootConstants(num32BitConstants=3, b0), UAV(u0)"
+cbuffer What : register(b0) { uint at; uint value; uint spin; };
+RWByteAddressBuffer memory : register(u0);
+[RootSignature(RS)]
+[numthreads(1, 1, 1)]
+void main() {
+    uint h = value;
+    [loop]
+    for (uint i = 0; i < spin; i++) {
+        h = (h ^ memory.Load((i & 63u) * 4u)) * 0x01000193u;
+    }
+    memory.Store(at, value + (h & 0u));
+}
+"#;
+
+    /// The software adapter with a direct queue and the copy queues.
+    struct Warp {
+        device: ID3D12Device,
+        direct: ID3D12CommandQueue,
+        /// The direct queue's fence and the last value signalled on it.
+        fence: ID3D12Fence,
+        submitted: u64,
+        event: HANDLE,
+        second: &'static Second,
+        root: ID3D12RootSignature,
+        pso: ID3D12PipelineState,
+        /// Direct lists sent and not waited for yet.
+        flown: Vec<CopyList>,
+    }
+
+    impl Warp {
+        fn new(bits: u32) -> Option<Warp> {
+            // SAFETY: plain DXGI and D3D12 set-up on the software adapter.
+            unsafe {
+                let factory: IDXGIFactory4 = CreateDXGIFactory2(DXGI_CREATE_FACTORY_FLAGS(0)).ok()?;
+                let adapter: IDXGIAdapter = factory.EnumWarpAdapter().ok()?;
+                let desc = adapter.cast::<IDXGIAdapter1>().ok()?.GetDesc1().ok()?;
+                if desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32 == 0 {
+                    return None;
+                }
+                let mut device: Option<ID3D12Device> = None;
+                D3D12CreateDevice(&adapter, D3D_FEATURE_LEVEL_12_0, &mut device).ok()?;
+                let device = device?;
+                let direct: ID3D12CommandQueue = device
+                    .CreateCommandQueue(&D3D12_COMMAND_QUEUE_DESC {
+                        Type: D3D12_COMMAND_LIST_TYPE_DIRECT,
+                        ..Default::default()
+                    })
+                    .ok()?;
+                let fence: ID3D12Fence = device.CreateFence(0, D3D12_FENCE_FLAG_NONE).ok()?;
+                let event = CreateEventW(None, false, false, None).ok()?;
+                // The clocks' threads live as long as the process: the
+                // queues of a test are kept for them.
+                let second: &'static Second = Box::leak(Box::new(Second::new(&device, bits).expect("copy queues on WARP")));
+                second.clocked();
+                let mut code: Option<ID3DBlob> = None;
+                D3DCompile(
+                    SLOW_STORE.as_ptr().cast(),
+                    SLOW_STORE.len(),
+                    s!("slow store"),
+                    None,
+                    None,
+                    s!("main"),
+                    s!("cs_5_1"),
+                    0,
+                    0,
+                    &mut code,
+                    None,
+                )
+                .expect("the test's shader compiles");
+                let code = code?;
+                let bytes = std::slice::from_raw_parts(code.GetBufferPointer().cast::<u8>(), code.GetBufferSize());
+                let root: ID3D12RootSignature = device.CreateRootSignature(0, bytes).ok()?;
+                let pso: ID3D12PipelineState = device
+                    .CreateComputePipelineState(&D3D12_COMPUTE_PIPELINE_STATE_DESC {
+                        pRootSignature: std::mem::transmute_copy(&root),
+                        CS: D3D12_SHADER_BYTECODE {
+                            pShaderBytecode: bytes.as_ptr().cast(),
+                            BytecodeLength: bytes.len(),
+                        },
+                        ..Default::default()
+                    })
+                    .ok()?;
+                Some(Warp {
+                    device,
+                    direct,
+                    fence,
+                    submitted: 0,
+                    event,
+                    second,
+                    root,
+                    pso,
+                    flown: Vec::new(),
+                })
+            }
+        }
+
+        /// A buffer as the host makes them: in the card's own memory
+        /// (`Host::uav_buffer`), or in the PC's memory and mapped
+        /// (`Host::shared_buffer`).
+        fn buffer(&self, size: u64, mapped: bool) -> (ID3D12Resource, *mut u8) {
+            let heap = if mapped {
+                D3D12_HEAP_PROPERTIES {
+                    Type: D3D12_HEAP_TYPE_CUSTOM,
+                    CPUPageProperty: D3D12_CPU_PAGE_PROPERTY_WRITE_BACK,
+                    MemoryPoolPreference: D3D12_MEMORY_POOL_L0,
+                    ..Default::default()
+                }
+            } else {
+                D3D12_HEAP_PROPERTIES {
+                    Type: D3D12_HEAP_TYPE_DEFAULT,
+                    ..Default::default()
+                }
+            };
+            let desc = D3D12_RESOURCE_DESC {
+                Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+                Width: size,
+                Height: 1,
+                DepthOrArraySize: 1,
+                MipLevels: 1,
+                SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+                Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+                Flags: D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+                ..Default::default()
+            };
+            let mut buffer: Option<ID3D12Resource> = None;
+            let mut data = std::ptr::null_mut();
+            // SAFETY: plain creation, and a mapping of CPU-visible memory.
+            unsafe {
+                self.device
+                    .CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COMMON, None, &mut buffer)
+                    .expect("a test buffer");
+                let buffer = buffer.expect("a test buffer");
+                if mapped {
+                    buffer.Map(0, None, Some(&mut data)).expect("a mapping");
+                }
+                (buffer, data.cast())
+            }
+        }
+
+        /// Sends a list of the direct queue made by `record`, with a
+        /// signal behind it, and does not wait: the value signalled.
+        fn fly(&mut self, record: impl FnOnce(&ID3D12GraphicsCommandList)) -> u64 {
+            // SAFETY: plain creation; an open list of ours; our queue and
+            // fence.
+            unsafe {
+                let allocator: ID3D12CommandAllocator =
+                    self.device.CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT).expect("an allocator");
+                let list: ID3D12GraphicsCommandList =
+                    self.device.CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, &allocator, None).expect("a list");
+                record(&list);
+                list.Close().expect("the list closes");
+                self.direct.ExecuteCommandLists(&[Some(list.cast().expect("a command list"))]);
+                self.submitted += 1;
+                self.direct.Signal(&self.fence, self.submitted).expect("a signal");
+                self.flown.push((allocator, list));
+            }
+            self.submitted
+        }
+
+        /// A direct list that stores `value` at byte `at` of `memory`
+        /// after `spin` steps.
+        fn store(&mut self, memory: &ID3D12Resource, at: u32, value: u32, spin: u32) -> u64 {
+            let (root, pso) = (self.root.clone(), self.pso.clone());
+            // SAFETY: a live buffer with unordered access; the shader's
+            // own root signature.
+            self.fly(|list| unsafe {
+                list.SetComputeRootSignature(&root);
+                list.SetPipelineState(&pso);
+                let constants = [at, value, spin];
+                list.SetComputeRoot32BitConstants(0, 3, constants.as_ptr().cast(), 0);
+                list.SetComputeRootUnorderedAccessView(1, memory.GetGPUVirtualAddress());
+                list.Dispatch(1, 1, 1);
+            })
+        }
+
+        /// Waits for everything sent to the direct queue and the lanes.
+        fn land(&mut self) {
+            // SAFETY: our fence and event.
+            unsafe {
+                self.fence.SetEventOnCompletion(self.submitted, self.event).expect("a wait");
+                WaitForSingleObject(self.event, INFINITE);
+            }
+            for lane in [&self.second.down, &self.second.up] {
+                let last = lock(&lane.state).sent;
+                lane.wait(last, self.event).expect("a wait");
+            }
+            assert!(
+                // SAFETY: a plain query.
+                unsafe { self.device.GetDeviceRemovedReason() }.is_ok(),
+                "the software adapter lost the device"
+            );
+            self.flown.clear();
+        }
+    }
+
+    /// The dwords of a mapped buffer.
+    fn dwords(data: *mut u8, at: usize, n: usize) -> Vec<u32> {
+        // SAFETY: the caller's mapping holds them.
+        (0..n).map(|i| unsafe { data.cast::<u32>().add(at + i).read_volatile() }).collect()
+    }
+
+    /// What shaders wrote, read back through the down lane, is what the
+    /// direct queue reads back: the same bytes of a buffer in the card's
+    /// memory come down both ways, and the lane's copy is behind the fence
+    /// of the submission that wrote them without any wait of ours between.
+    #[test]
+    fn warp_a_fetch_through_the_copy_queue_brings_what_the_direct_queue_brings() {
+        let Some(mut warp) = Warp::new(1) else {
+            return;
+        };
+        const DWORDS: usize = 4096;
+        let bytes = (DWORDS * 4) as u64;
+        let (card, _) = warp.buffer(bytes, false);
+        let (down_direct, direct_data) = warp.buffer(bytes, true);
+        let (down_lane, lane_data) = warp.buffer(bytes, true);
+        for round in 1..=3u32 {
+            // "Shader writes": a few dwords, each by a dispatch.
+            let mut behind = 0;
+            for i in 0..24u32 {
+                behind = warp.store(&card, (i * 163 % DWORDS as u32) * 4, round * 1000 + i, 20_000);
+            }
+            // Through the lane, behind the writes' fence; no wait of ours.
+            let second = warp.second;
+            let list = second.down.list().expect("a copy list");
+            // SAFETY: an open copy list; live buffers.
+            unsafe { list.1.CopyBufferRegion(&down_lane, 0, &card, 0, bytes) };
+            let job = second.down.send(list, &[(&warp.fence, behind)], bytes).expect("the fetch is sent");
+            // And through the direct queue, as before.
+            // SAFETY: an open list; live buffers.
+            warp.fly(|list| unsafe { list.CopyBufferRegion(&down_direct, 0, &card, 0, bytes) });
+            second.down.wait(job, warp.event).expect("the fetch is waited for");
+            assert!(second.down.done(job));
+            warp.land();
+            let (direct, lane) = (dwords(direct_data, 0, DWORDS), dwords(lane_data, 0, DWORDS));
+            assert_eq!(direct, lane, "round {round}: the two ways brought different bytes");
+            for i in 0..24u32 {
+                assert_eq!(lane[(i * 163 % DWORDS as u32) as usize], round * 1000 + i, "round {round}, write {i}");
+            }
+        }
+        assert_eq!(warp.second.down.stats.jobs.load(Ordering::Relaxed), 3);
+    }
+
+    /// Ordering under the fences, nothing waited for on the CPU: write k
+    /// goes to the direct queue with a signal behind it, and fetch k, sent
+    /// at once to the lane behind that signal, must hold writes 1..=k
+    /// (later writes may or may not be in it: they are newer, never
+    /// older). Sixteen of each are in the air together.
+    #[test]
+    fn warp_a_fetch_behind_a_fence_holds_everything_sent_before_that_fence() {
+        let Some(mut warp) = Warp::new(1) else {
+            return;
+        };
+        const N: usize = 16;
+        let bytes = (N * 4) as u64;
+        let (card, _) = warp.buffer(64 << 10, false);
+        let (down, data) = warp.buffer(bytes * N as u64, true);
+        let second = warp.second;
+        for k in 0..N {
+            let behind = warp.store(&card, (k * 4) as u32, 0xA000 + k as u32, 60_000);
+            let list = second.down.list().expect("a copy list");
+            // SAFETY: an open copy list; live buffers; the slot is inside.
+            unsafe { list.1.CopyBufferRegion(&down, k as u64 * bytes, &card, 0, bytes) };
+            second.down.send(list, &[(&warp.fence, behind)], bytes).expect("the fetch is sent");
+        }
+        warp.land();
+        for k in 0..N {
+            let slot = dwords(data, k * N, N);
+            for (i, &got) in slot.iter().enumerate().take(k + 1) {
+                assert_eq!(got, 0xA000 + i as u32, "fetch {k} ran before write {i}, which was sent before its fence");
+            }
+            for (i, &got) in slot.iter().enumerate().skip(k + 1) {
+                assert!(got == 0 || got == 0xA000 + i as u32, "fetch {k} holds {got:#x} for write {i}");
+            }
+        }
+    }
+
+    /// Title bytes sent up through the up lane are there when the direct
+    /// queue goes on: each of sixteen sends is followed, with no wait of
+    /// ours, by a direct list that reads the buffer back, and each read
+    /// holds its own send and all before it. Each send is made late on
+    /// purpose (it stands behind a slow list of the direct queue), so the
+    /// read would come first if the direct queue did not wait. The
+    /// numbered sends are signalled in order, and the clock saw the holds.
+    #[test]
+    fn warp_the_direct_queue_goes_on_only_when_what_was_sent_up_is_there() {
+        let Some(mut warp) = Warp::new(3) else {
+            return;
+        };
+        const N: usize = 16;
+        const PART: u64 = 64 << 10;
+        let (staging, staged) = warp.buffer(PART * N as u64, true);
+        // A buffer in the card's memory per send: the lane writes one that
+        // nothing in the air names yet (as it writes landing buffers).
+        let cards: Vec<ID3D12Resource> = (0..N).map(|_| warp.buffer(PART, false).0).collect();
+        let (other, _) = warp.buffer(64 << 10, false);
+        // What each read brings: the first dword of every part.
+        let (down, data) = warp.buffer((N * N * 4) as u64, true);
+        let second = warp.second;
+        for k in 0..N {
+            // The title's bytes of part k (the CPU's side of the copy).
+            for i in 0..(PART as usize / 4) {
+                // SAFETY: inside the mapping; nothing on the card reads
+                // part k before the send below.
+                unsafe { staged.cast::<u32>().add(k * (PART as usize / 4) + i).write_volatile(0xB000 + k as u32) };
+            }
+            let slow = warp.store(&other, 0, k as u32, 80_000);
+            let list = second.up.list().expect("a copy list");
+            // SAFETY: an open copy list; live buffers.
+            unsafe { list.1.CopyBufferRegion(&cards[k], 0, &staging, k as u64 * PART, PART) };
+            let job = second.up.send(list, &[(&warp.fence, slow)], PART).expect("the bytes are sent up");
+            second.hold(&warp.direct, job).expect("the direct queue waits");
+            second.sent_up(&warp.direct, k as u64 + 1);
+            // SAFETY: an open list; live buffers; the slots are inside.
+            warp.fly(|list| unsafe {
+                for (part, card) in cards.iter().enumerate().take(k + 1) {
+                    list.CopyBufferRegion(&down, ((k * N + part) * 4) as u64, card, 0, 4);
+                }
+            });
+        }
+        warp.land();
+        assert_eq!(second.order_done(), N as u64);
+        for k in 0..N {
+            let read = dwords(data, k * N, N);
+            for (part, &got) in read.iter().enumerate().take(k + 1) {
+                assert_eq!(got, 0xB000 + part as u32, "the direct queue's read {k} ran before send {part} was on the card");
+            }
+        }
+        assert_eq!(second.held[0].load(Ordering::Relaxed), N as u64);
+        assert_eq!(second.up.stats.bytes.load(Ordering::Relaxed), PART * N as u64);
+    }
+
+    /// The way title bytes go up with bit 2, as `Host::card_before` does
+    /// it: a job of the up lane brings them into a landing buffer while a
+    /// slow list of the direct queue is still running, the direct queue
+    /// waits for the job and then copies from the landing buffer into the
+    /// copy. A shader's store to the same bytes, sent before, must lose to
+    /// them (the copy changes in the direct queue's order, as on one
+    /// queue), and what a fetch through the down lane brings is what the
+    /// direct queue reads. Twelve rounds in the air together, each with a
+    /// landing buffer of its own until the card has passed its use.
+    #[test]
+    fn warp_title_bytes_reach_the_copy_through_a_landing_buffer_in_the_direct_queues_order() {
+        let Some(mut warp) = Warp::new(3) else {
+            return;
+        };
+        const N: usize = 12;
+        let (staging, staged) = warp.buffer(64 << 10, true);
+        let (card, _) = warp.buffer(64 << 10, false);
+        let (down, data) = warp.buffer((N * 4) as u64, true);
+        let (down_lane, lane_data) = warp.buffer((N * 4) as u64, true);
+        let second = warp.second;
+        let mut landings = Vec::new();
+        for k in 0..N {
+            let at = (k * 256) as u64;
+            // SAFETY: inside the mapping; read by the card only through
+            // the job below.
+            unsafe { staged.add(at as usize).cast::<u32>().write_volatile(0xC000 + k as u32) };
+            // A shader's (slow) store to the same dword, sent first.
+            warp.store(&card, at as u32, 0xDEAD_0000 + k as u32, 80_000);
+            // SAFETY: a plain query.
+            let completed = unsafe { warp.fence.GetCompletedValue() };
+            let landing = second.landing(4, completed, warp.submitted + 1).expect("a landing buffer");
+            let list = second.up.list().expect("a copy list");
+            // SAFETY: an open copy list; live buffers.
+            unsafe { list.1.CopyBufferRegion(&landing, 0, &staging, at, 4) };
+            let job = second.up.send(list, &[], 4).expect("the bytes are sent up");
+            second.hold(&warp.direct, job).expect("the direct queue waits");
+            // SAFETY: an open list; live buffers.
+            let read = warp.fly(|list| unsafe {
+                list.CopyBufferRegion(&card, at, &landing, 0, 4);
+                list.CopyBufferRegion(&down, (k * 4) as u64, &card, at, 4);
+            });
+            let list = second.down.list().expect("a copy list");
+            // SAFETY: an open copy list; live buffers.
+            unsafe { list.1.CopyBufferRegion(&down_lane, (k * 4) as u64, &card, at, 4) };
+            second.down.send(list, &[(&warp.fence, read)], 4).expect("the fetch is sent");
+            landings.push(landing.as_raw() as usize);
+        }
+        warp.land();
+        let want: Vec<u32> = (0..N).map(|k| 0xC000 + k as u32).collect();
+        assert_eq!(dwords(data, 0, N), want, "the title's bytes did not reach the copy behind the shader's store");
+        assert_eq!(dwords(lane_data, 0, N), want, "the copy queue's fetch differs from the direct queue's");
+        // No buffer was given out while its last use was in the air: one
+        // given to two rounds was free in between.
+        landings.sort_unstable();
+        landings.dedup();
+        assert!(!landings.is_empty() && landings.len() <= N);
+        // Everything has run: the next ask takes one of them, makes none.
+        let alive = second.landing[0].load(Ordering::Relaxed);
+        // SAFETY: a plain query.
+        let completed = unsafe { warp.fence.GetCompletedValue() };
+        let again = second.landing(4, completed, warp.submitted + 1).expect("a landing buffer");
+        assert!(landings.contains(&(again.as_raw() as usize)));
+        assert_eq!(second.landing[0].load(Ordering::Relaxed), alive);
+    }
+
+    /// Lists of a lane come back for the next job once the card has run
+    /// the job they were in, and not before.
+    #[test]
+    fn warp_a_lanes_lists_are_used_again_only_after_their_job() {
+        let Some(mut warp) = Warp::new(1) else {
+            return;
+        };
+        let (card, _) = warp.buffer(64 << 10, false);
+        let (down, _) = warp.buffer(64 << 10, true);
+        let second = warp.second;
+        // A job that cannot run yet: it waits for a fence value the direct
+        // queue reaches only after a slow store.
+        let behind = warp.store(&card, 0, 1, 400_000);
+        let first = second.down.list().expect("a copy list");
+        let first_list = first.1.as_raw();
+        // SAFETY: an open copy list; live buffers.
+        unsafe { first.1.CopyBufferRegion(&down, 0, &card, 0, 64) };
+        let job = second.down.send(first, &[(&warp.fence, behind)], 64).expect("sent");
+        if !second.down.done(job) {
+            // Still in the air: the next list is another one.
+            let next = second.down.list().expect("a copy list");
+            assert_ne!(next.1.as_raw(), first_list, "a list was reset while its job had not run");
+            second.down.send(next, &[], 0).expect("sent");
+        }
+        warp.land();
+        // Everything has run: a list of before comes back.
+        let again = second.down.list().expect("a copy list");
+        let spare_left = lock(&second.down.state).spare.len();
+        assert!(spare_left <= 1, "lists that have run are taken before new ones are made");
+        second.down.send(again, &[], 0).expect("sent");
+        warp.land();
+    }
+}
diff --git a/crates/victory-gpu/src/ranges.rs b/crates/victory-gpu/src/ranges.rs
new file mode 100644
index 0000000..ba46d13
--- /dev/null
+++ b/crates/victory-gpu/src/ranges.rs
@@ -0,0 +1,154 @@
+//! Ranges cut from a big block and given back: the bookkeeping behind
+//! memory the host is asked for in large pieces instead of once per texture
+//! (texture memory in [`crate::resource`], staging memory in
+//! [`crate::texture`]).
+//!
+//! After shadowdog00's vi-pc-combo `0781f61` (GPL-3.0), whose measurement is
+//! the reason: in the opening cutscene the pass over textures picked by
+//! index spent 80-95% of its time asking the host for memory, one committed
+//! resource per staging buffer and one per host texture. Ours besides: a
+//! length that found no room is remembered until something is given back
+//! (a pass may ask for a thousand ranges of many full blocks).
+
+use std::collections::BTreeMap;
+
+/// The free ranges of one block, by offset.
+pub(crate) struct Ranges {
+    free: BTreeMap<u64, u64>,
+    /// Free bytes in all.
+    room: u64,
+    /// The shortest length refused since the last range given back, at the
+    /// one alignment this block is asked for ([`take`](Self::take)).
+    refused: u64,
+    /// The first byte no range handed out has ever held.
+    fresh: u64,
+}
+
+impl Ranges {
+    pub(crate) fn new(size: u64) -> Ranges {
+        Ranges {
+            free: BTreeMap::from([(0, size)]),
+            room: size,
+            refused: u64::MAX,
+            fresh: 0,
+        }
+    }
+
+    /// Free bytes in all (an upper bound for what [`take`](Self::take) can
+    /// give).
+    pub(crate) fn room(&self) -> u64 {
+        self.room
+    }
+
+    /// The offset of `len` bytes at a multiple of `align` (a power of two),
+    /// the first that fits, and whether some of it held something before;
+    /// `None` if nothing fits. A block is asked for one alignment only.
+    pub(crate) fn take(&mut self, len: u64, align: u64) -> Option<(u64, bool)> {
+        if len == 0 || len > self.room || len >= self.refused {
+            return None;
+        }
+        let found = self.free.iter().find(|&(&at, &size)| {
+            let start = at.next_multiple_of(align);
+            start.checked_add(len).is_some_and(|end| end <= at + size)
+        });
+        let Some((&at, &size)) = found else {
+            self.refused = len;
+            return None;
+        };
+        let start = at.next_multiple_of(align);
+        self.free.remove(&at);
+        if start > at {
+            self.free.insert(at, start - at);
+        }
+        if start + len < at + size {
+            self.free.insert(start + len, at + size - (start + len));
+        }
+        self.room -= len;
+        let used_before = start < self.fresh;
+        self.fresh = self.fresh.max(start + len);
+        Some((start, used_before))
+    }
+
+    /// Gives back `len` bytes at `offset` that [`take`](Self::take) gave,
+    /// joined with free neighbours.
+    pub(crate) fn give(&mut self, offset: u64, len: u64) {
+        let (mut at, mut size) = (offset, len);
+        if let Some((&before, &its)) = self.free.range(..offset).next_back()
+            && before + its == offset
+        {
+            self.free.remove(&before);
+            (at, size) = (before, its + size);
+        }
+        if let Some(&after) = self.free.get(&(offset + len)) {
+            self.free.remove(&(offset + len));
+            size += after;
+        }
+        self.free.insert(at, size);
+        self.room += len;
+        self.refused = u64::MAX;
+    }
+
+    #[cfg(test)]
+    fn pieces(&self) -> Vec<(u64, u64)> {
+        self.free.iter().map(|(&a, &s)| (a, s)).collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Ranges;
+
+    #[test]
+    fn takes_first_fit_and_joins_what_is_given_back() {
+        let mut r = Ranges::new(1 << 20);
+        let a = r.take(4096, 4096).unwrap().0;
+        let b = r.take(8192, 4096).unwrap().0;
+        let c = r.take(4096, 4096).unwrap().0;
+        assert_eq!((a, b, c), (0, 4096, 12288));
+        assert_eq!(r.room(), (1 << 20) - 16384);
+        r.give(b, 8192);
+        assert_eq!(r.pieces(), vec![(4096, 8192), (16384, (1 << 20) - 16384)]);
+        assert_eq!(r.take(12288, 4096), Some((16384, false)));
+        assert_eq!(r.take(8192, 4096), Some((4096, true)));
+        r.give(16384, 12288);
+        r.give(a, 4096);
+        r.give(c, 4096);
+        r.give(4096, 8192);
+        assert_eq!(r.pieces(), vec![(0, 1 << 20)]);
+        assert_eq!(r.room(), 1 << 20);
+    }
+
+    #[test]
+    fn says_which_ranges_held_something_before() {
+        let mut r = Ranges::new(65536);
+        assert_eq!(r.take(8192, 4096), Some((0, false)));
+        assert_eq!(r.take(8192, 4096), Some((8192, false)));
+        r.give(8192, 8192);
+        // Half of it was handed out before, half of it never.
+        assert_eq!(r.take(16384, 4096), Some((8192, true)));
+        assert_eq!(r.take(4096, 4096), Some((24576, false)));
+    }
+
+    #[test]
+    fn remembers_a_refused_length_until_something_comes_back() {
+        let mut r = Ranges::new(65536);
+        let a = r.take(32768, 4096).unwrap().0;
+        r.take(16384, 4096).unwrap();
+        assert_eq!(r.take(32768, 4096), None);
+        assert_eq!(r.take(40960, 4096), None);
+        // Shorter ones still find room.
+        assert_eq!(r.take(8192, 4096), Some((49152, false)));
+        r.give(a, 32768);
+        assert_eq!(r.take(32768, 4096), Some((0, true)));
+    }
+
+    #[test]
+    fn keeps_the_alignment_and_refuses_what_does_not_fit() {
+        let mut r = Ranges::new(1 << 20);
+        assert_eq!(r.take(4096, 65536), Some((0, false)));
+        assert_eq!(r.take(65536, 65536), Some((65536, false)));
+        assert_eq!(r.pieces()[0], (4096, 61440));
+        assert_eq!(r.take(0, 65536), None);
+        assert_eq!(r.take((1 << 20) + 1, 65536), None);
+    }
+}
diff --git a/crates/victory-gpu/src/readback.rs b/crates/victory-gpu/src/readback.rs
new file mode 100644
index 0000000..1550197
--- /dev/null
+++ b/crates/victory-gpu/src/readback.rs
@@ -0,0 +1,316 @@
+//! `VICTORY_COPY_BACK_ONLY_READBACK=1` (testing, off by default): what
+//! shaders write is copied back into title memory only for the buffers the
+//! title reads on the CPU.
+//!
+//! The title (build 1.0.2.1) makes every buffer it reads back on the CPU
+//! through one function (its read-back ring, title RVA 0x1d40f90, 22
+//! callers: lighting, occlusion, particles, wind, water, autofocus, ...;
+//! read statically). A buffer created while that function is on the stack
+//! is noted here; with the switch on, shader writes to other memory stay on
+//! the card.
+//!
+//! "Stay on the card" must not mean "lost": the runtime itself reads title
+//! memory in several places, and run R2a (the switch on, the world drawn,
+//! the picture black) put stale title bytes back over shader results there.
+//! The ranges are still declared (flights in the air hold them, so readers
+//! wait), and what stays in a host copy is "owned" by it
+//! (`victory_core::gpuown`, `crate::shadow`'s `owning`/`owned`): its
+//! refreshes leave those bytes alone, and the title's buffer copies run on
+//! the CPU, fills, textures and other copies over the same memory get them
+//! written into title memory first. A page the title writes over owned
+//! bytes gives them to the title and is copied back from then on.
+//!
+//! shortcut: the function is found on the stack by scanning the stack for
+//! a return address into it (the title's unwind data is not registered
+//! with the system), so a stale return address left in a caller's frame
+//! could tag a buffer that is not read back (it is then copied back as
+//! before: harmless).
+
+use std::sync::Mutex;
+use std::sync::OnceLock;
+
+/// The title's read-back buffer creator (1.0.2.1).
+const CREATOR_RVA: u32 = 0x1d40f90;
+/// Stack bytes scanned above the creation call.
+const SCAN_BYTES: usize = 16 << 10;
+
+/// `VICTORY_COPY_BACK_ASYNC=1` (off by default; needs the relay,
+/// `VICTORY_RELAY`): what shaders wrote into the title's read-back rings of
+/// three is copied back on a thread of its own after its flight landed
+/// (`crate::host`'s async copy-back), not before the fences behind it.
+/// Rings of one (owners made with mode bit 0x8, which read in the same
+/// frame) are told apart by [`RingSizes`] and copied back as before.
+///
+/// [`RingSizes`]: victory_core::readring::RingSizes
+pub(crate) fn async_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var("VICTORY_COPY_BACK_ASYNC").is_ok_and(|v| v.trim() == "1");
+        if on {
+            tracing::warn!("VICTORY_COPY_BACK_ASYNC: read-back rings are copied back beside the landing of flights");
+        }
+        on
+    })
+}
+
+/// Read-back buffers by creation group ([`async_on`]), and their sizes.
+static RINGS: Mutex<Option<(victory_core::readring::RingSizes, std::collections::HashMap<u64, u64>)>> = Mutex::new(None);
+
+/// Whether a copy-back into `[start, start + len)` may land late: it lies
+/// in one read-back buffer made as one of a ring of two or more.
+pub(crate) fn lagged(start: u64, len: u64) -> bool {
+    let rings = RINGS.lock().unwrap_or_else(|e| e.into_inner());
+    let Some((sizes, lens)) = rings.as_ref() else {
+        return false;
+    };
+    // The buffer holding `start` (copies are per title buffer: its start).
+    lens.get(&start).is_some_and(|&l| len <= l) && sizes.lagged(start)
+}
+
+/// The size of the read-back buffer at `start`, if it is one.
+pub(crate) fn ring_len(start: u64) -> Option<u64> {
+    RINGS.lock().unwrap_or_else(|e| e.into_inner()).as_ref().and_then(|r| r.1.get(&start).copied())
+}
+
+/// Whether the switch is on.
+pub(crate) fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var("VICTORY_COPY_BACK_ONLY_READBACK").is_ok_and(|v| v.trim() == "1");
+        if on {
+            tracing::warn!(
+                "VICTORY_COPY_BACK_ONLY_READBACK: shader writes are copied back only for the title's read-back buffers"
+            );
+        }
+        on
+    })
+}
+
+/// `[start, end)` of title memory of the read-back buffers alive (let go
+/// in [`untag`]: a buffer made later in the same memory need not be one).
+static TAGGED: Mutex<crate::memcopy::RangeSet> = Mutex::new(crate::memcopy::RangeSet::new());
+
+/// The creator's code range, once the title image is known: `None` until
+/// then, `Some(None)` if it is not this build.
+static CREATOR: OnceLock<Option<(usize, usize)>> = OnceLock::new();
+
+/// The `[begin, end)` of the function at `rva` in the image at `base`, from
+/// its exception directory.
+///
+/// # Safety
+/// `base` is a mapped PE image.
+unsafe fn function_at(base: usize, rva: u32) -> Option<(usize, usize)> {
+    // SAFETY: reading the headers of a mapped image.
+    unsafe {
+        let nt = base + (base as *const u8).add(0x3c).cast::<u32>().read_unaligned() as usize;
+        if (nt as *const u32).read_unaligned() != 0x4550 {
+            return None;
+        }
+        // Optional header at +0x18; PE32+ data directories at +0x70; the
+        // exception directory is the fourth.
+        let dir = nt + 0x18 + 0x70 + 3 * 8;
+        let (at, size) = (
+            (dir as *const u32).read_unaligned() as usize,
+            ((dir + 4) as *const u32).read_unaligned() as usize,
+        );
+        let entries = std::slice::from_raw_parts((base + at) as *const [u32; 3], size / 12);
+        let i = entries.binary_search_by_key(&rva, |e| e[0]).ok()?;
+        Some((base + entries[i][0] as usize, base + entries[i][1] as usize))
+    }
+}
+
+/// The base of the image holding `address` (0 if none).
+fn module_of(address: usize) -> usize {
+    use windows_sys::Win32::System::LibraryLoader::{
+        GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        GetModuleHandleExW,
+    };
+    let mut module = std::ptr::null_mut();
+    // SAFETY: looks up the module holding the address, no reference.
+    let found = unsafe {
+        GetModuleHandleExW(
+            GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            address as *const u16,
+            &mut module,
+        )
+    };
+    if found == 0 { 0 } else { module as usize }
+}
+
+/// The title image holding `address`, if it holds the creator.
+fn creator_from(address: usize) -> Option<(usize, usize)> {
+    use windows_sys::Win32::System::LibraryLoader::{
+        GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        GetModuleHandleExW,
+    };
+    let mut module = std::ptr::null_mut();
+    // SAFETY: looks up the module holding the address, no reference.
+    let found = unsafe {
+        GetModuleHandleExW(
+            GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            address as *const u16,
+            &mut module,
+        )
+    };
+    if found == 0 {
+        return None;
+    }
+    // SAFETY: a module the system knows is a mapped image.
+    unsafe { function_at(module as usize, CREATOR_RVA) }
+}
+
+/// Called by a resource creation method: whether the title's read-back
+/// creator is on the stack, and where on the stack its return address was
+/// found (it names the creator's call, for [`RingSizes`]). Learns the
+/// creator's place from the first caller in the title executable.
+///
+/// [`RingSizes`]: victory_core::readring::RingSizes
+fn creator_frame() -> Option<usize> {
+    use windows_sys::Win32::System::Diagnostics::Debug::RtlCaptureStackBackTrace;
+    use windows_sys::Win32::System::Threading::GetCurrentThreadStackLimits;
+    // Also with `crate::rebar` placing title buffers (level 2), which must
+    // not place these.
+    if !enabled() && crate::rebar::level() < 2 && !async_on() {
+        return None;
+    }
+    let creator = match CREATOR.get() {
+        Some(c) => *c,
+        None => {
+            // The first caller outside this runtime's own image: the
+            // title's call of the creation method.
+            let mut frames = [std::ptr::null_mut(); 8];
+            // SAFETY: room for the frames asked for.
+            let n = unsafe { RtlCaptureStackBackTrace(1, frames.len() as u32, frames.as_mut_ptr(), std::ptr::null_mut()) };
+            let own = module_of(creator_frame as *const () as usize);
+            let frame = frames[..n as usize].iter().map(|&f| f as usize).find(|&f| module_of(f) != own)?;
+            let Some(c) = creator_from(frame) else {
+                // A caller outside the executable (a title DLL): ask again later.
+                return None;
+            };
+            tracing::warn!(begin = format_args!("{:#x}", c.0), end = format_args!("{:#x}", c.1), "read-back creator found");
+            *CREATOR.get_or_init(|| Some(c))
+        }
+    };
+    let (begin, end) = creator?;
+    let (mut low, mut high) = (0usize, 0usize);
+    // SAFETY: plain out pointers.
+    unsafe { GetCurrentThreadStackLimits(&mut low, &mut high) };
+    let here = &low as *const usize as usize;
+    let top = (here + SCAN_BYTES).min(high);
+    let mut at = here & !7;
+    while at + 8 <= top {
+        // SAFETY: inside this thread's committed stack, above this frame.
+        let v = unsafe { (at as *const usize).read() };
+        if (begin..end).contains(&v) {
+            return Some(at);
+        }
+        at += 8;
+    }
+    None
+}
+
+/// A buffer was made at `[start, start + len)` (any buffer): with
+/// [`async_on`], a read-back buffer is noted with its creation group, and
+/// any other buffer ends the group its thread was making. Whether it is a
+/// read-back buffer.
+pub(crate) fn buffer_made(start: u64, len: u64) -> bool {
+    let frame = creator_frame();
+    if async_on() {
+        use windows_sys::Win32::System::Threading::GetCurrentThreadId;
+        // SAFETY: a plain query.
+        let thread = u64::from(unsafe { GetCurrentThreadId() });
+        let mut rings = RINGS.lock().unwrap_or_else(|e| e.into_inner());
+        let (sizes, lens) = rings.get_or_insert_with(Default::default);
+        match frame {
+            Some(at) => {
+                sizes.created((thread, at), start, len);
+                lens.insert(start, len);
+                let depth = sizes.depth(start);
+                if depth == 2 || depth == 1 && lens.len().is_power_of_two() {
+                    tracing::info!(start = format_args!("{start:#x}"), len, depth, "read-back ring buffers (VICTORY_COPY_BACK_ASYNC)");
+                }
+            }
+            None => sizes.other(thread),
+        }
+    }
+    frame.is_some()
+}
+
+/// Notes a read-back buffer at `[start, start + len)`.
+pub(crate) fn tag(start: u64, len: u64) {
+    let mut t = TAGGED.lock().unwrap_or_else(|e| e.into_inner());
+    t.insert(start, start + len);
+    let n = t.len();
+    if n.is_power_of_two() {
+        tracing::warn!(n, start = format_args!("{start:#x}"), len, "read-back buffers tagged");
+    }
+}
+
+/// Whether a read-back buffer lies in `[start, start + len)`, switch or
+/// not (`crate::rebar` keeps such memory where the CPU reads it fast).
+pub(crate) fn tagged_in(start: u64, len: u64) -> bool {
+    TAGGED
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .overlaps(start, start.saturating_add(len))
+}
+
+/// Whether shader writes to `[start, start + len)` are copied back: always
+/// with the switch off; with it on, only where a read-back buffer lies.
+/// Asked at submission, per declared range (`Shadow::writing`).
+pub(crate) fn copy_back(start: u64, len: u64) -> bool {
+    if !enabled() {
+        return true;
+    }
+    let back = TAGGED
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .overlaps(start, start.saturating_add(len));
+    if back {
+        crate::memcopy::add(crate::memcopy::M::BackGoes, 1);
+    } else {
+        crate::memcopy::add(crate::memcopy::M::BackKept, 1);
+        crate::memcopy::add(crate::memcopy::M::BackKeptBytes, len);
+    }
+    back
+}
+
+/// A buffer starting at `start` is let go: if it was a read-back buffer,
+/// it is one no more.
+pub(crate) fn untag(start: u64) {
+    if async_on()
+        && let Some(len) = ring_len(start)
+    {
+        // Its copy-back is done before its memory goes.
+        crate::host::async_drain_range(start as usize, (start + len) as usize);
+        if let Some((sizes, lens)) = RINGS.lock().unwrap_or_else(|e| e.into_inner()).as_mut() {
+            sizes.forget(start);
+            lens.remove(&start);
+        }
+    }
+    if enabled() {
+        TAGGED.lock().unwrap_or_else(|e| e.into_inner()).remove_at(start);
+    }
+}
+
+/// How many read-back buffers are alive.
+pub(crate) fn tagged() -> usize {
+    TAGGED.lock().unwrap_or_else(|e| e.into_inner()).len()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn this_test_binary_has_its_own_functions_in_its_table() {
+        use windows_sys::Win32::System::LibraryLoader::GetModuleHandleW;
+        // SAFETY: our own executable.
+        let base = unsafe { GetModuleHandleW(std::ptr::null()) } as usize;
+        let f = function_at as usize - base;
+        // SAFETY: our own mapped image.
+        let (b, e) = unsafe { function_at(base, f as u32) }.expect("own function in .pdata");
+        assert_eq!(b, function_at as usize);
+        assert!(e > b);
+    }
+}
diff --git a/crates/victory-gpu/src/readfix.rs b/crates/victory-gpu/src/readfix.rs
new file mode 100644
index 0000000..32108c9
--- /dev/null
+++ b/crates/victory-gpu/src/readfix.rs
@@ -0,0 +1,250 @@
+//! `VICTORY_READFIX=1` (off by default; with the relay and
+//! `VICTORY_SYNC_PRECISE=1` or `VICTORY_RELAY=2`): a refresh of a host copy
+//! that overlaps what another copy's flights in the air may write is served
+//! on the card instead of waiting for those flights to land.
+//!
+//! The wait it replaces (`WHY_READ`, "title memory read ... another copy"):
+//! a submission refreshes `[from, to)` of copy Y from title memory, and a
+//! flight in the air declared shader writes over some of those bytes on
+//! another copy X (an alias: a 4 MiB window over a title buffer, two views
+//! of one buffer). Title memory there is not what the card will hold until
+//! X's flight has landed and been copied back, so the submission waited for
+//! that whole landing - and the ray-tracing builder declares every copy it
+//! numbered written on every dispatch (`memory.rs`), so the declared ranges
+//! cover most of what the frame's other draws read.
+//!
+//! What landing would give Y there is X's bytes after its flight: the copy
+//! back puts into title memory the bytes the card changed, and leaves the
+//! rest as title memory had them, which is what X took when its flight
+//! went, as long as the title wrote none of them since. So when
+//!
+//! - every byte of the overlap is declared written by one other copy only
+//!   (no read-back, no bottom-of-pipe write, not Y itself),
+//! - X took those pages whole and the title has not written them since,
+//! - Y is a plain copy (not in the card's own memory, not title memory in
+//!   place) and this submission's shaders do not write it there,
+//!
+//! the refresh goes on for the rest, and X's bytes are copied into Y on the
+//! card after X's flight and before this submission's lists: on one queue,
+//! in order, exactly where the console's single memory would have them.
+//! Anything else waits as before. Platform-neutral planning; the host side
+//! is in `host.rs`.
+
+/// Why a refresh was not served on the card (the frame line's counts).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Refuse {
+    /// A flight's bottom-of-pipe write lies in the range.
+    Immed = 0,
+    /// A texture read-back of a flight lands in the range.
+    ReadBack = 1,
+    /// Two copies' flights write the same bytes.
+    TwoWriters = 2,
+    /// Y's own flights write the same bytes as another copy's.
+    OwnWrites = 3,
+    /// Y is in the card's memory or title memory in place.
+    Kind = 4,
+    /// The source copy did not take the pages whole, or the title wrote
+    /// them since.
+    TitleWrote = 5,
+    /// This submission's shaders write Y there.
+    Declared = 6,
+    /// An earlier redirect into Y there is still in the air and this one
+    /// does not cover it.
+    Pending = 7,
+    /// The source copy is not known among the flights.
+    NoSource = 8,
+}
+
+pub(crate) const REFUSALS: usize = 9;
+
+/// Bytes `[from, to)` of title memory, for copy `owner` (an identity: the
+/// `Shadow` pointer).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Piece {
+    pub owner: usize,
+    pub from: usize,
+    pub to: usize,
+}
+
+/// The pieces of `[from, to)` refreshed for copy `copy` that other copies'
+/// flights write (`by_copy`: `(owner, from, to)` joined per owner, `0` for
+/// read-backs; `immed`: bottom-of-pipe writes, joined), each to be copied
+/// from its owner on the card; or why that cannot be done. Empty if
+/// nothing of another copy's lies there.
+pub(crate) fn plan_refresh(
+    copy: usize,
+    from: usize,
+    to: usize,
+    by_copy: &[(usize, usize, usize)],
+    immed: &[(usize, usize)],
+) -> Result<Vec<Piece>, Refuse> {
+    if from >= to {
+        return Ok(Vec::new());
+    }
+    if immed.iter().any(|&(a, b)| a < to && b > from) {
+        return Err(Refuse::Immed);
+    }
+    let hits: Vec<(usize, usize, usize)> = by_copy
+        .iter()
+        .filter(|&&(_, a, b)| a < to && b > from)
+        .map(|&(o, a, b)| (o, a.max(from), b.min(to)))
+        .collect();
+    let mut pieces: Vec<Piece> = Vec::new();
+    for &(owner, a, b) in &hits {
+        if owner == copy {
+            continue;
+        }
+        if owner == 0 {
+            return Err(Refuse::ReadBack);
+        }
+        pieces.push(Piece { owner, from: a, to: b });
+    }
+    // One writer per byte: another owner's (or Y's own) range over a piece
+    // makes what landing gives depend on the order of their copy-backs.
+    for p in &pieces {
+        for &(owner, a, b) in &hits {
+            if owner != p.owner && a < p.to && b > p.from {
+                return Err(if owner == copy { Refuse::OwnWrites } else { Refuse::TwoWriters });
+            }
+        }
+    }
+    pieces.sort_unstable_by_key(|p| (p.from, p.owner));
+    Ok(pieces)
+}
+
+/// Whether `[from, to)` is covered by `pieces` (sorted by `from`, not
+/// overlapping).
+pub(crate) fn covered(pieces: &[Piece], from: usize, to: usize) -> bool {
+    let mut at = from;
+    for p in pieces {
+        if p.to <= at {
+            continue;
+        }
+        if p.from > at {
+            return false;
+        }
+        at = p.to;
+        if at >= to {
+            return true;
+        }
+    }
+    at >= to
+}
+
+/// Whether a copy that took pages `[first, last]` (write-watch pages)
+/// still holds title memory there: each page taken whole once
+/// (`copied[page - base] != 0`) and not written since (`written`: last
+/// writes by page, any order).
+pub(crate) fn took_current(copied: &[u64], base: usize, first: usize, last: usize, written: &[(usize, u64)]) -> bool {
+    (first..=last).all(|page| {
+        let Some(&at) = page.checked_sub(base).and_then(|i| copied.get(i)) else {
+            return false;
+        };
+        at != 0 && !written.iter().any(|&(p, w)| p == page && w > at)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const Y: usize = 0x100;
+    const X: usize = 0x200;
+    const Z: usize = 0x300;
+
+    #[test]
+    fn nothing_of_another_copy_needs_nothing() {
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &[(Y, 0x1000, 0x2000), (X, 0x3000, 0x4000)], &[]), Ok(vec![]));
+        assert_eq!(plan_refresh(Y, 0x1000, 0x1000, &[(X, 0, 0x9000)], &[]), Ok(vec![]));
+    }
+
+    #[test]
+    fn another_copys_writes_are_cut_to_the_refresh() {
+        let by_copy = [(X, 0x0800, 0x1400), (X, 0x1800, 0x5000)];
+        assert_eq!(
+            plan_refresh(Y, 0x1000, 0x2000, &by_copy, &[]),
+            Ok(vec![Piece { owner: X, from: 0x1000, to: 0x1400 }, Piece { owner: X, from: 0x1800, to: 0x2000 }])
+        );
+    }
+
+    #[test]
+    fn two_writers_of_one_byte_wait() {
+        let by_copy = [(X, 0x1000, 0x1800), (Z, 0x1700, 0x2000)];
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &by_copy, &[]), Err(Refuse::TwoWriters));
+        // Side by side is fine.
+        let by_copy = [(X, 0x1000, 0x1800), (Z, 0x1800, 0x2000)];
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &by_copy, &[]).map(|p| p.len()), Ok(2));
+    }
+
+    #[test]
+    fn own_writes_under_anothers_wait() {
+        let by_copy = [(Y, 0x1000, 0x1100), (X, 0x1000, 0x2000)];
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &by_copy, &[]), Err(Refuse::OwnWrites));
+        // Own writes elsewhere in the range do not matter.
+        let by_copy = [(Y, 0x1000, 0x1100), (X, 0x1800, 0x2000)];
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &by_copy, &[]).map(|p| p.len()), Ok(1));
+    }
+
+    #[test]
+    fn read_backs_and_bottom_of_pipe_writes_wait() {
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &[(0, 0x1f00, 0x2100)], &[]), Err(Refuse::ReadBack));
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &[], &[(0x1ff8, 0x2000)]), Err(Refuse::Immed));
+        // Outside the range they do not.
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &[(0, 0x2000, 0x2100)], &[(0x0ff8, 0x1000)]), Ok(vec![]));
+    }
+
+    #[test]
+    fn coverage() {
+        let p = [Piece { owner: X, from: 0x10, to: 0x20 }, Piece { owner: Z, from: 0x20, to: 0x30 }];
+        assert!(covered(&p, 0x10, 0x30));
+        assert!(covered(&p, 0x18, 0x28));
+        assert!(!covered(&p, 0x08, 0x18));
+        assert!(!covered(&p, 0x28, 0x38));
+        assert!(!covered(&[], 0x10, 0x11));
+        let gap = [Piece { owner: X, from: 0x10, to: 0x18 }, Piece { owner: X, from: 0x19, to: 0x30 }];
+        assert!(!covered(&gap, 0x10, 0x30));
+    }
+
+    #[test]
+    fn a_page_counts_only_if_taken_whole_and_not_written_since() {
+        // Pages 10..=12 of a copy starting at page 10.
+        let copied = [5, 7, 0];
+        assert!(took_current(&copied, 10, 10, 11, &[(10, 5), (11, 3)]));
+        assert!(!took_current(&copied, 10, 10, 11, &[(11, 8)]));
+        // Never taken whole.
+        assert!(!took_current(&copied, 10, 12, 12, &[]));
+        // Outside the copy.
+        assert!(!took_current(&copied, 10, 9, 10, &[]));
+        assert!(!took_current(&copied, 10, 13, 13, &[]));
+    }
+
+    /// The exactness argument on bytes: what landing then refreshing gives
+    /// Y equals the refresh now plus X's card bytes copied over the piece,
+    /// when the title did not write the piece since X took it.
+    #[test]
+    fn serving_on_the_card_gives_what_landing_gives() {
+        // Title memory, 16 bytes; X declared writes over [4, 12).
+        let title: Vec<u8> = (0..16).collect();
+        let mut x_card = title.clone(); // X took it all when its flight went
+        for b in &mut x_card[6..9] {
+            *b = 0xEE; // what X's shaders wrote
+        }
+        // Landing: the bytes the card changed go to title memory; Y then
+        // refreshes all of it.
+        let mut landed = title.clone();
+        for i in 4..12 {
+            if x_card[i] != title[i] {
+                landed[i] = x_card[i];
+            }
+        }
+        let y_after_wait = landed.clone();
+        // Served on the card: Y refreshed from title memory now, then X's
+        // card bytes over the piece.
+        let pieces = plan_refresh(Y, 0, 16, &[(X, 4, 12)], &[]).unwrap();
+        let mut y_now = title.clone();
+        for p in pieces {
+            y_now[p.from..p.to].copy_from_slice(&x_card[p.from..p.to]);
+        }
+        assert_eq!(y_now, y_after_wait);
+    }
+}
diff --git a/crates/victory-gpu/src/rebar.rs b/crates/victory-gpu/src/rebar.rs
new file mode 100644
index 0000000..644618d
--- /dev/null
+++ b/crates/victory-gpu/src/rebar.rs
@@ -0,0 +1,375 @@
+//! `VICTORY_REBAR` (opt-in, off by default): host copies of title memory in
+//! the card's own memory that the CPU maps (Resizable BAR, D3D12's GPU
+//! upload heap, `D3D12_HEAP_TYPE_GPU_UPLOAD`).
+//!
+//! The console's memory is one: what the CPU writes, the GPU reads where it
+//! lies. Here a host copy of title memory is either in the PC's memory
+//! (`Host::shared_buffer`: the CPU writes it at full speed, every shader
+//! load crosses the bus) or, for big title buffers, in the card's memory
+//! with a second side in the PC's memory and a copy between the two before
+//! each submission (`crate::shadow::cards`). With a large CPU-visible
+//! window on the card's memory the CPU can write the card's side itself:
+//! no PC-side twin, no copy before the submission, shader loads at the
+//! card's speed.
+//!
+//! What is placed there is what the CPU writes and shaders only read:
+//! - `VICTORY_REBAR=1`: windows of title memory outside buffers (the
+//!   title's own allocator: interface vertices, mesh streams, constants;
+//!   run 91: shaders write none of them; run 104: 3.5 GB of the 5.4 GB
+//!   the card shares with the PC).
+//! - `VICTORY_REBAR=2`: also title buffers below the card-buffer size
+//!   (`VICTORY_CARD_BUFFERS_MIN_MB`), which shaders may write. What they
+//!   write is still found and copied back on the CPU, reading the card's
+//!   memory over the bus (uncached: slow), so this level is for A/B tests.
+//!
+//! Never placed there, at any level: the buffers the title reads on the CPU
+//! (its read-back ring, `crate::readback`). The CPU reads those, and a read
+//! of CPU-visible card memory is uncached; they stay in cached PC memory
+//! (write-back custom heap, as before), which is what a read-back heap is.
+//!
+//! Without the heap (Resizable BAR off: a 256 MB BAR; an older driver or
+//! system; the software adapter) nothing changes: every copy is made as
+//! before, and the start line says why.
+//!
+//! `VICTORY_REBAR_MB` sets the most bytes placed (default: a quarter of
+//! the card's budget, at most 4 GiB); as for card buffers, a copy goes
+//! there only while a fifth of the card's budget stays free.
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// What a copy is.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Kind {
+    /// A window of title memory outside buffers.
+    Window,
+    /// A title buffer's copy (one too small for the card-buffer path).
+    Buffer,
+}
+
+/// Where a copy goes, and why not to the card's mapped memory.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Decision {
+    Rebar,
+    Off,
+    Unsupported,
+    /// The level does not place this kind.
+    NotThisKind,
+    /// The title reads it on the CPU.
+    CpuRead,
+    OverBudget,
+    /// The card's memory is nearly full.
+    CardFull,
+}
+
+/// What a decision is made from.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Ask {
+    pub level: u8,
+    pub supported: bool,
+    pub kind: Kind,
+    pub size: u64,
+    pub cpu_read: bool,
+    /// Bytes already placed, and the most that may be.
+    pub placed: u64,
+    pub most: u64,
+    /// The card's budget and use, if known.
+    pub card: Option<(u64, u64)>,
+}
+
+/// The placement rule (pure: tested below).
+pub(crate) fn decide(ask: &Ask) -> Decision {
+    if ask.level == 0 {
+        return Decision::Off;
+    }
+    if !ask.supported {
+        return Decision::Unsupported;
+    }
+    if ask.cpu_read {
+        return Decision::CpuRead;
+    }
+    match ask.kind {
+        Kind::Window => {}
+        Kind::Buffer if ask.level >= 2 => {}
+        Kind::Buffer => return Decision::NotThisKind,
+    }
+    if ask.placed.saturating_add(ask.size) > ask.most {
+        return Decision::OverBudget;
+    }
+    if let Some((budget, used)) = ask.card
+        && used.saturating_add(ask.size) > budget / 10 * 8
+    {
+        return Decision::CardFull;
+    }
+    Decision::Rebar
+}
+
+/// `VICTORY_REBAR`: 0 (unset, or anything else), 1 or 2.
+pub(crate) fn level_of(value: Option<&str>) -> u8 {
+    match value.map(str::trim) {
+        Some("1") => 1,
+        Some("2") => 2,
+        _ => 0,
+    }
+}
+
+/// The default most bytes: a quarter of the card's budget, at most 4 GiB
+/// (256 MiB when the budget is unknown).
+pub(crate) fn default_most(card_budget: Option<u64>) -> u64 {
+    match card_budget {
+        Some(b) => (b / 4).min(4 << 30),
+        None => 256 << 20,
+    }
+}
+
+pub(crate) fn level() -> u8 {
+    static LEVEL: OnceLock<u8> = OnceLock::new();
+    *LEVEL.get_or_init(|| level_of(std::env::var("VICTORY_REBAR").ok().as_deref()))
+}
+
+/// Whether the host's device has GPU upload heaps: set once at the host's
+/// start ([`probe`]).
+static SUPPORTED: OnceLock<bool> = OnceLock::new();
+
+pub(crate) fn supported() -> bool {
+    SUPPORTED.get().copied().unwrap_or(false)
+}
+
+fn most() -> u64 {
+    static MOST: OnceLock<u64> = OnceLock::new();
+    *MOST.get_or_init(|| {
+        let env = std::env::var("VICTORY_REBAR_MB").ok().and_then(|v| v.trim().parse::<u64>().ok());
+        match env {
+            Some(mb) => mb << 20,
+            None => default_most(crate::host::host().and_then(|h| h.video_memory()).map(|[b, ..]| b)),
+        }
+    })
+}
+
+/// Bytes placed alive, copies placed alive, and copies that wanted to be
+/// placed but were not (over the budget, card full, creation failed).
+static PLACED: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+/// The next multiple of 64 MiB of placed bytes at which a line is written.
+static NEXT_LINE: AtomicU64 = AtomicU64::new(64 << 20);
+
+/// Reserves bytes against the current count, so concurrent callers cannot
+/// both spend the same remaining budget. Returns the new total.
+fn reserve_bytes(placed: &AtomicU64, size: u64, most: u64) -> Option<u64> {
+    placed
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |used| {
+            used.checked_add(size).filter(|&next| next <= most)
+        })
+        .ok()
+        .map(|before| before + size)
+}
+
+/// At the host's start: whether the device has GPU upload heaps, and the
+/// line that says so.
+pub(crate) fn probe(device: &windows::Win32::Graphics::Direct3D12::ID3D12Device, card_budget: Option<u64>) {
+    use windows::Win32::Graphics::Direct3D12::{D3D12_FEATURE_D3D12_OPTIONS16, D3D12_FEATURE_DATA_D3D12_OPTIONS16};
+    let mut o16 = D3D12_FEATURE_DATA_D3D12_OPTIONS16::default();
+    // SAFETY: a plain query that fills our structure.
+    let asked = unsafe {
+        device.CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS16, (&raw mut o16).cast(), size_of_val(&o16) as u32)
+    };
+    let supported = asked.is_ok() && o16.GPUUploadHeapSupported.as_bool();
+    let _ = SUPPORTED.set(supported);
+    let level = level();
+    let most_mb = match std::env::var("VICTORY_REBAR_MB").ok().and_then(|v| v.trim().parse::<u64>().ok()) {
+        Some(mb) => mb,
+        None => default_most(card_budget) >> 20,
+    };
+    tracing::info!(
+        gpu_upload_heaps = supported,
+        options16_known = asked.is_ok(),
+        card_budget_mb = card_budget.map(|b| b >> 20),
+        level,
+        most_mb,
+        "Resizable BAR (D3D12 GPU upload heaps): {}",
+        match (supported, level) {
+            (true, 0) => "available, not used (VICTORY_REBAR=1 or 2 places host copies there)",
+            (true, 1) => "used for windows of title memory",
+            (true, _) => "used for windows of title memory and small title buffers",
+            (false, 0) => "not available",
+            (false, _) => "NOT available: VICTORY_REBAR is ignored, copies are made as before \
+                           (Resizable BAR off in the firmware/driver, or no OS/driver support)",
+        }
+    );
+}
+
+/// Whether a copy of `size` bytes of `kind` goes to the card's mapped
+/// memory; if it does, its bytes are counted as placed (the caller gives
+/// them back with [`released`] if the buffer cannot be made, or when it
+/// goes).
+pub(crate) fn reserve(kind: Kind, size: u64, cpu_read: bool) -> bool {
+    let level = level();
+    if level == 0 || !supported() {
+        return false;
+    }
+    let host = crate::host::host();
+    let card = host.and_then(|h| h.video_memory()).map(|[b, u, ..]| (b, u));
+    let ask = Ask {
+        level,
+        supported: true,
+        kind,
+        size,
+        cpu_read,
+        placed: PLACED[0].load(Ordering::Relaxed),
+        most: most(),
+        card,
+    };
+    let reserved = match decide(&ask) {
+        Decision::Rebar => reserve_bytes(&PLACED[0], size, ask.most),
+        Decision::OverBudget | Decision::CardFull => None,
+        _ => return false,
+    };
+    let Some(now) = reserved else {
+        if PLACED[2].fetch_add(1, Ordering::Relaxed) == 0 {
+            tracing::warn!(?kind, size, "Resizable BAR: a copy stays in the PC's memory (budget or card full)");
+        }
+        return false;
+    };
+    PLACED[1].fetch_add(1, Ordering::Relaxed);
+    let line = NEXT_LINE.load(Ordering::Relaxed);
+    if now >= line && NEXT_LINE.compare_exchange(line, now / (64 << 20) * (64 << 20) + (64 << 20), Ordering::Relaxed, Ordering::Relaxed).is_ok() {
+        tracing::info!(
+            placed_mb = now >> 20,
+            copies = PLACED[1].load(Ordering::Relaxed),
+            "Resizable BAR: host copies placed in the card's mapped memory"
+        );
+    }
+    true
+}
+
+/// Gives back what [`reserve`] counted.
+pub(crate) fn released(size: u64) {
+    PLACED[0].fetch_sub(size, Ordering::Relaxed);
+    PLACED[1].fetch_sub(1, Ordering::Relaxed);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MIB: u64 = 1 << 20;
+    const GIB: u64 = 1 << 30;
+
+    fn ask(level: u8, kind: Kind) -> Ask {
+        Ask {
+            level,
+            supported: true,
+            kind,
+            size: 4 * MIB,
+            cpu_read: false,
+            placed: 0,
+            most: GIB,
+            card: Some((11 * GIB, 2 * GIB)),
+        }
+    }
+
+    #[test]
+    fn the_switch_reads_only_one_and_two() {
+        assert_eq!(level_of(None), 0);
+        assert_eq!(level_of(Some("0")), 0);
+        assert_eq!(level_of(Some(" 1 ")), 1);
+        assert_eq!(level_of(Some("2")), 2);
+        assert_eq!(level_of(Some("yes")), 0);
+        assert_eq!(level_of(Some("3")), 0);
+    }
+
+    #[test]
+    fn off_or_unsupported_places_nothing() {
+        assert_eq!(decide(&ask(0, Kind::Window)), Decision::Off);
+        let mut a = ask(2, Kind::Window);
+        a.supported = false;
+        assert_eq!(decide(&a), Decision::Unsupported);
+    }
+
+    #[test]
+    fn level_one_places_windows_only_level_two_buffers_too() {
+        assert_eq!(decide(&ask(1, Kind::Window)), Decision::Rebar);
+        assert_eq!(decide(&ask(1, Kind::Buffer)), Decision::NotThisKind);
+        assert_eq!(decide(&ask(2, Kind::Buffer)), Decision::Rebar);
+    }
+
+    #[test]
+    fn cpu_read_buffers_never_go_there() {
+        for level in [1, 2] {
+            for kind in [Kind::Window, Kind::Buffer] {
+                let mut a = ask(level, kind);
+                a.cpu_read = true;
+                assert_eq!(decide(&a), Decision::CpuRead);
+            }
+        }
+    }
+
+    #[test]
+    fn the_budget_holds_to_the_byte() {
+        let mut a = ask(1, Kind::Window);
+        a.placed = GIB - 4 * MIB;
+        assert_eq!(decide(&a), Decision::Rebar);
+        a.placed += 1;
+        assert_eq!(decide(&a), Decision::OverBudget);
+        a.placed = u64::MAX;
+        assert_eq!(decide(&a), Decision::OverBudget);
+    }
+
+    #[test]
+    fn reserved_bytes_stop_at_the_cap_and_can_be_returned() {
+        let placed = AtomicU64::new(4 * MIB);
+        assert_eq!(reserve_bytes(&placed, 4 * MIB, 8 * MIB), Some(8 * MIB));
+        assert_eq!(reserve_bytes(&placed, 1, 8 * MIB), None);
+        assert_eq!(placed.load(Ordering::Relaxed), 8 * MIB);
+        // Allocation failure and teardown return the successful reservation.
+        placed.fetch_sub(4 * MIB, Ordering::Relaxed);
+        assert_eq!(reserve_bytes(&placed, 4 * MIB, 8 * MIB), Some(8 * MIB));
+    }
+
+    #[test]
+    fn reserved_bytes_do_not_wrap() {
+        let placed = AtomicU64::new(u64::MAX - 1);
+        assert_eq!(reserve_bytes(&placed, 2, u64::MAX), None);
+        assert_eq!(placed.load(Ordering::Relaxed), u64::MAX - 1);
+        assert_eq!(reserve_bytes(&placed, 1, u64::MAX), Some(u64::MAX));
+    }
+
+    #[test]
+    fn concurrent_reservations_share_one_budget() {
+        let placed = AtomicU64::new(0);
+        let gate = std::sync::Barrier::new(8);
+        let accepted = std::thread::scope(|scope| {
+            let workers: Vec<_> = (0..8)
+                .map(|_| {
+                    scope.spawn(|| {
+                        gate.wait();
+                        reserve_bytes(&placed, 4 * MIB, 4 * MIB)
+                    })
+                })
+                .collect();
+            workers
+                .into_iter()
+                .filter_map(|worker| worker.join().unwrap())
+                .count()
+        });
+        assert_eq!(accepted, 1);
+        assert_eq!(placed.load(Ordering::Relaxed), 4 * MIB);
+    }
+
+    #[test]
+    fn a_fifth_of_the_card_stays_free() {
+        let mut a = ask(1, Kind::Window);
+        a.card = Some((10 * GIB, 8 * GIB - 4 * MIB));
+        assert_eq!(decide(&a), Decision::Rebar);
+        a.card = Some((10 * GIB, 8 * GIB));
+        assert_eq!(decide(&a), Decision::CardFull);
+        a.card = None;
+        assert_eq!(decide(&a), Decision::Rebar);
+    }
+
+    #[test]
+    fn default_budget_is_a_quarter_of_the_card_at_most_4_gib() {
+        assert_eq!(default_most(None), 256 * MIB);
+        assert_eq!(default_most(Some(11 * GIB)), 11 * GIB / 4);
+        assert_eq!(default_most(Some(30 * GIB)), 4 * GIB);
+    }
+}
diff --git a/crates/victory-gpu/src/regions.rs b/crates/victory-gpu/src/regions.rs
new file mode 100644
index 0000000..449275f
--- /dev/null
+++ b/crates/victory-gpu/src/regions.rs
@@ -0,0 +1,542 @@
+//! The title's placeholder memory as the runtime mapped it
+//! ([`victory_core::memmap`]), and the copies of title memory that use it.
+//!
+//! The runtime maps every page the title streams in (`victory-hle` xmem:
+//! placeholders, then views of physical pages) and tells this crate
+//! ([`title_memory_placeholder`], [`crate::title_memory_remapped`],
+//! [`crate::title_memory_view`]). With that record a refresh of a host copy
+//! reads the mapped runs of title memory with plain copies, writes zeros for
+//! the holes, and asks Windows nothing; before it, a read that met a hole
+//! went through the kernel region by region, asking `VirtualQuery` about
+//! each (milliseconds a question in the title's big placeholders): 1-20 s
+//! frames while the title streamed (thousands of mapping changes a frame).
+//! Memory the record does not hold (the title's heaps) is read as before.
+//!
+//! `VICTORY_COPY_FAST=0` copies, guards and asks as before (for A/B).
+
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+use victory_core::memmap::{Kind, RegionMap};
+
+static MAP: Mutex<RegionMap> = Mutex::new(RegionMap::new());
+
+fn map() -> std::sync::MutexGuard<'static, RegionMap> {
+    MAP.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// Whether copies and guards use the record (`VICTORY_COPY_FAST=0`: no).
+pub(crate) fn fast() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var_os("VICTORY_COPY_FAST").is_none_or(|v| v != "0");
+        tracing::info!("title memory copies: {} (VICTORY_COPY_FAST)", if on { "by the runtime's mapping record" } else { "asking Windows, as before" });
+        on
+    })
+}
+
+/// `VICTORY_COPY_NOQUERY=1` (off by default): a chunk whose mapping is
+/// being changed is waited for ([`wait_still`]) and read by the record,
+/// not through the kernel; and the kernel's sparse read
+/// (`host::read_sparse`) takes its runs from the record ([`sparse_runs`]),
+/// asking `VirtualQuery` only about memory it does not know.
+/// With it on the copy-path line is logged at `warn`.
+pub(crate) fn noquery() -> bool {
+    // Live (`victory_core::live`): flipped at frame boundaries by `VICTORY_AB`.
+    static ON: victory_core::live::Switch = victory_core::live::Switch::new("COPY_NOQUERY", 0);
+    static SAID: std::sync::Once = std::sync::Once::new();
+    let on = ON.on();
+    if on {
+        SAID.call_once(|| tracing::warn!("title memory copies: busy chunks waited for, sparse reads by the record (VICTORY_COPY_NOQUERY=1)"));
+    }
+    on
+}
+
+/// The runtime reserved `[at, at + len)` as a placeholder for physical
+/// pages: holes until it maps views there.
+pub fn title_memory_placeholder(at: usize, len: usize) {
+    crate::native::gpumem::reserved(at as u64, len as u64);
+    map().reserve(at, len);
+}
+
+/// The runtime reserved or released `[at, at + len)` as something other than
+/// a placeholder: what the record held there is gone.
+pub fn title_memory_not_placeholder(at: usize, len: usize) {
+    let mut m = map();
+    if !m.is_empty() {
+        m.release(at, len);
+    }
+}
+
+/// `[at, at + len)` shows nothing now (`crate::title_memory_remapped`).
+pub(crate) fn unmapped(at: usize, len: usize) {
+    map().unmap(at, len);
+}
+
+/// `[at, at + len)` shows a view now (`crate::title_memory_view`).
+pub(crate) fn mapped(at: usize, len: usize) {
+    map().map(at, len);
+    prefetch(at, len);
+}
+
+/// Whether every byte of `[at, at + len)` is placeholder memory (mapped or
+/// not): memory that is not write-watched, so a write-watch asking about it
+/// can only fail.
+pub(crate) fn all_placeholder(at: usize, len: usize) -> bool {
+    if !fast() || len == 0 {
+        return false;
+    }
+    let m = map();
+    !m.is_empty() && m.knows_all(at, len)
+}
+
+/// Whether all of `[at, at + len)` is mapped, some of it is a hole, or the
+/// record cannot say (`None`, also with the switch off).
+pub(crate) fn all_mapped(at: usize, len: usize) -> Option<bool> {
+    if !fast() || len == 0 {
+        return None;
+    }
+    let m = map();
+    if m.is_empty() {
+        return None;
+    }
+    let all = m.all_mapped(at, len);
+    // Holes shown through the translation table
+    // (`VICTORY_MEM2_GPU_ONLY_NOVIEW`) count as mapped: they show bytes,
+    // read through the table or in place once made views. (The table is
+    // never asked with the record's lock held: its fault handler takes the
+    // record's lock with the table's held.)
+    let runs = (all == Some(false)).then(|| m.runs(at, len, false));
+    drop(m);
+    if let Some(runs) = runs
+        && crate::translate::any(at, len)
+    {
+        if runs.iter().any(|r| r.kind == Kind::Hole && crate::translate::bytes_in(r.start, r.len()) != r.len()) {
+            return Some(false);
+        }
+        return (!runs.iter().any(|r| r.kind == Kind::Unknown)).then_some(true);
+    }
+    all
+}
+
+/// How many bytes of `[at, at + len)` are mapped, if the record knows all
+/// of it (`None` otherwise, and with the switch off).
+pub(crate) fn mapped_bytes(at: usize, len: usize) -> Option<u64> {
+    if !fast() || len == 0 {
+        return None;
+    }
+    let m = map();
+    if m.is_empty() {
+        return None;
+    }
+    let runs = m.runs(at, len, false);
+    drop(m);
+    let mut bytes = 0u64;
+    for run in runs {
+        match run.kind {
+            Kind::Mapped => bytes += run.len() as u64,
+            // Shown through the translation table: there.
+            Kind::Hole => bytes += crate::translate::bytes_in(run.start, run.len()) as u64,
+            Kind::Unknown => return None,
+        }
+    }
+    Some(bytes)
+}
+
+/// What the record says of `[at, at + len)` for the guards: `None` if it
+/// knows none of it; else its runs, each view on its own.
+pub(crate) fn runs_by_view(at: usize, len: usize) -> Option<Vec<victory_core::memmap::Run>> {
+    if !fast() || len == 0 {
+        return None;
+    }
+    let m = map();
+    if m.is_empty() || !m.knows_any(at, len) {
+        return None;
+    }
+    Some(m.runs(at, len, true))
+}
+
+/// The run holding `at`, by the record (`None` with the switch off).
+pub(crate) fn around(at: usize) -> Option<victory_core::memmap::Run> {
+    if !fast() {
+        return None;
+    }
+    let m = map();
+    if m.is_empty() {
+        return None;
+    }
+    Some(m.around(at))
+}
+
+/// The most read in one piece while the bytes are held still
+/// ([`crate::watch::title_memory_reading_now`]): the title's mapping of
+/// them waits that long at most (some milliseconds).
+const CHUNK: usize = 4 << 20;
+
+/// The longest [`wait_still`] waits: a change takes 10-20 us; one that
+/// waits on a read in place the caller itself holds (a texture refresh
+/// holds `title_memory_reading` around its `copy_mapped`) never ends, so
+/// the wait is bounded and polls (`title_memory_reading_now`) instead of
+/// blocking in `title_memory_reading`: no lock is held while it waits, and
+/// no new lock order is made.
+const WAIT_MOST: std::time::Duration = std::time::Duration::from_millis(2);
+
+/// [`noquery`]: `[at, at + len)` held still once the change of its mapping
+/// under way is done; `None` after [`WAIT_MOST`] (the caller reads through
+/// the kernel, as before).
+fn wait_still(at: usize, len: usize) -> Option<crate::watch::Reading> {
+    let begun = std::time::Instant::now();
+    let mut spins = 0u32;
+    let still = loop {
+        if spins < 64 {
+            std::hint::spin_loop();
+        } else {
+            std::thread::yield_now();
+        }
+        spins += 1;
+        if let Some(r) = crate::watch::title_memory_reading_now(at, len) {
+            break Some(r);
+        }
+        if begun.elapsed() >= WAIT_MOST {
+            break None;
+        }
+    };
+    add(S::WaitUs, begun.elapsed().as_micros() as u64);
+    add(if still.is_some() { S::Waited } else { S::WaitGaveUp }, 1);
+    still
+}
+
+/// [`noquery`]: the record's runs of `[at, at + len)` for the kernel's
+/// sparse read, if it knows any of it (`None`: ask Windows, as before).
+/// Not held still: the runs are a map of where to read, and the read
+/// itself is the kernel's guarded one, as after a `VirtualQuery` (whose
+/// answer was no fresher by the time of the read).
+pub(crate) fn sparse_runs(at: usize, len: usize) -> Option<Vec<victory_core::memmap::Run>> {
+    if !noquery() {
+        return None;
+    }
+    sparse_runs_any(at, len)
+}
+
+/// [`sparse_runs`] whatever the switch.
+pub(crate) fn sparse_runs_any(at: usize, len: usize) -> Option<Vec<victory_core::memmap::Run>> {
+    if !fast() || len == 0 {
+        return None;
+    }
+    let m = map();
+    if m.is_empty() || !m.knows_any(at, len) {
+        return None;
+    }
+    Some(m.runs(at, len, false))
+}
+
+/// Copies title memory `[src, src + len)` into host memory at `dst`: the
+/// mapped runs as they are, zeros for the holes, the rest through `os`
+/// (the kernel's guarded read). False if the record knows nothing of the
+/// range (the caller copies as before).
+pub(crate) fn copy(dst: *mut u8, src: *const u8, len: usize, os: impl Fn(*mut u8, *const u8, usize)) -> bool {
+    copy_by(dst, src, len, os, noquery())
+}
+
+/// [`copy`]; `wait`: busy chunks waited for ([`noquery`]).
+pub(crate) fn copy_by(dst: *mut u8, src: *const u8, len: usize, os: impl Fn(*mut u8, *const u8, usize), wait: bool) -> bool {
+    if len == 0 || !fast() {
+        return false;
+    }
+    let start = src as usize;
+    {
+        let m = map();
+        if m.is_empty() || !m.knows_any(start, len) {
+            return false;
+        }
+    }
+    let begun = std::time::Instant::now();
+    add(S::Copies, 1);
+    for (from, to) in victory_core::memmap::chunks(start, len, CHUNK) {
+        let at = |a: usize| dst.wrapping_add(a - start);
+        // The runtime changes no mapping of these bytes while they are
+        // read (it waits); one under way or waiting: read through the
+        // kernel, which tells a hole from a page itself.
+        // `VICTORY_COPY_NOQUERY=1`: wait for the change (microseconds)
+        // rather than read 4 MiB region by region through the kernel.
+        let still = match crate::watch::title_memory_reading_now(from, to - from) {
+            None if wait => wait_still(from, to - from),
+            still => still,
+        };
+        let Some(_still) = still else {
+            add(S::Busy, 1);
+            os(at(from), from as *const u8, to - from);
+            add(S::OsBytes, (to - from) as u64);
+            continue;
+        };
+        let runs = map().runs(from, to - from, false);
+        for run in runs {
+            add(S::Runs, 1);
+            let n = run.len();
+            match run.kind {
+                Kind::Mapped => {
+                    // SAFETY: the record says these bytes show a mapped,
+                    // committed view (the runtime maps views read-write and
+                    // commits them before telling), and no change of their
+                    // mapping can begin while `_still` is held. The
+                    // destination is the caller's host memory of `len` bytes.
+                    unsafe { std::ptr::copy_nonoverlapping(run.start as *const u8, at(run.start), n) };
+                    add(S::MappedBytes, n as u64);
+                }
+                Kind::Hole if crate::translate::any(run.start, n) => {
+                    // Pages shown through the translation table
+                    // (`VICTORY_MEM2_GPU_ONLY_NOVIEW`): their bytes; the
+                    // rest of the hole as below, piece by piece.
+                    crate::translate::read(run.start, at(run.start), n, |a, d, k| {
+                        add(S::Probes, 1);
+                        let mut byte = [0u8];
+                        if crate::host::read_into(a as *const u8, &mut byte) {
+                            add(S::Stale, 1);
+                            os(d, a as *const u8, k);
+                            add(S::OsBytes, k as u64);
+                        } else {
+                            // SAFETY: inside the caller's host destination.
+                            unsafe { d.write_bytes(0, k) };
+                            add(S::HoleBytes, k as u64);
+                        }
+                        true
+                    });
+                    add(S::MappedBytes, crate::translate::bytes_in(run.start, n) as u64);
+                }
+                Kind::Hole => {
+                    // One look through the kernel at the hole's first byte:
+                    // memory the title reserved anew without the runtime
+                    // (the record keeps placeholders it never saw released)
+                    // reads, and is then read as before and forgotten.
+                    add(S::Probes, 1);
+                    let mut byte = [0u8];
+                    if crate::host::read_into(run.start as *const u8, &mut byte) {
+                        add(S::Stale, 1);
+                        map().release(run.start, n);
+                        os(at(run.start), run.start as *const u8, n);
+                        add(S::OsBytes, n as u64);
+                    } else {
+                        // SAFETY: inside the caller's host destination.
+                        unsafe { at(run.start).write_bytes(0, n) };
+                        add(S::HoleBytes, n as u64);
+                    }
+                }
+                Kind::Unknown => {
+                    os(at(run.start), run.start as *const u8, n);
+                    add(S::OsBytes, n as u64);
+                }
+            }
+        }
+    }
+    add(S::FastUs, begun.elapsed().as_micros() as u64);
+    true
+}
+
+/// Counters of the copy path, since the last stats line.
+#[derive(Clone, Copy)]
+pub(crate) enum S {
+    /// Copies the record handled; runs they were cut into.
+    Copies,
+    Runs,
+    /// Bytes copied plainly from mapped runs, written as zeros for holes,
+    /// and read through the kernel (unknown memory, busy chunks).
+    MappedBytes,
+    HoleBytes,
+    OsBytes,
+    /// Holes looked at through the kernel, and found mapped after all.
+    Probes,
+    Stale,
+    /// Chunks whose mapping was being changed (read through the kernel).
+    Busy,
+    /// Microseconds in copies the record handled.
+    FastUs,
+    /// Copies as before (`host::copy_mapped`), their bytes and microseconds.
+    OsCopies,
+    OsCopyBytes,
+    OsCopyUs,
+    /// System calls by kind: kernel reads, `VirtualQuery`, `VirtualProtect`,
+    /// write-watch askings.
+    Reads,
+    Queries,
+    Protects,
+    Watches,
+    /// Microseconds in `VirtualQuery` and `VirtualProtect` calls.
+    QueryUs,
+    ProtectUs,
+    /// Submission flushes (`host::Batch::flush`), their microseconds, the
+    /// longest, and the page faults the process took during them.
+    Flushes,
+    FlushUs,
+    FlushMaxUs,
+    FlushFaults,
+    /// Write-watch askings left out: the range is all placeholder memory.
+    WatchesSaved,
+    /// Ranges given to the prefetch thread, and their bytes.
+    Prefetched,
+    PrefetchBytes,
+    /// `VICTORY_COPY_NOQUERY`: busy chunks waited for and then read by the
+    /// record, ones given up on ([`WAIT_MOST`]), the microseconds waited;
+    /// `VirtualQuery` calls the sparse read left out (runs the record had).
