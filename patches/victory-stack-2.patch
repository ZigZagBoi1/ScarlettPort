+            SyncAfter: D3D12_BARRIER_SYNC_ALL,
+            AccessBefore: before,
+            AccessAfter: after,
+            // SAFETY: borrowed for the Barrier call. The list retains the buffer.
+            pResource: unsafe { std::mem::transmute_copy(buffer) },
+            Offset: 0,
+            Size: u64::MAX,
+        };
