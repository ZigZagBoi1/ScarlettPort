+#define RS "DescriptorTable(SRV(t0)), UAV(u0)"
+Texture2D<uint4> t : register(t0);
+RWByteAddressBuffer o : register(u0);
+[RootSignature(RS)]
+[numthreads(16, 16, 1)]
