+    #[test]
+    fn a_group_waits_for_all_its_jobs() {
+        let group = Group::default();
+        let sum = Arc::new(AtomicU64::new(0));
+        for i in 1..=100u64 {
+            let sum = sum.clone();
+            group.spawn(move || {
+                std::thread::sleep(std::time::Duration::from_micros(50));
+                sum.fetch_add(i, Relaxed);
