+        let on = std::env::var_os("VICTORY_BARRIER_LITERAL").is_some_and(|v| v == "1");
+        if on {
+            tracing::info!("the title's barrier groups are taken literally (VICTORY_BARRIER_LITERAL=1)");
+        }
+        on
+    })
