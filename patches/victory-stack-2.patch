+/// On the card, without the title: what levels on demand relies on, with
+/// the pool and the mapping call of this module on a device of the test's
+/// own. One test, one device: the pool is one for the process, and its
+/// heaps belong to the device that made them.
+///
+/// Run by name, alone, no game needed:
+/// `cargo test -p victory-gpu --release -- --ignored levels_on_demand --nocapture`
+///
+/// It runs on the SOFTWARE adapter unless `VICTORY_TILES_TEST_CARD=1`: on
+/// that adapter nothing reaches the card or its driver, so nothing it does
+/// can reset the driver or touch the screen. Wherever it runs, the debug
+/// layer is switched on if Windows has it (the optional feature "Graphics
+/// Tools"), its messages are printed after every step, and the test stops
+/// at the first error or lost device with the step's name, before
+/// anything else is sent. On the card it does not run without the layer,
+/// and no wait is longer than 1.5 s.
+#[cfg(test)]
+mod tests {
+    use windows::Win32::Foundation::{HANDLE, WAIT_OBJECT_0};
+    use windows::Win32::Graphics::Direct3D::D3D_FEATURE_LEVEL_12_0;
+    use windows::Win32::Graphics::Dxgi::Common::*;
+    use windows::Win32::System::Threading::{CreateEventW, WaitForSingleObject};
+    use windows::core::{Interface, s};
+
+    use super::*;
+    use crate::host::{compile, transition, warp_adapter};
+
+    const SIDE: u32 = 1024;
+    const LEVELS: u16 = 11;
+
+    /// Two views of one texture read at the same place and level: the
+    /// first as the layer makes it for a texture whose level 0 has no
+    /// memory, the second as the title asked.
+    const LOOK: &str = r#"
+#define RS "DescriptorTable(SRV(t0, numDescriptors = 2)), UAV(u0), StaticSampler(s0, filter = FILTER_MIN_MAG_MIP_POINT)"
+Texture2D<float4> clamped : register(t0);
+Texture2D<float4> whole : register(t1);
+SamplerState nearest : register(s0);
+RWByteAddressBuffer words : register(u0);
+[RootSignature(RS)]
+[numthreads(1, 1, 1)]
+void look() {
+    float4 a = clamped.SampleLevel(nearest, float2(0.3, 0.3), 0);
+    float4 b = whole.SampleLevel(nearest, float2(0.3, 0.3), 0);
+    words.Store(0, (uint)(a.x * 255.0 + 0.5));
+    words.Store(4, (uint)(b.x * 255.0 + 0.5));
+}
+"#;
+
+    /// Where each level of a texture lies in a buffer of all of them: its
+    /// place, its rows, the bytes of a row that are the level's own, and
+    /// the buffer's bytes.
+    struct Laid {
+        footprints: Vec<D3D12_PLACED_SUBRESOURCE_FOOTPRINT>,
+        rows: Vec<u32>,
+        wide: Vec<u64>,
+        total: u64,
+    }
+
+    struct Rig {
+        device: ID3D12Device,
+        queue: ID3D12CommandQueue,
+        allocator: ID3D12CommandAllocator,
+        list: ID3D12GraphicsCommandList,
+        fence: ID3D12Fence,
+        event: HANDLE,
+        submitted: u64,
+        /// The debug layer's messages, if Windows has the layer.
+        messages: Option<ID3D12InfoQueue>,
+        /// What the test is doing, for the message when it stops.
+        step: &'static str,
+        /// On the card, not on the software adapter.
+        card: bool,
+    }
+
+    impl Rig {
+        /// The software adapter, or the default one with
+        /// `VICTORY_TILES_TEST_CARD=1`; `None` without one, without tiled
+        /// resources of tier 2, or on the card without the debug layer.
+        fn new() -> Option<Rig> {
+            // SAFETY: plain object creation on a device of our own.
+            unsafe {
+                let card = std::env::var_os("VICTORY_TILES_TEST_CARD").is_some_and(|v| v == "1");
+                // The debug layer, before the device is made: a call that
+                // is not well formed is then refused and named by the
+                // runtime, not handed to the driver.
+                let mut layer: Option<ID3D12Debug> = None;
+                let layered = D3D12GetDebugInterface(&mut layer).is_ok() && layer.is_some();
+                layer.iter().for_each(|l| l.EnableDebugLayer());
+                if card && !layered {
+                    eprintln!("no D3D12 debug layer (Windows optional feature \"Graphics Tools\"): not run on the card without it");
+                    return None;
+                }
+                let mut device: Option<ID3D12Device> = None;
+                if card {
+                    D3D12CreateDevice(None, D3D_FEATURE_LEVEL_12_0, &mut device).ok()?;
+                } else {
+                    let adapter = warp_adapter().ok()?;
+                    D3D12CreateDevice(&adapter, D3D_FEATURE_LEVEL_12_0, &mut device).ok()?;
+                }
+                let device = device?;
+                let messages = device.cast::<ID3D12InfoQueue>().ok();
+                let mut options = D3D12_FEATURE_DATA_D3D12_OPTIONS::default();
+                device
+                    .CheckFeatureSupport(
+                        D3D12_FEATURE_D3D12_OPTIONS,
+                        (&raw mut options).cast(),
+                        size_of_val(&options) as u32,
+                    )
+                    .ok()?;
+                eprintln!(
+                    "levels on demand, {}: tiled resources tier {}, debug layer {}",
+                    if card { "ON THE CARD" } else { "on the software adapter" },
+                    options.TiledResourcesTier.0,
+                    if messages.is_some() { "on" } else { "not installed" }
+                );
+                if options.TiledResourcesTier.0 < 2 {
+                    return None;
+                }
+                let queue: ID3D12CommandQueue = device
+                    .CreateCommandQueue(&D3D12_COMMAND_QUEUE_DESC {
+                        Type: D3D12_COMMAND_LIST_TYPE_DIRECT,
+                        ..Default::default()
+                    })
+                    .ok()?;
+                let allocator: ID3D12CommandAllocator =
+                    device.CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT).ok()?;
+                let list: ID3D12GraphicsCommandList = device
+                    .CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, &allocator, None)
+                    .ok()?;
+                let fence: ID3D12Fence = device.CreateFence(0, D3D12_FENCE_FLAG_NONE).ok()?;
+                let event = CreateEventW(None, false, false, None).ok()?;
+                Some(Rig {
+                    device,
+                    queue,
+                    allocator,
+                    list,
+                    fence,
+                    event,
+                    submitted: 0,
+                    messages,
+                    step: "making the device",
+                    card,
+                })
+            }
+        }
+
+        /// Prints what the debug layer said since the last call; the first
+        /// error among it (as `host.rs` `log_messages` reads them).
+        fn said(&self) -> Option<String> {
+            let queue = self.messages.as_ref()?;
+            let mut first_error = None;
+            // SAFETY: each message is read into a buffer of the size the
+            // queue reports, then the queue is emptied.
+            unsafe {
+                for i in 0..queue.GetNumStoredMessages() {
+                    let mut size = 0;
+                    if queue.GetMessage(i, None, &mut size).is_err() || size == 0 {
+                        continue;
+                    }
+                    let mut buffer = vec![0u64; size.div_ceil(8)];
+                    let message = buffer.as_mut_ptr().cast::<D3D12_MESSAGE>();
+                    if queue.GetMessage(i, Some(message), &mut size).is_ok() {
+                        let m = &*message;
+                        let text = std::slice::from_raw_parts(m.pDescription, m.DescriptionByteLength);
+                        let text = String::from_utf8_lossy(text);
+                        let text = text.trim_end_matches('\0');
+                        eprintln!("D3D12 says (severity {}, id {}): {text}", m.Severity.0, m.ID.0);
+                        if m.Severity.0 <= D3D12_MESSAGE_SEVERITY_ERROR.0 && first_error.is_none() {
+                            first_error = Some(text.to_owned());
+                        }
+                    }
+                }
+                queue.ClearStoredMessages();
+            }
+            first_error
+        }
+
+        /// Stops the test, naming the step, if the device is lost or the
+        /// debug layer reported an error: nothing more is sent after it.
+        fn check(&self, what: &str) {
+            let error = self.said();
+            // SAFETY: a plain query.
+            let removed = unsafe { self.device.GetDeviceRemovedReason() };
+            assert!(removed.is_ok(), "{}, {what}: the device is lost: {removed:?}", self.step);
+            assert!(error.is_none(), "{}, {what}: the debug layer reports an error: {}", self.step, error.unwrap_or_default());
+        }
+
+        /// Gives tiles as a submission would, and stops if the mapping
+        /// call was refused.
+        fn give(&self, tiled: &Tiled, texture: &ID3D12Resource, levels: u32) {
+            tiled.give_on(&self.queue, &self.device, texture, levels, levels);
+            self.check("tiles given");
+        }
+
+        /// Records with `record`, runs the list behind what is already on
+        /// the queue (tile mappings among it), waits for the card and
+        /// opens the list again.
+        fn run(&mut self, record: impl FnOnce(&ID3D12GraphicsCommandList)) {
+            record(&self.list);
+            self.submitted += 1;
+            // SAFETY: our list, queue and fence; the allocator is reset
+            // only after the card finished everything recorded from it.
+            unsafe {
+                self.list.Close().unwrap();
+                let run: ID3D12CommandList = self.list.cast().unwrap();
+                self.queue.ExecuteCommandLists(&[Some(run)]);
+                self.queue.Signal(&self.fence, self.submitted).unwrap();
+                self.fence.SetEventOnCompletion(self.submitted, self.event).unwrap();
+                // Never without end: a step is a few copies of a few
+                // megabytes. On the card the limit stays under Windows' own
+                // two seconds; the software adapter, which compiles its
+                // shader on first use and resets nothing, gets longer.
+                let limit = if self.card { 1500 } else { 20_000 };
+                let waited = WaitForSingleObject(self.event, limit);
+                self.check("a submission");
+                assert!(
+                    waited == WAIT_OBJECT_0,
+                    "{}: a submission did not finish within {limit} ms; stopped before another is sent",
+                    self.step
+                );
+                self.allocator.Reset().unwrap();
+                self.list.Reset(&self.allocator, None).unwrap();
+            }
+        }
+
+        fn buffer(&self, kind: D3D12_HEAP_TYPE, flags: D3D12_RESOURCE_FLAGS, state: D3D12_RESOURCE_STATES, bytes: u64) -> ID3D12Resource {
+            let heap = D3D12_HEAP_PROPERTIES {
+                Type: kind,
+                ..Default::default()
+            };
+            let desc = D3D12_RESOURCE_DESC {
+                Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+                Width: bytes,
+                Height: 1,
+                DepthOrArraySize: 1,
+                MipLevels: 1,
+                SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+                Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+                Flags: flags,
+                ..Default::default()
+            };
+            let mut out: Option<ID3D12Resource> = None;
+            // SAFETY: plain buffer creation.
+            unsafe {
+                self.device
+                    .CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, state, None, &mut out)
+                    .unwrap();
+            }
+            out.unwrap()
+        }
+
+        /// A square texture description of `side` texels and `levels`
+        /// levels; `reserved`: in the layout a texture without memory of
+        /// its own must have.
+        fn desc(format: DXGI_FORMAT, side: u32, levels: u16, reserved: bool) -> D3D12_RESOURCE_DESC {
+            D3D12_RESOURCE_DESC {
+                Dimension: D3D12_RESOURCE_DIMENSION_TEXTURE2D,
+                Width: u64::from(side),
+                Height: side,
+                DepthOrArraySize: 1,
+                MipLevels: levels,
+                Format: format,
+                SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+                Layout: if reserved { D3D12_TEXTURE_LAYOUT_64KB_UNDEFINED_SWIZZLE } else { D3D12_TEXTURE_LAYOUT_UNKNOWN },
+                ..Default::default()
+            }
+        }
+
+        /// A texture without memory, in the state copies into it need, and
+        /// how the card cuts it.
+        fn reserved(&self, desc: &D3D12_RESOURCE_DESC) -> (ID3D12Resource, Tiled) {
+            let mut made: Option<ID3D12Resource> = None;
+            // SAFETY: plain creation; a texture that is no target has no clear value.
+            let asked = unsafe {
+                self.device
+                    .CreateReservedResource(desc, D3D12_RESOURCE_STATE_COPY_DEST, None, &mut made)
+            };
+            // The layer's reason first, if it refused.
+            self.check("a texture without memory made");
+            asked.expect("a reserved texture");
+            let texture = made.expect("a reserved texture");
+            let tiled = Tiled::make(&self.device, &texture, u32::from(desc.MipLevels)).expect("the card says how it cuts the texture");
+            (texture, tiled)
+        }
+
+        fn footprints(&self, desc: &D3D12_RESOURCE_DESC) -> Laid {
+            let levels = usize::from(desc.MipLevels);
+            let mut footprints = vec![D3D12_PLACED_SUBRESOURCE_FOOTPRINT::default(); levels];
+            let mut rows = vec![0u32; levels];
+            let mut wide = vec![0u64; levels];
+            let mut total = 0u64;
+            // SAFETY: outputs for `levels` subresources.
+            unsafe {
+                self.device.GetCopyableFootprints(
+                    desc,
+                    0,
+                    levels as u32,
+                    0,
+                    Some(footprints.as_mut_ptr()),
+                    Some(rows.as_mut_ptr()),
+                    Some(wide.as_mut_ptr()),
+                    Some(&mut total),
+                );
+            }
+            Laid {
+                footprints,
+                rows,
+                wide,
+                total,
+            }
+        }
+
+        /// An upload buffer of `total` bytes in which the bytes of each
+        /// level are `byte(level)`.
+        fn filled(&self, layout: &Laid, byte: impl Fn(usize) -> u8) -> ID3D12Resource {
+            let (footprints, rows) = (&layout.footprints, &layout.rows);
+            let upload = self.buffer(D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_GENERIC_READ, layout.total);
+            // SAFETY: the buffer is `total` bytes; each level's rows lie inside it.
+            unsafe {
+                let mut data = std::ptr::null_mut();
+                upload.Map(0, None, Some(&mut data)).unwrap();
+                for (level, f) in footprints.iter().enumerate() {
+                    let len = rows[level] as usize * f.Footprint.RowPitch as usize;
+                    std::slice::from_raw_parts_mut(data.cast::<u8>().add(f.Offset as usize), len).fill(byte(level));
+                }
+                upload.Unmap(0, None);
+            }
+            upload
+        }
+
+        /// Copies every level of `texture` from `upload`, then every level
+        /// back, and gives for each level the first sixteen bytes read of
+        /// its first row and of the row and column half way (another tile
+        /// of a level of several).
+        fn round_trip(
+            &mut self,
+            texture: &ID3D12Resource,
+            layout: &Laid,
+            upload: Option<&ID3D12Resource>,
+        ) -> Vec<[Vec<u8>; 2]> {
+            let (footprints, rows) = (&layout.footprints, &layout.rows);
+            let back = self.buffer(D3D12_HEAP_TYPE_READBACK, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST, layout.total);
+            self.run(|list| {
+                // SAFETY: an open list; the texture and buffers outlive the run.
+                unsafe {
+                    if let Some(upload) = upload {
+                        for (level, f) in footprints.iter().enumerate() {
+                            list.CopyTextureRegion(&sub(texture, level as u32), 0, 0, 0, &placed(upload, *f), None);
+                        }
+                    }
+                    list.ResourceBarrier(&[transition(texture, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_COPY_SOURCE)]);
+                    for (level, f) in footprints.iter().enumerate() {
+                        list.CopyTextureRegion(&placed(&back, *f), 0, 0, 0, &sub(texture, level as u32), None);
+                    }
+                    list.ResourceBarrier(&[transition(texture, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COPY_DEST)]);
+                }
+            });
+            let mut read = Vec::new();
+            // SAFETY: a read-back buffer of `total` bytes the finished list copied into.
+            unsafe {
+                let mut data = std::ptr::null_mut();
+                back.Map(0, None, Some(&mut data)).unwrap();
+                for (level, f) in footprints.iter().enumerate() {
+                    let pitch = f.Footprint.RowPitch as usize;
+                    let len = rows[level] as usize * pitch;
+                    let bytes = std::slice::from_raw_parts(data.cast::<u8>().cast_const().add(f.Offset as usize), len);
+                    // The bytes of a row that are the level's own (its
+                    // blocks or texels; the rest of the pitch is padding).
+                    let own = layout.wide[level] as usize;
+                    let wide = own.min(len).min(16);
+                    let first = bytes[..wide].to_vec();
+                    let middle = (rows[level] as usize / 2) * pitch + ((own / 2) & !15);
+                    let far = if rows[level] >= 2 && own >= 32 && middle + wide <= len {
+                        bytes[middle..middle + wide].to_vec()
+                    } else {
+                        first.clone()
+                    };
+                    read.push([first, far]);
+                }
+                back.Unmap(0, None);
+            }
+            read
+        }
+    }
+
+    fn sub(texture: &ID3D12Resource, index: u32) -> D3D12_TEXTURE_COPY_LOCATION {
+        D3D12_TEXTURE_COPY_LOCATION {
+            // SAFETY: a borrowed pointer the location never releases.
+            pResource: unsafe { std::mem::transmute_copy(texture) },
+            Type: D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX,
+            Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 { SubresourceIndex: index },
+        }
+    }
+
+    fn placed(buffer: &ID3D12Resource, footprint: D3D12_PLACED_SUBRESOURCE_FOOTPRINT) -> D3D12_TEXTURE_COPY_LOCATION {
+        D3D12_TEXTURE_COPY_LOCATION {
+            // SAFETY: as above.
+            pResource: unsafe { std::mem::transmute_copy(buffer) },
+            Type: D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT,
+            Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 { PlacedFootprint: footprint },
+        }
+    }
+
+    fn all(bytes: &[Vec<u8>; 2], want: u8) -> bool {
+        bytes.iter().all(|part| part.iter().all(|&b| b == want))
+    }
+
+    /// The levels from `first` on, a bit a level.
+    fn from_level(first: u32) -> u32 {
+        (u32::MAX << first) & ((1 << u32::from(LEVELS)) - 1)
+    }
+
+    /// (i) Levels arrive one by one: after each step every level with
+    /// tiles reads back its own bytes and every level without reads zeros.
+    fn levels_arrive(rig: &mut Rig, format: DXGI_FORMAT) {
+        rig.step = if format == DXGI_FORMAT_BC7_UNORM { "step 1, levels arrive (BC7)" } else { "step 1, levels arrive (BC3)" };
+        let desc = Rig::desc(format, SIDE, LEVELS, true);
+        let (texture, tiled) = rig.reserved(&desc);
+        // (The card packs the levels smaller than a tile into shared
+        // tiles; the software adapter may give each its own.)
+        eprintln!(
+            "format {}: {} levels with tiles of their own ({:?} tiles), {} tiles for the packed ones",
+            format.0,
+            tiled.standard.len(),
+            tiled.standard,
+            tiled.packed
+        );
+        assert!(!rig.card || tiled.packed > 0, "on the card a 1024 texture has levels smaller than a tile");
+        let layout = rig.footprints(&desc);
+        let upload = rig.filled(&layout, |level| level as u8 + 1);
+        for first in [3u32, 1, 0] {
+            // Ahead of the list on the queue, as at a submission.
+            rig.give(&tiled, &texture, from_level(first));
+            let read = rig.round_trip(&texture, &layout, Some(&upload));
+            for (level, bytes) in read.iter().enumerate() {
+                let want = if tiled.has_tiles(level as u32) { level as u8 + 1 } else { 0 };
+                assert!(all(bytes, want), "format {} from level {first}: level {level} reads {bytes:?}, wanted {want}", format.0);
+            }
+        }
+        assert!(tiled.whole());
+        assert_eq!(tiled.first_shown(), Some(0));
+    }
+
+    /// (ii) A copy on the card into a level without tiles is dropped; the
+    /// same copy in a list that runs after the level was given lands.
+    fn a_card_copy_lands_after_the_give(rig: &mut Rig) {
+        rig.step = "step 2, a copy on the card into a level without tiles";
+        let format = DXGI_FORMAT_BC7_UNORM;
+        let desc = Rig::desc(format, SIDE, LEVELS, true);
+        let (texture, tiled) = rig.reserved(&desc);
+        let layout = rig.footprints(&desc);
+        // The last level with tiles of its own, and a texture of its size
+        // with every byte 0x5a to copy from.
+        let level = tiled.standard.len() as u32 - 1;
+        let source_desc = Rig::desc(format, SIDE >> level, 1, false);
+        let source_layout = rig.footprints(&source_desc);
+        let source_bytes = rig.filled(&source_layout, |_| 0x5a);
+        let mut made: Option<ID3D12Resource> = None;
+        let heap = D3D12_HEAP_PROPERTIES {
+            Type: D3D12_HEAP_TYPE_DEFAULT,
+            ..Default::default()
+        };
+        // SAFETY: plain texture creation.
+        unsafe {
+            rig.device
+                .CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &source_desc, D3D12_RESOURCE_STATE_COPY_DEST, None, &mut made)
+                .unwrap();
+        }
+        let source = made.unwrap();
+        rig.run(|list| {
+            // SAFETY: an open list and live resources.
+            unsafe {
+                list.CopyTextureRegion(&sub(&source, 0), 0, 0, 0, &placed(&source_bytes, source_layout.footprints[0]), None);
+                list.ResourceBarrier(&[transition(&source, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_COPY_SOURCE)]);
+                // No tiles yet: this copy goes nowhere.
+                list.CopyTextureRegion(&sub(&texture, level), 0, 0, 0, &sub(&source, 0), None);
+            }
+        });
+        let before = rig.round_trip(&texture, &layout, None);
+        assert!(all(&before[level as usize], 0), "a copy into a level without tiles left {:?}", before[level as usize]);
+        // As `texture.rs` `card_writes` has it: the give at the list's
+        // submission, the copy in the list.
+        assert_ne!(tiled.claim(tiled.with_level(level)), 0, "the level is new");
+        rig.give(&tiled, &texture, tiled.with_level(level));
+        rig.run(|list| {
+            // SAFETY: as above.
+            unsafe { list.CopyTextureRegion(&sub(&texture, level), 0, 0, 0, &sub(&source, 0), None) };
+        });
+        let after = rig.round_trip(&texture, &layout, None);
+        assert!(all(&after[level as usize], 0x5a), "the copy after the give left {:?}", after[level as usize]);
+        assert_eq!(tiled.claim(tiled.with_level(level)), 0, "claimed once");
+    }
+
+    /// (iii) Tiles a texture gave back go to the next one, which reads
+    /// what was written into it and zeros where it has no tiles; what a
+    /// level given and not written reads is printed (the reason no level
+    /// is given outside a list that writes it).
+    fn a_reused_tile_reads_as_written(rig: &mut Rig) {
+        rig.step = "step 3, a reused tile";
+        let desc = Rig::desc(DXGI_FORMAT_BC7_UNORM, SIDE, LEVELS, true);
+        let layout = rig.footprints(&desc);
+        let (first, first_tiles) = rig.reserved(&desc);
+        let level = first_tiles.standard.len() as u32 - 1;
+        rig.give(&first_tiles, &first, 1 << level);
+        let upload = rig.filled(&layout, |_| 0xa5);
+        let read = rig.round_trip(&first, &layout, Some(&upload));
+        assert!(all(&read[level as usize], 0xa5));
+        let runs = first_tiles.given.lock().unwrap().runs.clone();
+        drop(first_tiles);
+        drop(first);
+        let (second, second_tiles) = rig.reserved(&desc);
+        rig.give(&second_tiles, &second, 1 << level);
+        let reused = second_tiles.given.lock().unwrap().runs == runs;
+        let unwritten = rig.round_trip(&second, &layout, None);
+        eprintln!(
+            "a level given tiles and not written reads {:?} (its tiles are the first texture's: {reused})",
+            &unwritten[level as usize][0][..4]
+        );
+        let upload = rig.filled(&layout, |_| 0x3c);
+        let read = rig.round_trip(&second, &layout, Some(&upload));
+        assert!(all(&read[level as usize], 0x3c), "the reused level reads {:?}", read[level as usize]);
+        assert!(all(&read[0], 0), "level 0 has no tiles and reads {:?}", read[0]);
+    }
+
+    /// (iv) A level whose tiles come from several runs of the heap (single
+    /// free tiles between taken ones) reads as written in every tile.
+    fn a_level_on_several_ranges(rig: &mut Rig) {
+        rig.step = "step 4, a level on several ranges of the heap";
+        // Three single tiles; the first and the last go back, the middle
+        // one stays taken.
+        let singles: Vec<_> = (0..3).map(|_| take(&rig.device, 1).expect("a tile")).collect();
+        give_back(singles[0].1, &singles[0].2);
+        give_back(singles[2].1, &singles[2].2);
+        let desc = Rig::desc(DXGI_FORMAT_BC7_UNORM, SIDE, LEVELS, true);
+        let layout = rig.footprints(&desc);
+        let (texture, tiled) = rig.reserved(&desc);
+        // Level 1 of a 1024 texture: four tiles.
+        assert!(tiled.standard.len() > 1 && tiled.standard[1] >= 2);
+        rig.give(&tiled, &texture, 1 << 1);
+        let runs = tiled.given.lock().unwrap().runs.len();
+        eprintln!("level 1 ({} tiles) was mapped on {runs} ranges", tiled.standard[1]);
+        assert!(runs >= 2, "the single free tiles were not used first");
+        let upload = rig.filled(&layout, |_| 0x77);
+        let read = rig.round_trip(&texture, &layout, Some(&upload));
+        assert!(all(&read[1], 0x77), "level 1 reads {:?}", read[1]);
+        give_back(singles[1].1, &singles[1].2);
+    }
+
+    /// (v) A view made by [`show_from`] of a texture whose level 0 has no
+    /// tiles returns level 1's colour for a sample at level 0; the view as
+    /// the title asked returns zero.
+    fn the_view_starts_at_the_first_level_with_tiles(rig: &mut Rig) -> Option<()> {
+        rig.step = "step 5, the view from the first level with tiles";
+        let cs = compile(LOOK, s!("look"), s!("cs_5_1")).ok()?;
+        let format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        let desc = Rig::desc(format, SIDE, LEVELS, true);
+        let layout = rig.footprints(&desc);
+        let (texture, tiled) = rig.reserved(&desc);
+        // Every level but the largest; each level's bytes are sixteen
+        // times its number plus one.
+        rig.give(&tiled, &texture, from_level(1));
+        assert_eq!(tiled.first_shown(), Some(1));
+        let upload = rig.filled(&layout, |level| (level as u8 + 1) * 16);
+        rig.round_trip(&texture, &layout, Some(&upload));
+        // SAFETY: plain object creation; the views are made in a heap
+        // that lives to the end of the function, of a live texture.
+        let (root, pipeline, views, words, back) = unsafe {
+            let root: ID3D12RootSignature = rig.device.CreateRootSignature(0, &cs[..]).ok()?;
+            let pipeline: ID3D12PipelineState = rig
+                .device
+                .CreateComputePipelineState(&D3D12_COMPUTE_PIPELINE_STATE_DESC {
+                    pRootSignature: std::mem::transmute_copy(&root),
+                    CS: D3D12_SHADER_BYTECODE {
+                        pShaderBytecode: cs.as_ptr().cast(),
+                        BytecodeLength: cs.len(),
+                    },
+                    ..Default::default()
+                })
+                .ok()?;
+            let views: ID3D12DescriptorHeap = rig
+                .device
+                .CreateDescriptorHeap(&D3D12_DESCRIPTOR_HEAP_DESC {
+                    Type: D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV,
+                    NumDescriptors: 2,
+                    Flags: D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE,
+                    NodeMask: 0,
+                })
+                .ok()?;
+            let as_asked = D3D12_SHADER_RESOURCE_VIEW_DESC {
+                Format: format,
+                ViewDimension: D3D12_SRV_DIMENSION_TEXTURE2D,
+                Shader4ComponentMapping: 5768,
+                Anonymous: D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                    Texture2D: D3D12_TEX2D_SRV {
+                        MostDetailedMip: 0,
+                        MipLevels: u32::MAX,
+                        PlaneSlice: 0,
+                        ResourceMinLODClamp: 0.0,
+                    },
+                },
+            };
+            let mut shown = as_asked;
+            show_from(&mut shown, tiled.first_shown()?, u32::from(LEVELS));
+            assert_eq!(shown.Anonymous.Texture2D.MostDetailedMip, 1);
+            let step = rig.device.GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV) as usize;
+            let mut at = views.GetCPUDescriptorHandleForHeapStart();
+            rig.device.CreateShaderResourceView(&texture, Some(&raw const shown), at);
+            at.ptr += step;
+            rig.device.CreateShaderResourceView(&texture, Some(&raw const as_asked), at);
+            let words = rig.buffer(
+                D3D12_HEAP_TYPE_DEFAULT,
+                D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+                D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                256,
+            );
+            let back = rig.buffer(D3D12_HEAP_TYPE_READBACK, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST, 256);
+            (root, pipeline, views, words, back)
+        };
+        // Before the one dispatch: the pipeline and both views are sound.
+        rig.check("the pipeline and the views made");
+        rig.run(|list| {
+            // SAFETY: an open list and live objects.
+            unsafe {
+                list.ResourceBarrier(&[transition(&texture, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE)]);
+                list.SetDescriptorHeaps(&[Some(views.clone())]);
+                list.SetComputeRootSignature(&root);
+                list.SetPipelineState(&pipeline);
+                list.SetComputeRootDescriptorTable(0, views.GetGPUDescriptorHandleForHeapStart());
+                list.SetComputeRootUnorderedAccessView(1, words.GetGPUVirtualAddress());
+                list.Dispatch(1, 1, 1);
+                list.ResourceBarrier(&[transition(&words, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE)]);
+                list.CopyBufferRegion(&back, 0, &words, 0, 16);
+            }
+        });
+        // SAFETY: a read-back buffer the finished list copied sixteen bytes into.
+        let read = unsafe {
+            let mut data = std::ptr::null_mut();
+            let range = D3D12_RANGE { Begin: 0, End: 16 };
+            back.Map(0, Some(&range), Some(&mut data)).unwrap();
+            let read = std::slice::from_raw_parts(data.cast::<u32>(), 2).to_vec();
+            back.Unmap(0, None);
+            read
+        };
+        eprintln!("a sample at level 0: {} through the view from level 1, {} through the view as asked", read[0], read[1]);
+        assert_eq!(read[0], 32, "the view from the first level with tiles reads level 1");
+        assert_eq!(read[1], 0, "the view from level 0 reads a level without tiles");
+        Some(())
+    }
+
+    fn a_full_card_keeps_new_levels_waiting(rig: &mut Rig) {
+        rig.step = "step 6, no room on the card: held levels wait, and get their tiles when asked again";
+        let desc = Rig::desc(DXGI_FORMAT_BC7_UNORM, SIDE, LEVELS, true);
+        let (texture, tiled) = rig.reserved(&desc);
+        let layout = rig.footprints(&desc);
+        let upload = rig.filled(&layout, |level| level as u8 + 1);
+        let read_as_given = |rig: &mut Rig, what: &str| {
+            let read = rig.round_trip(&texture, &layout, Some(&upload));
+            for (level, bytes) in read.iter().enumerate() {
+                let want = if tiled.has_tiles(level as u32) { level as u8 + 1 } else { 0 };
+                assert!(all(bytes, want), "{what}: level {level} reads {bytes:?}, wanted {want}");
+            }
+        };
+        // No room: nothing is given, the held levels are said to wait,
+        // nothing is shown, every level reads zeros.
+        let (changed, waiting) = tiled.uploaded_on(&rig.queue, &rig.device, &texture, from_level(3), false);
+        rig.check("an upload without room");
+        assert!(!changed && waiting, "without room: changed {changed}, waiting {waiting}");
+        assert_eq!(tiled.given_bytes(), 0, "without room no tile is given");
+        assert_eq!(tiled.first_shown(), None);
+        read_as_given(rig, "without room");
+        // Asked again with room: the same levels get theirs.
+        let (changed, waiting) = tiled.uploaded_on(&rig.queue, &rig.device, &texture, from_level(3), true);
+        rig.check("the upload again, with room");
+        assert!(changed && !waiting, "with room: changed {changed}, waiting {waiting}");
+        assert!(tiled.has_tiles(3) && !tiled.has_tiles(2));
+        assert_eq!(tiled.first_shown(), Some(3));
+        read_as_given(rig, "with room");
+        // More levels held and no room again: the ones that have tiles
+        // are brought up to date, the new ones wait, the view stays.
+        let before = tiled.given_bytes();
+        let (changed, waiting) = tiled.uploaded_on(&rig.queue, &rig.device, &texture, from_level(1), false);
+        rig.check("more levels held, without room");
+        assert!(!changed && waiting, "more levels without room: changed {changed}, waiting {waiting}");
+        assert_eq!(tiled.given_bytes(), before);
+        assert_eq!(tiled.first_shown(), Some(3));
+        read_as_given(rig, "more levels without room");
+        // The card's own write is not kept waiting, and brings only its
+        // own level: level 1 still waits although it is held.
+        assert_eq!(tiled.claim(1 << 0), 1 << 0);
+        let changed = tiled.card_wrote_on(&rig.queue, &rig.device, &texture, 1 << 0);
+        rig.check("the card's own write, without room");
+        assert!(changed && tiled.has_tiles(0) && !tiled.has_tiles(1) && !tiled.has_tiles(2));
+        assert_eq!(tiled.first_shown(), Some(0));
+        assert_eq!(tiled.claim(1 << 0), 0, "a level with tiles is not claimed again");
+        // With room everything held gets its tiles.
+        let (_, waiting) = tiled.uploaded_on(&rig.queue, &rig.device, &texture, from_level(1), true);
+        rig.check("the last upload, with room");
+        assert!(!waiting && tiled.whole());
+        read_as_given(rig, "everything given");
+    }
+
+    fn a_claim_given_up_is_made_again(rig: &mut Rig) {
+        rig.step = "step 7, a claim whose zeros never landed is given up";
+        let desc = Rig::desc(DXGI_FORMAT_BC7_UNORM, SIDE, LEVELS, true);
+        let (_texture, tiled) = rig.reserved(&desc);
+        let level = tiled.with_level(2);
+        assert_eq!(tiled.claim(level), level, "the level is new");
+        assert_eq!(tiled.claim(level), 0, "claimed once");
+        // The list that claimed it was reset without being submitted.
+        tiled.unclaim(level);
+        assert_eq!(tiled.claim(level), level, "claimed again after it was given up");
+        // The small levels the card packs together are claimed together.
+        let small = tiled.with_level(u32::from(LEVELS) - 1);
+        assert!(!rig.card || small.count_ones() > 1, "on the card a 1024 texture has several levels in one tile");
+        assert_eq!(tiled.claim(1 << (u32::from(LEVELS) - 1)), 1 << (u32::from(LEVELS) - 1));
+        tiled.unclaim(small);
+        assert_eq!(tiled.claim(small), small);
+    }
+
+    /// A host copy let go while a list still keeps its texture (as
+    /// `HostList::keep` does): the tiles stay given until nothing but the
+    /// let-go list names the texture (issue #776).
+    fn a_texture_kept_by_a_list_keeps_its_tiles(rig: &mut Rig) {
+        rig.step = "step 8, a texture let go while a list keeps it";
+        let desc = Rig::desc(DXGI_FORMAT_BC7_UNORM, SIDE, LEVELS, true);
+        let (texture, tiled) = rig.reserved(&desc);
+        rig.give(&tiled, &texture, tiled.with_level(0));
+        // (the mapping is on the queue: run it before the texture can go)
+        rig.run(|_| {});
+        assert!(tiled.given_bytes() > 0, "level 0 has tiles");
+        let waiting = super::let_go_waiting();
+        // A list recorded or in the air keeps the texture.
+        let kept_by_a_list = texture.clone();
+        super::let_go(texture, tiled);
+        assert_eq!(super::let_go_waiting(), waiting + 1, "the tiles wait while the list keeps the texture");
+        super::give_back_let_go();
+        assert_eq!(super::let_go_waiting(), waiting + 1, "still kept: still waiting");
+        // The list is reset: it lets go of the texture.
+        drop(kept_by_a_list);
+        super::give_back_let_go();
+        assert_eq!(super::let_go_waiting(), waiting, "nothing names the texture: its tiles go back");
+        // And a texture nothing else names gives them back at once.
+        let (texture, tiled) = rig.reserved(&desc);
+        rig.give(&tiled, &texture, tiled.with_level(0));
+        rig.run(|_| {});
+        super::let_go(texture, tiled);
+        assert_eq!(super::let_go_waiting(), waiting, "given back at once");
+    }
+
+    /// On the software adapter unless `VICTORY_TILES_TEST_CARD=1`.
+    #[test]
+    #[ignore = "on the card: run it by name with --ignored --nocapture"]
+    fn levels_on_demand_on_the_card() {
+        let Some(mut rig) = Rig::new() else {
+            eprintln!("no adapter with tiled resources of tier 2, or no debug layer for a run on the card; skipped");
+            return;
+        };
+        rig.check("the device made");
+        levels_arrive(&mut rig, DXGI_FORMAT_BC7_UNORM);
+        levels_arrive(&mut rig, DXGI_FORMAT_BC3_UNORM);
+        a_card_copy_lands_after_the_give(&mut rig);
+        a_reused_tile_reads_as_written(&mut rig);
+        a_level_on_several_ranges(&mut rig);
+        a_full_card_keeps_new_levels_waiting(&mut rig);
+        a_claim_given_up_is_made_again(&mut rig);
+        a_texture_kept_by_a_list_keeps_its_tiles(&mut rig);
+        if the_view_starts_at_the_first_level_with_tiles(&mut rig).is_none() {
+            eprintln!("the view test's shader or objects could not be made; that part was skipped");
+        }
+        rig.step = "the end";
+        rig.check("every step done");
+        eprintln!(
+            "all steps passed {}",
+            if rig.card { "ON THE CARD" } else { "on the software adapter; VICTORY_TILES_TEST_CARD=1 is the run on the card" }
+        );
+        let s: Vec<u64> = STATS.iter().map(|s| s.load(Ordering::Relaxed)).collect();
+        eprintln!(
+            "{} calls of UpdateTileMappings took {} microseconds in all ({} a call); the pool's heaps {} MB, {} given back",
+            s[6],
+            s[7],
+            s[7] / s[6].max(1),
+            s[3] >> 20,
+            s[8]
+        );
+    }
+
+    #[test]
+    fn floor_saturates_instead_of_wrapping() {
+        assert_eq!(parse_floor(None), 1 << 20);
+        assert_eq!(parse_floor(Some("0")), 64 << 10);
+        assert_eq!(parse_floor(Some("2048")), 2048 << 10);
+        assert_eq!(parse_floor(Some(&(1u64 << 54).to_string())), u64::MAX);
+        assert_eq!(parse_floor(Some(&u64::MAX.to_string())), u64::MAX);
+    }
+
+    #[test]
+    fn show_from_clamps_2d_and_2d_array_and_adjusts_min_lod() {
+        let mut srv2d = D3D12_SHADER_RESOURCE_VIEW_DESC {
+            Format: DXGI_FORMAT_R8G8B8A8_UNORM,
+            ViewDimension: D3D12_SRV_DIMENSION_TEXTURE2D,
+            Shader4ComponentMapping: 5768,
+            Anonymous: D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                Texture2D: D3D12_TEX2D_SRV {
+                    MostDetailedMip: 0,
+                    MipLevels: 12,
+                    PlaneSlice: 0,
+                    ResourceMinLODClamp: 3.5,
+                },
+            },
+        };
+        show_from(&mut srv2d, 3, 11);
+        // SAFETY: `ViewDimension` is `TEXTURE2D`.
+        let v2d = unsafe { srv2d.Anonymous.Texture2D };
+        assert_eq!(v2d.MostDetailedMip, 3);
+        // Clamped to remaining levels (11 - 3 = 8), not 12 - 3 = 9.
+        assert_eq!(v2d.MipLevels, 8);
+        assert_eq!(v2d.ResourceMinLODClamp, 0.5);
+
+        let mut srv_arr = D3D12_SHADER_RESOURCE_VIEW_DESC {
+            Format: DXGI_FORMAT_R8G8B8A8_UNORM,
+            ViewDimension: D3D12_SRV_DIMENSION_TEXTURE2DARRAY,
+            Shader4ComponentMapping: 5768,
+            Anonymous: D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                Texture2DArray: D3D12_TEX2D_ARRAY_SRV {
+                    MostDetailedMip: 0,
+                    MipLevels: 6,
+                    FirstArraySlice: 0,
+                    ArraySize: 1,
+                    PlaneSlice: 0,
+                    ResourceMinLODClamp: 1.5,
+                },
+            },
+        };
+        show_from(&mut srv_arr, 2, 11);
+        // SAFETY: `ViewDimension` is `TEXTURE2DARRAY`.
+        let varr = unsafe { srv_arr.Anonymous.Texture2DArray };
+        assert_eq!(varr.MostDetailedMip, 2);
+        assert_eq!(varr.MipLevels, 4);
+        assert_eq!(varr.ResourceMinLODClamp, 0.0);
+    }
+
+    #[test]
+    fn card_wrote_failure_does_not_poison_card_mask() {
+        let Some(host) = host() else {
+            return;
+        };
+        // A dummy live resource (never mapped because `take()` rejects `HEAP_TILES + 1`).
+        let heap = D3D12_HEAP_PROPERTIES {
+            Type: D3D12_HEAP_TYPE_DEFAULT,
+            ..Default::default()
+        };
+        let desc = Rig::desc(DXGI_FORMAT_R8G8B8A8_UNORM, 64, 2, false);
+        let mut tex: Option<ID3D12Resource> = None;
+        // SAFETY: plain texture creation on the host device.
+        unsafe {
+            host.device
+                .CreateCommittedResource(
+                    &heap,
+                    D3D12_HEAP_FLAG_NONE,
+                    &desc,
+                    D3D12_RESOURCE_STATE_COMMON,
+                    None,
+                    &mut tex,
+                )
+                .unwrap();
+        }
+        let tex = tex.unwrap();
+        STATS[0].fetch_add(1, Ordering::Relaxed);
+        STATS[1].fetch_add(TILE, Ordering::Relaxed);
+        let mut tiled = Tiled {
+            // Level 0 demands > HEAP_TILES so `take()` fails deterministically.
+            standard: vec![HEAP_TILES + 1, 1],
+            packed: 0,
+            levels: 2,
+            full: TILE,
+            given: Mutex::new(Given {
+                levels: vec![false, false],
+                packed: false,
+                runs: Vec::new(),
+            }),
+            shown: AtomicU32::new(u32::MAX),
+            held: AtomicU32::new(0),
+            card: AtomicU32::new(0),
+            claimed: AtomicU32::new(0),
+        };
+        assert_eq!(tiled.claim(1 << 0), 1 << 0);
+        let changed = tiled.card_wrote_on(host.queue(), &host.device, &tex, 1 << 0);
+        assert!(!changed);
+        assert_eq!(tiled.card.load(Ordering::Relaxed), 0, "failed tile allocation must not poison `card`");
+        assert_eq!(tiled.first_shown(), None);
+        assert_eq!(tiled.claim(1 << 0), 1 << 0, "failed level must be unclaimed");
+        // Even if level 0 later becomes allocatable, an upload with `room == false`
+        // that does not hold level 0 must not treat level 0 as card-owned.
+        tiled.standard[0] = 1;
+        let (changed, waiting) = tiled.uploaded_on(host.queue(), &host.device, &tex, 1 << 1, false);
+        assert!(!changed && waiting);
+        assert!(!tiled.has_tiles(0));
+        assert_eq!(tiled.given_bytes(), 0);
+    }
+}
diff --git a/crates/victory-gpu/src/translate.rs b/crates/victory-gpu/src/translate.rs
new file mode 100644
index 0000000..2078b89
--- /dev/null
+++ b/crates/victory-gpu/src/translate.rs
@@ -0,0 +1,1121 @@
+//! `VICTORY_MEM2_GPU_ONLY_NOVIEW=1` (off by default): page mappings into the
+//! title's GPU-only reservations are not host views (MEMORY.md §3.3 4).
+//!
+//! The title's texture streamer maps each streamed page twice: once into
+//! its CPU pool view (`XMemMapPhysicalPagesScatter`), once at the tiled
+//! resource's address (`CopyPageMappingsBatchX`), which lies in a
+//! reservation the console's CPU cannot touch (protection 0x801). The
+//! runtime made a host view for both, 3-4 system calls and a TLB shootdown
+//! a page. With the switch, `victory-hle` xmem records the second as a
+//! translation instead: destination page → the page's bytes in a view of
+//! the whole section that never moves ([`title_memory_translated`]).
+//!
+//! Every read of title memory the runtime makes through the kernel or the
+//! mapping record translates (`crate::host::read`, `crate::regions::copy`,
+//! the texture refresh); a write of the runtime's own goes through the
+//! table too (`crate::host::write_mapped`). Anything else that touches such
+//! a page, the title's code included (which the console would not allow),
+//! faults: the handler here then maps the page as a view after all, as
+//! without the switch ([`materialize`]), tells the mapping record, and lets
+//! the access run again. A kernel call about to write title memory
+//! (`crate::watch::writing`) has its pages made views first the same way.
+//!
+//! `VICTORY_REMAP_LAZY=1` (off by default, [`lazy`]) uses the same table for
+//! every page the title's streamer maps (`XMemMapPhysicalPagesScatter`,
+//! `CopyPageMappingsBatchX`, single-page maps), CPU-reachable or not: a
+//! remap is a table update, and a page gets a host view only when the CPU
+//! touches it (the fault above). With it:
+//! - views taken away (a page made a view, then remapped or unmapped) are
+//!   unmapped at the end of the title's call ([`flush_unmaps`]), each
+//!   address once, not in the middle of it; a page about to be made a view
+//!   again first loses its old one;
+//! - an address unmapped this way stays a lone 64 KiB placeholder and is
+//!   remembered ([`LONE`]), so making it a view again needs no split: each
+//!   address is split out of the title's reservation once per session;
+//! - the sections are committed whole (`SEC_COMMIT`), so a view is no
+//!   commit either.
+
+use std::sync::RwLock;
+use std::sync::atomic::{AtomicU8, AtomicU64, AtomicUsize, Ordering::Relaxed};
+
+use victory_core::mem2::{PAGE, PageTable};
+
+/// A destination page shown through the table.
+struct Entry {
+    /// The page's first byte in the section's own view (unmoving while the
+    /// entry lives: the runtime keeps the section until it removes it).
+    src: usize,
+    /// The section and the page's offset in it, to map it as a view.
+    section: usize,
+    offset: u64,
+    /// The section is committed whole: a view of it needs no commit.
+    committed: bool,
+    /// 0: no view; 1: being mapped; 2: mapped as a view ([`materialize`]).
+    state: AtomicU8,
+}
+
+static TABLE: RwLock<PageTable<Entry>> = RwLock::new(PageTable::new());
+/// Entries in [`TABLE`], read without its lock to pass by at once.
+static PAGES: AtomicUsize = AtomicUsize::new(0);
+
+/// Since the start: destination pages recorded instead of mapped, of those
+/// made views later after all, and bytes read and written through the table.
+pub(crate) static COUNTS: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+
+thread_local! {
+    /// This thread holds [`TABLE`]'s lock (its fault handler must not take
+    /// it again).
+    static HOLDING: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// `VICTORY_REMAP_LAZY=1` (off by default, read once): every page mapping of
+/// the title's streamer goes through the table (module docs).
+pub fn lazy() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = victory_core::mem2::switch("VICTORY_REMAP_LAZY");
+        if on {
+            tracing::warn!("VICTORY_REMAP_LAZY: page mappings are table updates, views made when the CPU touches a page");
+        }
+        on
+    })
+}
+
+/// Since the last frame line ([`lazy`]): 0 pages put in the table, 1 taken
+/// out, 2 views made lazily (any cause), 3 of them made by a fault of the
+/// CPU, 4 views unmapped at the end of a call, 5 placeholder splits left
+/// out, 6 faults passed on (a page a view already: a guard's).
+pub(crate) static LAZY: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+
+/// Views taken out of the table and not unmapped yet ([`lazy`]): unmapped at
+/// the end of the title's call ([`flush_unmaps`]), or just before the page
+/// is made a view again.
+static PENDING: std::sync::Mutex<Vec<usize>> = std::sync::Mutex::new(Vec::new());
+static PENDING_N: AtomicUsize = AtomicUsize::new(0);
+
+/// Addresses known to be lone 64 KiB placeholders (a view of one page was
+/// unmapped there): making a view there needs no split ([`lazy`]).
+static LONE: std::sync::Mutex<std::collections::BTreeSet<usize>> =
+    std::sync::Mutex::new(std::collections::BTreeSet::new());
+
+#[cfg(test)]
+pub(crate) static LAZY_TEST: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+fn deferring() -> bool {
+    #[cfg(test)]
+    if LAZY_TEST.load(Relaxed) {
+        return true;
+    }
+    lazy()
+}
+
+/// Unmaps the view at `page` (made by [`materialize_one`]), back to a
+/// placeholder of its own.
+fn unmap_view(page: usize) {
+    use windows_sys::Win32::System::Memory::{MEM_PRESERVE_PLACEHOLDER, MEMORY_MAPPED_VIEW_ADDRESS, UnmapViewOfFile2};
+    use windows_sys::Win32::System::Threading::GetCurrentProcess;
+    // SAFETY: a view [`materialize_one`] mapped there and no entry stands
+    // for any more.
+    let ok = unsafe {
+        UnmapViewOfFile2(GetCurrentProcess(), MEMORY_MAPPED_VIEW_ADDRESS { Value: page as *mut _ }, MEM_PRESERVE_PLACEHOLDER)
+    } != 0;
+    if ok {
+        LONE.lock().unwrap_or_else(|e| e.into_inner()).insert(page);
+    }
+}
+
+/// A view no entry stands for any more: unmapped now, or at the end of the
+/// call ([`lazy`]). `section` and `offset` are what it shows (kept for
+/// [`park`]).
+fn retire_view(page: usize, section: usize, offset: u64) {
+    if deferring() {
+        let mut p = PENDING.lock().unwrap_or_else(|e| e.into_inner());
+        p.push(page);
+        PENDING_N.store(p.len(), Relaxed);
+        if parking() {
+            SHOWS.lock().unwrap_or_else(|e| e.into_inner()).insert(page, (section, offset));
+        }
+    } else {
+        unmap_view(page);
+    }
+}
+
+/// `VICTORY_REMAP_PARK=1` (off by default; with `VICTORY_REMAP_LAZY`): a
+/// view taken away is not unmapped at the end of the call but parked, out
+/// of the table and the mapping record, still mapped; when the same
+/// physical page (section and offset) is made a view at the same address
+/// again it is that view, with no system call. The title's render-target
+/// pool is trimmed every frame and mostly given its pages back at the same
+/// addresses. A parked view of another page there is unmapped first.
+/// Counted on the frame line ("parked views reused / unmapped").
+pub fn parking() -> bool {
+    #[cfg(test)]
+    if PARK_TEST.load(Relaxed) {
+        return true;
+    }
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = victory_core::mem2::switch("VICTORY_REMAP_PARK");
+        if on {
+            tracing::warn!("VICTORY_REMAP_PARK: views taken away stay mapped, reused for the same page at the same address");
+        }
+        on
+    })
+}
+
+#[cfg(test)]
+pub(crate) static PARK_TEST: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Since the last frame line: 0 parked views reused, 1 parked views
+/// unmapped (another page wanted there), 2 views parked.
+pub(crate) static PARK: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+
+/// What each retired view shows, by address ([`parking`]).
+static SHOWS: std::sync::Mutex<std::collections::BTreeMap<usize, (usize, u64)>> =
+    std::sync::Mutex::new(std::collections::BTreeMap::new());
+/// Views parked: address to what they show ([`parking`]).
+static PARKED: std::sync::Mutex<std::collections::BTreeMap<usize, (usize, u64)>> =
+    std::sync::Mutex::new(std::collections::BTreeMap::new());
+
+/// Parks the retired view at `page` instead of unmapping it; false if
+/// parking is off. Under [`PENDING`]'s lock.
+fn park(page: usize) -> bool {
+    if !parking() {
+        return false;
+    }
+    let Some(shows) = SHOWS.lock().unwrap_or_else(|e| e.into_inner()).remove(&page) else {
+        return false;
+    };
+    // No access while parked: the title's CPU touching the address meets
+    // the fault (and the table's entry, if any) instead of the old page.
+    if !protect(page, windows_sys::Win32::System::Memory::PAGE_NOACCESS) {
+        return false;
+    }
+    PARKED.lock().unwrap_or_else(|e| e.into_inner()).insert(page, shows);
+    PARK[2].fetch_add(1, Relaxed);
+    true
+}
+
+/// Sets the protection of the 64 KiB view at `page`.
+fn protect(page: usize, to: u32) -> bool {
+    let mut old = 0;
+    // SAFETY: a whole view of ours.
+    unsafe { windows_sys::Win32::System::Memory::VirtualProtect(page as *const _, PAGE, to, &mut old) != 0 }
+}
+
+/// Takes the parked view at `page`, if any: what it shows.
+fn unpark(page: usize) -> Option<(usize, u64)> {
+    if !parking() {
+        return None;
+    }
+    PARKED.lock().unwrap_or_else(|e| e.into_inner()).remove(&page)
+}
+
+/// A retired view at `page` still on the list that shows `e`'s page: kept
+/// as `e`'s view (true). Under [`PENDING`]'s lock, the page taken off it.
+fn reuse(page: usize, e: &Entry) -> bool {
+    if !parking() {
+        return false;
+    }
+    let shows = SHOWS.lock().unwrap_or_else(|e| e.into_inner()).remove(&page);
+    if shows == Some((e.section, e.offset)) {
+        PARK[0].fetch_add(1, Relaxed);
+        return true;
+    }
+    false
+}
+
+/// Parked views (for the frame line).
+pub(crate) fn parked() -> usize {
+    PARKED.lock().unwrap_or_else(|e| e.into_inner()).len()
+}
+
+/// Unmaps the views retired during the title's call, each address once.
+/// The caller holds the bytes against reads in place (its remapping covers
+/// every retired page: they were in the ranges it changed). Returns the
+/// views unmapped.
+///
+/// A page leaves the list only once its view is unmapped, under the list's
+/// lock, a few at a time: a thread about to map a view at a page of the
+/// list ([`materialize_one`]) finds it there, or finds it unmapped. (The
+/// list used to be emptied before the unmaps, and a view mapped meanwhile
+/// at a page still showing its old one failed with error 487.) Callers
+/// need not hold the bytes: a retired page is out of the table and of the
+/// mapping record already, so nothing reads or writes it in place.
+pub fn flush_unmaps() -> usize {
+    const CHUNK: usize = 64;
+    if PENDING_N.load(Relaxed) == 0 {
+        return 0;
+    }
+    {
+        let mut p = PENDING.lock().unwrap_or_else(|e| e.into_inner());
+        // Highest first, so the chunks below come off the end in order.
+        p.sort_unstable_by(|a, b| b.cmp(a));
+        p.dedup();
+        PENDING_N.store(p.len(), Relaxed);
+    }
+    race_pause(usize::MAX);
+    let mut n = 0;
+    loop {
+        let mut p = PENDING.lock().unwrap_or_else(|e| e.into_inner());
+        if p.is_empty() {
+            break;
+        }
+        let keep = p.len().saturating_sub(CHUNK);
+        for page in p.split_off(keep) {
+            if !park(page) {
+                unmap_view(page);
+            }
+            n += 1;
+        }
+        PENDING_N.store(p.len(), Relaxed);
+    }
+    LAZY[4].fetch_add(n as u64, Relaxed);
+    n
+}
+
+/// Calls of page mappings under way ([`lazy_call`]).
+static CALLS: AtomicUsize = AtomicUsize::new(0);
+/// Bounds of every address ever put in the table: only a fault there waits
+/// for a call (any other is no business of ours).
+static LO: AtomicUsize = AtomicUsize::new(usize::MAX);
+static HI: AtomicUsize = AtomicUsize::new(0);
+
+/// Held by `victory-hle` xmem over a call of page mappings
+/// (`VICTORY_REMAP_LAZY`): a CPU fault on a page with no entry meanwhile
+/// waits for the call's end instead of being taken for a bad access.
+pub struct LazyCall(());
+
+impl Drop for LazyCall {
+    fn drop(&mut self) {
+        CALLS.fetch_sub(1, Relaxed);
+    }
+}
+
+pub fn lazy_call() -> LazyCall {
+    CALLS.fetch_add(1, Relaxed);
+    LazyCall(())
+}
+
+/// Pages retired and not unmapped yet (for tests and the frame line).
+pub(crate) fn pending() -> usize {
+    PENDING_N.load(Relaxed)
+}
+
+/// Whether the switch is on (read once).
+pub fn enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = victory_core::mem2::switch("VICTORY_MEM2_GPU_ONLY_NOVIEW");
+        if on {
+            tracing::warn!("VICTORY_MEM2_GPU_ONLY_NOVIEW: page mappings into GPU-only reservations are translated, not mapped");
+        }
+        on
+    })
+}
+
+/// Whether any page of `[at, at + len)` is shown through the table.
+#[inline]
+pub(crate) fn any(at: usize, len: usize) -> bool {
+    PAGES.load(Relaxed) != 0 && len != 0 && table().any_in(at, len)
+}
+
+/// Bytes of `[at, at + len)` shown through the table.
+pub(crate) fn bytes_in(at: usize, len: usize) -> usize {
+    if PAGES.load(Relaxed) == 0 || len == 0 {
+        return 0;
+    }
+    table().pieces(at, len).iter().filter(|p| p.page.is_some()).map(|p| p.len).sum()
+}
+
+/// `[at, at + len)` (64 KiB pages) as one run of one section through the
+/// table, every page in it: the section, the offset of `at` in it, and
+/// whether the section was made committed (`crate::zerocopy`).
+pub(crate) fn run_of(at: usize, len: usize) -> Option<(usize, u64, bool)> {
+    if PAGES.load(Relaxed) == 0 || len == 0 {
+        return None;
+    }
+    let t = table();
+    let first = at / PAGE * PAGE;
+    let mut pages = Vec::new();
+    let mut committed = true;
+    let mut page = first;
+    while page < at + len {
+        let (_, e) = t.get(page)?;
+        pages.push((e.section, e.offset / PAGE as u64 * PAGE as u64));
+        committed &= e.committed;
+        page += PAGE;
+    }
+    drop(t);
+    let (section, offset) = crate::zerocopy::one_run(&pages, PAGE as u64)?;
+    Some((section, offset + (at - first) as u64, committed))
+}
+
+/// Pages shown through the table now.
+pub(crate) fn live() -> usize {
+    PAGES.load(Relaxed)
+}
+
+struct Held(std::sync::RwLockReadGuard<'static, PageTable<Entry>>);
+
+impl std::ops::Deref for Held {
+    type Target = PageTable<Entry>;
+    fn deref(&self) -> &PageTable<Entry> {
+        &self.0
+    }
+}
+
+impl Drop for Held {
+    fn drop(&mut self) {
+        HOLDING.with(|h| h.set(false));
+    }
+}
+
+fn table() -> Held {
+    let g = TABLE.read().unwrap_or_else(|e| e.into_inner());
+    HOLDING.with(|h| h.set(true));
+    Held(g)
+}
+
+/// The runtime shows the page at `src` (in a view of section `section`, at
+/// `offset` in it) at destination page `at`, without a view there. Called
+/// under the runtime's page lock, after what `at` showed was taken away.
+pub fn title_memory_translated(at: usize, src: usize, section: usize, offset: u64, committed: bool) {
+    install();
+    LO.fetch_min(at / PAGE * PAGE, Relaxed);
+    HI.fetch_max(at / PAGE * PAGE + PAGE, Relaxed);
+    let entry = Entry { src, section, offset, committed, state: AtomicU8::new(0) };
+    let mut t = TABLE.write().unwrap_or_else(|e| e.into_inner());
+    let old = t.insert(at, entry);
+    race_pause(at);
+    match old {
+        None => {
+            PAGES.fetch_add(1, Relaxed);
+        }
+        // The page was a view of what the entry showed before: it must not
+        // go on showing it. Retired before the lock goes: a thread that
+        // makes the new entry a view (under the read lock) then finds the
+        // old view on the list and unmaps it first, instead of mapping over
+        // it (error 487) and leaving it mapped, untracked.
+        Some(e) if settled(&e) == 2 => retire_view(at / PAGE * PAGE, e.section, e.offset),
+        Some(_) => {}
+    }
+    drop(t);
+    COUNTS[0].fetch_add(1, Relaxed);
+    LAZY[0].fetch_add(1, Relaxed);
+}
+
+/// Tests widen the race windows: a pause at `at` (an address given to
+/// [`title_memory_translated`], or `usize::MAX` in [`flush_unmaps`]).
+#[cfg(test)]
+pub(crate) static PAUSE_AT: AtomicUsize = AtomicUsize::new(0);
+
+#[inline]
+fn race_pause(_at: usize) {
+    #[cfg(test)]
+    if PAUSE_AT.load(Relaxed) == _at {
+        std::thread::sleep(std::time::Duration::from_millis(20));
+    }
+}
+
+/// An entry's state once no thread is mapping it: 0 or 2. Under the
+/// table's write lock no thread can be (a view is mapped under the read
+/// lock), so this does not wait in practice; it guards against an entry
+/// replaced or removed while being mapped, whose view would stay mapped
+/// and untracked.
+fn settled(e: &Entry) -> u8 {
+    loop {
+        match e.state.load(Relaxed) {
+            1 => std::hint::spin_loop(),
+            s => return s,
+        }
+    }
+}
+
+/// The runtime takes away what the table shows in `[at, at + len)`: the
+/// entries go, and a page made a view meanwhile is a placeholder again.
+/// Returns the pages removed. Called under the runtime's page lock and its
+/// hold on the bytes, before it lets go of the sections.
+pub fn title_memory_untranslated(at: usize, len: usize) -> usize {
+    if PAGES.load(Relaxed) == 0 {
+        return 0;
+    }
+    let mut t = TABLE.write().unwrap_or_else(|e| e.into_inner());
+    let gone = t.remove_range(at, len);
+    for (page, e) in &gone {
+        if settled(e) == 2 {
+            // The view [`materialize`] mapped there (retired under the
+            // lock, as in [`title_memory_translated`]).
+            retire_view(*page, e.section, e.offset);
+        }
+    }
+    drop(t);
+    PAGES.fetch_sub(gone.len(), Relaxed);
+    LAZY[1].fetch_add(gone.len() as u64, Relaxed);
+    gone.len()
+}
+
+/// Copies `[at, at + len)` of title memory to `dst`: the pages the table
+/// shows from their sections, the rest with `plain(at, dst, n)`. True if
+/// every piece was read (`plain`'s answers).
+pub(crate) fn read(at: usize, dst: *mut u8, len: usize, mut plain: impl FnMut(usize, *mut u8, usize) -> bool) -> bool {
+    let pieces = table().pieces(at, len);
+    let mut ok = true;
+    for p in pieces {
+        let to = dst.wrapping_add(p.at - at);
+        let done = p.page.is_some_and(|page| {
+            let t = table();
+            let Some((_, e)) = t.get(page) else {
+                return false;
+            };
+            // SAFETY: the entry's page lies in a committed view of its
+            // section that stays while the table holds the entry (held);
+            // the destination is the caller's `len` bytes.
+            unsafe { std::ptr::copy_nonoverlapping((e.src + (p.at - page)) as *const u8, to, p.len) };
+            true
+        });
+        if done {
+            COUNTS[2].fetch_add(p.len as u64, Relaxed);
+        } else {
+            ok &= plain(p.at, to, p.len);
+        }
+    }
+    ok
+}
+
+/// Copies `len` bytes from `src` into title memory `[at, at + len)`: the
+/// pages the table shows into their sections (the same physical pages, as
+/// a write through a view would), the rest with `plain(at, src, n)`.
+pub(crate) fn write(at: usize, src: *const u8, len: usize, mut plain: impl FnMut(usize, *const u8, usize)) {
+    let pieces = table().pieces(at, len);
+    for p in pieces {
+        let from = src.wrapping_add(p.at - at);
+        let done = p.page.is_some_and(|page| {
+            let t = table();
+            let Some((_, e)) = t.get(page) else {
+                return false;
+            };
+            // SAFETY: as in [`read`]; the source is the caller's.
+            unsafe { std::ptr::copy_nonoverlapping(from, (e.src + (p.at - page)) as *mut u8, p.len) };
+            true
+        });
+        if done {
+            COUNTS[3].fetch_add(p.len as u64, Relaxed);
+        } else {
+            plain(p.at, from, p.len);
+        }
+    }
+}
+
+/// Whether a write of the runtime's own into title memory `[at, at + len)`
+/// (a DirectStorage destination, a file read) goes through the table
+/// ([`write_through`]) instead of in place: some page of it is shown
+/// through the table. No page is made a view for such a write, so a lazily
+/// mapped page stays a table entry and nothing is left for a later remap to
+/// retire and unmap.
+pub fn shown(at: usize, len: usize) -> bool {
+    any(at, len)
+}
+
+/// Writes `data` at title memory `at`: the pages the table shows into their
+/// sections, the rest in place from user mode (a guarded block faults into
+/// the guard like the title's own writes). The guards are opened and the
+/// GPU side told as for a kernel write.
+pub fn write_through(at: usize, data: &[u8]) {
+    if data.is_empty() {
+        return;
+    }
+    crate::watch::writing_soft(at, data.len());
+    write(at, data.as_ptr(), data.len(), |to, from, n| {
+        // SAFETY: title memory the caller writes, `n` bytes of `data`.
+        unsafe { std::ptr::copy_nonoverlapping(from, to as *mut u8, n) }
+    });
+}
+
+/// After the mapping record forgot the views of `[at, at + len)`
+/// (`crate::title_memory_remapped`): the pages of it the table shows that
+/// are views are views still.
+pub(crate) fn remapped(at: usize, len: usize) {
+    if PAGES.load(Relaxed) == 0 || len == 0 {
+        return;
+    }
+    let views: Vec<usize> = table().iter_in(at, len).filter(|(_, e)| e.state.load(Relaxed) == 2).map(|(p, _)| p).collect();
+    for page in views {
+        crate::regions::mapped(page, PAGE);
+    }
+}
+
+/// Makes the pages of `[at, at + len)` the table shows host views, as the
+/// runtime maps them without the switch: before something reads or writes
+/// them in place or through the kernel.
+pub(crate) fn materialize(at: usize, len: usize) {
+    if PAGES.load(Relaxed) == 0 || len == 0 || HOLDING.with(|h| h.get()) {
+        return;
+    }
+    let pages: Vec<usize> = table().iter_in(at, len).map(|(p, _)| p).collect();
+    for page in pages {
+        let made = {
+            let t = table();
+            t.get(page).is_some_and(|(page, e)| materialize_one(page, e) == Made::Now)
+        };
+        if made {
+            // A view now, for the mapping record (its lock is never taken
+            // with the table's held).
+            crate::regions::mapped(page, PAGE);
+        }
+    }
+}
+
+/// What [`materialize_one`] did.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Made {
+    /// Mapped the view now (or waited for the thread that did).
+    Now,
+    /// The page was a view already.
+    Before,
+    /// It could not be mapped.
+    Failed,
+}
+
+/// Maps `e`'s page as a view at `page`, once (another thread doing it is
+/// waited for).
+fn materialize_one(page: usize, e: &Entry) -> Made {
+    use windows_sys::Win32::System::Memory::{
+        MEM_COMMIT, MEM_PRESERVE_PLACEHOLDER, MEM_RELEASE, MEM_REPLACE_PLACEHOLDER, MEMORY_MAPPED_VIEW_ADDRESS,
+        MapViewOfFile3, PAGE_READWRITE, UnmapViewOfFile2, VirtualAlloc, VirtualFree,
+    };
+    use windows_sys::Win32::System::Threading::GetCurrentProcess;
+    loop {
+        match e.state.compare_exchange(0, 1, Relaxed, Relaxed) {
+            Ok(_) => break,
+            Err(2) => return Made::Before,
+            Err(_) => {
+                // Another thread maps it: that is this thread's view too.
+                while e.state.load(Relaxed) == 1 {
+                    std::thread::yield_now();
+                }
+                if e.state.load(Relaxed) == 2 {
+                    return Made::Now;
+                }
+            }
+        }
+    }
+    // A view of what the address showed before, retired and not unmapped
+    // yet (`VICTORY_REMAP_LAZY`): it goes first.
+    if PENDING_N.load(Relaxed) != 0 {
+        let mut p = PENDING.lock().unwrap_or_else(|e| e.into_inner());
+        let before = p.len();
+        p.retain(|&q| q != page);
+        if p.len() != before {
+            PENDING_N.store(p.len(), Relaxed);
+            // The same physical page parked here (`VICTORY_REMAP_PARK`):
+            // that view is this entry's view.
+            if reuse(page, e) {
+                drop(p);
+                e.state.store(2, Relaxed);
+                COUNTS[1].fetch_add(1, Relaxed);
+                LAZY[2].fetch_add(1, Relaxed);
+                return Made::Now;
+            }
+            unmap_view(page);
+            LAZY[4].fetch_add(1, Relaxed);
+        }
+    }
+    // A view parked here at an earlier end of a call (`VICTORY_REMAP_PARK`).
+    if let Some(old) = unpark(page) {
+        if old == (e.section, e.offset) && protect(page, windows_sys::Win32::System::Memory::PAGE_READWRITE) {
+            e.state.store(2, Relaxed);
+            PARK[0].fetch_add(1, Relaxed);
+            COUNTS[1].fetch_add(1, Relaxed);
+            LAZY[2].fetch_add(1, Relaxed);
+            return Made::Now;
+        }
+        unmap_view(page);
+        PARK[1].fetch_add(1, Relaxed);
+    }
+    let map = || {
+        // SAFETY: maps the section's page in place of a placeholder.
+        unsafe {
+            MapViewOfFile3(
+                e.section as _,
+                GetCurrentProcess(),
+                page as *const _,
+                e.offset,
+                PAGE,
+                MEM_REPLACE_PLACEHOLDER,
+                PAGE_READWRITE,
+                std::ptr::null_mut(),
+                0,
+            )
+        }
+        .Value as usize
+            == page
+    };
+    // A lone placeholder already: no split. Otherwise (or if that was
+    // stale: the reservation was freed and made again) split it out first.
+    let lone = LONE.lock().unwrap_or_else(|e| e.into_inner()).remove(&page);
+    let mut mapped = lone && map();
+    if lone && mapped {
+        LAZY[5].fetch_add(1, Relaxed);
+    }
+    if !mapped {
+        // SAFETY: `page` is a page of a placeholder no view shows (the
+        // table's entry stands for it): split it out; acts on placeholders
+        // only (fails harmlessly on a lone one).
+        unsafe { VirtualFree(page as *mut _, PAGE, MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER) };
+        mapped = map();
+    }
+    // SAFETY: the view just mapped; committing it, or back to a placeholder.
+    let ok = mapped
+        && (e.committed
+            || unsafe { !VirtualAlloc(page as *const _, PAGE, MEM_COMMIT, PAGE_READWRITE).is_null() }
+            || unsafe {
+                UnmapViewOfFile2(GetCurrentProcess(), MEMORY_MAPPED_VIEW_ADDRESS { Value: page as *mut _ }, MEM_PRESERVE_PLACEHOLDER);
+                false
+            });
+    e.state.store(if ok { 2 } else { 0 }, Relaxed);
+    if ok {
+        COUNTS[1].fetch_add(1, Relaxed);
+        LAZY[2].fetch_add(1, Relaxed);
+    } else {
+        let error = std::io::Error::last_os_error();
+        let n = FAILED.fetch_add(1, Relaxed);
+        // Every failure up to 32, then every 1024th.
+        if n < 32 || n.is_multiple_of(1024) {
+            let (state, kind, size, protect) = region(page);
+            tracing::warn!(
+                page = format_args!("{page:#x}"),
+                %error,
+                failures = n + 1,
+                state = format_args!("{state:#x}"),
+                kind = format_args!("{kind:#x}"),
+                size = format_args!("{size:#x}"),
+                protect = format_args!("{protect:#x}"),
+                "VICTORY_MEM2_GPU_ONLY_NOVIEW: a translated page could not be mapped as a view"
+            );
+        }
+    }
+    if ok { Made::Now } else { Made::Failed }
+}
+
+/// Views that could not be mapped, since the start.
+pub(crate) static FAILED: AtomicU64 = AtomicU64::new(0);
+
+/// What `VirtualQuery` says of the region at `page`: state, type, size and
+/// protection (zeros if it says nothing).
+fn region(page: usize) -> (u32, u32, usize, u32) {
+    use windows_sys::Win32::System::Memory::{MEMORY_BASIC_INFORMATION, VirtualQuery};
+    // SAFETY: plain data filled in by the query.
+    let mut info: MEMORY_BASIC_INFORMATION = unsafe { std::mem::zeroed() };
+    // SAFETY: a valid out pointer of the right size.
+    if unsafe { VirtualQuery(page as *const _, &mut info, size_of_val(&info)) } == 0 {
+        return (0, 0, 0, 0);
+    }
+    (info.State, info.Type, info.RegionSize, info.Protect)
+}
+
+/// Recoveries in the fault handler, since the start: 0 a view that could not
+/// be mapped, mapped on a later try; 1 an entry said to be a view whose
+/// page was a placeholder again, made a view anew; 2 a view not committed,
+/// committed on the access.
+pub(crate) static HEALED: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+
+/// [`materialize_one`] for a CPU fault on `page`, which must not end in a
+/// crash while the page has an entry:
+/// - a view that could not be mapped is tried again (another thread's
+///   operation on the same placeholder made it fail for a moment: the
+///   remap_lazy racing test, about one run in three, a retry always
+///   mapped it);
+/// - an entry said to be a view whose page is a placeholder again (its view
+///   was taken away under it) is made a view anew;
+/// - a view of a section not committed there is committed on the access,
+///   read or write (sections are no longer committed whole under
+///   `VICTORY_REMAP_LAZY`).
+/// A view that is mapped and committed but not writable is left to the
+/// guards (`Made::Before`).
+fn fault_in(page: usize, e: &Entry) -> Made {
+    use windows_sys::Win32::System::Memory::{MEM_COMMIT, MEM_MAPPED, MEM_PRIVATE, MEM_RESERVE, PAGE_READWRITE, VirtualAlloc};
+    let mut made = materialize_one(page, e);
+    for _ in 0..10_000 {
+        match made {
+            Made::Failed => {
+                std::thread::yield_now();
+                made = materialize_one(page, e);
+                if made == Made::Now {
+                    HEALED[0].fetch_add(1, Relaxed);
+                }
+            }
+            Made::Before => {
+                let (state, kind, _, _) = region(page);
+                if state == MEM_RESERVE && kind == MEM_PRIVATE {
+                    // A placeholder: the view is gone. Mapped anew.
+                    if e.state.compare_exchange(2, 0, Relaxed, Relaxed).is_ok() {
+                        HEALED[1].fetch_add(1, Relaxed);
+                    }
+                    made = materialize_one(page, e);
+                } else if state == MEM_RESERVE && kind == MEM_MAPPED {
+                    // A view, not committed.
+                    // SAFETY: commits the view of the entry's page in place.
+                    if unsafe { !VirtualAlloc(page as *const _, PAGE, MEM_COMMIT, PAGE_READWRITE).is_null() } {
+                        HEALED[2].fetch_add(1, Relaxed);
+                    }
+                    return Made::Before;
+                } else {
+                    return Made::Before;
+                }
+            }
+            Made::Now => return Made::Now,
+        }
+    }
+    made
+}
+
+/// Whether `page` is mapped read-write now (a view another thread made
+/// after this one faulted).
+fn read_write(page: usize) -> bool {
+    use windows_sys::Win32::System::Memory::{MEM_COMMIT, MEMORY_BASIC_INFORMATION, PAGE_READWRITE, VirtualQuery};
+    // SAFETY: plain data filled in by the query.
+    let mut info: MEMORY_BASIC_INFORMATION = unsafe { std::mem::zeroed() };
+    // SAFETY: a valid out pointer of the right size.
+    let n = unsafe { VirtualQuery(page as *const _, &mut info, size_of_val(&info)) };
+    n != 0 && info.State == MEM_COMMIT && info.Protect == PAGE_READWRITE
+}
+
+/// Registers the handler that maps a translated page when something
+/// touches it in place, once, ahead of the crash reporter's.
+fn install() {
+    use windows_sys::Win32::Foundation::{EXCEPTION_ACCESS_VIOLATION, NTSTATUS};
+    use windows_sys::Win32::System::Diagnostics::Debug::{
+        AddVectoredExceptionHandler, EXCEPTION_CONTINUE_EXECUTION, EXCEPTION_CONTINUE_SEARCH, EXCEPTION_POINTERS,
+    };
+    unsafe extern "system" fn on_fault(info: *mut EXCEPTION_POINTERS) -> i32 {
+        // SAFETY: the system passes the exception being dispatched.
+        let r = unsafe { &*(*info).ExceptionRecord };
+        if r.ExceptionCode != EXCEPTION_ACCESS_VIOLATION as NTSTATUS
+            || r.NumberParameters < 2
+            || (PAGES.load(Relaxed) == 0 && CALLS.load(Relaxed) == 0)
+            || HOLDING.with(|h| h.get())
+            // SAFETY: the system passes the context with the record.
+            || crate::safe_copy::is_write_at(unsafe { (*(*info).ContextRecord).Rip })
+        {
+            return EXCEPTION_CONTINUE_SEARCH;
+        }
+        let at = r.ExceptionInformation[1];
+        let made = {
+            let t = table();
+            t.get(at).map(|(page, e)| (page, fault_in(page, e)))
+        };
+        match made {
+            Some((page, Made::Now)) => {
+                // A view now, for the mapping record: copies read it in
+                // place, the guards take its writes as they do any view's.
+                crate::regions::mapped(page, PAGE);
+                // SAFETY: the system passes the context with the record.
+                crate::native::probe::lazy_touch(at, r.ExceptionInformation[0], unsafe { (*(*info).ContextRecord).Rip });
+                LAZY[3].fetch_add(1, Relaxed);
+                EXCEPTION_CONTINUE_EXECUTION
+            }
+            // A view already: made by another thread after this one
+            // faulted (run again), or the fault is not ours (a guard's
+            // read-only block: its handler's). Saying "run again" to the
+            // latter looped for ever.
+            Some((page, Made::Before)) if read_write(page) => EXCEPTION_CONTINUE_EXECUTION,
+            Some((_, Made::Before)) => {
+                LAZY[6].fetch_add(1, Relaxed);
+                EXCEPTION_CONTINUE_SEARCH
+            }
+            // Not mapped (logged there), but the page is read-write now all
+            // the same (another thread's view of it): run again.
+            Some((page, Made::Failed)) if read_write(page) => EXCEPTION_CONTINUE_EXECUTION,
+            // No entry while a call of page mappings is under way
+            // (`VICTORY_REMAP_LAZY`): the page may be between its old entry
+            // and its new one. Wait for the call to end and run again; a
+            // page that shows nothing then faults again and is not ours.
+            None if CALLS.load(Relaxed) != 0 && (LO.load(Relaxed)..HI.load(Relaxed)).contains(&at) => {
+                while CALLS.load(Relaxed) != 0 && !table().any_in(at, 1) {
+                    std::thread::yield_now();
+                }
+                EXCEPTION_CONTINUE_EXECUTION
+            }
+            _ => EXCEPTION_CONTINUE_SEARCH,
+        }
+    }
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    // SAFETY: the handler touches only the table and maps placeholders.
+    ONCE.call_once(|| unsafe {
+        AddVectoredExceptionHandler(1, Some(on_fault));
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Destination pages far from anything mapped: the table is only read
+    /// for them, never touched in place.
+    const AT: usize = 0x7f30_0000_0000;
+
+    #[test]
+    fn reads_and_writes_go_through_the_table_and_the_rest_through_plain() {
+        let mut page1 = vec![0u8; PAGE];
+        let mut page2 = vec![0u8; PAGE];
+        for (i, b) in page1.iter_mut().enumerate() {
+            *b = (i % 251) as u8;
+        }
+        page2.fill(0xab);
+        // Pages 1 and 2 of four shown through the table.
+        title_memory_translated(AT + PAGE, page1.as_mut_ptr() as usize, 0, 0, true);
+        title_memory_translated(AT + 2 * PAGE, page2.as_mut_ptr() as usize, 0, 0, true);
+        assert!(any(AT, PAGE + 1));
+        assert!(!any(AT, PAGE));
+        assert_eq!(bytes_in(AT + 100, 4 * PAGE), 2 * PAGE);
+        // A read from inside page 0 to inside page 3.
+        let (from, len) = (AT + PAGE - 10, 2 * PAGE + 20);
+        let mut out = vec![0u8; len];
+        let mut plain = Vec::new();
+        let ok = read(from, out.as_mut_ptr(), len, |at, d, n| {
+            plain.push((at, n));
+            // SAFETY: inside `out`.
+            unsafe { d.write_bytes(0xee, n) };
+            true
+        });
+        assert!(ok);
+        assert_eq!(plain, vec![(from, 10), (AT + 3 * PAGE, 10)]);
+        assert_eq!(&out[..10], &[0xee; 10]);
+        assert_eq!(&out[10..10 + PAGE], &page1[..]);
+        assert!(out[10 + PAGE..10 + 2 * PAGE].iter().all(|&b| b == 0xab));
+        assert_eq!(&out[10 + 2 * PAGE..], &[0xee; 10]);
+        // A plain piece that fails fails the read.
+        assert!(!read(AT, out.as_mut_ptr(), PAGE + 1, |_, _, _| false));
+        // The kernel-path read of the runtime translates too.
+        let mut two = [0u8; 2];
+        assert!(crate::host::read_into((AT + PAGE + 5) as *const u8, &mut two));
+        assert_eq!(two, [5, 6]);
+        // Writes land in the pages, the rest goes to plain.
+        let data = vec![0x11u8; 30];
+        let mut wrote = Vec::new();
+        write(AT + 2 * PAGE - 15, data.as_ptr(), 30, |at, _, n| wrote.push((at, n)));
+        assert_eq!(wrote, Vec::<(usize, usize)>::new());
+        assert!(page1[PAGE - 15..].iter().all(|&b| b == 0x11));
+        assert!(page2[..15].iter().all(|&b| b == 0x11) && page2[15] == 0xab);
+        write(AT + 3 * PAGE - 1, data.as_ptr(), 2, |at, _, n| wrote.push((at, n)));
+        assert_eq!(wrote, vec![(AT + 3 * PAGE, 1)]);
+        assert_eq!(page2[PAGE - 1], 0x11);
+        // Untranslated: gone, and the read is all plain.
+        assert_eq!(title_memory_untranslated(AT, 4 * PAGE), 2);
+        assert!(!any(AT, 4 * PAGE));
+        let mut plain = 0;
+        assert!(read(AT, out.as_mut_ptr(), PAGE, |_, _, n| {
+            plain += n;
+            true
+        }));
+        assert_eq!(plain, PAGE);
+        assert_eq!(title_memory_untranslated(AT, 4 * PAGE), 0);
+    }
+
+    /// A section of `n` 64 KiB pages, committed, each page tagged with its
+    /// index, and a view of the whole of it: (section, view).
+    fn tagged_section(n: usize) -> (usize, usize) {
+        use windows_sys::Win32::Foundation::INVALID_HANDLE_VALUE;
+        use windows_sys::Win32::System::Memory::{CreateFileMappingW, FILE_MAP_WRITE, MapViewOfFile, PAGE_READWRITE, SEC_COMMIT};
+        // SAFETY: plain section creation and a view of it.
+        let section = unsafe {
+            CreateFileMappingW(INVALID_HANDLE_VALUE, std::ptr::null(), PAGE_READWRITE | SEC_COMMIT, 0, (n * PAGE) as u32, std::ptr::null())
+        };
+        assert!(!section.is_null());
+        let view = unsafe { MapViewOfFile(section, FILE_MAP_WRITE, 0, 0, n * PAGE) }.Value as usize;
+        assert_ne!(view, 0);
+        for k in 0..n {
+            // SAFETY: inside the view.
+            unsafe { ((view + k * PAGE) as *mut u64).write(0x7a90_0000 + k as u64) };
+        }
+        (section as usize, view)
+    }
+
+    /// A placeholder of `n` pages.
+    fn placeholder(n: usize) -> usize {
+        use windows_sys::Win32::System::Memory::{MEM_RESERVE, MEM_RESERVE_PLACEHOLDER, PAGE_NOACCESS, VirtualAlloc2};
+        // SAFETY: a fresh reservation of our own.
+        let at = unsafe {
+            VirtualAlloc2(0 as _, std::ptr::null(), n * PAGE, MEM_RESERVE | MEM_RESERVE_PLACEHOLDER, PAGE_NOACCESS, std::ptr::null_mut(), 0)
+        } as usize;
+        assert_ne!(at, 0);
+        at
+    }
+
+    fn tag_at(page: usize) -> u64 {
+        // SAFETY: a view the test made there.
+        unsafe { (page as *const u64).read_volatile() }
+    }
+
+    /// The test serializes on this: the switches below are process-wide.
+    static ONE: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+    /// An entry replaced while another thread makes the new one a view: the
+    /// old view must be retired before the table lets go, or the other
+    /// thread maps over it (error 487, `Made::Failed`) and the old view
+    /// stays mapped, untracked: the RL-C crash's 487.
+    #[test]
+    fn lazy_race_replace_while_mapping() {
+        use std::sync::atomic::AtomicBool;
+        let _one = ONE.lock().unwrap_or_else(|e| e.into_inner());
+        LAZY_TEST.store(true, Relaxed);
+        let (section, view) = tagged_section(2);
+        let at = placeholder(1);
+        let failed = FAILED.load(Relaxed);
+        title_memory_translated(at, view, section, 0, true);
+        materialize(at, PAGE);
+        assert_eq!(tag_at(at), 0x7a90_0000);
+        PAUSE_AT.store(at, Relaxed);
+        for round in 0..40usize {
+            let (from, to) = (round % 2, (round + 1) % 2);
+            assert_eq!(tag_at(at), 0x7a90_0000 + from as u64);
+            let stop = AtomicBool::new(false);
+            std::thread::scope(|s| {
+                s.spawn(|| {
+                    while !stop.load(Relaxed) {
+                        materialize(at, PAGE);
+                    }
+                });
+                title_memory_translated(at, view + to * PAGE, section, (to * PAGE) as u64, true);
+                materialize(at, PAGE);
+                stop.store(true, Relaxed);
+            });
+            flush_unmaps();
+            materialize(at, PAGE);
+            assert_eq!(FAILED.load(Relaxed), failed, "a view mapped over a retired one (round {round})");
+        }
+        PAUSE_AT.store(0, Relaxed);
+        title_memory_untranslated(at, PAGE);
+        flush_unmaps();
+        LAZY_TEST.store(false, Relaxed);
+    }
+
+    /// The end of a call unmaps retired views while another thread makes
+    /// new entries at the same addresses views: each page is either still
+    /// on the list (unmapped first) or unmapped already, never neither.
+    #[test]
+    fn lazy_race_flush_while_mapping() {
+        let _one = ONE.lock().unwrap_or_else(|e| e.into_inner());
+        LAZY_TEST.store(true, Relaxed);
+        const N: usize = 256;
+        let (section, view) = tagged_section(2);
+        let at = placeholder(N);
+        let failed = FAILED.load(Relaxed);
+        for round in 0..6usize {
+            let (from, to) = (round % 2, (round + 1) % 2);
+            for k in 0..N {
+                title_memory_translated(at + k * PAGE, view + from * PAGE, section, (from * PAGE) as u64, true);
+            }
+            materialize(at, N * PAGE);
+            for k in 0..N {
+                assert_eq!(tag_at(at + k * PAGE), 0x7a90_0000 + from as u64);
+                title_memory_translated(at + k * PAGE, view + to * PAGE, section, (to * PAGE) as u64, true);
+            }
+            assert!(pending() >= N);
+            PAUSE_AT.store(usize::MAX, Relaxed);
+            std::thread::scope(|s| {
+                s.spawn(flush_unmaps);
+                std::thread::sleep(std::time::Duration::from_millis(5));
+                for k in (0..N).rev() {
+                    materialize(at + k * PAGE, PAGE);
+                }
+            });
+            PAUSE_AT.store(0, Relaxed);
+            flush_unmaps();
+            assert_eq!(FAILED.load(Relaxed), failed, "round {round}");
+            for k in 0..N {
+                assert_eq!(tag_at(at + k * PAGE), 0x7a90_0000 + to as u64, "page {k} round {round}");
+            }
+            title_memory_untranslated(at, N * PAGE);
+            flush_unmaps();
+        }
+        LAZY_TEST.store(false, Relaxed);
+    }
+
+    /// `VICTORY_REMAP_PARK`: a view taken away is parked (no access), and
+    /// reused when the same page is shown at the same address again; a
+    /// different page there unmaps it first.
+    #[test]
+    fn lazy_park_reuses_the_same_page_only() {
+        let _one = ONE.lock().unwrap_or_else(|e| e.into_inner());
+        LAZY_TEST.store(true, Relaxed);
+        PARK_TEST.store(true, Relaxed);
+        let (section, view) = tagged_section(2);
+        let at = placeholder(1);
+        let failed = FAILED.load(Relaxed);
+        title_memory_translated(at, view, section, 0, true);
+        materialize(at, PAGE);
+        title_memory_untranslated(at, PAGE);
+        flush_unmaps();
+        assert!(PARKED.lock().unwrap().contains_key(&at));
+        assert!(!read_write(at), "a parked view is not accessible");
+        let reused = PARK[0].load(Relaxed);
+        title_memory_translated(at, view, section, 0, true);
+        materialize(at, PAGE);
+        assert_eq!(PARK[0].load(Relaxed), reused + 1);
+        assert_eq!(tag_at(at), 0x7a90_0000);
+        title_memory_untranslated(at, PAGE);
+        flush_unmaps();
+        let other = PARK[1].load(Relaxed);
+        title_memory_translated(at, view + PAGE, section, PAGE as u64, true);
+        materialize(at, PAGE);
+        assert_eq!(PARK[1].load(Relaxed), other + 1);
+        assert_eq!(tag_at(at), 0x7a90_0001);
+        // Replaced before the end of the call by the same page: kept.
+        title_memory_translated(at, view, section, 0, true);
+        title_memory_translated(at, view + PAGE, section, PAGE as u64, true);
+        let reused = PARK[0].load(Relaxed);
+        materialize(at, PAGE);
+        assert_eq!(PARK[0].load(Relaxed), reused + 1);
+        assert_eq!(tag_at(at), 0x7a90_0001);
+        assert_eq!(FAILED.load(Relaxed), failed);
+        title_memory_untranslated(at, PAGE);
+        flush_unmaps();
+        PARK_TEST.store(false, Relaxed);
+        LAZY_TEST.store(false, Relaxed);
+    }
+
+    /// A CPU read, in place, of a page shown through the table whose
+    /// section is reserved, not committed (`VICTORY_REMAP_LAZY` without
+    /// `_COMMIT`): the fault makes it a committed view and the read sees the
+    /// page. Then the view is taken away under its entry (what the racing
+    /// test caught): the next read makes it a view anew instead of crashing.
+    #[test]
+    fn lazy_cpu_read_of_an_uncommitted_page() {
+        use windows_sys::Win32::Foundation::INVALID_HANDLE_VALUE;
+        use windows_sys::Win32::System::Memory::{
+            CreateFileMappingW, FILE_MAP_WRITE, MEM_COMMIT, MEM_PRESERVE_PLACEHOLDER, MEMORY_MAPPED_VIEW_ADDRESS, MapViewOfFile,
+            PAGE_READWRITE, SEC_RESERVE, UnmapViewOfFile2, VirtualAlloc,
+        };
+        use windows_sys::Win32::System::Threading::GetCurrentProcess;
+        let _one = ONE.lock().unwrap_or_else(|e| e.into_inner());
+        // SAFETY: plain section creation and a view of it.
+        let section = unsafe {
+            CreateFileMappingW(INVALID_HANDLE_VALUE, std::ptr::null(), PAGE_READWRITE | SEC_RESERVE, 0, (2 * PAGE) as u32, std::ptr::null())
+        };
+        assert!(!section.is_null());
+        let whole = unsafe { MapViewOfFile(section, FILE_MAP_WRITE, 0, 0, 2 * PAGE) }.Value as usize;
+        assert_ne!(whole, 0);
+        // The runtime's own copy of page 1 is committed (as xmem's
+        // `translate` does); a view of it elsewhere is not.
+        assert!(!unsafe { VirtualAlloc((whole + PAGE) as *const _, PAGE, MEM_COMMIT, PAGE_READWRITE) }.is_null());
+        // SAFETY: inside the committed page.
+        unsafe { ((whole + PAGE + 8) as *mut u64).write(0x1a2b_3c4d) };
+        let at = placeholder(4) + PAGE;
+        title_memory_translated(at, whole + PAGE, section as usize, PAGE as u64, false);
+        assert_eq!(tag_at(at + 8), 0x1a2b_3c4d, "read through the fault");
+        assert!(read_write(at), "a committed, writable view now");
+        // The view taken away under its entry.
+        let healed = HEALED[1].load(Relaxed);
+        // SAFETY: the view the fault made.
+        assert_ne!(
+            unsafe { UnmapViewOfFile2(GetCurrentProcess(), MEMORY_MAPPED_VIEW_ADDRESS { Value: at as *mut _ }, MEM_PRESERVE_PLACEHOLDER) },
+            0
+        );
+        assert_eq!(tag_at(at + 8), 0x1a2b_3c4d, "made a view anew");
+        assert_eq!(HEALED[1].load(Relaxed), healed + 1);
+        title_memory_untranslated(at, PAGE);
+        flush_unmaps();
+    }
+}
diff --git a/crates/victory-gpu/src/vram.rs b/crates/victory-gpu/src/vram.rs
new file mode 100644
index 0000000..858a47d
--- /dev/null
+++ b/crates/victory-gpu/src/vram.rs
@@ -0,0 +1,382 @@
+//! The card's memory budget (`VICTORY_VRAM_BUDGET=1`).
+//!
+//! The layer makes every card object committed (one heap each) and never
+//! calls `MakeResident` / `Evict`: when the title's world outgrows the card,
+//! the system demotes our objects to the PC's memory behind our back and,
+//! on small cards, the driver can lose the device. With this switch on:
+//!
+//! - the budget is read with `IDXGIAdapter3::QueryVideoMemoryInfo`, again
+//!   at once when the system says it changed (the budget-change
+//!   notification) and at most every 100 ms otherwise;
+//! - every 5 s a memory line says use against budget and what was let go;
+//! - near the budget the sweeps (`crate::resource::let_go_idle`,
+//!   `crate::shadow::let_go_idle`) run more often and take host copies and
+//!   cached textures that nothing used in the last N frames
+//!   (`VICTORY_VRAM_IDLE_FRAMES`, 8) sooner. They never take what a list
+//!   or a descriptor slot still holds, and what they let go is dropped only
+//!   once every running submission has finished (`crate::host::retire`):
+//!   nothing in flight is touched.
+//!
+//! Off (the default) the sweeps keep their own timings and nothing here is
+//! read, except the eviction counters.
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+/// Whether the budget policy is on (`VICTORY_VRAM_BUDGET=1`).
+pub(crate) fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_VRAM_BUDGET").is_some_and(|v| v == "1"))
+}
+
+/// The policy's knobs.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Config {
+    /// Use at or above this share of the budget (percent) is "near".
+    pub near_pct: u64,
+    /// At or above this share it is "over": the policy acts hardest.
+    pub over_pct: u64,
+    /// N: frames a cached object must have gone unused before it may go.
+    pub idle_frames: u64,
+}
+
+impl Default for Config {
+    fn default() -> Self {
+        Self { near_pct: 85, over_pct: 95, idle_frames: 8 }
+    }
+}
+
+impl Config {
+    /// From the environment: `VICTORY_VRAM_NEAR_PCT`, `VICTORY_VRAM_OVER_PCT`,
+    /// `VICTORY_VRAM_IDLE_FRAMES`.
+    fn from_env() -> Self {
+        let get = |name: &str| std::env::var(name).ok().and_then(|v| v.trim().parse::<u64>().ok());
+        let d = Self::default();
+        let near = get("VICTORY_VRAM_NEAR_PCT").unwrap_or(d.near_pct).clamp(10, 100);
+        let over = get("VICTORY_VRAM_OVER_PCT").unwrap_or(d.over_pct).clamp(near, 200);
+        let frames = get("VICTORY_VRAM_IDLE_FRAMES").unwrap_or(d.idle_frames).max(2);
+        Self { near_pct: near, over_pct: over, idle_frames: frames }
+    }
+}
+
+fn config() -> Config {
+    static C: OnceLock<Config> = OnceLock::new();
+    *C.get_or_init(Config::from_env)
+}
+
+/// How close the card is to its budget.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) enum Pressure {
+    Calm,
+    Near,
+    Over,
+}
+
+/// The pressure for `used` bytes of a `budget` (no budget: calm).
+pub(crate) fn pressure(budget: u64, used: u64, cfg: &Config) -> Pressure {
+    if budget == 0 {
+        return Pressure::Calm;
+    }
+    let pct = u128::from(used) * 100 / u128::from(budget);
+    if pct >= u128::from(cfg.over_pct) {
+        Pressure::Over
+    } else if pct >= u128::from(cfg.near_pct) {
+        Pressure::Near
+    } else {
+        Pressure::Calm
+    }
+}
+
+/// Shortest idle time ever used: a host texture handed out and not yet
+/// recorded into a list or slot is protected by idle time alone
+/// (`crate::resource::host_resource`), and every caller records it within
+/// the title's call.
+pub(crate) const FLOOR_MS: u64 = 1_000;
+
+/// What a sweep does at a pressure.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Plan {
+    /// An object may go once unused this long ...
+    pub idle_ms: u64,
+    /// ... and this many frames.
+    pub idle_frames: u64,
+    /// The sweeps run at most this often.
+    pub sweep_every_ms: u64,
+}
+
+/// The sweep plan: calm keeps the sweep's own `default_ms` / `default_frames`
+/// and its once-a-second pace; near takes what was unused for N frames (and
+/// [`FLOOR_MS`]) twice a second; over takes what was unused for N/2 frames
+/// four times a second. Idle times never fall below [`FLOOR_MS`] nor two
+/// frames.
+pub(crate) fn plan(p: Pressure, cfg: &Config, default_ms: u64, default_frames: u64) -> Plan {
+    match p {
+        Pressure::Calm => Plan { idle_ms: default_ms, idle_frames: default_frames, sweep_every_ms: 1_000 },
+        Pressure::Near => Plan {
+            idle_ms: default_ms.min(2 * FLOOR_MS).max(FLOOR_MS),
+            idle_frames: cfg.idle_frames.max(2),
+            sweep_every_ms: 500,
+        },
+        Pressure::Over => Plan {
+            idle_ms: FLOOR_MS,
+            idle_frames: (cfg.idle_frames / 2).max(2),
+            sweep_every_ms: 250,
+        },
+    }
+}
+
+/// Whether a cached object may go: unused for the plan's time and frames,
+/// and held by nobody but its cache (`holders` beyond the cache's own: lists
+/// not yet reset, descriptor slots, a submission comparing it). Anything
+/// held is in flight or about to be, and stays.
+pub(crate) fn may_evict(plan: &Plan, ms_since: u64, frames_since: u64, holders: u64) -> bool {
+    holders == 0 && ms_since >= plan.idle_ms && frames_since >= plan.idle_frames
+}
+
+/// The last look: budget, use of the card's own memory, use of the PC's
+/// memory shared with the card (bytes), and when (ms, `crate::host::now_ms`).
+static LOOK: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+/// Budget-change notifications received, and changes of 64 MB or more seen.
+static CHANGES: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+/// Let go by the sweeps since the start: objects, bytes; and of them under
+/// pressure (near or over).
+static EVICTED: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+/// Highest use seen, bytes; looks at near and at over.
+static PEAK: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+
+/// A sweep let `count` objects of `bytes` go (counted on or off).
+pub(crate) fn evicted(count: u64, bytes: u64) {
+    if count == 0 {
+        return;
+    }
+    EVICTED[0].fetch_add(count, Relaxed);
+    EVICTED[1].fetch_add(bytes, Relaxed);
+    if on() && current() > Pressure::Calm {
+        EVICTED[2].fetch_add(count, Relaxed);
+        EVICTED[3].fetch_add(bytes, Relaxed);
+    }
+}
+
+/// The pressure as of the last look (calm when off or never looked).
+pub(crate) fn current() -> Pressure {
+    if !on() {
+        return Pressure::Calm;
+    }
+    pressure(LOOK[0].load(Relaxed), LOOK[1].load(Relaxed), &config())
+}
+
+/// The sweep plan for a sweep whose own defaults are `default_ms` and
+/// `default_frames`: those as they are when off.
+pub(crate) fn sweep_plan(default_ms: u64, default_frames: u64) -> Plan {
+    plan(current(), &config(), default_ms, default_frames)
+}
+
+/// The last look, for the device-removed line: budget, use, shared use.
+pub(crate) fn last_look() -> [u64; 3] {
+    [0, 1, 2].map(|i| LOOK[i].load(Relaxed))
+}
+
+/// Reads the budget now and keeps it.
+#[cfg(windows)]
+fn refresh() {
+    let Some(host) = crate::host::host() else { return };
+    let Some([budget, used, _, shared]) = host.video_memory() else { return };
+    let was = LOOK[0].swap(budget, Relaxed);
+    if was != 0 && was.abs_diff(budget) >= 64 << 20 {
+        CHANGES[1].fetch_add(1, Relaxed);
+    }
+    LOOK[1].store(used, Relaxed);
+    LOOK[2].store(shared, Relaxed);
+    LOOK[3].store(crate::host::now_ms(), Relaxed);
+    PEAK[0].fetch_max(used, Relaxed);
+    match pressure(budget, used, &config()) {
+        Pressure::Calm => {}
+        Pressure::Near => {
+            PEAK[1].fetch_add(1, Relaxed);
+        }
+        Pressure::Over => {
+            PEAK[2].fetch_add(1, Relaxed);
+        }
+    }
+}
+
+/// Registers for the system's budget-change notification, once: a thread
+/// waits for it and reads the budget again at once.
+#[cfg(windows)]
+fn listen() {
+    use windows::Win32::System::Threading::{CreateEventW, INFINITE, WaitForSingleObject};
+    static ONCE: OnceLock<()> = OnceLock::new();
+    ONCE.get_or_init(|| {
+        let Some(host) = crate::host::host() else { return };
+        // SAFETY: a plain event, kept for the run.
+        let Ok(event) = (unsafe { CreateEventW(None, false, false, None) }) else { return };
+        let Some(cookie) = host.budget_notification(event) else {
+            tracing::warn!("vram: the system refused the budget-change notification; the budget is read every 100 ms instead");
+            return;
+        };
+        let raw = event.0 as usize;
+        let spawned = std::thread::Builder::new().name("victory-vram-budget".into()).spawn(move || {
+            let event = windows::Win32::Foundation::HANDLE(raw as *mut _);
+            loop {
+                // SAFETY: the event lives for the run.
+                unsafe { WaitForSingleObject(event, INFINITE) };
+                CHANGES[0].fetch_add(1, Relaxed);
+                let before = LOOK[0].load(Relaxed);
+                refresh();
+                let after = LOOK[0].load(Relaxed);
+                if before != after {
+                    tracing::info!(
+                        "vram: the system changed the card's budget {} MB -> {} MB (in use {} MB, frame {})",
+                        before >> 20,
+                        after >> 20,
+                        LOOK[1].load(Relaxed) >> 20,
+                        crate::frame::current()
+                    );
+                }
+            }
+        });
+        if spawned.is_err() {
+            tracing::warn!("vram: no thread for the budget-change notification");
+        }
+        tracing::info!(cookie, cfg = ?config(), "vram: budget policy on (VICTORY_VRAM_BUDGET=1)");
+    });
+}
+
+/// Before a sweep, on the submitting thread: reads the budget (at most
+/// every 100 ms) and says the memory line every 5 s. Nothing when off.
+#[cfg(windows)]
+pub(crate) fn tick() {
+    if !on() {
+        return;
+    }
+    listen();
+    let now = crate::host::now_ms();
+    if now >= LOOK[3].load(Relaxed) + 100 {
+        refresh();
+    }
+    static LINE: AtomicU64 = AtomicU64::new(0);
+    static LAST: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+    let last = LINE.load(Relaxed);
+    if now < last + 5_000 || LINE.compare_exchange(last, now, Relaxed, Relaxed).is_err() {
+        return;
+    }
+    let [budget, used, shared] = last_look();
+    let all = [EVICTED[0].load(Relaxed), EVICTED[1].load(Relaxed)];
+    let before = [0, 1].map(|i| LAST[i].swap(all[i], Relaxed));
+    tracing::info!(
+        "vram: used {} / budget {} MB ({}%, {:?}), shared {} MB, peak {} MB; evictions last 5 s {} ({} MB), since start {} ({} MB), {} under pressure; looks near {} over {}; budget notifications {}, changes {}",
+        used >> 20,
+        budget >> 20,
+        if budget == 0 { 0 } else { u128::from(used) * 100 / u128::from(budget) },
+        current(),
+        shared >> 20,
+        PEAK[0].load(Relaxed) >> 20,
+        all[0] - before[0],
+        (all[1] - before[1]) >> 20,
+        all[0],
+        all[1] >> 20,
+        EVICTED[2].load(Relaxed),
+        PEAK[1].load(Relaxed),
+        PEAK[2].load(Relaxed),
+        CHANGES[0].load(Relaxed),
+        CHANGES[1].load(Relaxed),
+    );
+}
+
+/// What most likely removed the device, from its reason (an HRESULT),
+/// whether DRED saw a page fault, and the card's use against its budget at
+/// the last look.
+pub(crate) fn removal_cause(reason: u32, page_fault: bool, budget: u64, used: u64) -> &'static str {
+    let over = budget != 0 && used >= budget;
+    match reason {
+        0x8007_000E => "out of memory (E_OUTOFMEMORY)",
+        _ if page_fault && over => "page fault with the card over its budget: likely an object demoted or freed under pressure",
+        _ if page_fault => "page fault: a shader or copy touched memory that is not there",
+        0x887A_0006 if over => "GPU hang (DEVICE_HUNG / TDR) with the card over its budget: likely paging",
+        0x887A_0006 => "GPU hang (DEVICE_HUNG / TDR): work ran too long or never finished",
+        0x887A_0007 => "device reset (DEVICE_RESET): badly formed commands",
+        0x887A_0020 => "driver internal error (DRIVER_INTERNAL_ERROR)",
+        0x887A_0001 => "invalid call (INVALID_CALL)",
+        _ if over => "device removed with the card over its budget",
+        _ => "device removed, cause not named by the reason",
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const GIB: u64 = 1 << 30;
+
+    #[test]
+    fn pressure_tiers() {
+        let c = Config::default();
+        assert_eq!(pressure(12 * GIB, 0, &c), Pressure::Calm);
+        assert_eq!(pressure(100, 84, &c), Pressure::Calm);
+        assert_eq!(pressure(100, 85, &c), Pressure::Near);
+        assert_eq!(pressure(100, 94, &c), Pressure::Near);
+        assert_eq!(pressure(100, 95, &c), Pressure::Over);
+        assert_eq!(pressure(6 * GIB, 7 * GIB, &c), Pressure::Over);
+        assert_eq!(pressure(0, 5 * GIB, &c), Pressure::Calm);
+        // No overflow at huge numbers.
+        assert_eq!(pressure(u64::MAX, u64::MAX, &c), Pressure::Over);
+    }
+
+    #[test]
+    fn calm_keeps_the_sweeps_own_timing() {
+        let c = Config::default();
+        let p = plan(Pressure::Calm, &c, 5_000, 4);
+        assert_eq!(p, Plan { idle_ms: 5_000, idle_frames: 4, sweep_every_ms: 1_000 });
+    }
+
+    #[test]
+    fn pressure_tightens_but_never_below_the_floor() {
+        let c = Config { idle_frames: 8, ..Config::default() };
+        let near = plan(Pressure::Near, &c, 5_000, 4);
+        assert_eq!(near.idle_frames, 8);
+        assert_eq!(near.idle_ms, 2_000);
+        assert_eq!(near.sweep_every_ms, 500);
+        let over = plan(Pressure::Over, &c, 5_000, 4);
+        assert_eq!(over.idle_frames, 4);
+        assert_eq!(over.idle_ms, FLOOR_MS);
+        assert_eq!(over.sweep_every_ms, 250);
+        // A sweep with a short default of its own is not lowered below
+        // the floor, and tiny N stays at two frames.
+        let tiny = Config { idle_frames: 2, ..Config::default() };
+        assert_eq!(plan(Pressure::Near, &tiny, 0, 1).idle_ms, FLOOR_MS);
+        assert_eq!(plan(Pressure::Over, &tiny, 0, 1).idle_frames, 2);
+        for p in [Pressure::Near, Pressure::Over] {
+            let x = plan(p, &tiny, 0, 0);
+            assert!(x.idle_ms >= FLOOR_MS && x.idle_frames >= 2);
+        }
+    }
+
+    #[test]
+    fn never_evicts_what_is_held() {
+        let c = Config::default();
+        let over = plan(Pressure::Over, &c, 5_000, 4);
+        // Idle for ages but still held by a list or slot: stays.
+        assert!(!may_evict(&over, u64::MAX, u64::MAX, 1));
+        assert!(!may_evict(&over, u64::MAX, u64::MAX, 3));
+        // Unheld but used within N frames or the floor: stays.
+        assert!(!may_evict(&over, FLOOR_MS, over.idle_frames - 1, 0));
+        assert!(!may_evict(&over, FLOOR_MS - 1, 100, 0));
+        // Unheld and idle: goes.
+        assert!(may_evict(&over, FLOOR_MS, over.idle_frames, 0));
+        // The same object at calm waits for the sweep's own time.
+        let calm = plan(Pressure::Calm, &c, 5_000, 4);
+        assert!(!may_evict(&calm, 2_000, 10, 0));
+        assert!(may_evict(&calm, 5_000, 4, 0));
+    }
+
+    #[test]
+    fn removal_causes() {
+        assert!(removal_cause(0x8007_000E, false, 0, 0).contains("out of memory"));
+        assert!(removal_cause(0x887A_0006, false, 10, 11).contains("over its budget"));
+        assert!(removal_cause(0x887A_0006, false, 10, 5).starts_with("GPU hang"));
+        assert!(removal_cause(0x887A_0005, true, 10, 5).starts_with("page fault:"));
+        assert!(removal_cause(0x887A_0005, true, 10, 10).contains("demoted"));
+        assert!(removal_cause(0x887A_0020, false, 0, 0).contains("DRIVER_INTERNAL"));
+        assert!(removal_cause(0x887A_0005, false, 0, 0).contains("not named"));
+    }
+}
