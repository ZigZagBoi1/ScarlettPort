@@ -0,0 +1,85 @@
+//! `VICTORY_NATIVE_BUFFERS=1` (off by default): GPU-owned buffers, the
+//! re-scoped milestone 1. A title buffer's host copy starts on today's
+//! path. Once [`STREAK`] copy-backs of it in a row ran with no title CPU
+//! write in it since the one before (write watch) and it is not a read-back
+//! buffer, it is promoted: the copy is the truth from then on. Its ranges
+//! shaders write are still declared (flights stay ordered) but get no
+//! snapshot and no copy-back, and nothing is refreshed from title memory.
+//! The first title CPU write seen in it demotes it. The copy's bytes go into
+//! title memory for every page the title did not write, then it is on
+//! today's path again with its streak at 0.
+//!
+//! Not exact:
+//! - A title CPU *read* of a promoted buffer outside the read-back ring is
+//!   not seen; it reads bytes from the promotion on.
+//! - On demotion, a page the title wrote keeps the title's bytes whole
+//!   (shader bytes elsewhere in that page are lost).
+//! - Shader writes of a flight still in the air at demotion are not copied
+//!   back.
+//!
+//! Only plain host copies (not in the card's memory, not ReBAR, not in
+//! place): their bytes are in mapped memory the CPU reads at demotion.
+
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::OnceLock;
+
+/// Copy-backs in a row with no title write before promotion
+/// (`VICTORY_NATIVE_BUFFERS_STREAK`, default 120: a couple of seconds).
+pub(crate) fn streak() -> u32 {
+    static N: OnceLock<u32> = OnceLock::new();
+    *N.get_or_init(|| std::env::var("VICTORY_NATIVE_BUFFERS_STREAK").ok().and_then(|v| v.parse().ok()).filter(|&n| n > 0).unwrap_or(120))
+}
+
+pub(crate) fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var_os("VICTORY_NATIVE_BUFFERS").is_some_and(|v| v == "1");
+        if on {
+            tracing::warn!(streak = streak(), "VICTORY_NATIVE_BUFFERS: GPU-owned buffers are promoted off the copy-back path");
+        }
+        on
+    })
+}
+
+/// Promotions, demotions, copy-backs skipped, bytes they covered, bytes
+/// put into title memory at demotion, promoted now, bytes promoted now.
+pub(crate) static STATS: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+pub(crate) const PROMOTED: usize = 0;
+pub(crate) const DEMOTED: usize = 1;
+pub(crate) const SKIPPED: usize = 2;
+pub(crate) const SKIPPED_BYTES: usize = 3;
+pub(crate) const MATERIALIZED: usize = 4;
+pub(crate) const LIVE: usize = 5;
+pub(crate) const LIVE_BYTES: usize = 6;
+
+/// Every 5 s at a submission: the counts and the copy-back avoided per
+/// frame since the last line.
+pub(crate) fn line() {
+    if !on() {
+        return;
+    }
+    static LAST: std::sync::Mutex<Option<(std::time::Instant, u64, u64)>> = std::sync::Mutex::new(None);
+    let mut last = LAST.lock().unwrap_or_else(|e| e.into_inner());
+    let now = std::time::Instant::now();
+    let frames = crate::native::probe::frames();
+    let bytes = STATS[SKIPPED_BYTES].load(Relaxed);
+    let Some((at, f0, b0)) = *last else {
+        *last = Some((now, frames, bytes));
+        return;
+    };
+    if now - at < std::time::Duration::from_secs(5) {
+        return;
+    }
+    *last = Some((now, frames, bytes));
+    let per_frame = (bytes - b0) as f64 / (frames.saturating_sub(f0)).max(1) as f64 / 1e6;
+    tracing::warn!(
+        "native buffers: promoted {} (now {}, {:.1} MB), demoted {}, copy-backs skipped {}, copy-back avoided {:.2} MB/frame, put back at demotion {:.1} MB",
+        STATS[PROMOTED].load(Relaxed),
+        STATS[LIVE].load(Relaxed),
+        STATS[LIVE_BYTES].load(Relaxed) as f64 / 1e6,
+        STATS[DEMOTED].load(Relaxed),
+        STATS[SKIPPED].load(Relaxed),
+        per_frame,
+        STATS[MATERIALIZED].load(Relaxed) as f64 / 1e6,
+    );
+}
diff --git a/crates/victory-gpu/src/native/gpumem.rs b/crates/victory-gpu/src/native/gpumem.rs
new file mode 100644
index 0000000..b7511f3
--- /dev/null
+++ b/crates/victory-gpu/src/native/gpumem.rs
@@ -0,0 +1,683 @@
+//! `VICTORY_NATIVE_GPUMEM=1` (off by default, boot only): milestone 1 of
+//! NATIVE-BOUNDARY.md §4. Memory the CPU never touches lives on the card:
+//!
+//! - The render-target pool: one host heap the pool's size and one reserved
+//!   buffer spanning the title's reservation the pool's pages are mapped
+//!   into. Each page map or unmap of the title is a tile mapping of that
+//!   buffer (queued, `UpdateTileMappings` before the next submission), so
+//!   addresses that show one page show one tile, as on the console.
+//!   Buffers, root views, vertex/index views, indirect arguments and copies
+//!   at pool addresses resolve to it (`crate::shadow` `lookup`/`exact`
+//!   consult [`find`] first) as a copy "in place": nothing refreshed,
+//!   watched, snapshotted or copied back.
+//! - Unordered-access buffers the title makes in a GPU-only reservation
+//!   (0x801) whose title bytes are all zero at first use: a buffer of the
+//!   card's own, the same way.
+//! - Target/depth/unordered-access textures made by device 0x3f8: no title
+//!   memory (their contents were the card's alone already); their address
+//!   comes from a reserved range that is never committed.
+//!
+//! Anything else, and anything ambiguous (a range only partly in the pool,
+//! a page not mapped, an excluded or demoted range, a read-back buffer,
+//! title bytes present), takes today's path and is counted.
+//! `VICTORY_NATIVE_GPUMEM_EXCLUDE=<start-end|start+len,...>` (hex) keeps
+//! ranges on today's path; a CPU touch the lazy remap handler sees in a
+//! native range demotes its page to today's path from then on (what the
+//! card holds there is not in title memory: counted, not exact).
+
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::{Arc, Mutex, OnceLock};
+
+use windows::Win32::Graphics::Direct3D12::*;
+
+use super::table::{Bump, Ranges, Table};
+use crate::shadow::Shadow;
+
+/// Counts since the start (logged every 5 s at a submission).
+pub(crate) static STATS: [AtomicU64; 19] = [const { AtomicU64::new(0) }; 19];
+const RT_HIT: usize = 0;
+const RT_FALLBACK: usize = 1;
+const BUF_NATIVE: usize = 2;
+const BUF_FALLBACK: usize = 3;
+const TEX_NATIVE: usize = 4;
+const TEX_FALLBACK: usize = 5;
+const TILE_UPDATES: usize = 6;
+const TILE_CALLS: usize = 7;
+const DEMOTED: usize = 8;
+const EXCLUDED: usize = 9;
+const BUF_HIT: usize = 10;
+const NOT_MADE: usize = 11;
+const BUF_DATA: usize = 12;
+const TEX_BYTES: usize = 13;
+const COPIES: usize = 14;
+const COPY_FALLBACK: usize = 15;
+const TEX_POOL_ASKED: usize = 16;
+const TEX_POOL: usize = 17;
+const TEX_POOL_FALLBACK: usize = 18;
+const NAMES: [&str; 19] = [
+    "rt hits", "rt fallbacks", "buffers made", "buffer fallbacks", "textures made", "texture fallbacks",
+    "tile updates", "tile calls", "demoted pages", "excluded asks", "buffer hits", "pool not made yet",
+    "buffers with title bytes", "texture bytes", "copies on the card", "copies dropped", "pool textures asked", "pool textures made", "pool texture fallbacks",
+];
+
+/// Buffer fallbacks by reason.
+static WHY: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+const WHY_NAMES: [&str; 7] = ["no UAV flag", "read-back", "excluded", "demoted", "title bytes", "no heap", "overlaps native"];
+
+/// The pool's pages have no virtual range of their own: `PhysPool_Init`
+/// (title+0x22163d0) only allocates physical pages, and the title maps them
+/// wherever it places targets. So the card side is one heap the pool's size
+/// and, per 256 MiB window of addresses a pool page was mapped in, one
+/// reserved buffer over that window whose tiles follow the title's maps.
+const WINDOW: u64 = 256 << 20;
+
+struct RtWindow {
+    buffer: ID3D12Resource,
+    shadow: Arc<Shadow>,
+    /// Something bound it: its tiles follow the title's maps from then on.
+    /// Until then no tile call is made for it (7,671 calls in a run with
+    /// no hit cost prep and card time).
+    live: std::sync::atomic::AtomicBool,
+    /// Its tiles are behind the title's maps (it was not live).
+    stale: bool,
+}
+
+/// A target texture whose memory is all pool pages: a reserved texture
+/// whose tiles are the pool's, in the order of its pages.
+struct RtTexture {
+    texture: ID3D12Resource,
+    start: u64,
+    tiles: u32,
+    /// Mapped once at a submission.
+    mapped: bool,
+}
+
+struct State {
+    /// The pool's heap on the card, once made.
+    heap: Option<ID3D12Heap>,
+    /// Reserved buffers by window base.
+    windows: std::collections::BTreeMap<u64, RtWindow>,
+    pool_textures: Vec<RtTexture>,
+    /// Making the pool failed: never tried again.
+    rt_failed: bool,
+    /// Native buffers by title start: (resource, shadow).
+    buffers: Table<(usize, Arc<Shadow>)>,
+    demoted: Ranges,
+    textures: Option<Bump>,
+    last_line: Option<std::time::Instant>,
+}
+
+static STATE: Mutex<State> = Mutex::new(State {
+    heap: None,
+    windows: std::collections::BTreeMap::new(),
+    pool_textures: Vec::new(),
+    rt_failed: false,
+    buffers: Table::new(),
+    demoted: Ranges::new(),
+    textures: None,
+    last_line: None,
+});
+/// Windows made, read without the lock.
+static WINDOWS: AtomicU64 = AtomicU64::new(0);
+
+// SAFETY: D3D12 objects are free-threaded.
+unsafe impl Send for State {}
+/// Native buffers, read without the lock.
+static BUFFERS: AtomicU64 = AtomicU64::new(0);
+
+fn state() -> std::sync::MutexGuard<'static, State> {
+    STATE.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+fn on() -> bool {
+    super::gpumem()
+}
+
+fn excluded(start: u64, end: u64) -> bool {
+    static EX: OnceLock<Ranges> = OnceLock::new();
+    let ex = EX.get_or_init(|| {
+        let r = Ranges::parse(&std::env::var("VICTORY_NATIVE_GPUMEM_EXCLUDE").unwrap_or_default());
+        if !r.is_empty() {
+            tracing::warn!(ranges = ?r, "VICTORY_NATIVE_GPUMEM_EXCLUDE");
+        }
+        r
+    });
+    ex.meets(start, end)
+}
+
+/// A placeholder reservation of the title's (no longer needed).
+pub(crate) fn reserved(_at: u64, _len: u64) {}
+
+/// The pool's first page was mapped at `at`.
+pub(crate) fn pool_page_at(at: u64) {
+    if on() {
+        tracing::warn!(first_page = format_args!("{at:#x}"), "native: the RT pool's first page is mapped");
+    }
+}
+
+/// A CPU touch of `at` (the lazy remap handler made a view): a native page
+/// there is demoted.
+pub(crate) fn touched(at: usize) {
+    if !on() {
+        return;
+    }
+    let page = at as u64 & !0xffff;
+    let in_span = WINDOWS.load(Relaxed) != 0 && super::pool().as_ref().is_some_and(|p| p.covers(page as usize, 1));
+    let mut s = state();
+    if in_span || s.buffers.find(page, 1).is_some() {
+        if !s.demoted.meets(page, page + 0x1_0000) {
+            s.demoted.add(page, page + 0x1_0000);
+            let n = STATS[DEMOTED].fetch_add(1, Relaxed) + 1;
+            if n.is_power_of_two() {
+                tracing::warn!(n, page = format_args!("{page:#x}"), "native: a CPU touch demoted a page to today's path");
+            }
+        }
+    }
+}
+
+/// What serves `[address, address + len)` on the card, if it is native:
+/// the pool's span or a native buffer.
+pub(crate) fn find(address: u64, len: u64) -> Option<Arc<Shadow>> {
+    let r = find_inner(address, len);
+    static SEEN: AtomicU64 = AtomicU64::new(0);
+    if WINDOWS.load(Relaxed) != 0 && SEEN.fetch_add(1, Relaxed) < 10 {
+        tracing::warn!(address = format_args!("{address:#x}"), len, hit = r.is_some(),
+            windows = WINDOWS.load(Relaxed), "native: lookup");
+    }
+    r
+}
+
+fn find_inner(address: u64, len: u64) -> Option<Arc<Shadow>> {
+    let end = address.checked_add(len.max(1))?;
+    let base = address & !(WINDOW - 1);
+    let windowed = WINDOWS.load(Relaxed) != 0;
+    if !windowed && BUFFERS.load(Relaxed) == 0 {
+        return None;
+    }
+    // A pool page: every page of the range mapped from the pool, one window.
+    let in_pool = windowed && super::pool().as_ref().is_some_and(|p| p.covers(address as usize, 1));
+    let s = state();
+    if !s.demoted.is_empty() && s.demoted.meets(address & !0xffff, end) {
+        return None;
+    }
+    if in_pool {
+        let whole = (end - 1) & !(WINDOW - 1) == base
+            && super::pool().as_ref().is_some_and(|p| p.covers(address as usize, (end - address) as usize));
+        if whole
+            && !excluded(address, end)
+            && let Some(w) = s.windows.get(&base)
+        {
+            STATS[RT_HIT].fetch_add(1, Relaxed);
+            w.live.store(true, Relaxed);
+            return Some(w.shadow.clone());
+        }
+        STATS[RT_FALLBACK].fetch_add(1, Relaxed);
+        return None;
+    }
+    let (_, (_, shadow)) = s.buffers.find(address, end - address)?;
+    STATS[BUF_HIT].fetch_add(1, Relaxed);
+    Some(shadow.clone())
+}
+
+/// A title buffer `[start, start + len)` (resource `resource`, flags
+/// `flags`) wants a host side: a buffer of the card's own if it may be.
+pub(crate) fn buffer(resource: usize, start: u64, len: u64, flags: u32) -> Option<Arc<Shadow>> {
+    if !on() || len == 0 {
+        return None;
+    }
+    let end = start.checked_add(len)?;
+    {
+        let s = state();
+        if let Some((at, (r, shadow))) = s.buffers.find(start, len)
+            && at == start
+            && *r == resource
+        {
+            return Some(shadow.clone());
+        }
+    }
+    const UNORDERED: u32 = 0x4;
+    let gpu_only = crate::watch::gpu_only_ranges().iter().any(|&(a, b)| a as u64 <= start && end <= b as u64);
+    if !gpu_only {
+        return None;
+    }
+    let fallback = |why: usize| {
+        STATS[BUF_FALLBACK].fetch_add(1, Relaxed);
+        WHY[why].fetch_add(1, Relaxed);
+        if WHY[why].load(Relaxed) <= 3 {
+            tracing::warn!(why = WHY_NAMES[why], start = format_args!("{start:#x}"), len, flags = format_args!("{flags:#x}"), "native: buffer fallback");
+        }
+        None
+    };
+    if flags & UNORDERED == 0 {
+        return fallback(0);
+    }
+    if crate::readback::tagged_in(start, len) {
+        return fallback(1);
+    }
+    if excluded(start, end) {
+        STATS[EXCLUDED].fetch_add(1, Relaxed);
+        return fallback(2);
+    }
+    if state().demoted.meets(start, end) {
+        return fallback(3);
+    }
+    // Title bytes there (an initial fill through the CPU view): today's path.
+    let mut bytes = vec![0u8; len as usize];
+    if !crate::host::read_into(start as *const u8, &mut bytes) || bytes.iter().any(|&b| b != 0) {
+        STATS[BUF_DATA].fetch_add(1, Relaxed);
+        return fallback(4);
+    }
+    drop(bytes);
+    let host = crate::host::host()?;
+    let size = len.next_multiple_of(1 << 16);
+    let Some((heap, buffer)) = heap_and_buffer(&host.device, size, size, false) else {
+        return fallback(5);
+    };
+    crate::host::name(&buffer, || format!("native buffer {start:#x}+{len:#x}"));
+    // SAFETY: a live buffer.
+    let gpu = unsafe { buffer.GetGPUVirtualAddress() };
+    let shadow = Arc::new(Shadow::native(buffer, heap, gpu, start, len));
+    let mut s = state();
+    if !s.buffers.insert(start, end, (resource, shadow.clone())) {
+        // Overlaps a native buffer (an alias of another size): today's path.
+        return fallback(6);
+    }
+    BUFFERS.fetch_add(1, Relaxed);
+    STATS[BUF_NATIVE].fetch_add(1, Relaxed);
+    Some(shadow)
+}
+
+/// The title let go of buffer `resource` at `start`.
+pub(crate) fn released(resource: usize, start: u64) {
+    if BUFFERS.load(Relaxed) == 0 {
+        return;
+    }
+    let mut s = state();
+    if s.buffers.find(start, 1).is_some_and(|(at, (r, _))| at == start && *r == resource) {
+        s.buffers.remove(start);
+        BUFFERS.fetch_sub(1, Relaxed);
+    }
+}
+
+/// An address for a card-only texture of `size` bytes (device 0x3f8).
+pub(crate) fn texture_address(size: u64, align: u64) -> Option<u64> {
+    if !on() {
+        return None;
+    }
+    let mut s = state();
+    if s.textures.is_none() {
+        use windows_sys::Win32::System::Memory::{MEM_RESERVE, PAGE_NOACCESS, VirtualAlloc};
+        const LEN: usize = 64 << 30;
+        // SAFETY: a reservation of our own, never committed.
+        let at = unsafe { VirtualAlloc(std::ptr::null(), LEN, MEM_RESERVE, PAGE_NOACCESS) } as u64;
+        if at == 0 {
+            STATS[TEX_FALLBACK].fetch_add(1, Relaxed);
+            return None;
+        }
+        tracing::warn!(at = format_args!("{at:#x}"), "native: card-only texture addresses reserved");
+        s.textures = Some(Bump::new(at, LEN as u64));
+    }
+    let bump = s.textures.as_mut()?;
+    match bump.take(size, align) {
+        Some(at) => {
+            STATS[TEX_NATIVE].fetch_add(1, Relaxed);
+            STATS[TEX_BYTES].fetch_add(size, Relaxed);
+            Some(at)
+        }
+        None => {
+            STATS[TEX_FALLBACK].fetch_add(1, Relaxed);
+            None
+        }
+    }
+}
+
+fn make_heap(device: &ID3D12Device, bytes: u64) -> Option<ID3D12Heap> {
+    let hdesc = D3D12_HEAP_DESC {
+        SizeInBytes: bytes,
+        Properties: D3D12_HEAP_PROPERTIES { Type: D3D12_HEAP_TYPE_DEFAULT, ..Default::default() },
+        Alignment: 0,
+        // Buffers and textures (pool targets) where the card allows it.
+        Flags: if textures_ok() { D3D12_HEAP_FLAG_NONE } else { D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS },
+    };
+    let mut heap: Option<ID3D12Heap> = None;
+    // SAFETY: plain creation into an out pointer of ours.
+    match unsafe { device.CreateHeap(&raw const hdesc, &raw mut heap) } {
+        Ok(()) => heap,
+        Err(e) => {
+            tracing::warn!(error = %e, bytes, "native: no heap for the RT pool; today's path");
+            None
+        }
+    }
+}
+
+fn make_reserved(device: &ID3D12Device, len: u64) -> Option<ID3D12Resource> {
+    let desc = D3D12_RESOURCE_DESC {
+        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+        Width: len,
+        Height: 1,
+        DepthOrArraySize: 1,
+        MipLevels: 1,
+        SampleDesc: windows::Win32::Graphics::Dxgi::Common::DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+        Flags: D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+        ..Default::default()
+    };
+    let mut buffer: Option<ID3D12Resource> = None;
+    // SAFETY: plain creation into an out pointer of ours.
+    match unsafe { device.CreateReservedResource(&raw const desc, D3D12_RESOURCE_STATE_COMMON, None, &raw mut buffer) } {
+        Ok(()) => buffer,
+        Err(e) => {
+            tracing::warn!(error = %e, len, "native: no reserved buffer for an RT pool window");
+            None
+        }
+    }
+}
+
+/// A heap of `heap_bytes` and a buffer of `len` bytes over it: placed, or
+/// reserved (its tiles mapped later).
+fn heap_and_buffer(device: &ID3D12Device, heap_bytes: u64, len: u64, reserved: bool) -> Option<(ID3D12Heap, ID3D12Resource)> {
+    let hdesc = D3D12_HEAP_DESC {
+        SizeInBytes: heap_bytes,
+        Properties: D3D12_HEAP_PROPERTIES { Type: D3D12_HEAP_TYPE_DEFAULT, ..Default::default() },
+        Alignment: 0,
+        Flags: D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS,
+    };
+    let desc = D3D12_RESOURCE_DESC {
+        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+        Width: len,
+        Height: 1,
+        DepthOrArraySize: 1,
+        MipLevels: 1,
+        SampleDesc: windows::Win32::Graphics::Dxgi::Common::DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+        Flags: D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+        ..Default::default()
+    };
+    let mut heap: Option<ID3D12Heap> = None;
+    let mut buffer: Option<ID3D12Resource> = None;
+    // SAFETY: plain creations into out pointers of ours.
+    let made = unsafe {
+        device.CreateHeap(&raw const hdesc, &raw mut heap).and_then(|()| {
+            if reserved {
+                device.CreateReservedResource(&raw const desc, D3D12_RESOURCE_STATE_COMMON, None, &raw mut buffer)
+            } else {
+                let h = heap.as_ref().ok_or_else(windows::core::Error::empty)?;
+                device.CreatePlacedResource(h, 0, &raw const desc, D3D12_RESOURCE_STATE_COMMON, None, &raw mut buffer)
+            }
+        })
+    };
+    match made {
+        Ok(()) => Some((heap?, buffer?)),
+        Err(e) => {
+            tracing::warn!(error = %e, heap_bytes, len, reserved, "native: no heap or buffer; today's path");
+            None
+        }
+    }
+}
+
+/// Before a submission, on its queue: makes the pool on the card once its
+/// span is known, and applies the title's page maps since the last one as
+/// tile mappings.
+pub(crate) fn flush(device: &ID3D12Device, queue: &ID3D12CommandQueue) {
+    if !on() {
+        return;
+    }
+    let mut s = state();
+    line(&mut s);
+    if s.rt_failed {
+        return;
+    }
+    let mut pool = super::pool();
+    let Some(p) = pool.as_mut() else { return };
+    if p.mapped_len() == 0 && s.heap.is_none() {
+        return;
+    }
+    let updates: Vec<super::pool::Update> = if s.heap.is_none() {
+        let heap_bytes = p.tiles() as u64 * 0x1_0000;
+        let Some(heap) = make_heap(device, heap_bytes) else {
+            s.rt_failed = true;
+            STATS[NOT_MADE].fetch_add(1, Relaxed);
+            return;
+        };
+        tracing::warn!(tiles = p.tiles(), "native: the RT pool's heap is on the card");
+        s.heap = Some(heap);
+        let _ = p.take_updates();
+        p.mapped().map(|(at, tile)| super::pool::Update { at, tile: Some(tile) }).collect()
+    } else {
+        p.take_updates()
+    };
+    drop(pool);
+    if updates.is_empty() {
+        let heap = s.heap.clone().expect("made above");
+        textures_flush(&mut s, queue, &heap, &[]);
+        return;
+    }
+    let heap = s.heap.clone().expect("made above");
+    let changed: Vec<u64> = updates.iter().map(|u| u.at as u64).collect();
+    let mut by_window: std::collections::BTreeMap<u64, Vec<super::pool::Update>> = std::collections::BTreeMap::new();
+    for u in updates {
+        by_window.entry(u.at as u64 & !(WINDOW - 1)).or_default().push(u);
+    }
+    for (base, updates) in by_window {
+        if !s.windows.contains_key(&base) {
+            if updates.iter().all(|u| u.tile.is_none()) {
+                continue;
+            }
+            let Some(buffer) = make_reserved(device, WINDOW) else { continue };
+            crate::host::name(&buffer, || format!("native RT window {base:#x}"));
+            // SAFETY: a live buffer.
+            let gpu = unsafe { buffer.GetGPUVirtualAddress() };
+            let shadow = Arc::new(Shadow::native(buffer.clone(), heap.clone(), gpu, base, WINDOW));
+            s.windows.insert(base, RtWindow { buffer, shadow, live: std::sync::atomic::AtomicBool::new(false), stale: true });
+            let n = WINDOWS.fetch_add(1, Relaxed) + 1;
+            tracing::warn!(base = format_args!("{base:#x}"), windows = n, "native: an RT pool window is on the card");
+        }
+        let w = s.windows.get_mut(&base).expect("made above");
+        if !w.live.load(Relaxed) {
+            w.stale = true;
+            continue;
+        }
+        if w.stale {
+            continue; // mapped whole below
+        }
+        map_tiles(queue, &w.buffer, &heap, base, &updates);
+    }
+    // Windows that went live behind the title's maps: all their pages now.
+    let stale: Vec<u64> = s.windows.iter().filter(|(_, w)| w.stale && w.live.load(Relaxed)).map(|(&b, _)| b).collect();
+    if !stale.is_empty() {
+        let all: Vec<super::pool::Update> = super::pool()
+            .as_ref()
+            .map(|p| p.mapped().map(|(at, tile)| super::pool::Update { at, tile: Some(tile) }).collect())
+            .unwrap_or_default();
+        for base in stale {
+            let w = s.windows.get_mut(&base).expect("listed");
+            w.stale = false;
+            let mine: Vec<_> = all.iter().filter(|u| u.at as u64 & !(WINDOW - 1) == base).map(|u| super::pool::Update { at: u.at, tile: u.tile }).collect();
+            if !mine.is_empty() {
+                map_tiles(queue, &w.buffer, &heap, base, &mine);
+            }
+        }
+    }
+    textures_flush(&mut s, queue, &heap, &changed);
+}
+
+/// Pool textures: new ones mapped whole, live ones whose pages the title
+/// mapped again given those pages' tiles. One call per texture.
+fn textures_flush(s: &mut State, queue: &ID3D12CommandQueue, heap: &ID3D12Heap, changed: &[u64]) {
+    s.pool_textures.retain(|t| crate::host::references(&t.texture) > 1);
+    if s.pool_textures.is_empty() {
+        return;
+    }
+    let pool = super::pool();
+    let Some(p) = pool.as_ref() else { return };
+    for t in &mut s.pool_textures {
+        let end = t.start + u64::from(t.tiles) * 0x1_0000;
+        let pages: Vec<u32> = if t.mapped {
+            changed.iter().filter(|&&a| a >= t.start && a < end).map(|&a| ((a - t.start) >> 16) as u32).collect()
+        } else {
+            (0..t.tiles).collect()
+        };
+        if pages.is_empty() {
+            continue;
+        }
+        t.mapped = true;
+        let coords: Vec<D3D12_TILED_RESOURCE_COORDINATE> = pages
+            .iter()
+            .map(|&i| D3D12_TILED_RESOURCE_COORDINATE { X: i, Y: 0, Z: 0, Subresource: 0 })
+            .collect();
+        let tiles: Vec<Option<u32>> = pages.iter().map(|&i| p.lookup((t.start + u64::from(i) * 0x1_0000) as usize).map(|(tile, _)| tile)).collect();
+        // Region i: tile i of the resource counted across subresources
+        // (D3D12 numbers a reserved resource's tiles in subresource order
+        // when a region does not use a box).
+        let sizes = vec![D3D12_TILE_REGION_SIZE { NumTiles: 1, ..Default::default() }; pages.len()];
+        let flags: Vec<D3D12_TILE_RANGE_FLAGS> =
+            tiles.iter().map(|t| if t.is_some() { D3D12_TILE_RANGE_FLAG_NONE } else { D3D12_TILE_RANGE_FLAG_NULL }).collect();
+        let starts: Vec<u32> = tiles.iter().map(|t| t.unwrap_or(0)).collect();
+        let counts = vec![1u32; pages.len()];
+        // SAFETY: a live reserved texture and heap of ours; arrays of one
+        // length that live through the call; tile indices inside the heap.
+        unsafe {
+            queue.UpdateTileMappings(
+                &t.texture,
+                coords.len() as u32,
+                Some(coords.as_ptr()),
+                Some(sizes.as_ptr()),
+                heap,
+                starts.len() as u32,
+                Some(flags.as_ptr()),
+                Some(starts.as_ptr()),
+                Some(counts.as_ptr()),
+                D3D12_TILE_MAPPING_FLAG_NONE,
+            );
+        }
+        STATS[TILE_CALLS].fetch_add(1, Relaxed);
+        STATS[TILE_UPDATES].fetch_add(pages.len() as u64, Relaxed);
+    }
+}
+
+/// Whether a target texture's memory `[start, start + bytes)` is all pool
+/// pages, the pool is on the card in a heap textures may use: it is then
+/// made reserved ([`texture_on_pool`]).
+pub(crate) fn texture_wants_pool(start: u64, bytes: u64) -> bool {
+    if !on() || bytes == 0 || !textures_ok() {
+        return false;
+    }
+    let covered = super::pool().as_ref().is_some_and(|p| p.covers(start as usize, bytes as usize));
+    if covered {
+        STATS[TEX_POOL_ASKED].fetch_add(1, Relaxed);
+    }
+    covered && state().heap.is_some()
+}
+
+/// `texture` (reserved) shows the pool pages at `start`: its tiles are
+/// mapped at the next submission. False if its tiles do not fit the
+/// title's memory (`bytes`): the caller makes it as before.
+pub(crate) fn texture_on_pool(texture: &ID3D12Resource, start: u64, bytes: u64) -> bool {
+    let Some(host) = crate::host::host() else { return false };
+    let mut total = 0u32;
+    // SAFETY: a live reserved texture; only the total is asked for.
+    unsafe { host.device.GetResourceTiling(texture, Some(&raw mut total), None, None, None, 0, std::ptr::null_mut()) };
+    if total == 0 || u64::from(total) * 0x1_0000 > bytes.next_multiple_of(0x1_0000) {
+        STATS[TEX_POOL_FALLBACK].fetch_add(1, Relaxed);
+        return false;
+    }
+    state().pool_textures.push(RtTexture { texture: texture.clone(), start, tiles: total, mapped: false });
+    STATS[TEX_POOL].fetch_add(1, Relaxed);
+    true
+}
+
+/// Whether the card lets one heap hold buffers and textures (resource heap
+/// tier 2): pool textures need it.
+fn textures_ok() -> bool {
+    static OK: OnceLock<bool> = OnceLock::new();
+    *OK.get_or_init(|| {
+        let Some(host) = crate::host::host() else { return false };
+        let mut o = D3D12_FEATURE_DATA_D3D12_OPTIONS::default();
+        // SAFETY: a plain query into a struct of its own size.
+        let ok = unsafe { host.device.CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS, (&raw mut o).cast(), size_of_val(&o) as u32) }.is_ok()
+            && o.ResourceHeapTier.0 >= D3D12_RESOURCE_HEAP_TIER_2.0
+            && o.TiledResourcesTier.0 >= D3D12_TILED_RESOURCES_TIER_2.0;
+        tracing::warn!(ok, "native: pool textures (resource heap tier 2, tiled resources tier 2)");
+        ok
+    })
+}
+
+fn map_tiles(queue: &ID3D12CommandQueue, buffer: &ID3D12Resource, heap: &ID3D12Heap, rt_start: u64, updates: &[super::pool::Update]) {
+    let coords: Vec<D3D12_TILED_RESOURCE_COORDINATE> = updates
+        .iter()
+        .map(|u| D3D12_TILED_RESOURCE_COORDINATE { X: ((u.at as u64 - rt_start) >> 16) as u32, Y: 0, Z: 0, Subresource: 0 })
+        .collect();
+    let sizes = vec![D3D12_TILE_REGION_SIZE { NumTiles: 1, ..Default::default() }; updates.len()];
+    let flags: Vec<D3D12_TILE_RANGE_FLAGS> =
+        updates.iter().map(|u| if u.tile.is_some() { D3D12_TILE_RANGE_FLAG_NONE } else { D3D12_TILE_RANGE_FLAG_NULL }).collect();
+    let starts: Vec<u32> = updates.iter().map(|u| u.tile.unwrap_or(0)).collect();
+    let counts = vec![1u32; updates.len()];
+    // SAFETY: a live reserved buffer and heap of ours; `n` regions of one
+    // tile each and `n` ranges of one tile each, in arrays that live through
+    // the call; every tile index is inside the heap (the pool's size).
+    unsafe {
+        queue.UpdateTileMappings(
+            buffer,
+            coords.len() as u32,
+            Some(coords.as_ptr()),
+            Some(sizes.as_ptr()),
+            heap,
+            starts.len() as u32,
+            Some(flags.as_ptr()),
+            Some(starts.as_ptr()),
+            Some(counts.as_ptr()),
+            D3D12_TILE_MAPPING_FLAG_NONE,
+        );
+    }
+    STATS[TILE_UPDATES].fetch_add(updates.len() as u64, Relaxed);
+    STATS[TILE_CALLS].fetch_add(1, Relaxed);
+}
+
+fn line(s: &mut State) {
+    let now = std::time::Instant::now();
+    if s.last_line.is_some_and(|t| now - t < std::time::Duration::from_secs(5)) {
+        return;
+    }
+    s.last_line = Some(now);
+    let parts: Vec<String> = NAMES.iter().zip(&STATS).map(|(n, v)| format!("{n} {}", v.load(Relaxed))).collect();
+    tracing::warn!(
+        "native gpumem: {}; native buffers {}, demoted ranges {}; buffer fallbacks by reason: {}",
+        parts.join(", "),
+        s.buffers.len(),
+        s.demoted.len(),
+        WHY_NAMES.iter().zip(&WHY).map(|(n, v)| format!("{n} {}", v.load(Relaxed))).collect::<Vec<_>>().join(", ")
+    );
+}
+
+/// A buffer copy or `CopyMemoryToMemoryX` of `len` bytes from `src` to
+/// `dst` (title addresses): if either side is native, it is recorded on
+/// the card here (the other side's host copy refreshed first, or its
+/// shader-written range declared) and true is returned; otherwise false
+/// (today's copy at submission).
+pub(crate) fn copy_on_card(list: &crate::host::HostList, dst: u64, src: u64, len: u64) -> bool {
+    if !on() || len == 0 || (WINDOWS.load(Relaxed) == 0 && BUFFERS.load(Relaxed) == 0) {
+        return false;
+    }
+    let (to_native, from_native) = (find(dst, len), find(src, len));
+    if to_native.is_none() && from_native.is_none() {
+        return false;
+    }
+    let to = to_native.or_else(|| crate::shadow::find(dst, len));
+    let from = from_native.or_else(|| crate::shadow::find(src, len));
+    let (Some(to), Some(from)) = (to, from) else {
+        // A side with no host side at all: nothing exact to do.
+        STATS[COPY_FALLBACK].fetch_add(1, Relaxed);
+        return true;
+    };
+    if to.left(dst) < len || from.left(src) < len {
+        STATS[COPY_FALLBACK].fetch_add(1, Relaxed);
+        return true;
+    }
+    from.refresh(list, src, len);
+    to.gpu_writes(list, dst, len);
+    // SAFETY: an open list; both buffers live (the list holds the copies
+    // through `refresh`/`gpu_writes`; native ones live in the table).
+    unsafe { list.list.CopyBufferRegion(&to.buffer, to.offset(dst), &from.buffer, from.offset(src), len) };
+    STATS[COPIES].fetch_add(1, Relaxed);
+    true
+}
diff --git a/crates/victory-gpu/src/native/mod.rs b/crates/victory-gpu/src/native/mod.rs
new file mode 100644
index 0000000..11bbece
--- /dev/null
+++ b/crates/victory-gpu/src/native/mod.rs
@@ -0,0 +1,158 @@
+//! Native GPU memory (NATIVE-BOUNDARY.md §4, milestone 1).
+//!
+//! - [`pool`]: the render-target pool's pages as tiles.
+//! - [`probe`]: `VICTORY_NATIVE_PROBE=1`, counts CPU touches of the ranges
+//!   milestone 1 moves onto the card.
+
+pub mod pool;
+#[cfg(windows)]
+pub(crate) mod gpumem;
+#[cfg(windows)]
+pub(crate) mod buffers;
+pub mod table;
+#[cfg(windows)]
+pub mod probe;
+
+use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+use std::sync::{Mutex, MutexGuard};
+
+/// The render-target pool, once the title allocated it.
+static POOL: Mutex<Option<pool::Pool>> = Mutex::new(None);
+/// Its section (the physical pages' handle), read without the lock; 0: none.
+static POOL_SECTION: AtomicUsize = AtomicUsize::new(0);
+
+pub(crate) fn pool() -> MutexGuard<'static, Option<pool::Pool>> {
+    POOL.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// The pool's size in bytes (`VICTORY_NATIVE_RTPOOL_BYTES` overrides).
+fn pool_bytes() -> usize {
+    static B: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *B.get_or_init(|| {
+        std::env::var("VICTORY_NATIVE_RTPOOL_BYTES")
+            .ok()
+            .and_then(|v| {
+                let v = v.trim();
+                v.strip_prefix("0x").map_or_else(|| v.parse().ok(), |h| usize::from_str_radix(h, 16).ok())
+            })
+            .unwrap_or(pool::DEFAULT_BYTES)
+    })
+}
+
+/// Whether anything here needs the page mappings.
+pub fn tracking() -> bool {
+    #[cfg(windows)]
+    if probe::on() {
+        return true;
+    }
+    gpumem()
+}
+
+/// `VICTORY_NATIVE_GPUMEM=1` (off by default, boot only): milestone 1.
+pub fn gpumem() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = victory_core::mem2::switch("VICTORY_NATIVE_GPUMEM");
+        if on {
+            tracing::warn!("VICTORY_NATIVE_GPUMEM: GPU-only resources live in D3D12 memory");
+        }
+        on
+    })
+}
+
+/// `XMemAllocatePhysicalPages` gave `n` pages, one section (`section`,
+/// its handle): the render-target pool if its size matches.
+pub fn physical_pages(section: usize, n: usize) {
+    if !tracking() {
+        return;
+    }
+    let bytes = n * pool::PAGE;
+    if bytes != pool_bytes() {
+        tracing::debug!(n, bytes, "native: physical pages, not the RT pool");
+        return;
+    }
+    let mut p = pool();
+    if p.is_some() {
+        tracing::warn!(n, "native: a second batch the RT pool's size, ignored");
+        return;
+    }
+    *p = Some(pool::Pool::new(0, 1, n));
+    POOL_SECTION.store(section, Relaxed);
+    tracing::info!(n, "native: the RT pool's physical pages");
+}
+
+/// `[at, at + len)` shows the section's pages from `index` on.
+pub fn shown(at: usize, len: usize, section: usize, index: usize) {
+    let pool_section = POOL_SECTION.load(Relaxed);
+    if pool_section == 0 {
+        return;
+    }
+    let first = {
+        let mut g = pool();
+        let Some(p) = g.as_mut() else { return };
+        let first = p.mapped_len() == 0 && section == pool_section;
+        for k in 0..len / pool::PAGE {
+            let a = at + k * pool::PAGE;
+            if section == pool_section {
+                p.map(a, index + k);
+            } else if p.lookup(a).is_some() {
+                p.unmap(a, 1);
+            }
+        }
+        first
+    };
+    // (Not under the pool's lock: the native side takes its own first.)
+    #[cfg(windows)]
+    if first {
+        gpumem::pool_page_at(at as u64);
+    }
+    let _ = first;
+}
+
+/// `[at, at + len)` shows nothing now.
+pub fn unmapped(at: usize, len: usize) {
+    if POOL_SECTION.load(Relaxed) == 0 {
+        return;
+    }
+    if let Some(p) = pool().as_mut() {
+        p.unmap(at, len.div_ceil(pool::PAGE));
+    }
+}
+
+/// Which probed kind `at` is in.
+pub(crate) fn kind_of(at: usize) -> Option<usize> {
+    #[cfg(windows)]
+    {
+        if pool().as_ref().is_some_and(|p| p.lookup(at).is_some()) {
+            return Some(probe::RT);
+        }
+        if crate::watch::gpu_only_ranges().iter().any(|&(a, b)| (a..b).contains(&at)) {
+            return Some(probe::GPU_ONLY);
+        }
+        if crate::resource::page_pool_ranges().iter().any(|&(a, b)| (a..b).contains(&(at as u64))) {
+            return Some(probe::PAGE_POOL);
+        }
+    }
+    let _ = at;
+    None
+}
+
+/// The probed ranges: mapped RT-pool pages joined into runs, GPU-only
+/// reservations, page pools.
+#[cfg(windows)]
+pub(crate) fn probe_ranges() -> Vec<(usize, usize, usize)> {
+    let mut out: Vec<(usize, usize, usize)> = Vec::new();
+    if let Some(p) = pool().as_ref() {
+        for (a, _) in p.mapped() {
+            match out.last_mut() {
+                Some(l) if l.1 == a => l.1 = a + pool::PAGE,
+                _ => out.push((a, a + pool::PAGE, probe::RT)),
+            }
+        }
+    }
+    out.extend(crate::watch::gpu_only_ranges().into_iter().map(|(a, b)| (a, b, probe::GPU_ONLY)));
+    out.extend(
+        crate::resource::page_pool_ranges().into_iter().map(|(a, b)| (a as usize, b as usize, probe::PAGE_POOL)),
+    );
+    out
+}
diff --git a/crates/victory-gpu/src/native/pool.rs b/crates/victory-gpu/src/native/pool.rs
new file mode 100644
index 0000000..b26918f
--- /dev/null
+++ b/crates/victory-gpu/src/native/pool.rs
@@ -0,0 +1,182 @@
+//! The render-target pool's page bookkeeping (NATIVE-BOUNDARY §4 #1-#3).
+//!
+//! The title allocates the pool as one batch of physical pages
+//! (`XMemAllocatePhysicalPages`, 0xDC00000 bytes) and maps them one page per
+//! call into its own reservation. Here each pool page is a tile index (its
+//! position in the batch), and each mapped address remembers its tile, so
+//! a reserved D3D12 resource the size of the pool can show the same bytes
+//! at the same addresses: an address maps to a tile, a tile's contents live
+//! on the card only. Updates are queued for the next submission
+//! ([`Pool::take_updates`]), in the title's order.
+
+use std::collections::BTreeMap;
+
+/// 64 KiB, the pool's page and D3D12's tile.
+pub const PAGE: usize = 0x1_0000;
+/// The pool's size the title asks for (`PhysPool_Init`).
+pub const DEFAULT_BYTES: usize = 0xDC0_0000;
+
+/// One queued tile-mapping change: the title address's page now shows
+/// `tile`, or nothing.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct Update {
+    pub at: usize,
+    pub tile: Option<u32>,
+}
+
+#[derive(Default)]
+pub struct Pool {
+    /// First page number of the batch and the step between numbers (page
+    /// numbers count 4 KiB frames).
+    first: usize,
+    step: usize,
+    tiles: usize,
+    /// Mapped title page address → tile.
+    at: BTreeMap<usize, u32>,
+    /// Tile → how many addresses show it (the title aliases transient
+    /// targets: two addresses may show one page).
+    shown: Vec<u16>,
+    pending: Vec<Update>,
+    /// Since the start: maps, unmaps, maps of a page outside the pool.
+    pub counts: [u64; 3],
+}
+
+impl Pool {
+    pub fn new(first: usize, step: usize, tiles: usize) -> Self {
+        Self { first, step: step.max(1), tiles, shown: vec![0; tiles], ..Self::default() }
+    }
+
+    pub fn tiles(&self) -> usize {
+        self.tiles
+    }
+
+    /// The tile of page number `page`, if it is one of the pool's.
+    pub fn tile_of(&self, page: usize) -> Option<u32> {
+        let d = page.checked_sub(self.first)?;
+        (d % self.step == 0 && d / self.step < self.tiles).then(|| (d / self.step) as u32)
+    }
+
+    /// `page` (a page number) mapped at `at` (64 KiB aligned). False if it
+    /// is not a pool page (an address that showed a pool page shows none
+    /// then).
+    pub fn map(&mut self, at: usize, page: usize) -> bool {
+        let at = at & !(PAGE - 1);
+        let Some(tile) = self.tile_of(page) else {
+            self.unmap(at, 1);
+            self.counts[2] += 1;
+            return false;
+        };
+        if let Some(old) = self.at.insert(at, tile) {
+            self.shown[old as usize] -= 1;
+        }
+        self.shown[tile as usize] += 1;
+        self.pending.push(Update { at, tile: Some(tile) });
+        self.counts[0] += 1;
+        true
+    }
+
+    /// `n` pages from `at` show nothing now.
+    pub fn unmap(&mut self, at: usize, n: usize) {
+        let at = at & !(PAGE - 1);
+        for k in 0..n {
+            let a = at + k * PAGE;
+            if let Some(old) = self.at.remove(&a) {
+                self.shown[old as usize] -= 1;
+                self.pending.push(Update { at: a, tile: None });
+                self.counts[1] += 1;
+            }
+        }
+    }
+
+    /// The tile and the offset in it of title address `va`.
+    pub fn lookup(&self, va: usize) -> Option<(u32, usize)> {
+        self.at.get(&(va & !(PAGE - 1))).map(|&t| (t, va & (PAGE - 1)))
+    }
+
+    /// Whether `[va, va + len)` is mapped to pool pages throughout.
+    pub fn covers(&self, va: usize, len: usize) -> bool {
+        len > 0 && (va & !(PAGE - 1)..va + len).step_by(PAGE).all(|p| self.at.contains_key(&p))
+    }
+
+    /// Mapped addresses, in order.
+    pub fn mapped(&self) -> impl Iterator<Item = (usize, u32)> + '_ {
+        self.at.iter().map(|(&a, &t)| (a, t))
+    }
+
+    pub fn mapped_len(&self) -> usize {
+        self.at.len()
+    }
+
+    /// How many addresses show `tile`.
+    pub fn aliases(&self, tile: u32) -> u16 {
+        self.shown.get(tile as usize).copied().unwrap_or(0)
+    }
+
+    /// The queued changes, joined: only the last change of each address
+    /// counts, in the order of first change.
+    pub fn take_updates(&mut self) -> Vec<Update> {
+        let mut last: BTreeMap<usize, (usize, Option<u32>)> = BTreeMap::new();
+        for (i, u) in self.pending.drain(..).enumerate() {
+            let e = last.entry(u.at).or_insert((i, u.tile));
+            e.1 = u.tile;
+        }
+        let mut out: Vec<(usize, Update)> = last.into_iter().map(|(at, (i, tile))| (i, Update { at, tile })).collect();
+        out.sort_by_key(|&(i, _)| i);
+        out.into_iter().map(|(_, u)| u).collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const BASE: usize = 0x2_0000_0000;
+
+    #[test]
+    fn pages_are_tiles_in_batch_order() {
+        let p = Pool::new(0x1000, 16, 4);
+        assert_eq!(p.tile_of(0x1000), Some(0));
+        assert_eq!(p.tile_of(0x1030), Some(3));
+        assert_eq!(p.tile_of(0x1040), None, "past the pool");
+        assert_eq!(p.tile_of(0x1008), None, "not a page start");
+        assert_eq!(p.tile_of(0xff0), None);
+    }
+
+    #[test]
+    fn map_remap_unmap_and_alias() {
+        let mut p = Pool::new(0x1000, 16, 4);
+        assert!(p.map(BASE, 0x1010));
+        assert!(p.map(BASE + PAGE, 0x1010), "two addresses, one page");
+        assert_eq!(p.aliases(1), 2);
+        assert_eq!(p.lookup(BASE + 0x123), Some((1, 0x123)));
+        assert!(p.covers(BASE + 10, 2 * PAGE - 20));
+        assert!(!p.covers(BASE, 3 * PAGE));
+        assert!(p.map(BASE, 0x1020), "remap");
+        assert_eq!((p.aliases(1), p.aliases(2)), (1, 1));
+        assert!(!p.map(BASE + PAGE, 0x9999), "not a pool page: unmapped");
+        assert_eq!(p.aliases(1), 0);
+        assert_eq!(p.lookup(BASE + PAGE), None);
+        p.unmap(BASE, 4);
+        assert_eq!(p.mapped_len(), 0);
+        assert_eq!(p.counts, [3, 2, 1]);
+    }
+
+    #[test]
+    fn updates_join_to_the_last_per_address() {
+        let mut p = Pool::new(0, 16, 8);
+        p.map(BASE + PAGE, 16);
+        p.map(BASE, 32);
+        p.map(BASE + PAGE, 48);
+        p.unmap(BASE, 1);
+        p.map(BASE + 2 * PAGE, 0);
+        assert_eq!(
+            p.take_updates(),
+            vec![
+                Update { at: BASE + PAGE, tile: Some(3) },
+                Update { at: BASE, tile: None },
+                Update { at: BASE + 2 * PAGE, tile: Some(0) },
+            ]
+        );
+        assert!(p.take_updates().is_empty());
+    }
+}
diff --git a/crates/victory-gpu/src/native/probe.rs b/crates/victory-gpu/src/native/probe.rs
new file mode 100644
index 0000000..5f81d45
--- /dev/null
+++ b/crates/victory-gpu/src/native/probe.rs
@@ -0,0 +1,299 @@
+//! `VICTORY_NATIVE_PROBE=1` (diagnostic, off by default): counts CPU reads
+//! and writes of the memory milestone 1 would move onto the card
+//! (NATIVE-BOUNDARY §5 questions 1 and 2): the render-target pool's mapped
+//! pages, the GPU-only reservations (protection 0x801) and the registered
+//! page pools (device 0x250), outside the read-back ring.
+//!
+//! Every 5 s a thread arms each mapped page of those ranges once
+//! (`PAGE_NOACCESS`, its protection remembered); the first touch faults
+//! here, is counted (read or write, by the title's code or by a host
+//! module, by range kind) and the page gets its protection back. Pages
+//! the lazy remap table shows without a view (`VICTORY_REMAP_LAZY`) are
+//! counted where that handler makes a view on a touch instead. The counts
+//! are logged at each tick, then the pages are armed again.
+//!
+//! Pages are armed only once the world runs (60 frames in a row of 1,500
+//! draws or more; boot loads through kernel reads and writes the arming
+//! would fail, and run C4N-PROBE stalled on the loading screen). The
+//! runtime's own kernel reads and writes ([`release`], from
+//! `crate::host` reads and `crate::watch::writing`) give armed pages their
+//! access back first and count as host touches.
+//!
+//! shortcut: "title code" is a faulting instruction outside every module
+//! the system loader knows (the title's image is mapped by hand); a page
+//! the runtime re-protects meanwhile (its write guards) may lose its arming
+//! until the next tick, so counts are a floor.
+
+use std::collections::HashMap;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+use super::pool::PAGE;
+
+/// Range kinds.
+pub const RT: usize = 0;
+pub const GPU_ONLY: usize = 1;
+pub const PAGE_POOL: usize = 2;
+const KINDS: [&str; 3] = ["rt-pool", "gpu-only", "page-pool"];
+
+/// [kind][title, host][read, write]
+static COUNTS: [[[AtomicU64; 2]; 2]; 3] = [const { [const { [const { AtomicU64::new(0) }; 2] }; 2] }; 3];
+/// Touches inside the read-back ring (not counted above), lazy views made,
+/// pages armed at the last tick, ticks.
+static OTHER: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+/// Armed page → (protection to give back, kind).
+static ARMED: Mutex<Option<HashMap<usize, (u32, u8)>>> = Mutex::new(None);
+/// Title instruction addresses that touched, with counts (first 64).
+static SITES: Mutex<Vec<(u64, u8, u64)>> = Mutex::new(Vec::new());
+
+pub fn on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = victory_core::mem2::switch("VICTORY_NATIVE_PROBE");
+        if on {
+            tracing::warn!("VICTORY_NATIVE_PROBE: CPU touches of the RT pool, GPU-only and page-pool ranges are counted");
+            start();
+        }
+        on
+    })
+}
+
+fn armed() -> std::sync::MutexGuard<'static, Option<HashMap<usize, (u32, u8)>>> {
+    ARMED.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// Whether `rip` lies in a module the system loader knows.
+fn host_code(rip: u64) -> bool {
+    use windows_sys::Win32::System::LibraryLoader::{
+        GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, GetModuleHandleExW,
+    };
+    let mut m = std::ptr::null_mut();
+    // SAFETY: a lookup by address; no reference is taken.
+    unsafe {
+        GetModuleHandleExW(
+            GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            rip as usize as *const u16,
+            &mut m,
+        ) != 0
+    }
+}
+
+/// Counts one touch of `at` (`access`: 0 read, 1 write, 8 execute).
+fn count(at: usize, kind: usize, access: usize, rip: u64) {
+    if crate::readback::tagged_in(at as u64, 1) {
+        OTHER[0].fetch_add(1, Relaxed);
+        return;
+    }
+    let host = host_code(rip);
+    let w = usize::from(access == 1);
+    COUNTS[kind][usize::from(host)][w].fetch_add(1, Relaxed);
+    if !host {
+        let mut s = SITES.lock().unwrap_or_else(|e| e.into_inner());
+        if let Some(e) = s.iter_mut().find(|e| e.0 == rip && e.1 == kind as u8) {
+            e.2 += 1;
+        } else if s.len() < 64 {
+            s.push((rip, kind as u8, 1));
+        }
+    }
+}
+
+/// Frames in a row with 1,500 draws or more; the world runs at 60.
+static WORLD_FRAMES: AtomicU64 = AtomicU64::new(0);
+
+/// Whether the world runs (60 frames in a row of 1,500 draws or more).
+pub(crate) fn world() -> bool {
+    WORLD_FRAMES.load(Relaxed) >= 60
+}
+
+/// Presents since the start.
+static FRAMES: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) fn frames() -> u64 {
+    FRAMES.load(Relaxed)
+}
+
+/// At each present: `drawn` draws since the start.
+pub(crate) fn frame_drew(drawn: u64) {
+    static LAST: AtomicU64 = AtomicU64::new(0);
+    let before = LAST.swap(drawn, Relaxed);
+    FRAMES.fetch_add(1, Relaxed);
+    if WORLD_FRAMES.load(Relaxed) >= 60 {
+        return;
+    }
+    if drawn.saturating_sub(before) >= 1500 {
+        if WORLD_FRAMES.fetch_add(1, Relaxed) + 1 == 60 && on() {
+            tracing::warn!("native probe: the world runs; arming from the next tick");
+        }
+    } else {
+        WORLD_FRAMES.store(0, Relaxed);
+    }
+}
+
+/// The runtime is about to read or write `[at, at + len)` itself (through
+/// the kernel, which an armed page would fail): armed pages there get
+/// their access back, counted as host touches.
+pub(crate) fn release(at: usize, len: usize, write: bool) {
+    if len == 0 || WORLD_FRAMES.load(Relaxed) < 60 || !on() {
+        return;
+    }
+    use windows_sys::Win32::System::Memory::VirtualProtect;
+    let mut g = armed();
+    let Some(a) = g.as_mut() else { return };
+    if a.is_empty() {
+        return;
+    }
+    let mut page = at & !(PAGE - 1);
+    while page < at + len {
+        if let Some((protect, kind)) = a.remove(&page) {
+            let mut old = 0;
+            // SAFETY: a page this probe took the access of.
+            unsafe { VirtualProtect(page as *const _, PAGE, protect, &mut old) };
+            COUNTS[kind as usize][1][usize::from(write)].fetch_add(1, Relaxed);
+        }
+        page += PAGE;
+    }
+}
+
+/// The lazy remap handler made a view of `at` on a touch.
+pub(crate) fn lazy_touch(at: usize, access: usize, rip: u64) {
+    // Only the title's own code demotes: the runtime's lazy views, refreshes
+    // and detiling touched 1,931 pages in a run the probe counted no title
+    // touch in.
+    if super::gpumem() && !host_code(rip) {
+        super::gpumem::touched(at);
+    }
+    if !on() {
+        return;
+    }
+    OTHER[1].fetch_add(1, Relaxed);
+    if let Some(kind) = super::kind_of(at) {
+        count(at, kind, access, rip);
+    }
+}
+
+unsafe extern "system" fn on_fault(info: *mut windows_sys::Win32::System::Diagnostics::Debug::EXCEPTION_POINTERS) -> i32 {
+    use windows_sys::Win32::Foundation::{EXCEPTION_ACCESS_VIOLATION, NTSTATUS};
+    use windows_sys::Win32::System::Diagnostics::Debug::{EXCEPTION_CONTINUE_EXECUTION, EXCEPTION_CONTINUE_SEARCH};
+    use windows_sys::Win32::System::Memory::VirtualProtect;
+    // SAFETY: the system passes the exception being dispatched.
+    let (r, rip) = unsafe { (&*(*info).ExceptionRecord, (*(*info).ContextRecord).Rip) };
+    if r.ExceptionCode != EXCEPTION_ACCESS_VIOLATION as NTSTATUS || r.NumberParameters < 2 {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    let at = r.ExceptionInformation[1];
+    let page = at & !(PAGE - 1);
+    let Some((protect, kind)) = armed().as_mut().and_then(|a| a.remove(&page)) else {
+        return EXCEPTION_CONTINUE_SEARCH;
+    };
+    let mut old = 0;
+    // SAFETY: a page this probe took the access of; it gets it back.
+    unsafe { VirtualProtect(page as *const _, PAGE, protect, &mut old) };
+    count(at, kind as usize, r.ExceptionInformation[0], rip);
+    EXCEPTION_CONTINUE_EXECUTION
+}
+
+/// Puts the handler first (again: handlers added later go ahead of it).
+fn install(handle: &mut usize) {
+    use windows_sys::Win32::System::Diagnostics::Debug::{AddVectoredExceptionHandler, RemoveVectoredExceptionHandler};
+    // SAFETY: a handler that lives as long as the process; the old
+    // registration is this one's.
+    unsafe {
+        if *handle != 0 {
+            RemoveVectoredExceptionHandler(*handle as *const _);
+        }
+        *handle = AddVectoredExceptionHandler(1, Some(on_fault)) as usize;
+    }
+}
+
+/// Arms the mapped pages of `[from, to)` of `kind` that are readable or
+/// writable now.
+fn arm(from: usize, to: usize, kind: usize, armed: &mut HashMap<usize, (u32, u8)>, n: &mut u64) {
+    use windows_sys::Win32::System::Memory::{
+        MEM_COMMIT, MEMORY_BASIC_INFORMATION, PAGE_GUARD, PAGE_NOACCESS, VirtualProtect, VirtualQuery,
+    };
+    let mut at = from & !(PAGE - 1);
+    while at < to {
+        if armed.contains_key(&at) || crate::readback::tagged_in(at as u64, PAGE as u64) {
+            at += PAGE;
+            continue;
+        }
+        let mut m: MEMORY_BASIC_INFORMATION = unsafe { std::mem::zeroed() };
+        // SAFETY: a query.
+        if unsafe { VirtualQuery(at as *const _, &mut m, size_of::<MEMORY_BASIC_INFORMATION>()) } == 0 {
+            return;
+        }
+        let end = (m.BaseAddress as usize + m.RegionSize).max(at + 1);
+        if m.State != MEM_COMMIT || m.Protect & (PAGE_GUARD | PAGE_NOACCESS) != 0 || m.Protect == 0 {
+            at = end.next_multiple_of(PAGE);
+            continue;
+        }
+        let stop = end.min(to);
+        while at + PAGE <= stop {
+            let mut old = 0;
+            armed.insert(at, (m.Protect, kind as u8));
+            // SAFETY: a mapped page of the title's; the handler gives its
+            // access back on the first touch.
+            if unsafe { VirtualProtect(at as *const _, PAGE, PAGE_NOACCESS, &mut old) } == 0 {
+                armed.remove(&at);
+            } else {
+                *n += 1;
+            }
+            at += PAGE;
+        }
+        at = at.max(end.next_multiple_of(PAGE));
+    }
+}
+
+fn line() {
+    let c = |k: usize, h: usize, w: usize| COUNTS[k][h][w].load(Relaxed);
+    for (k, name) in KINDS.iter().enumerate() {
+        tracing::warn!(
+            "native probe {name}: title reads {} writes {}, host reads {} writes {}",
+            c(k, 0, 0),
+            c(k, 0, 1),
+            c(k, 1, 0),
+            c(k, 1, 1)
+        );
+    }
+    let s = SITES.lock().unwrap_or_else(|e| e.into_inner()).clone();
+    let mut top = s;
+    top.sort_by_key(|e| std::cmp::Reverse(e.2));
+    let sites: Vec<String> = top.iter().take(8).map(|(rip, k, n)| format!("{rip:#x}/{}x{n}", KINDS[*k as usize])).collect();
+    tracing::warn!(
+        "native probe: readback-ring touches {}, lazy views {}, pages armed {}, tick {}, ranges {}, rt pool mapped {} (maps/unmaps/other {:?}), title sites [{}]",
+        OTHER[0].load(Relaxed),
+        OTHER[1].load(Relaxed),
+        OTHER[2].load(Relaxed),
+        OTHER[3].load(Relaxed),
+        super::probe_ranges().len(),
+        super::pool().as_ref().map_or(0, |p| p.mapped_len()),
+        super::pool().as_ref().map_or([0; 3], |p| p.counts),
+        sites.join(" ")
+    );
+}
+
+fn start() {
+    let r = std::thread::Builder::new().name("victory-native-probe".into()).spawn(|| {
+        let mut handle = 0usize;
+        loop {
+            std::thread::sleep(std::time::Duration::from_secs(5));
+            OTHER[3].fetch_add(1, Relaxed);
+            line();
+            if WORLD_FRAMES.load(Relaxed) < 60 {
+                continue;
+            }
+            install(&mut handle);
+            let ranges = super::probe_ranges();
+            let mut n = 0;
+            let mut g = armed();
+            let a = g.get_or_insert_with(HashMap::new);
+            for (from, to, kind) in ranges {
+                arm(from, to, kind, a, &mut n);
+            }
+            OTHER[2].store(a.len() as u64, Relaxed);
+        }
+    });
+    if let Err(e) = r {
+        tracing::warn!(%e, "VICTORY_NATIVE_PROBE: no thread");
+    }
+}
diff --git a/crates/victory-gpu/src/native/table.rs b/crates/victory-gpu/src/native/table.rs
new file mode 100644
index 0000000..5845ebd
--- /dev/null
+++ b/crates/victory-gpu/src/native/table.rs
@@ -0,0 +1,182 @@
+//! The native range table: title address range → what serves it on the
+//! card, and plain range sets (exclusions, demotions). Pure, so tested
+//! without a card.
+
+use std::collections::BTreeMap;
+
+/// Disjoint `[start, end)` ranges, each with a value.
+pub struct Table<T> {
+    at: BTreeMap<u64, (u64, T)>,
+}
+
+impl<T> Default for Table<T> {
+    fn default() -> Self {
+        Self { at: BTreeMap::new() }
+    }
+}
+
+impl<T> Table<T> {
+    pub const fn new() -> Self {
+        Self { at: BTreeMap::new() }
+    }
+
+    /// Adds `[start, end)`; false (nothing added) if it is empty or
+    /// overlaps an entry.
+    pub fn insert(&mut self, start: u64, end: u64, value: T) -> bool {
+        if start >= end || self.overlaps(start, end) {
+            return false;
+        }
+        self.at.insert(start, (end, value));
+        true
+    }
+
+    pub fn remove(&mut self, start: u64) -> Option<T> {
+        self.at.remove(&start).map(|(_, v)| v)
+    }
+
+    /// The entry holding all of `[address, address + len)` (`len` 0 counts
+    /// as 1): its start and value.
+    pub fn find(&self, address: u64, len: u64) -> Option<(u64, &T)> {
+        let end = address.checked_add(len.max(1))?;
+        let (&start, (e, v)) = self.at.range(..=address).next_back()?;
+        (end <= *e).then_some((start, v))
+    }
+
+    /// Whether any entry meets `[start, end)`.
+    pub fn overlaps(&self, start: u64, end: u64) -> bool {
+        self.at.range(..end).next_back().is_some_and(|(_, (e, _))| *e > start)
+    }
+
+    pub fn len(&self) -> usize {
+        self.at.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.at.is_empty()
+    }
+}
+
+/// A set of ranges that may overlap as added; asked only whether they meet
+/// a range.
+#[derive(Default, Clone, Debug, PartialEq, Eq)]
+pub struct Ranges(Vec<(u64, u64)>);
+
+impl Ranges {
+    pub const fn new() -> Self {
+        Self(Vec::new())
+    }
+
+    pub fn add(&mut self, start: u64, end: u64) {
+        if start < end {
+            self.0.push((start, end));
+        }
+    }
+
+    pub fn meets(&self, start: u64, end: u64) -> bool {
+        self.0.iter().any(|&(a, b)| a < end && start < b)
+    }
+
+    pub fn len(&self) -> usize {
+        self.0.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+
+    /// `VICTORY_NATIVE_GPUMEM_EXCLUDE`: comma-separated `start-end` or
+    /// `start+len`, hexadecimal with or without `0x`. Bad items are skipped.
+    pub fn parse(text: &str) -> Self {
+        let num = |s: &str| {
+            let s = s.trim();
+            u64::from_str_radix(s.strip_prefix("0x").or_else(|| s.strip_prefix("0X")).unwrap_or(s), 16).ok()
+        };
+        let mut r = Self::new();
+        for item in text.split(',').map(str::trim).filter(|s| !s.is_empty()) {
+            if let Some((a, b)) = item.split_once('+') {
+                if let (Some(a), Some(n)) = (num(a), num(b)) {
+                    r.add(a, a.saturating_add(n));
+                }
+            } else if let Some((a, b)) = item.split_once('-')
+                && let (Some(a), Some(b)) = (num(a), num(b))
+            {
+                r.add(a, b);
+            }
+        }
+        r
+    }
+}
+
+/// A bump allocator over a reserved address range that is never committed:
+/// addresses for resources that live on the card alone.
+pub struct Bump {
+    next: u64,
+    end: u64,
+}
+
+impl Bump {
+    pub const fn new(start: u64, len: u64) -> Self {
+        Self { next: start, end: start.saturating_add(len) }
+    }
+
+    /// `size` bytes aligned to `align` (a power of two; at least 64 KiB is
+    /// used, so no two resources share a page).
+    pub fn take(&mut self, size: u64, align: u64) -> Option<u64> {
+        let align = align.max(1 << 16);
+        if !align.is_power_of_two() || size == 0 {
+            return None;
+        }
+        let at = self.next.checked_next_multiple_of(align)?;
+        let end = at.checked_add(size)?.checked_next_multiple_of(1 << 16)?;
+        if end > self.end {
+            return None;
+        }
+        self.next = end;
+        Some(at)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn table_finds_only_whole_ranges() {
+        let mut t = Table::new();
+        assert!(t.insert(0x1000, 0x2000, 'a'));
+        assert!(t.insert(0x3000, 0x5000, 'b'));
+        assert!(!t.insert(0x1800, 0x3800, 'c'), "overlap refused");
+        assert!(!t.insert(0x6000, 0x6000, 'c'), "empty refused");
+        assert!(t.insert(0x2000, 0x3000, 'd'), "touching is fine");
+        assert_eq!(t.find(0x1000, 0x1000), Some((0x1000, &'a')));
+        assert_eq!(t.find(0x1fff, 0), Some((0x1000, &'a')));
+        assert_eq!(t.find(0x1fff, 2), None, "straddles two entries");
+        assert_eq!(t.find(0x4000, 0x1000), Some((0x3000, &'b')));
+        assert_eq!(t.find(0x4000, 0x1001), None);
+        assert_eq!(t.find(0x500, 1), None);
+        assert_eq!(t.find(u64::MAX, 1), None);
+        assert_eq!(t.remove(0x3000), Some('b'));
+        assert_eq!(t.find(0x4000, 1), None);
+        assert_eq!(t.len(), 2);
+    }
+
+    #[test]
+    fn exclusions_parse_and_meet() {
+        let r = Ranges::parse("0x1000-0x2000, 3000+100 ,junk, 0x10-zz");
+        assert_eq!(r, Ranges(vec![(0x1000, 0x2000), (0x3000, 0x3100)]));
+        assert!(r.meets(0x1fff, 0x2001));
+        assert!(!r.meets(0x2000, 0x3000));
+        assert!(r.meets(0x30ff, 0x3100));
+        assert!(Ranges::parse("").is_empty());
+    }
+
+    #[test]
+    fn bump_aligns_and_ends() {
+        let mut b = Bump::new(0x10_0000, 0x40_0000);
+        assert_eq!(b.take(0x100, 0x1000), Some(0x10_0000));
+        assert_eq!(b.take(0x100, 0x1000), Some(0x11_0000), "own page");
+        assert_eq!(b.take(0x10_0000, 0x40_0000), Some(0x40_0000), "4 MiB alignment");
+        assert_eq!(b.take(1, 1), None, "full");
+        assert_eq!(b.take(0, 1), None);
+    }
+}
diff --git a/crates/victory-gpu/src/over.rs b/crates/victory-gpu/src/over.rs
new file mode 100644
index 0000000..14485c0
--- /dev/null
+++ b/crates/victory-gpu/src/over.rs
@@ -0,0 +1,590 @@
+//! A present's second plane, drawn over the first in our window.
+//!
+//! The console's display composes the planes of a present. The title in
+//! its Series S mode presents two: its game image at 1920x1080 and its
+//! interface at 3840x2160, whose empty texels are zero with alpha zero. A
+//! window showing the first plane alone is black wherever the game plane
+//! is, the menus and loading screens included.
+//!
+//! The pass here draws the second plane over the back buffer once the first
+//! has been copied there: one triangle, the plane sampled across the whole
+//! buffer (stretched to it), blended by its alpha.
+//!
+//! shortcut: the alpha is taken as premultiplied (what an interface drawn
+//! onto a cleared target with the usual blending holds); planes after the
+//! second, and the placement and scaling a plane's parameters can ask for,
+//! are not read.
+
+use std::sync::Mutex;
+
+use windows::Win32::Foundation::RECT;
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::{DXGI_FORMAT, DXGI_SAMPLE_DESC};
+
+const SOURCE: &str = r#"
+Texture2D<float4> plane : register(t0);
+SamplerState bilinear : register(s0);
+struct Corner { float4 position : SV_Position; float2 at : TEXCOORD0; };
+Corner corner(uint i : SV_VertexID) {
+    Corner c;
+    c.at = float2(float(i & 1) * 2.0, float(i >> 1) * 2.0);
+    c.position = float4(c.at.x * 2.0 - 1.0, 1.0 - c.at.y * 2.0, 0.0, 1.0);
+    return c;
+}
+float4 over(Corner c) : SV_Target { return plane.Sample(bilinear, c.at); }
+"#;
+
+/// Views kept until the list that uses them has run: a present can be sent
+/// ahead of the card, so a view is not reused for this many presents.
+///
+/// shortcut: a fixed count, not derived from how many presents are in
+/// flight. Presents sent ahead each hold a back buffer and the swap chain
+/// has two, so no more than a few lists are ever waiting; 16 is well past
+/// that.
+const RING: u32 = 16;
+
+struct Pass {
+    format: i32,
+    root: ID3D12RootSignature,
+    pipeline: ID3D12PipelineState,
+    /// The same draw for an opaque picture at an opacity: the list's blend factor.
+    faded: ID3D12PipelineState,
+    targets: ID3D12DescriptorHeap,
+    views: ID3D12DescriptorHeap,
+    target_step: usize,
+    view_step: u32,
+    next: u32,
+}
+
+// SAFETY: D3D12 objects are free-threaded.
+unsafe impl Send for Pass {}
+
+static PASS: Mutex<Option<Pass>> = Mutex::new(None);
+
+/// A bilinear, clamping sampler at `s0` for the stages `visibility` names.
+fn bilinear(visibility: D3D12_SHADER_VISIBILITY) -> D3D12_STATIC_SAMPLER_DESC {
+    D3D12_STATIC_SAMPLER_DESC {
+        Filter: D3D12_FILTER_MIN_MAG_LINEAR_MIP_POINT,
+        AddressU: D3D12_TEXTURE_ADDRESS_MODE_CLAMP,
+        AddressV: D3D12_TEXTURE_ADDRESS_MODE_CLAMP,
+        AddressW: D3D12_TEXTURE_ADDRESS_MODE_CLAMP,
+        ComparisonFunc: D3D12_COMPARISON_FUNC_NEVER,
+        MaxLOD: f32::MAX,
+        ShaderRegister: 0,
+        RegisterSpace: 0,
+        ShaderVisibility: visibility,
+        ..Default::default()
+    }
+}
+
+/// A root signature of `parameters` and one bilinear sampler, serialized by
+/// the runtime and not taken from a shader: the system compiler under Wine
+/// compiles a `[RootSignature]` attribute without writing the signature
+/// into the shader, and `CreateRootSignature` then fails on it (#188).
+fn root_signature(
+    device: &ID3D12Device,
+    parameters: &[D3D12_ROOT_PARAMETER],
+    sampler: D3D12_SHADER_VISIBILITY,
+    flags: D3D12_ROOT_SIGNATURE_FLAGS,
+) -> windows::core::Result<ID3D12RootSignature> {
+    use windows::Win32::Graphics::Direct3D::ID3DBlob;
+    let samplers = [bilinear(sampler)];
+    let desc = D3D12_ROOT_SIGNATURE_DESC {
+        NumParameters: parameters.len() as u32,
+        pParameters: parameters.as_ptr(),
+        NumStaticSamplers: 1,
+        pStaticSamplers: samplers.as_ptr(),
+        Flags: flags,
+    };
+    let mut blob: Option<ID3DBlob> = None;
+    // SAFETY: the description points at live slices; the blob is the
+    // runtime's own, read while it lives.
+    unsafe {
+        D3D12SerializeRootSignature(&desc, D3D_ROOT_SIGNATURE_VERSION_1, &mut blob, None)?;
+        let blob = blob.ok_or_else(windows::core::Error::empty)?;
+        let bytes =
+            std::slice::from_raw_parts(blob.GetBufferPointer().cast::<u8>(), blob.GetBufferSize());
+        device.CreateRootSignature(0, bytes)
+    }
+}
+
+/// One descriptor range of one view at register 0, at `offset` in its table.
+fn range(kind: D3D12_DESCRIPTOR_RANGE_TYPE, offset: u32) -> D3D12_DESCRIPTOR_RANGE {
+    D3D12_DESCRIPTOR_RANGE {
+        RangeType: kind,
+        NumDescriptors: 1,
+        BaseShaderRegister: 0,
+        RegisterSpace: 0,
+        OffsetInDescriptorsFromTableStart: offset,
+    }
+}
+
+/// A root parameter that is a table of `ranges`, for the stages `visibility`
+/// names.
+fn table(ranges: &[D3D12_DESCRIPTOR_RANGE], visibility: D3D12_SHADER_VISIBILITY) -> D3D12_ROOT_PARAMETER {
+    D3D12_ROOT_PARAMETER {
+        ParameterType: D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE,
+        Anonymous: D3D12_ROOT_PARAMETER_0 {
+            DescriptorTable: D3D12_ROOT_DESCRIPTOR_TABLE {
+                NumDescriptorRanges: ranges.len() as u32,
+                pDescriptorRanges: ranges.as_ptr(),
+            },
+        },
+        ShaderVisibility: visibility,
+    }
+}
+
+fn make(device: &ID3D12Device, format: DXGI_FORMAT) -> windows::core::Result<Pass> {
+    use windows::core::s;
+    let vs = crate::host::compile(SOURCE, s!("corner"), s!("vs_5_1"))?;
+    let ps = crate::host::compile(SOURCE, s!("over"), s!("ps_5_1"))?;
+    let code = |bytes: &[u8]| D3D12_SHADER_BYTECODE {
+        pShaderBytecode: bytes.as_ptr().cast(),
+        BytecodeLength: bytes.len(),
+    };
+    let plane = [range(D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 0)];
+    let root = root_signature(
+        device,
+        &[table(&plane, D3D12_SHADER_VISIBILITY_PIXEL)],
+        D3D12_SHADER_VISIBILITY_PIXEL,
+        D3D12_ROOT_SIGNATURE_FLAG_NONE,
+    )?;
+    // SAFETY: the description points at live data and never releases its
+    // pointer.
+    unsafe {
+        let mut desc = D3D12_GRAPHICS_PIPELINE_STATE_DESC {
+            pRootSignature: std::mem::transmute_copy(&root),
+            VS: code(&vs[..]),
+            PS: code(&ps[..]),
+            SampleMask: u32::MAX,
+            RasterizerState: D3D12_RASTERIZER_DESC {
+                FillMode: D3D12_FILL_MODE_SOLID,
+                CullMode: D3D12_CULL_MODE_NONE,
+                DepthClipEnable: true.into(),
+                ..Default::default()
+            },
+            PrimitiveTopologyType: D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE,
+            NumRenderTargets: 1,
+            SampleDesc: DXGI_SAMPLE_DESC {
+                Count: 1,
+                Quality: 0,
+            },
+            ..Default::default()
+        };
+        desc.RTVFormats[0] = format;
+        desc.BlendState.RenderTarget[0] = D3D12_RENDER_TARGET_BLEND_DESC {
+            BlendEnable: true.into(),
+            SrcBlend: D3D12_BLEND_ONE,
+            DestBlend: D3D12_BLEND_INV_SRC_ALPHA,
+            BlendOp: D3D12_BLEND_OP_ADD,
+            SrcBlendAlpha: D3D12_BLEND_ONE,
+            DestBlendAlpha: D3D12_BLEND_INV_SRC_ALPHA,
+            BlendOpAlpha: D3D12_BLEND_OP_ADD,
+            RenderTargetWriteMask: D3D12_COLOR_WRITE_ENABLE_ALL.0 as u8,
+            ..Default::default()
+        };
+        let pipeline: ID3D12PipelineState = device.CreateGraphicsPipelineState(&desc)?;
+        desc.BlendState.RenderTarget[0].SrcBlend = D3D12_BLEND_BLEND_FACTOR;
+        desc.BlendState.RenderTarget[0].DestBlend = D3D12_BLEND_INV_BLEND_FACTOR;
+        desc.BlendState.RenderTarget[0].SrcBlendAlpha = D3D12_BLEND_BLEND_FACTOR;
+        desc.BlendState.RenderTarget[0].DestBlendAlpha = D3D12_BLEND_INV_BLEND_FACTOR;
+        let faded: ID3D12PipelineState = device.CreateGraphicsPipelineState(&desc)?;
+        let targets: ID3D12DescriptorHeap =
+            device.CreateDescriptorHeap(&D3D12_DESCRIPTOR_HEAP_DESC {
+                Type: D3D12_DESCRIPTOR_HEAP_TYPE_RTV,
+                NumDescriptors: RING,
+                Flags: D3D12_DESCRIPTOR_HEAP_FLAG_NONE,
+                NodeMask: 0,
+            })?;
+        let views: ID3D12DescriptorHeap =
+            device.CreateDescriptorHeap(&D3D12_DESCRIPTOR_HEAP_DESC {
+                Type: D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV,
+                NumDescriptors: RING,
+                Flags: D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE,
+                NodeMask: 0,
+            })?;
+        Ok(Pass {
+            format: format.0,
+            root,
+            pipeline,
+            faded,
+            target_step: device.GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_RTV)
+                as usize,
+            view_step: device
+                .GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV),
+            targets,
+            views,
+            next: 0,
+        })
+    }
+}
+
+/// Records into `list` the draw of `plane` (readable by pixel shaders, read
+/// as `plane_format`) over `back` (in the render-target state, `width` by
+/// `height`, of `format`). False if the pass could not be made: nothing was
+/// recorded then.
+///
+/// The pass sets the list's descriptor heap, root signature, pipeline,
+/// target, viewport, scissor and topology and puts none of them back: it is
+/// for a list of ours that records nothing of the title's.
+pub(crate) fn record(
+    device: &ID3D12Device,
+    list: &ID3D12GraphicsCommandList,
+    back: &ID3D12Resource,
+    format: DXGI_FORMAT,
+    size: (u32, u32),
+    plane: &ID3D12Resource,
+    plane_format: DXGI_FORMAT,
+) -> bool {
+    draw(device, list, back, format, size, plane, plane_format, None)
+}
+
+/// [`record`] for an opaque `picture` shown at `alpha` (0 gone .. 1 covering): the boot splash.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn record_faded(
+    device: &ID3D12Device,
+    list: &ID3D12GraphicsCommandList,
+    back: &ID3D12Resource,
+    format: DXGI_FORMAT,
+    size: (u32, u32),
+    picture: &ID3D12Resource,
+    picture_format: DXGI_FORMAT,
+    alpha: f32,
+) -> bool {
+    draw(device, list, back, format, size, picture, picture_format, Some(alpha))
+}
+
+#[allow(clippy::too_many_arguments)]
+fn draw(
+    device: &ID3D12Device,
+    list: &ID3D12GraphicsCommandList,
+    back: &ID3D12Resource,
+    format: DXGI_FORMAT,
+    (width, height): (u32, u32),
+    plane: &ID3D12Resource,
+    plane_format: DXGI_FORMAT,
+    alpha: Option<f32>,
+) -> bool {
+    let mut pass = PASS.lock().unwrap_or_else(|e| e.into_inner());
+    if pass.as_ref().is_none_or(|p| p.format != format.0) {
+        *pass = match make(device, format) {
+            Ok(p) => Some(p),
+            Err(e) => {
+                static TOLD: std::sync::Once = std::sync::Once::new();
+                TOLD.call_once(|| {
+                    tracing::warn!(error = %e, "no pass to draw a present's second plane: it is not shown");
+                });
+                return false;
+            }
+        };
+        tracing::info!(format = format.0, "a present's second plane is drawn over the first");
+    }
+    let Some(p) = pass.as_mut() else { return false };
+    let slot = p.next % RING;
+    p.next = p.next.wrapping_add(1);
+    let view = D3D12_SHADER_RESOURCE_VIEW_DESC {
+        Format: plane_format,
+        ViewDimension: D3D12_SRV_DIMENSION_TEXTURE2D,
+        Shader4ComponentMapping: D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING,
+        Anonymous: D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+            Texture2D: D3D12_TEX2D_SRV {
+                MostDetailedMip: 0,
+                MipLevels: 1,
+                ..Default::default()
+            },
+        },
+    };
+    let target_desc = D3D12_RENDER_TARGET_VIEW_DESC {
+        Format: format,
+        ViewDimension: D3D12_RTV_DIMENSION_TEXTURE2D,
+        ..Default::default()
+    };
+    // SAFETY: an open list; slots of our heaps; live resources and objects
+    // (the pass's own live as long as the process or until remade, and a
+    // list holds what it was recorded with).
+    unsafe {
+        let target = D3D12_CPU_DESCRIPTOR_HANDLE {
+            ptr: p.targets.GetCPUDescriptorHandleForHeapStart().ptr + slot as usize * p.target_step,
+        };
+        let cpu = D3D12_CPU_DESCRIPTOR_HANDLE {
+            ptr: p.views.GetCPUDescriptorHandleForHeapStart().ptr
+                + (slot * p.view_step) as usize,
+        };
+        let gpu = D3D12_GPU_DESCRIPTOR_HANDLE {
+            ptr: p.views.GetGPUDescriptorHandleForHeapStart().ptr
+                + u64::from(slot * p.view_step),
+        };
+        device.CreateRenderTargetView(back, Some(&target_desc), target);
+        device.CreateShaderResourceView(plane, Some(&view), cpu);
+        list.SetDescriptorHeaps(&[Some(p.views.clone())]);
+        list.SetGraphicsRootSignature(&p.root);
+        match alpha {
+            Some(a) => {
+                list.SetPipelineState(&p.faded);
+                list.OMSetBlendFactor(Some(&[a; 4]));
+            }
+            None => list.SetPipelineState(&p.pipeline),
+        }
+        list.SetGraphicsRootDescriptorTable(0, gpu);
+        list.OMSetRenderTargets(1, Some(&target), false, None);
+        list.RSSetViewports(&[D3D12_VIEWPORT {
+            TopLeftX: 0.0,
+            TopLeftY: 0.0,
+            Width: width as f32,
+            Height: height as f32,
+            MinDepth: 0.0,
+            MaxDepth: 1.0,
+        }]);
+        list.RSSetScissorRects(&[RECT {
+            left: 0,
+            top: 0,
+            right: width as i32,
+            bottom: height as i32,
+        }]);
+        list.IASetPrimitiveTopology(windows::Win32::Graphics::Direct3D::D3D_PRIMITIVE_TOPOLOGY(4));
+        list.DrawInstanced(3, 1, 0, 0);
+    }
+    true
+}
+
+// ---------------------------------------------------------------------------
+// The upscaler's output, by a plain stretch
+// ---------------------------------------------------------------------------
+
+/// The title in its Series S mode renders below its output size and has the
+/// console's upscaler (its `ffxDispatch`) write the output. That upscaler's
+/// passes are compute pipelines in a container we do not translate, so the
+/// output stayed black. This pass stands in for it: each output texel is the
+/// bilinear sample of the rendered part of the colour input.
+///
+/// shortcut: no temporal accumulation, sharpening or use of the depth and
+/// motion inputs: an image, not the upscaler's quality.
+const STRETCH: &str = r#"
+cbuffer Sizes : register(b0) { float2 scale; float2 texel; };
+Texture2D<float4> source : register(t0);
+RWTexture2D<float4> target : register(u0);
+SamplerState bilinear : register(s0);
+[numthreads(8, 8, 1)]
+void stretch(uint3 id : SV_DispatchThreadID) {
+    // Groups are 8 by 8: the last ones reach past a size that is not a
+    // multiple of 8.
+    uint width, height;
+    target.GetDimensions(width, height);
+    if (id.x >= width || id.y >= height) return;
+    float2 at = (float2(id.xy) + 0.5) * texel * scale;
+    target[id.xy] = source.SampleLevel(bilinear, at, 0);
+}
+"#;
+
+struct Stretch {
+    root: ID3D12RootSignature,
+    pipeline: ID3D12PipelineState,
+    views: ID3D12DescriptorHeap,
+    step: u32,
+    next: u32,
+}
+
+// SAFETY: D3D12 objects are free-threaded.
+unsafe impl Send for Stretch {}
+
+static STRETCHER: Mutex<Option<Stretch>> = Mutex::new(None);
+
+/// Views of a stretch are kept this many stretches (two views each).
+///
+/// shortcut: a fixed count. The title dispatches the upscaler once a frame
+/// and a list runs within the frames the title keeps in flight; 64 frames
+/// is far more than it keeps.
+const STRETCH_RING: u32 = 64;
+
+fn make_stretch(device: &ID3D12Device) -> windows::core::Result<Stretch> {
+    use windows::core::s;
+    let cs = crate::host::compile(STRETCH, s!("stretch"), s!("cs_5_1"))?;
+    let views = [
+        range(D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 0),
+        range(D3D12_DESCRIPTOR_RANGE_TYPE_UAV, 1),
+    ];
+    let sizes = D3D12_ROOT_PARAMETER {
+        ParameterType: D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS,
+        Anonymous: D3D12_ROOT_PARAMETER_0 {
+            Constants: D3D12_ROOT_CONSTANTS {
+                ShaderRegister: 0,
+                RegisterSpace: 0,
+                Num32BitValues: 4,
+            },
+        },
+        ShaderVisibility: D3D12_SHADER_VISIBILITY_ALL,
+    };
+    let root = root_signature(
+        device,
+        &[sizes, table(&views, D3D12_SHADER_VISIBILITY_ALL)],
+        D3D12_SHADER_VISIBILITY_ALL,
+        D3D12_ROOT_SIGNATURE_FLAG_NONE,
+    )?;
+    // SAFETY: the description points at live data and never releases its
+    // pointer.
+    unsafe {
+        let desc = D3D12_COMPUTE_PIPELINE_STATE_DESC {
+            pRootSignature: std::mem::transmute_copy(&root),
+            CS: D3D12_SHADER_BYTECODE {
+                pShaderBytecode: cs.as_ptr().cast(),
+                BytecodeLength: cs.len(),
+            },
+            ..Default::default()
+        };
+        let pipeline: ID3D12PipelineState = device.CreateComputePipelineState(&desc)?;
+        let views: ID3D12DescriptorHeap =
+            device.CreateDescriptorHeap(&D3D12_DESCRIPTOR_HEAP_DESC {
+                Type: D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV,
+                NumDescriptors: STRETCH_RING * 2,
+                Flags: D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE,
+                NodeMask: 0,
+            })?;
+        Ok(Stretch {
+            root,
+            pipeline,
+            step: device
+                .GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV),
+            views,
+            next: 0,
+        })
+    }
+}
+
+/// A typeless colour format as the typed one shaders read and write.
+fn typed(format: DXGI_FORMAT) -> DXGI_FORMAT {
+    DXGI_FORMAT(match format.0 {
+        1 => 2,
+        9 => 10,
+        23 => 24,
+        27 => 28,
+        f => f,
+    })
+}
+
+/// Records into `list` the stretch of the top-left `render` texels of
+/// `source` (readable by compute shaders) over the whole of `target` (in
+/// the unordered-access state). False if nothing was recorded.
+///
+/// The pass sets the list's descriptor heap, compute root signature and
+/// pipeline and puts none of them back: the caller replays the title's.
+pub(crate) fn record_stretch(
+    device: &ID3D12Device,
+    list: &ID3D12GraphicsCommandList,
+    target: &ID3D12Resource,
+    source: &ID3D12Resource,
+    render: [u32; 2],
+) -> bool {
+    // SAFETY: live resources.
+    let (to, from) = unsafe { (target.GetDesc(), source.GetDesc()) };
+    if to.Flags.0 & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS.0 == 0
+        || to.Width == 0
+        || from.Width == 0
+    {
+        return false;
+    }
+    let mut made = STRETCHER.lock().unwrap_or_else(|e| e.into_inner());
+    if made.is_none() {
+        // Tried again at the next dispatch if it fails, as the pass over a
+        // present is: a failure need not last.
+        *made = match make_stretch(device) {
+            Ok(p) => {
+                tracing::info!("the upscaler's output is made by a plain stretch of its colour input");
+                Some(p)
+            }
+            Err(e) => {
+                static TOLD: std::sync::Once = std::sync::Once::new();
+                TOLD.call_once(|| {
+                    tracing::warn!(error = %e, "no pass to stretch the upscaler's input: its output stays as it is");
+                });
+                None
+            }
+        };
+    }
+    let Some(p) = made.as_mut() else { return false };
+    let slot = (p.next % STRETCH_RING) * 2;
+    p.next = p.next.wrapping_add(1);
+    let (width, height) = (to.Width as u32, to.Height);
+    let rendered = [
+        if render[0] == 0 { from.Width as u32 } else { render[0].min(from.Width as u32) },
+        if render[1] == 0 { from.Height } else { render[1].min(from.Height) },
+    ];
+    let sizes = [
+        rendered[0] as f32 / from.Width as f32,
+        rendered[1] as f32 / from.Height as f32,
+        1.0 / width as f32,
+        1.0 / height as f32,
+    ];
+    let read = D3D12_SHADER_RESOURCE_VIEW_DESC {
+        Format: typed(from.Format),
+        ViewDimension: D3D12_SRV_DIMENSION_TEXTURE2D,
+        Shader4ComponentMapping: D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING,
+        Anonymous: D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+            Texture2D: D3D12_TEX2D_SRV {
+                MostDetailedMip: 0,
+                MipLevels: 1,
+                ..Default::default()
+            },
+        },
+    };
+    let written = D3D12_UNORDERED_ACCESS_VIEW_DESC {
+        Format: typed(to.Format),
+        ViewDimension: D3D12_UAV_DIMENSION_TEXTURE2D,
+        ..Default::default()
+    };
+    // SAFETY: an open list; slots of our heap; live resources and objects
+    // (the pass's own live as long as the process).
+    unsafe {
+        let cpu = |i: u32| D3D12_CPU_DESCRIPTOR_HANDLE {
+            ptr: p.views.GetCPUDescriptorHandleForHeapStart().ptr + ((slot + i) * p.step) as usize,
+        };
+        let gpu = D3D12_GPU_DESCRIPTOR_HANDLE {
+            ptr: p.views.GetGPUDescriptorHandleForHeapStart().ptr + u64::from(slot * p.step),
+        };
+        device.CreateShaderResourceView(source, Some(&read), cpu(0));
+        device.CreateUnorderedAccessView(target, None, Some(&written), cpu(1));
+        list.SetDescriptorHeaps(&[Some(p.views.clone())]);
+        list.SetComputeRootSignature(&p.root);
+        list.SetPipelineState(&p.pipeline);
+        list.SetComputeRoot32BitConstants(0, 4, sizes.as_ptr().cast(), 0);
+        list.SetComputeRootDescriptorTable(1, gpu);
+        list.Dispatch(width.div_ceil(8), height.div_ceil(8), 1);
+    }
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Typeless colour formats are read and written as their typed ones;
+    /// typed formats, and formats with no typeless form here, stay.
+    #[test]
+    fn typeless_formats_get_their_typed_one() {
+        for (typeless, typed_one) in [(1, 2), (9, 10), (23, 24), (27, 28)] {
+            assert_eq!(typed(DXGI_FORMAT(typeless)).0, typed_one);
+            assert_eq!(typed(DXGI_FORMAT(typed_one)).0, typed_one);
+        }
+        // R11G11B10_FLOAT, R8G8B8A8_UNORM_SRGB and the FP16 stand-in's own.
+        for format in [26, 29, 10, 0] {
+            assert_eq!(typed(DXGI_FORMAT(format)).0, format);
+        }
+    }
+
+    /// The passes' root signatures are serialized by the runtime: neither
+    /// source asks the compiler for one (Wine's writes none).
+    #[test]
+    fn the_sources_carry_no_root_signature() {
+        for source in [SOURCE, STRETCH] {
+            assert!(!source.contains("RootSignature"));
+            assert!(!source.contains("#define RS"));
+        }
+    }
+
+    /// The stretch's source guards its writes: groups of 8 reach past sizes
+    /// that are not multiples of 8.
+    #[test]
+    fn the_stretch_writes_inside_its_target_only() {
+        assert!(STRETCH.contains("numthreads(8, 8, 1)"));
+        assert!(STRETCH.contains("if (id.x >= width || id.y >= height) return;"));
+    }
+}
