+        for at in [0, 1, 7, 8, 63, 64, 65, 511, 2048, 4095, 4096, 4098] {
+            let was = data[at];
+            for flip in [1u8, 0x80, 0xff] {
+                data[at] = was ^ flip;
+                assert_ne!(lane_hash(&data), base, "byte {at} ^ {flip:#x}");
+            }
+            data[at] = was;
