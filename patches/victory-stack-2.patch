+    }
+    static FROM_ENV: OnceLock<Mode> = OnceLock::new();
+    *FROM_ENV.get_or_init(|| match std::env::var("VICTORY_SHADER_REVALIDATE").as_deref().map(str::trim) {
+        Ok("eager") => Mode::Eager,
+        Ok("trust" | "off" | "0") => Mode::Trust,
+        _ => Mode::Lazy,
+    })
