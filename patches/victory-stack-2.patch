+            list.Barrier(&[D3D12_BARRIER_GROUP {
+                Type: D3D12_BARRIER_TYPE_BUFFER,
+                NumBarriers: 1,
+                Anonymous: D3D12_BARRIER_GROUP_0 { pBufferBarriers: &b },
