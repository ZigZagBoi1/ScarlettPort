+//! Frame pacing and latency switches, the pacer's arithmetic and the
+//! per-second pacing statistics. The host side (swap chain, timer waits)
+//! lives in `victory-gpu`; the input side in `victory-hle`. Everything here
+//! is plain arithmetic on nanoseconds so it can be tested without a GPU.
+//!
+//! Switches (all off by default; nothing here changes what is drawn):
+//! * `VICTORY_PACE=1`: release presents on an even cadence ([`Pacer`]).
+//!   `VICTORY_PACE_FPS=30|60` fixes the base rate; otherwise it follows the
+//!   title's frame interval.
+//! * `VICTORY_PACE_LATENCY=1|2`: waitable swap chain, at most that many
+//!   frames queued.
+//! * `VICTORY_PACE_TEARING=1`: allow tearing (VRR) when the system supports it.
+//! * `VICTORY_PACE_INPUT=1`: sample input when the title reads it (on by
+//!   default with `VICTORY_PACE=1`; `VICTORY_PACE_INPUT=0` turns it off).
+//! * `VICTORY_PACE_FEEDBACK=1`: hand the title real display times and lock
+//!   its frame clock to them (on by default with pacing or latency).
+//! * `VICTORY_PACE_STATS=1`: the per-second statistics line alone (on with
+//!   any of the above), for the baseline of an A/B run.
+//! * `VICTORY_LOW_LATENCY=1`: the low-latency defaults: a waitable swap
+//!   chain with one frame queued at most, waited on at the title's frame
+//!   start (the origin wait) instead of before the copy to the back buffer,
+//!   so the title begins (and reads input) as late as possible; tearing when
+//!   no cap is set at boot (sync interval is always 0); late input sampling
+//!   and the statistics line. Each `VICTORY_PACE_*` still wins when set.
+//! * `VICTORY_FPS_CAP=N` (live): a frame-time limiter at the title's frame
+//!   start, N frames a second, high-resolution waitable timer plus a short
+//!   spin. `VICTORY_LIMITER=0` (live) turns it off with the cap kept. Both
+//!   are A/B live switches ([`crate::live`]).
+
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+use std::sync::{LazyLock, OnceLock};
+use std::time::Instant;
+
+/// The pacing switches, read once.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Switches {
+    pub pace: bool,
+    /// Fixed base rate, frames per second (None: the title's interval).
+    pub fps: Option<u32>,
+    /// Maximum frame latency for a waitable swap chain (0: off).
+    pub latency: u32,
+    pub tearing: bool,
+    pub input: bool,
+    pub feedback: bool,
+    pub stats: bool,
+    /// `VICTORY_LOW_LATENCY=1`: the swap chain wait moves to the frame start.
+    pub low_latency: bool,
+}
+
+impl Switches {
+    /// From a variable lookup (`get(name)`), for tests and [`switches`].
+    pub fn from_lookup(get: impl Fn(&str) -> Option<String>) -> Switches {
+        let on = |name: &str| get(name).map(|v| v.trim() == "1");
+        let pace = on("VICTORY_PACE").unwrap_or(false);
+        let low_latency = on("VICTORY_LOW_LATENCY").unwrap_or(false);
+        let capped = get("VICTORY_FPS_CAP").and_then(|v| v.trim().parse::<u32>().ok()).is_some_and(|c| c > 0);
+        let fps = get("VICTORY_PACE_FPS")
+            .and_then(|v| v.trim().parse::<u32>().ok())
+            .filter(|f| (1..=1000).contains(f));
+        let latency = get("VICTORY_PACE_LATENCY")
+            .and_then(|v| v.trim().parse::<u32>().ok())
+            .map_or(if low_latency { 1 } else { 0 }, |n| n.min(2));
+        let tearing = on("VICTORY_PACE_TEARING").unwrap_or(low_latency && !capped);
+        let input = on("VICTORY_PACE_INPUT").unwrap_or(pace || low_latency);
+        let feedback = on("VICTORY_PACE_FEEDBACK").unwrap_or(pace || latency > 0);
+        let stats = on("VICTORY_PACE_STATS").unwrap_or(false)
+            || pace
+            || latency > 0
+            || tearing
+            || input
+            || feedback
+            || low_latency;
+        Switches { pace, fps, latency, tearing, input, feedback, stats, low_latency }
+    }
+}
+
+static FILE: OnceLock<toml::Table> = OnceLock::new();
+
+/// Takes `[pace]` from the config file: `pace`, `fps`, `latency`,
+/// `tearing`, `input`, `feedback`, each the file's say for the variable of
+/// the same name (`VICTORY_PACE_FPS` for `fps`); the environment wins. Call
+/// before [`switches`] is first read; later calls change nothing.
+pub fn configure(table: Option<&toml::Table>) {
+    if let Some(t) = table {
+        let _ = FILE.set(t.clone());
+    }
+}
+
+/// The file's value for the variable `name`, written as the variable would be.
+pub fn file_value(name: &str) -> Option<String> {
+    let key = match name {
+        "VICTORY_PACE" => "pace",
+        "VICTORY_PACE_FPS" => "fps",
+        "VICTORY_PACE_LATENCY" => "latency",
+        "VICTORY_PACE_TEARING" => "tearing",
+        "VICTORY_PACE_INPUT" => "input",
+        "VICTORY_PACE_FEEDBACK" => "feedback",
+        _ => return None,
+    };
+    match FILE.get()?.get(key)? {
+        toml::Value::Boolean(b) => Some(if *b { "1" } else { "0" }.to_string()),
+        toml::Value::Integer(i) => Some(i.to_string()),
+        _ => None,
+    }
+}
+
+/// The process's switches at start (the environment over the config file).
+pub fn switches() -> &'static Switches {
+    static S: OnceLock<Switches> = OnceLock::new();
+    S.get_or_init(|| Switches::from_lookup(|n| std::env::var(n).ok().or_else(|| file_value(n))))
+}
+
+/// What the overlay can change while the title runs: pacing on or off, its
+/// fixed rate (0: the title's interval) and the late input sample. The rest
+/// of [`Switches`] shapes the swap chain and needs a restart.
+struct Live {
+    pace: AtomicBool,
+    fps: AtomicU32,
+    input: AtomicBool,
+}
+
+fn live() -> &'static Live {
+    static L: LazyLock<Live> = LazyLock::new(|| {
+        let s = switches();
+        Live {
+            pace: AtomicBool::new(s.pace),
+            fps: AtomicU32::new(s.fps.unwrap_or(0)),
+            input: AtomicBool::new(s.input),
+        }
+    });
+    &L
+}
+
+/// Whether presents are paced now.
+pub fn live_pace() -> bool {
+    live().pace.load(Ordering::Relaxed)
+}
+
+/// The fixed base rate now (None: the title's interval).
+pub fn live_fps() -> Option<u32> {
+    Some(live().fps.load(Ordering::Relaxed)).filter(|&f| f > 0)
+}
+
+/// Whether input is sampled again when the title reads it.
+pub fn live_input() -> bool {
+    live().input.load(Ordering::Relaxed)
+}
+
+/// Sets what [`live_pace`], [`live_fps`] and [`live_input`] answer.
+pub fn set_live(pace: bool, fps: Option<u32>, input: bool) {
+    let l = live();
+    l.pace.store(pace, Ordering::Relaxed);
+    l.fps.store(fps.filter(|f| (1..=1000).contains(f)).unwrap_or(0), Ordering::Relaxed);
+    l.input.store(input, Ordering::Relaxed);
+}
+
+/// `VICTORY_FPS_CAP` (live): the limiter's rate, 0 for none.
+pub static FPS_CAP: crate::live::Switch = crate::live::Switch::new("FPS_CAP", 0);
+/// `VICTORY_LIMITER` (live, on by default): whether the cap is applied.
+pub static LIMITER: crate::live::Switch = crate::live::Switch::new("LIMITER", 1);
+
+/// The limiter's period now (None: no cap, or the limiter is off).
+pub fn limiter_period() -> Option<u64> {
+    let cap = FPS_CAP.get().min(1000) as u32;
+    (cap > 0 && LIMITER.on()).then(|| period_of_fps(cap))
+}
+
+/// A frame-time limiter: frame starts on a grid of `period`. A start that
+/// is early waits for the next grid point; a little late (under half a
+/// period) goes at once and keeps the grid; later than that (a stall, a
+/// load) starts a new grid from now, so no burst of short frames follows.
+#[derive(Clone, Debug, Default)]
+pub struct Limiter {
+    next: Option<u64>,
+    period: u64,
+}
+
+impl Limiter {
+    /// A frame wants to start at `now`; when it may (`>= now`).
+    pub fn start_at(&mut self, now: u64, period: u64) -> u64 {
+        if period != self.period {
+            self.period = period;
+            self.next = None;
+        }
+        let at = match self.next {
+            Some(t) if now <= t => t,
+            _ => now,
+        };
+        // The grid goes on from the target when on time, from now after a stall.
+        let base = match self.next {
+            Some(t) if now < t + period / 2 => t,
+            _ => at,
+        };
+        self.next = Some(base + period);
+        at
+    }
+}
+
+/// ns the title's frame starts waited, since last taken: for the swap
+/// chain (`VICTORY_LOW_LATENCY`), by the limiter, and the swap chain waits
+/// that timed out.
+pub static START_WAIT_NS: AtomicU64 = AtomicU64::new(0);
+pub static LIMIT_WAIT_NS: AtomicU64 = AtomicU64::new(0);
+pub static START_TIMEOUTS: AtomicU64 = AtomicU64::new(0);
+
+static EPOCH: LazyLock<Instant> = LazyLock::new(Instant::now);
+
+/// Nanoseconds on one process-wide monotonic clock (shared by input and present).
+pub fn now_ns() -> u64 {
+    EPOCH.elapsed().as_nanos() as u64
+}
+
+/// [`now_ns`] of an instant (0 if before the clock started).
+pub fn ns_of(at: Instant) -> u64 {
+    at.checked_duration_since(*EPOCH).map_or(0, |d| d.as_nanos() as u64)
+}
+
+/// When the host's input was last sampled ([`now_ns`]).
+static SAMPLED: AtomicU64 = AtomicU64::new(0);
+/// The sample time behind the newest input the title read.
+static READ: AtomicU64 = AtomicU64::new(0);
+/// The present that last consumed [`READ`] (so latency is counted once per read).
+static CONSUMED: AtomicU64 = AtomicU64::new(0);
+
+/// The host's input was sampled at `at` ([`now_ns`]).
+pub fn input_sampled(at: u64) {
+    SAMPLED.fetch_max(at, Ordering::Relaxed);
+}
+
+/// When input was last sampled ([`now_ns`], 0: never).
+pub fn last_sampled() -> u64 {
+    SAMPLED.load(Ordering::Relaxed)
+}
+
+/// The title read input: it now holds what was sampled last.
+pub fn input_read() {
+    READ.fetch_max(SAMPLED.load(Ordering::Relaxed), Ordering::Relaxed);
+}
+
+/// A present at `now`: the input-to-present latency of the newest input
+/// the title read, if it read some since the last present.
+pub fn input_latency(now: u64) -> Option<u64> {
+    let read = READ.load(Ordering::Relaxed);
+    if read == 0 || CONSUMED.swap(read, Ordering::Relaxed) == read {
+        return None;
+    }
+    Some(now.saturating_sub(read))
+}
+
+/// The base period for a rate.
+pub fn period_of_fps(fps: u32) -> u64 {
+    1_000_000_000 / u64::from(fps.max(1))
+}
+
+/// Releases presents on an even cadence: a grid of `period` (a whole
+/// multiple of the base period, enough for the title's recent frame cost),
+/// waiting for the next grid point when a frame is early. A frame a little
+/// late goes at once and keeps the grid; one late by half a period or more
+/// (a stall) starts a new grid from now, so frames queued behind a stall are
+/// not let out back to back.
+#[derive(Clone, Debug)]
+pub struct Pacer {
+    base: u64,
+    multiple: u64,
+    /// The last grid point (target) and the last release.
+    target: Option<u64>,
+    released: u64,
+    /// Smoothed cost of a frame: from one release to the next frame ready.
+    cost: f64,
+    /// Consecutive frames whose cost fits a smaller multiple.
+    fits_lower: u32,
+}
+
+/// The most base periods one frame may be paced to.
+pub const MAX_MULTIPLE: u64 = 8;
+/// Weight of a new frame in the smoothed cost.
+const COST_GAIN: f64 = 0.125;
+/// Frames that must fit a smaller multiple before it is taken.
+const LOWER_AFTER: u32 = 30;
+
+impl Pacer {
+    pub fn new(base_ns: u64) -> Pacer {
+        Pacer { base: base_ns.max(1), multiple: 1, target: None, released: 0, cost: 0.0, fits_lower: 0 }
+    }
+
+    /// A new base period (the title changed its interval); the grid restarts.
+    pub fn set_base(&mut self, base_ns: u64) {
+        if base_ns.max(1) != self.base {
+            self.base = base_ns.max(1);
+            self.multiple = 1;
+            self.target = None;
+            self.fits_lower = 0;
+        }
+    }
+
+    pub fn base(&self) -> u64 {
+        self.base
+    }
+
+    /// The paced period now.
+    pub fn period(&self) -> u64 {
+        self.base * self.multiple
+    }
+
+    /// The smallest multiple of the base that holds `cost` with a little room.
+    fn multiple_for(&self, cost: f64) -> u64 {
+        let m = (cost * 1.05 / self.base as f64).ceil() as u64;
+        m.clamp(1, MAX_MULTIPLE)
+    }
+
+    /// A frame is ready to present at `ready`; when to release it (`>= ready`).
+    pub fn release_at(&mut self, ready: u64) -> u64 {
+        let Some(last) = self.target else {
+            self.target = Some(ready);
+            self.released = ready;
+            return ready;
+        };
+        let frame_cost = ready.saturating_sub(self.released) as f64;
+        self.cost = if self.cost == 0.0 { frame_cost } else { self.cost + COST_GAIN * (frame_cost - self.cost) };
+        // The multiple goes up at once, down only after it has fit for a while.
+        let want = self.multiple_for(self.cost);
+        let mut regrid = false;
+        if want > self.multiple {
+            self.multiple = want;
+            self.fits_lower = 0;
+            regrid = true;
+        } else if want < self.multiple {
+            self.fits_lower += 1;
+            if self.fits_lower >= LOWER_AFTER {
+                self.multiple -= 1;
+                self.fits_lower = 0;
+                regrid = true;
+            }
+        } else {
+            self.fits_lower = 0;
+        }
+        let period = self.period();
+        // A new period continues from the last release.
+        let grid = if regrid { self.released } else { last };
+        let target = grid + period;
+        let release = if ready <= target {
+            self.target = Some(target);
+            target
+        } else if ready - target < period / 2 {
+            // Late by a little: now, on the same grid.
+            self.target = Some(target);
+            ready
+        } else {
+            // A stall: a new grid from now.
+            self.target = Some(ready);
+            ready
+        };
+        self.released = release;
+        release
+    }
+}
+
+/// The signed distance (ns) from `at` to the nearest tick of a grid that
+/// started at 0 with `interval`: positive when `at` is after the tick.
+pub fn phase_error(at: u64, interval: u64) -> i64 {
+    let interval = interval.max(1);
+    let r = at % interval;
+    if r * 2 < interval { r as i64 } else { r as i64 - interval as i64 }
+}
+
+/// The nudge (ns, to add to a clock's start) that moves its ticks a step
+/// toward an event observed `elapsed` after the start: a fraction of the
+/// phase error, so one late display moves the clock little.
+pub fn phase_nudge(elapsed: u64, interval: u64) -> i64 {
+    phase_error(elapsed, interval) / 8
+}
+
+/// The `q`-th quantile (0..=1) of sorted samples, nearest rank.
+pub fn quantile(sorted: &[u64], q: f64) -> u64 {
+    if sorted.is_empty() {
+        return 0;
+    }
+    let rank = (q.clamp(0.0, 1.0) * sorted.len() as f64).ceil() as usize;
+    sorted[rank.clamp(1, sorted.len()) - 1]
+}
+
+/// One second of presents.
+#[derive(Default, Debug)]
+pub struct Window {
+    last: Option<u64>,
+    intervals: Vec<u64>,
+    latencies: Vec<u64>,
+    /// ns waited for the swap chain and by the pacer.
+    pub latency_wait: u64,
+    pub pace_wait: u64,
+    started: Option<u64>,
+}
+
+/// What a [`Window`] says.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Summary {
+    pub frames: usize,
+    pub p50_ms: f64,
+    pub p95_ms: f64,
+    pub p99_ms: f64,
+    /// Mean of |interval - previous interval|.
+    pub jitter_ms: f64,
+    pub latency_p50_ms: f64,
+    pub latency_p95_ms: f64,
+    pub latency_wait_ms: f64,
+    pub pace_wait_ms: f64,
+}
+
+fn ms(ns: u64) -> f64 {
+    ns as f64 / 1e6
+}
+
+impl Window {
+    /// A present at `now`, with the input latency it showed, if any.
+    pub fn present(&mut self, now: u64, latency: Option<u64>) {
+        if let Some(last) = self.last {
+            self.intervals.push(now.saturating_sub(last));
+        }
+        self.started.get_or_insert(now);
+        self.last = Some(now);
+        self.latencies.extend(latency);
+    }
+
+    /// After a second or more: the summary, and the window starts over.
+    pub fn take_if_due(&mut self, now: u64) -> Option<Summary> {
+        let started = self.started?;
+        if now.saturating_sub(started) < 1_000_000_000 {
+            return None;
+        }
+        let s = self.summary();
+        let last = self.last;
+        *self = Window { last, started: Some(now), ..Window::default() };
+        Some(s)
+    }
+
+    pub fn summary(&self) -> Summary {
+        let mut sorted = self.intervals.clone();
+        sorted.sort_unstable();
+        let mut lat = self.latencies.clone();
+        lat.sort_unstable();
+        let jitter = if self.intervals.len() > 1 {
+            let sum: u64 = self.intervals.windows(2).map(|w| w[0].abs_diff(w[1])).sum();
+            ms(sum) / (self.intervals.len() - 1) as f64
+        } else {
+            0.0
+        };
+        Summary {
+            frames: self.intervals.len(),
+            p50_ms: ms(quantile(&sorted, 0.50)),
+            p95_ms: ms(quantile(&sorted, 0.95)),
+            p99_ms: ms(quantile(&sorted, 0.99)),
+            jitter_ms: jitter,
+            latency_p50_ms: ms(quantile(&lat, 0.50)),
+            latency_p95_ms: ms(quantile(&lat, 0.95)),
+            latency_wait_ms: ms(self.latency_wait),
+            pace_wait_ms: ms(self.pace_wait),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MS: u64 = 1_000_000;
+    const P30: u64 = 33_333_333;
+
+    /// Runs the pacer over frames that each need `costs[i]` after release.
+    fn run(p: &mut Pacer, costs: &[u64]) -> Vec<u64> {
+        let mut now = 0;
+        let mut out = Vec::new();
+        for &c in costs {
+            now += c;
+            let r = p.release_at(now);
+            assert!(r >= now);
+            now = r;
+            out.push(r);
+        }
+        out
+    }
+
+    fn gaps(r: &[u64]) -> Vec<u64> {
+        r.windows(2).map(|w| w[1] - w[0]).collect()
+    }
+
+    #[test]
+    fn fast_frames_wait_for_the_grid() {
+        let mut p = Pacer::new(P30);
+        let r = run(&mut p, &[5 * MS; 20]);
+        assert!(gaps(&r).iter().all(|&g| g == P30), "{:?}", gaps(&r));
+    }
+
+    #[test]
+    fn jittery_frames_come_out_even() {
+        let mut p = Pacer::new(P30);
+        let costs: Vec<u64> = (0..60).map(|i| [4, 28, 12, 30, 9][i % 5] * MS).collect();
+        let r = run(&mut p, &costs);
+        assert!(gaps(&r).iter().all(|&g| g == P30));
+    }
+
+    #[test]
+    fn a_stall_starts_a_new_grid_without_a_burst() {
+        let mut p = Pacer::new(P30);
+        let mut costs = vec![10 * MS; 10];
+        costs.push(120 * MS);
+        costs.extend([MS; 10]);
+        let r = run(&mut p, &costs);
+        let g = gaps(&r);
+        // After the stall no two presents are closer than a period.
+        assert!(g.iter().all(|&x| x >= P30), "{g:?}");
+        assert!(g[10..].iter().all(|&x| x == P30));
+    }
+
+    #[test]
+    fn slightly_late_keeps_the_grid() {
+        let mut p = Pacer::new(P30);
+        run(&mut p, &[5 * MS; 40]);
+        let t0 = p.released;
+        // 5 ms late: released at once.
+        let late = t0 + P30 + 5 * MS;
+        assert_eq!(p.release_at(late), late);
+        // The next early frame lands back on the original grid.
+        assert_eq!(p.release_at(late + MS), t0 + 2 * P30);
+    }
+
+    #[test]
+    fn slow_frames_pace_to_a_whole_multiple() {
+        let mut p = Pacer::new(P30 / 2); // 60 fps base
+        let r = run(&mut p, &[45 * MS; 60]);
+        let g = gaps(&r);
+        assert_eq!(p.period(), 3 * (P30 / 2));
+        assert!(g[10..].iter().all(|&x| x == p.period()), "{g:?}");
+    }
+
+    #[test]
+    fn the_multiple_comes_down_only_after_frames_fit() {
+        let mut p = Pacer::new(P30 / 2);
+        run(&mut p, &[40 * MS; 40]);
+        assert_eq!(p.multiple, 3);
+        run(&mut p, &[5 * MS; 5]);
+        assert_eq!(p.multiple, 3, "one fast frame must not drop the multiple");
+        run(&mut p, &[5 * MS; 200]);
+        assert_eq!(p.multiple, 1);
+    }
+
+    #[test]
+    fn multiple_is_capped() {
+        let mut p = Pacer::new(P30);
+        run(&mut p, &[2_000 * MS; 10]);
+        assert_eq!(p.multiple, MAX_MULTIPLE);
+    }
+
+    #[test]
+    fn phase_errors_point_to_the_nearest_tick() {
+        assert_eq!(phase_error(0, 100), 0);
+        assert_eq!(phase_error(10, 100), 10);
+        assert_eq!(phase_error(90, 100), -10);
+        assert_eq!(phase_error(250, 100), 50 - 100);
+        assert_eq!(phase_nudge(1_016, 1_000), 2);
+        // Repeated nudges converge on the event.
+        let (mut start, event, interval) = (0i64, 7_400i64, 1_000u64);
+        for _ in 0..100 {
+            start += phase_nudge((event - start) as u64, interval);
+        }
+        assert!(phase_error((event - start) as u64, interval).abs() <= 8);
+    }
+
+    #[test]
+    fn quantiles_and_window() {
+        let v: Vec<u64> = (1..=100).collect();
+        assert_eq!(quantile(&v, 0.5), 50);
+        assert_eq!(quantile(&v, 0.95), 95);
+        assert_eq!(quantile(&v, 0.99), 99);
+        assert_eq!(quantile(&v, 1.0), 100);
+        assert_eq!(quantile(&[], 0.5), 0);
+        let mut w = Window::default();
+        for (i, t) in [0, 30, 70, 100].iter().enumerate() {
+            w.present(t * MS, (i > 0).then_some(20 * MS));
+        }
+        let s = w.summary();
+        assert_eq!(s.frames, 3);
+        assert_eq!(s.p50_ms, 30.0);
+        assert_eq!(s.p99_ms, 40.0);
+        assert!((s.jitter_ms - 10.0).abs() < 1e-9);
+        assert_eq!(s.latency_p50_ms, 20.0);
+        assert!(w.take_if_due(500 * MS).is_none());
+        assert!(w.take_if_due(1_000 * MS).is_some());
+        assert_eq!(w.summary().frames, 0);
+    }
+
+    #[test]
+    fn switches_from_the_environment() {
+        let none = Switches::from_lookup(|_| None);
+        assert_eq!(none, Switches::default());
+        let s = Switches::from_lookup(|n| match n {
+            "VICTORY_PACE" => Some("1".into()),
+            "VICTORY_PACE_LATENCY" => Some("5".into()),
+            "VICTORY_PACE_FPS" => Some("60".into()),
+            _ => None,
+        });
+        assert!(s.pace && s.input && s.feedback && s.stats);
+        assert_eq!((s.latency, s.fps), (2, Some(60)));
+        let s = Switches::from_lookup(|n| (n == "VICTORY_PACE_STATS").then(|| "1".into()));
+        assert!(s.stats && !s.pace && !s.input && !s.feedback);
+    }
+
+    #[test]
+    fn limiter_holds_an_even_grid_and_resyncs_after_a_stall() {
+        let mut l = Limiter::default();
+        let mut now = 0;
+        let mut starts = Vec::new();
+        for c in [5, 20, 3, 30, 10, 5].map(|c| c * MS) {
+            let at = l.start_at(now, P30);
+            starts.push(at);
+            now = at + c;
+        }
+        assert!(gaps(&starts).iter().all(|&g| g == P30), "{:?}", gaps(&starts));
+        // 5 ms late: at once, grid kept.
+        let t = *starts.last().unwrap() + P30;
+        assert_eq!(l.start_at(t + 5 * MS, P30), t + 5 * MS);
+        assert_eq!(l.start_at(t + 6 * MS, P30), t + P30);
+        // A stall: a new grid from now, then a full period.
+        let s = t + 500 * MS;
+        assert_eq!(l.start_at(s, P30), s);
+        assert_eq!(l.start_at(s + MS, P30), s + P30);
+    }
+
+    #[test]
+    fn low_latency_defaults() {
+        let s = Switches::from_lookup(|n| (n == "VICTORY_LOW_LATENCY").then(|| "1".into()));
+        assert!(s.low_latency && s.tearing && s.input && s.stats && s.feedback);
+        assert_eq!(s.latency, 1);
+        let s = Switches::from_lookup(|n| match n {
+            "VICTORY_LOW_LATENCY" => Some("1".into()),
+            "VICTORY_FPS_CAP" => Some("30".into()),
+            "VICTORY_PACE_LATENCY" => Some("2".into()),
+            _ => None,
+        });
+        assert!(!s.tearing);
+        assert_eq!(s.latency, 2);
+    }
+
+    #[test]
+    fn latency_counts_each_read_once() {
+        input_sampled(10 * MS);
+        input_read();
+        assert_eq!(input_latency(40 * MS), Some(30 * MS));
+        assert_eq!(input_latency(50 * MS), None);
+    }
+}
diff --git a/crates/victory-core/src/pagemap.rs b/crates/victory-core/src/pagemap.rs
new file mode 100644
index 0000000..a2afc87
--- /dev/null
+++ b/crates/victory-core/src/pagemap.rs
@@ -0,0 +1,310 @@
+//! How a batch of page mappings is cut into as few host operations as
+//! possible (`VICTORY_PAGEMAP_RUNS=1`, `victory-hle` xmem and `victory-gpu`
+//! queue `CopyPageMappingsBatchX`).
+//!
+//! The title's texture streamer maps its pages in batches: one
+//! `XMemMapPhysicalPagesScatter(addresses, n, pages)` per flush, addresses
+//! sorted and without neighbours that repeat, then one
+//! `CopyPageMappingsBatchX` that maps the same pool pages at the tiled
+//! resources' addresses. The runtime did both one 64 KiB page at a time:
+//! a lock, a wait for reads in place, an unmap, a placeholder split, a map,
+//! a commit and two rounds of notifications per page.
+//!
+//! [`scatter_groups`] cuts a Scatter batch into groups of consecutive
+//! addresses that are all mapped or all unmapped: each group is then one
+//! unmap pass and one map call over a range (which itself makes one view
+//! per run of consecutive pages). The order of the entries is kept, so an
+//! address named twice ends as the title's last entry says, as before.
+//!
+//! [`merge_alias`] joins the ranges of a page-mapping batch where the
+//! destinations follow each other and the sources do too (kind 0 after kind
+//! 0) or both unmap; a range of one page repeated (kind 1) stays one
+//! operation of its own over all its destination pages.
+//!
+//! [`Notes`] collects the ranges whose mapping changed and the views made
+//! during a batch, so the GPU side is told once per joined range instead of
+//! once per page. Platform-neutral, so it is tested on any host.
+
+/// Bytes per mapped page.
+pub const PAGE: usize = 64 << 10;
+
+/// Groups of a Scatter batch: `(first entry, entries)`, in order. Entries
+/// `i` and `i + 1` share a group when `addresses[i + 1]` is one page after
+/// `addresses[i]` and both map or both unmap (`unmaps(i)`).
+pub fn scatter_groups(addresses: &[usize], unmaps: impl Fn(usize) -> bool) -> Vec<(usize, usize)> {
+    let mut groups: Vec<(usize, usize)> = Vec::new();
+    for i in 0..addresses.len() {
+        let joins = i > 0
+            && addresses[i - 1].checked_add(PAGE) == Some(addresses[i])
+            && unmaps(i - 1) == unmaps(i);
+        match groups.last_mut() {
+            Some(g) if joins => g.1 += 1,
+            _ => groups.push((i, 1)),
+        }
+    }
+    groups
+}
+
+/// One operation of a page-mapping batch: map `len` bytes of what is shown
+/// at `from` (or unmap, `from` `None`) at `to`. With `repeat` the one page
+/// at `from` is shown at every page of `[to, to + len)`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AliasOp {
+    pub to: u64,
+    pub from: Option<u64>,
+    pub len: u64,
+    pub repeat: bool,
+}
+
+impl AliasOp {
+    /// Destination pages.
+    pub fn pages(&self) -> u64 {
+        self.len / PAGE as u64
+    }
+}
+
+/// `ops` with neighbours joined where that maps the same: destinations that
+/// follow each other, and either both unmap, or neither repeats and the
+/// sources follow each other too. A repeated page joins only another range
+/// repeating the same page right after it.
+pub fn merge_alias(ops: &[AliasOp]) -> Vec<AliasOp> {
+    let mut out: Vec<AliasOp> = Vec::with_capacity(ops.len());
+    for &op in ops.iter().filter(|o| o.len > 0) {
+        if let Some(last) = out.last_mut()
+            && last.to.checked_add(last.len) == Some(op.to)
+        {
+            let joins = match (last.from, op.from) {
+                (None, None) => true,
+                (Some(a), Some(b)) if !last.repeat && !op.repeat => a.checked_add(last.len) == Some(b),
+                (Some(a), Some(b)) if last.repeat && op.repeat => a == b,
+                _ => false,
+            };
+            // A one-page range of either kind is the same as the other.
+            let one = |o: &AliasOp| o.len == PAGE as u64;
+            let joins = joins
+                || matches!((last.from, op.from), (Some(a), Some(b))
+                    if last.repeat && one(&op) && a == b)
+                || matches!((last.from, op.from), (Some(a), Some(b))
+                    if op.repeat && one(last) && a == b);
+            if joins {
+                if one(last) && op.repeat {
+                    last.repeat = true;
+                }
+                last.len += op.len;
+                continue;
+            }
+        }
+        out.push(op);
+    }
+    out
+}
+
+/// What changed during a batch, for one round of notifications at its end.
+#[derive(Default, Debug)]
+pub struct Notes {
+    /// Ranges whose mapping changed, `[from, to)`.
+    changed: Vec<(usize, usize)>,
+    /// Views made: address, bytes and what they show (opaque to this
+    /// module: section and offset).
+    views: Vec<(usize, usize, usize, u64)>,
+}
+
+impl Notes {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn changed(&mut self, at: usize, len: usize) {
+        if len > 0 {
+            self.changed.push((at, at.saturating_add(len)));
+        }
+    }
+
+    pub fn view(&mut self, at: usize, len: usize, section: usize, offset: u64) {
+        self.views.push((at, len, section, offset));
+    }
+
+    /// The changed ranges, sorted and joined where they overlap or touch.
+    pub fn changed_joined(&self) -> Vec<(usize, usize)> {
+        let mut all = self.changed.clone();
+        all.sort_unstable();
+        let mut out: Vec<(usize, usize)> = Vec::with_capacity(all.len());
+        for (from, to) in all {
+            match out.last_mut() {
+                Some(last) if from <= last.1 => last.1 = last.1.max(to),
+                _ => out.push((from, to)),
+            }
+        }
+        out
+    }
+
+    /// The views made that `alive(at, len)` says are still mapped as made
+    /// (a later entry of the batch may have unmapped one again), in the
+    /// order made.
+    pub fn views_alive(&self, alive: impl Fn(usize, usize) -> bool) -> Vec<(usize, usize, usize, u64)> {
+        let mut seen = std::collections::HashSet::new();
+        // The last made at an address is the one that may still be there.
+        let mut out: Vec<_> = self
+            .views
+            .iter()
+            .rev()
+            .filter(|v| seen.insert(v.0) && alive(v.0, v.1))
+            .copied()
+            .collect();
+        out.reverse();
+        out
+    }
+
+    /// Views noted.
+    pub fn views(&self) -> usize {
+        self.views.len()
+    }
+
+    /// Changes noted (before joining).
+    pub fn changes(&self) -> usize {
+        self.changed.len()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const P: usize = PAGE;
+
+    #[test]
+    fn scatter_groups_join_consecutive_addresses_of_one_kind() {
+        let base = 0x10_0000_0000usize;
+        let addresses = [base, base + P, base + 2 * P, base + 5 * P, base + 6 * P, base + 7 * P, base + 8 * P];
+        // Entry 4 unmaps: it cuts 3..=6 in three.
+        let unmaps = |i: usize| i == 4;
+        assert_eq!(scatter_groups(&addresses, unmaps), vec![(0, 3), (3, 1), (4, 1), (5, 2)]);
+        // Two unmaps next to each other join.
+        let unmaps = |i: usize| i == 4 || i == 5;
+        assert_eq!(scatter_groups(&addresses, unmaps), vec![(0, 3), (3, 1), (4, 2), (6, 1)]);
+    }
+
+    #[test]
+    fn scatter_groups_keep_order_and_repeats_apart() {
+        let base = 0x2000_0000usize;
+        // Not sorted, and one address twice: nothing joins backwards, and
+        // the repeat stays its own group after the first.
+        let addresses = [base + P, base, base + P, base + P];
+        assert_eq!(scatter_groups(&addresses, |_| false), vec![(0, 1), (1, 2), (3, 1)]);
+        assert!(scatter_groups(&[], |_| false).is_empty());
+        // The end of the address space does not wrap into a join.
+        assert_eq!(scatter_groups(&[usize::MAX - P + 1, 0], |_| false), vec![(0, 1), (1, 1)]);
+    }
+
+    #[test]
+    fn scatter_groups_cover_every_entry_once() {
+        let base = 0x4000_0000usize;
+        let addresses: Vec<usize> = (0..100).map(|i| base + (i + i / 7) * P).collect();
+        let groups = scatter_groups(&addresses, |i| i % 13 == 0);
+        let mut next = 0;
+        for (first, n) in &groups {
+            assert_eq!(*first, next);
+            assert!(*n > 0);
+            next += n;
+        }
+        assert_eq!(next, addresses.len());
+        assert!(groups.len() < addresses.len());
+    }
+
+    fn op(to: u64, from: Option<u64>, pages: u64, repeat: bool) -> AliasOp {
+        AliasOp { to, from, len: pages * P as u64, repeat }
+    }
+
+    #[test]
+    fn alias_runs_join_when_both_sides_follow() {
+        let (d, s) = (0x80_0000_0000u64, 0x1_0000_0000u64);
+        let p = P as u64;
+        let ops = [
+            op(d, Some(s), 2, false),
+            op(d + 2 * p, Some(s + 2 * p), 1, false), // follows: joins
+            op(d + 3 * p, Some(s + 9 * p), 1, false), // source jumps: new
+            op(d + 4 * p, None, 2, false),            // unmap: new
+            op(d + 6 * p, None, 3, false),            // unmap after unmap: joins
+            op(d + 20 * p, None, 1, false),           // destination jumps: new
+        ];
+        assert_eq!(
+            merge_alias(&ops),
+            vec![
+                op(d, Some(s), 3, false),
+                op(d + 3 * p, Some(s + 9 * p), 1, false),
+                op(d + 4 * p, None, 5, false),
+                op(d + 20 * p, None, 1, false),
+            ]
+        );
+    }
+
+    #[test]
+    fn a_repeated_page_joins_only_the_same_page() {
+        let (d, s) = (0x80_0000_0000u64, 0x1_0000_0000u64);
+        let p = P as u64;
+        let ops = [
+            op(d, Some(s), 4, true),
+            op(d + 4 * p, Some(s), 2, true),       // same page repeated: joins
+            op(d + 6 * p, Some(s), 1, false),      // one page of it: joins
+            op(d + 7 * p, Some(s + p), 2, false),  // a run from the next page: new
+            op(d + 9 * p, Some(s + p), 3, true),   // another page repeated: new
+        ];
+        assert_eq!(
+            merge_alias(&ops),
+            vec![op(d, Some(s), 7, true), op(d + 7 * p, Some(s + p), 2, false), op(d + 9 * p, Some(s + p), 3, true)]
+        );
+        // A one-page run then the same page repeated: one repeated range.
+        assert_eq!(merge_alias(&[op(d, Some(s), 1, false), op(d + p, Some(s), 2, true)]), vec![op(d, Some(s), 3, true)]);
+        // Empty ranges go.
+        assert!(merge_alias(&[op(d, Some(s), 0, false)]).is_empty());
+    }
+
+    #[test]
+    fn merged_ops_map_the_same_pages_as_the_ops() {
+        // Page by page, what each destination page shows.
+        fn expand(ops: &[AliasOp]) -> Vec<(u64, Option<u64>)> {
+            let p = P as u64;
+            ops.iter()
+                .flat_map(|o| {
+                    (0..o.pages()).map(move |k| (o.to + k * p, o.from.map(|f| if o.repeat { f } else { f + k * p })))
+                })
+                .collect()
+        }
+        let (d, s) = (0x80_0000_0000u64, 0x1_0000_0000u64);
+        let p = P as u64;
+        let mut ops = Vec::new();
+        let mut at = d;
+        for i in 0..200u64 {
+            let pages = 1 + i % 3;
+            let o = match i % 5 {
+                0 | 1 => op(at, Some(s + (i / 2) * 3 * p), pages, false),
+                2 => op(at, Some(s + 7 * p), pages, true),
+                3 => op(at, None, pages, false),
+                _ => op(at, Some(s + 7 * p), 1, false),
+            };
+            ops.push(o);
+            at += pages * p + if i % 11 == 0 { p } else { 0 };
+        }
+        let merged = merge_alias(&ops);
+        assert!(merged.len() < ops.len());
+        assert_eq!(expand(&merged), expand(&ops));
+    }
+
+    #[test]
+    fn notes_join_changes_and_keep_the_last_view_at_an_address() {
+        let mut n = Notes::new();
+        n.changed(0x3000, 0x1000);
+        n.changed(0x1000, 0x1000);
+        n.changed(0x2000, 0x1000);
+        n.changed(0x2400, 0x200);
+        n.changed(0x9000, 0);
+        n.changed(0x8000, 0x1000);
+        assert_eq!(n.changed_joined(), vec![(0x1000, 0x4000), (0x8000, 0x9000)]);
+        assert_eq!(n.changes(), 5);
+        n.view(0x1000, 0x1000, 7, 0);
+        n.view(0x2000, 0x1000, 7, 0x1000);
+        n.view(0x1000, 0x2000, 8, 0); // mapped again at the same address
+        let alive = n.views_alive(|at, len| !(at == 0x2000 && len == 0x1000));
+        assert_eq!(alive, vec![(0x1000, 0x2000, 8, 0)]);
+    }
+}
diff --git a/crates/victory-core/src/prep.rs b/crates/victory-core/src/prep.rs
new file mode 100644
index 0000000..c940a16
--- /dev/null
+++ b/crates/victory-core/src/prep.rs
@@ -0,0 +1,518 @@
+//! Per-op recording and preparing logic that needs no GPU, behind the
+//! `VICTORY_PREP_*` switches of `victory-gpu`: which held barriers can be
+//! recorded as one call (and which of them are no-ops), which descriptor
+//! table sets repeat what the list already has, and which pending refreshes
+//! a title copy must wait for. Kept here so it is tested on every host.
+
+/// D3D12 resource states that only read (`D3D12_RESOURCE_STATE_*`): vertex
+/// and constant buffer, index buffer, depth read, non-pixel and pixel shader
+/// resource, indirect argument, copy source, resolve source, shading rate
+/// source. `COMMON` (0) is not among them: it decays and promotes.
+pub const READ_ONLY_STATES: u32 = 0x1 | 0x2 | 0x20 | 0x40 | 0x80 | 0x200 | 0x800 | 0x2000 | 0x0100_0000;
+
+/// Whether `state` is a non-empty combination of read-only states.
+pub const fn read_only(state: u32) -> bool {
+    state != 0 && state & !READ_ONLY_STATES == 0
+}
+
+/// One held barrier, as the coalescing sees it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Held {
+    /// A transition of `resource`'s `subresource` (`flags`: split-barrier
+    /// bits; only whole barriers, `flags == 0`, are folded).
+    Transition { resource: usize, subresource: u32, before: u32, after: u32, flags: u32 },
+    /// A wait for unordered access to `resource` (0: all resources).
+    Uav { resource: usize },
+    /// Anything else (aliasing): kept, and nothing folds across it.
+    Other,
+}
+
+/// What [`coalesce`] keeps of a run of held barriers recorded with no work
+/// between them: indices into the input, in order, each with the `before`
+/// state a folded transition starts from (`None`: as it was).
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Coalesced {
+    pub keep: Vec<(usize, Option<u32>)>,
+    /// Transitions whose state does not change (left out).
+    pub noops: u32,
+    /// Waits for unordered access another wait in the run already covers.
+    pub uavs_dropped: u32,
+    /// Pairs `A -> B`, `B -> C` of one subresource made one `A -> C` (`B`
+    /// read-only, `A != C`).
+    pub folded: u32,
+}
+
+/// Coalesces `held` (barriers with no work recorded between them) into
+/// what one `ResourceBarrier` call needs, in order:
+/// - a transition whose before and after are equal is left out;
+/// - a wait for unordered access is left out when an earlier one in the run
+///   covers it (one on all resources, or one on the same resource), unless
+///   an aliasing barrier lies between;
+/// - `A -> B` then `B -> C` of the same subresource become `A -> C` at the
+///   later one's place when `B` only reads and `A != C` (no work ran in `B`,
+///   and `A -> C` makes `A`'s writes visible as `A -> B` did). `A == C` is
+///   kept as two transitions: the pair still orders writes of `A`.
+///
+/// Nothing is reordered relative to barriers of the same resource.
+pub fn coalesce(held: &[Held]) -> Coalesced {
+    let mut out = Coalesced::default();
+    // Per kept entry: its input and its current `before` (folds rewrite it).
+    let mut kept: Vec<(usize, Option<u32>)> = Vec::with_capacity(held.len());
+    let mut all_uav = false;
+    let mut uavs: Vec<usize> = Vec::new();
+    for (i, h) in held.iter().enumerate() {
+        match *h {
+            Held::Transition { before, after, .. } if before == after => out.noops += 1,
+            Held::Transition { resource, subresource, before, after, flags } => {
+                // The last kept transition of this subresource, if nothing
+                // other than barriers of other resources lies between.
+                let last = kept.iter().rposition(|&(k, _)| match held[k] {
+                    Held::Transition { resource: r, .. } => r == resource,
+                    Held::Other => true,
+                    Held::Uav { resource: r } => r == resource || r == 0,
+                });
+                let fold = last.and_then(|at| {
+                    let (k, b) = kept[at];
+                    match held[k] {
+                        Held::Transition { resource: r, subresource: s, before: first, after: middle, flags: f }
+                            if r == resource && s == subresource && f == 0 && flags == 0 && middle == before =>
+                        {
+                            let first = b.unwrap_or(first);
+                            (read_only(middle) && first != after).then_some((at, first))
+                        }
+                        _ => None,
+                    }
+                });
+                match fold {
+                    Some((at, first)) => {
+                        kept.remove(at);
+                        kept.push((i, Some(first)));
+                        out.folded += 1;
+                    }
+                    None => kept.push((i, None)),
+                }
+            }
+            Held::Uav { resource } => {
+                if all_uav || (resource != 0 && uavs.contains(&resource)) {
+                    out.uavs_dropped += 1;
+                } else {
+                    if resource == 0 {
+                        all_uav = true;
+                    } else {
+                        uavs.push(resource);
+                    }
+                    kept.push((i, None));
+                }
+            }
+            Held::Other => {
+                all_uav = false;
+                uavs.clear();
+                kept.push((i, None));
+            }
+        }
+    }
+    out.keep = kept;
+    out
+}
+
+/// The descriptor tables a list has set per root parameter, for skipping a
+/// set of the same table again. Valid only for the root signature binding
+/// that was current when they were set: [`TableCache::root_set`] forgets
+/// them (setting a root signature on a list invalidates its root
+/// arguments; so does a change of descriptor heaps, which sets the root
+/// signature again).
+#[derive(Clone, Debug)]
+pub struct TableCache {
+    handles: [u64; 64],
+    valid: u64,
+}
+
+impl Default for TableCache {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl TableCache {
+    pub const fn new() -> Self {
+        Self { handles: [0; 64], valid: 0 }
+    }
+
+    /// A root signature was set (or may have been): nothing is known set.
+    pub fn root_set(&mut self) {
+        self.valid = 0;
+    }
+
+    /// Whether a set of `handle` at `param` must be recorded (and notes it
+    /// set). Parameters past 63 are always recorded.
+    pub fn set(&mut self, param: u32, handle: u64) -> bool {
+        let Some(bit) = 1u64.checked_shl(param) else {
+            return true;
+        };
+        if self.valid & bit != 0 && self.handles[param as usize] == handle {
+            return false;
+        }
+        self.valid |= bit;
+        self.handles[param as usize] = handle;
+        true
+    }
+}
+
+/// Whether `[a0, a1)` and `[b0, b1)` share a page of `page` bytes (empty
+/// ranges share none). A title copy into one range must first finish
+/// pending refreshes of the other when they do: refreshes take whole
+/// written pages.
+pub fn pages_meet((a0, a1): (usize, usize), (b0, b1): (usize, usize), page: usize) -> bool {
+    if a0 >= a1 || b0 >= b1 || page == 0 {
+        return a0 < a1 && b0 < b1 && a0 < b1 && b0 < a1;
+    }
+    let (a0, a1) = (a0 / page, a1.div_ceil(page));
+    let (b0, b1) = (b0 / page, b1.div_ceil(page));
+    a0 < b1 && b0 < a1
+}
+
+/// The root arguments a list has set per root parameter besides
+/// descriptor tables (`VICTORY_STATE_DEDUP`): 32-bit constants (all their
+/// words) and root views (kind and address), for skipping a set that
+/// repeats what the list already has. Like [`TableCache`] valid only while
+/// the root signature binding stands: [`RootArgCache::root_set`] forgets
+/// everything. Compared exactly (the words themselves, not a hash).
+#[derive(Clone, Debug, Default)]
+pub struct RootArgCache {
+    /// Per parameter: 32-bit constants as last set.
+    constants: Vec<Option<Vec<u32>>>,
+    /// Per parameter: a root view's kind (0 CBV, 1 SRV, 2 UAV) and address.
+    views: Vec<Option<(u8, u64)>>,
+    /// Bumped by every [`RootArgCache::root_set`]: the generation of what
+    /// is known.
+    pub generation: u64,
+}
+
+impl RootArgCache {
+    /// A root signature was set (or may have been): nothing is known set.
+    pub fn root_set(&mut self) {
+        self.constants.iter_mut().for_each(|c| {
+            if let Some(v) = c {
+                v.clear();
+            }
+            *c = None;
+        });
+        self.views.iter_mut().for_each(|v| *v = None);
+        self.generation = self.generation.wrapping_add(1);
+    }
+
+    /// Whether a set of `values` as the 32-bit constants at `param` must be
+    /// recorded (and notes them set).
+    pub fn set_constants(&mut self, param: u32, values: &[u32]) -> bool {
+        let p = param as usize;
+        if p >= 64 {
+            return true;
+        }
+        if self.constants.len() <= p {
+            self.constants.resize_with(p + 1, || None);
+        }
+        match &mut self.constants[p] {
+            Some(v) if v.as_slice() == values => false,
+            slot => {
+                let mut v = slot.take().unwrap_or_default();
+                v.clear();
+                v.extend_from_slice(values);
+                *slot = Some(v);
+                true
+            }
+        }
+    }
+
+    /// Whether a set of a root view of `kind` at `address` at `param` must
+    /// be recorded (and notes it set).
+    pub fn set_view(&mut self, param: u32, kind: u8, address: u64) -> bool {
+        let p = param as usize;
+        if p >= 64 {
+            return true;
+        }
+        if self.views.len() <= p {
+            self.views.resize(p + 1, None);
+        }
+        if self.views[p] == Some((kind, address)) {
+            return false;
+        }
+        self.views[p] = Some((kind, address));
+        true
+    }
+}
+
+/// What [`KickMerge::offer`] says of a title submission (`VICTORY_KICK_MERGE`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kick {
+    /// Held with the pending ones; nothing goes to the card yet.
+    Joined,
+    /// Held, and the pending ones (it among them) go to the card now: the
+    /// most a merged submission takes was reached.
+    JoinedFlush,
+    /// Not mergeable: the pending ones go first, then this one on its own.
+    FlushThenAlone,
+}
+
+/// The title's submissions sent ahead with no wait between them, held for
+/// one host submission (`VICTORY_KICK_MERGE`). A title that submits early
+/// whenever its command ring is half full makes many small submissions;
+/// each one costs a whole preparing (settle checks, sweep, the compare of
+/// copies in the card, a flight to land). Order is kept: only submissions
+/// of one queue, one after another, with nothing between them that orders
+/// against the card (a fence signal or wait, a present, a submission of
+/// another queue, a synchronous one, a read of the card's results) are
+/// joined; anything else flushes the pending ones first.
+#[derive(Clone, Debug, Default)]
+pub struct KickMerge {
+    /// The queue the pending submissions are of, and how many there are.
+    pub queue: usize,
+    pub pending: usize,
+    /// Lists pending.
+    pub lists: usize,
+}
+
+impl KickMerge {
+    /// A submission of `lists` lists to `queue`; `mergeable`: it runs at
+    /// once as a whole, not waited for (no memory-value waits, nothing
+    /// held on its queue). `most`: the most submissions joined in one.
+    pub fn offer(&mut self, queue: usize, lists: usize, mergeable: bool, most: usize) -> Kick {
+        if !mergeable || (self.pending > 0 && self.queue != queue) {
+            return Kick::FlushThenAlone;
+        }
+        self.queue = queue;
+        self.pending += 1;
+        self.lists += lists;
+        if self.pending >= most.max(1) { Kick::JoinedFlush } else { Kick::Joined }
+    }
+
+    /// The pending ones were sent: how many submissions that was.
+    pub fn take(&mut self) -> usize {
+        let n = self.pending;
+        (self.pending, self.lists) = (0, 0);
+        n
+    }
+}
+
+#[cfg(test)]
