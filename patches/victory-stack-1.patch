new file mode 100644
index 0000000..9520fca
--- /dev/null
+++ b/crates/victory-gpu/src/fsr.rs
@@ -0,0 +1,833 @@
+//! AMD FSR 3 upscaling and frame generation on the host, through the PC
+//! FidelityFX API (`ffx_api.h`), loaded at run time.
+//!
+//! The title calls the console FidelityFX upscaler with a
+//! `ffxDispatchDescUpscale` (`victory_hle::modules::ffx`). The PC API takes
+//! the very same description, so the dispatch is answered by the PC
+//! upscaler with the title's numbers and our host copies of its textures.
+//!
+//! The DLL is not part of this build. It is looked for, in order, at
+//! `VICTORY_FFX_DLL`, then next to the executable as
+//! `amd_fidelityfx_loader_dx12.dll` (FidelityFX SDK 2.x signed binaries,
+//! AMD's binary-only licence) and `amd_fidelityfx_dx12.dll` (SDK 1.1.x,
+//! MIT, buildable from source). Without one, the upscale falls back to the
+//! plain stretch ([`crate::over`]).
+//!
+//! Frame generation (`VICTORY_FRAMEGEN=1`) replaces the presenter's swap
+//! chain with the API's frame-generation swap chain
+//! ([`framegen_swap_chain`]) and, at each upscale, configures generation
+//! (the upscaled image before the title's UI as the HUD-less colour) and
+//! records its prepare pass. A gate keeps it off under a 15 fps base rate
+//! ([`victory_core::upscale::FramegenGate`]).
+
+use std::ffi::c_void;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, AtomicPtr, AtomicU64, Ordering};
+
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::*;
+use windows::Win32::Graphics::Dxgi::*;
+use windows::core::Interface;
+
+use victory_core::upscale::{FramegenGate, HostParams, Plumbing, TitleParams};
+
+// ---------------------------------------------------------------------------
+// The API's types (ffx_api.h, ffx_api_types.h, ffx_upscale.h,
+// ffx_framegeneration.h, dx12/ffx_api_dx12.h, ffx_api_framegeneration_dx12.h)
+// ---------------------------------------------------------------------------
+
+#[repr(C)]
+struct Header {
+    kind: u64,
+    next: *const Header,
+}
+
+impl Header {
+    fn new(kind: u64) -> Header {
+        Header { kind, next: std::ptr::null() }
+    }
+}
+
+/// `FfxApiResource`: a pointer, a description (type, format, width,
+/// height, depth, mips, flags, usage) and a state.
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Resource {
+    pub resource: *mut c_void,
+    pub description: [u32; 8],
+    pub state: u32,
+}
+
+impl Resource {
+    pub(crate) const NONE: Resource = Resource { resource: std::ptr::null_mut(), description: [0; 8], state: 0 };
+}
+
+const OK: u32 = 0;
+
+const CREATE_UPSCALE: u64 = 0x0001_0000;
+const DISPATCH_UPSCALE: u64 = 0x0001_0001;
+const CREATE_BACKEND_DX12: u64 = 0x0000_0002;
+const CREATE_FRAMEGEN: u64 = 0x0002_0001;
+const CONFIGURE_FRAMEGEN: u64 = 0x0002_0002;
+const DISPATCH_FRAMEGEN_PREPARE: u64 = 0x0002_0004;
+const CREATE_FRAMEGEN_HUDLESS: u64 = 0x0002_0009;
+const CREATE_FGSWAPCHAIN_FOR_HWND_DX12: u64 = 0x0003_0006;
+
+/// `FFX_API_RESOURCE_STATE_*`.
+const STATE_UNORDERED: u32 = 1 << 1;
+const STATE_COMPUTE_READ: u32 = 1 << 2;
+/// `FFX_API_RESOURCE_TYPE_TEXTURE2D`.
+const TYPE_TEXTURE2D: u32 = 2;
+/// `FFX_API_RESOURCE_USAGE_*`.
+const USAGE_UAV: u32 = 1 << 1;
+const USAGE_DEPTH: u32 = 1 << 2;
+const USAGE_STENCIL: u32 = 1 << 5;
+
+/// `FFX_UPSCALE_ENABLE_DEPTH_INVERTED`, `_DEPTH_INFINITE`, `_DYNAMIC_RESOLUTION`.
+const UPSCALE_DEPTH_INVERTED: u32 = 1 << 3;
+const UPSCALE_DEPTH_INFINITE: u32 = 1 << 4;
+const UPSCALE_DYNAMIC_RESOLUTION: u32 = 1 << 6;
+/// `FFX_UPSCALE_ENABLE_MOTION_VECTORS_JITTER_CANCELLATION` and the
+/// frame-generation flags of the same meaning.
+const UPSCALE_JITTER_CANCELLATION: u32 = 1 << 2;
+const FG_JITTER_CANCELLATION: u32 = 1 << 2;
+const FG_DEPTH_INVERTED: u32 = 1 << 3;
+const FG_DEPTH_INFINITE: u32 = 1 << 4;
+const FG_HDR: u32 = 1 << 5;
+const UPSCALE_HDR: u32 = 1 << 0;
+
+#[repr(C)]
+struct CreateBackendDx12 {
+    header: Header,
+    device: *mut c_void,
+}
+
+#[repr(C)]
+struct CreateUpscale {
+    header: Header,
+    flags: u32,
+    max_render: [u32; 2],
+    max_upscale: [u32; 2],
+    message: Option<extern "C" fn(u32, *const u16)>,
+}
+
+/// `ffxDispatchDescUpscale`, as the title lays it out too.
+#[repr(C)]
+struct DispatchUpscale {
+    header: Header,
+    list: *mut c_void,
+    colour: Resource,
+    depth: Resource,
+    motion: Resource,
+    exposure: Resource,
+    reactive: Resource,
+    composition: Resource,
+    output: Resource,
+    jitter: [f32; 2],
+    motion_scale: [f32; 2],
+    render: [u32; 2],
+    upscale: [u32; 2],
+    sharpening: bool,
+    sharpness: f32,
+    frame_ms: f32,
+    pre_exposure: f32,
+    reset: bool,
+    near: f32,
+    far: f32,
+    fov_y: f32,
+    meters: f32,
+    flags: u32,
+}
+
+#[repr(C)]
+struct CreateFramegen {
+    header: Header,
+    flags: u32,
+    display: [u32; 2],
+    max_render: [u32; 2],
+    back_buffer_format: u32,
+}
+
+#[repr(C)]
+struct CreateFramegenHudless {
+    header: Header,
+    hudless_format: u32,
+}
+
+#[repr(C)]
+struct FgSwapChainForHwnd {
+    header: Header,
+    swap_chain: *mut *mut c_void,
+    hwnd: *mut c_void,
+    desc: *const DXGI_SWAP_CHAIN_DESC1,
+    fullscreen: *const c_void,
+    factory: *mut c_void,
+    queue: *mut c_void,
+}
+
+type FgDispatchCallback = extern "C" fn(*mut c_void, *mut c_void) -> u32;
+
+#[repr(C)]
+struct ConfigureFramegen {
+    header: Header,
+    swap_chain: *mut c_void,
+    present_callback: *const c_void,
+    present_context: *mut c_void,
+    framegen_callback: Option<FgDispatchCallback>,
+    framegen_context: *mut c_void,
+    enabled: bool,
+    allow_async: bool,
+    hudless: Resource,
+    flags: u32,
+    only_generated: bool,
+    rect: [i32; 4],
+    frame_id: u64,
+}
+
+#[repr(C)]
+struct DispatchFramegenPrepare {
+    header: Header,
+    frame_id: u64,
+    flags: u32,
+    list: *mut c_void,
+    render: [u32; 2],
+    jitter: [f32; 2],
+    motion_scale: [f32; 2],
+    frame_ms: f32,
+    unused_reset: bool,
+    near: f32,
+    far: f32,
+    fov_y: f32,
+    meters: f32,
+    depth: Resource,
+    motion: Resource,
+}
+
+const _: () = {
+    use std::mem::offset_of;
+    assert!(size_of::<Resource>() == 48);
+    assert!(offset_of!(DispatchUpscale, output) == 0x138);
+    assert!(offset_of!(DispatchUpscale, jitter) == 0x168);
+    assert!(offset_of!(DispatchUpscale, sharpening) == 0x188);
+    assert!(offset_of!(DispatchUpscale, flags) == 0x1ac);
+    assert!(offset_of!(CreateUpscale, message) == 40);
+    assert!(offset_of!(ConfigureFramegen, hudless) == 64);
+    assert!(offset_of!(ConfigureFramegen, frame_id) == 136);
+    assert!(offset_of!(DispatchFramegenPrepare, depth) == 88);
+    assert!(size_of::<DispatchFramegenPrepare>() == 184);
+};
+
+type Create = unsafe extern "C" fn(*mut *mut c_void, *const Header, *const c_void) -> u32;
+type Destroy = unsafe extern "C" fn(*mut *mut c_void, *const c_void) -> u32;
+type Configure = unsafe extern "C" fn(*mut *mut c_void, *const Header) -> u32;
+type Dispatch = unsafe extern "C" fn(*mut *mut c_void, *const Header) -> u32;
+
+struct Api {
+    create: Create,
+    destroy: Destroy,
+    configure: Configure,
+    dispatch: Dispatch,
+}
+
+/// The DLL names tried next to the executable, in order.
+pub(crate) const DLLS: [&str; 2] = ["amd_fidelityfx_loader_dx12.dll", "amd_fidelityfx_dx12.dll"];
+
+fn api() -> Option<&'static Api> {
+    static API: std::sync::OnceLock<Option<Api>> = std::sync::OnceLock::new();
+    API.get_or_init(|| {
+        use windows::Win32::System::LibraryLoader::{GetProcAddress, LoadLibraryW};
+        let mut tried = Vec::new();
+        if let Some(p) = std::env::var_os("VICTORY_FFX_DLL") {
+            tried.push(std::path::PathBuf::from(p));
+        }
+        if let Some(dir) = std::env::current_exe().ok().and_then(|e| e.parent().map(|d| d.to_path_buf())) {
+            tried.extend(DLLS.iter().map(|n| dir.join(n)));
+        }
+        for path in &tried {
+            if !path.exists() {
+                continue;
+            }
+            let wide: Vec<u16> = path.as_os_str().to_string_lossy().encode_utf16().chain([0]).collect();
+            // SAFETY: loading a DLL the user put there; its exports are the
+            // FidelityFX API's C entry points.
+            unsafe {
+                let Ok(module) = LoadLibraryW(windows::core::PCWSTR(wide.as_ptr())) else {
+                    tracing::warn!(path = %path.display(), "the FidelityFX DLL did not load");
+                    continue;
+                };
+                let get = |name: windows::core::PCSTR| GetProcAddress(module, name);
+                let (Some(c), Some(d), Some(f), Some(x)) = (
+                    get(windows::core::s!("ffxCreateContext")),
+                    get(windows::core::s!("ffxDestroyContext")),
+                    get(windows::core::s!("ffxConfigure")),
+                    get(windows::core::s!("ffxDispatch")),
+                ) else {
+                    tracing::warn!(path = %path.display(), "the FidelityFX DLL lacks the API's entry points");
+                    continue;
+                };
+                tracing::info!(path = %path.display(), "FidelityFX API loaded (FSR 3 upscaling, frame generation)");
+                return Some(Api {
+                    create: std::mem::transmute::<_, Create>(c),
+                    destroy: std::mem::transmute::<_, Destroy>(d),
+                    configure: std::mem::transmute::<_, Configure>(f),
+                    dispatch: std::mem::transmute::<_, Dispatch>(x),
+                });
+            }
+        }
+        tracing::warn!(
+            "no FidelityFX DLL ({} or {} next to the executable, or VICTORY_FFX_DLL): the upscale is a plain stretch",
+            DLLS[0],
+            DLLS[1]
+        );
+        None
+    })
+    .as_ref()
+}
+
+/// Whether the API can be had (loads it on first call).
+pub(crate) fn available() -> bool {
+    api().is_some()
+}
+
+extern "C" fn message(kind: u32, text: *const u16) {
+    if text.is_null() {
+        return;
+    }
+    // SAFETY: a nul-terminated wide string from the runtime.
+    let s = unsafe {
+        let mut n = 0;
+        while *text.add(n) != 0 && n < 4096 {
+            n += 1;
+        }
+        String::from_utf16_lossy(std::slice::from_raw_parts(text, n))
+    };
+    if kind == 0 {
+        tracing::error!(message = s, "FidelityFX");
+    } else {
+        tracing::warn!(message = s, "FidelityFX");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Formats and resource descriptions
+// ---------------------------------------------------------------------------
+
+/// `FfxApiSurfaceFormat` for a DXGI format, as `ffxApiGetSurfaceFormatDX12`
+/// maps it (depth-stencil formats read as their depth or stencil plane).
+pub(crate) fn ffx_format(dxgi: i32) -> u32 {
+    match dxgi {
+        1 => 1,                 // R32G32B32A32_TYPELESS
+        2 => 3,                 // R32G32B32A32_FLOAT
+        3 => 2,                 // R32G32B32A32_UINT
+        9 => 30,                // R16G16B16A16_TYPELESS
+        10 => 4,                // R16G16B16A16_FLOAT
+        6 => 5,                 // R32G32B32_FLOAT
+        15 => 31,               // R32G32_TYPELESS
+        16 => 6,                // R32G32_FLOAT
+        17 => 38,               // R32G32_UINT
+        19..=21 => 28,          // R32G8X24 / D32S8 / R32_X8X24: R32_FLOAT
+        22 | 47 => 7,           // the stencil planes: R8_UINT
+        23 => 32,               // R10G10B10A2_TYPELESS
+        24 => 17,               // R10G10B10A2_UNORM
+        26 => 16,               // R11G11B10_FLOAT
+        27 => 9,                // R8G8B8A8_TYPELESS
+        28 => 10,               // R8G8B8A8_UNORM
+        29 => 12,               // R8G8B8A8_UNORM_SRGB
+        31 => 11,               // R8G8B8A8_SNORM
+        33 => 33,               // R16G16_TYPELESS
+        34 => 18,               // R16G16_FLOAT
+        36 => 19,               // R16G16_UINT
+        38 => 20,               // R16G16_SINT
+        39 => 37,               // R32_TYPELESS
+        40 | 41 => 28,          // D32_FLOAT, R32_FLOAT
+        42 => 8,                // R32_UINT
+        44..=46 => 8,           // R24G8 / D24S8 / R24_X8: R32_UINT
+        48 => 36,               // R8G8_TYPELESS
+        49 => 26,               // R8G8_UNORM
+        50 => 27,               // R8G8_UINT
+        53 => 34,               // R16_TYPELESS
+        54 => 21,               // R16_FLOAT
+        55 | 56 => 23,          // D16_UNORM, R16_UNORM
+        57 => 22,               // R16_UINT
+        58 => 24,               // R16_SNORM
+        60 => 35,               // R8_TYPELESS
+        61 => 25,               // R8_UNORM
+        62 => 7,                // R8_UINT
+        63 => 39,               // R8_SNORM
+        67 => 29,               // R9G9B9E5_SHAREDEXP
+        87 => 14,               // B8G8R8A8_UNORM
+        90 => 13,               // B8G8R8A8_TYPELESS
+        91 => 15,               // B8G8R8A8_UNORM_SRGB
+        _ => 0,
+    }
+}
+
+/// The description `ffxApiGetResourceDX12` makes for a 2D texture.
+pub(crate) fn describe(format: i32, width: u64, height: u32, depth_or_array: u16, mips: u16, uav: bool) -> [u32; 8] {
+    let mut usage = match format {
+        40 | 55 => USAGE_DEPTH,
+        20 | 45 => USAGE_DEPTH | USAGE_STENCIL,
+        _ => 0,
+    };
+    if uav {
+        usage |= USAGE_UAV;
+    }
+    [
+        TYPE_TEXTURE2D,
+        ffx_format(format),
+        width as u32,
+        height,
+        u32::from(depth_or_array),
+        u32::from(mips),
+        0,
+        usage,
+    ]
+}
+
+fn resource(r: &ID3D12Resource, state: u32) -> Resource {
+    // SAFETY: a live resource.
+    let d = unsafe { r.GetDesc() };
+    Resource {
+        resource: r.as_raw(),
+        description: describe(
+            d.Format.0,
+            d.Width,
+            d.Height,
+            d.DepthOrArraySize,
+            d.MipLevels,
+            d.Flags.0 & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS.0 != 0,
+        ),
+        state,
+    }
+}
+
+// ---------------------------------------------------------------------------
+// The upscaler
+// ---------------------------------------------------------------------------
+
+struct Context {
+    ctx: *mut c_void,
+    max_render: [u32; 2],
+    max_upscale: [u32; 2],
+    flags: u32,
+}
+
+struct Framegen {
+    ctx: *mut c_void,
+    display: [u32; 2],
+    gate: FramegenGate,
+    frame_id: u64,
+}
+
+#[derive(Default)]
+struct State {
+    upscale: Option<Context>,
+    framegen: Option<Framegen>,
+    framegen_failed: bool,
+    plumbing: Plumbing,
+    last: Option<std::time::Instant>,
+}
+
+// SAFETY: the contexts are the API's, usable from any thread one at a time
+// (the mutex).
+unsafe impl Send for State {}
+
+static STATE: Mutex<Option<State>> = Mutex::new(None);
+
+/// The title's upscale context flags, from its `ffxCreateContext`
+/// (`victory_hle::modules::ffx`); `u32::MAX` until it made one.
+static TITLE_FLAGS: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(u32::MAX);
+
+/// Records the flags the title made its upscale context with.
+pub fn set_title_flags(flags: u32) {
+    TITLE_FLAGS.store(flags, Ordering::Relaxed);
+}
+
+/// The flags our context is made with: the title's (it knows its depth and
+/// colour), or reversed depth when it made none we saw; always dynamic
+/// resolution (the render size can change under a fixed maximum).
+pub(crate) fn context_flags(title: u32) -> u32 {
+    let base = if title == u32::MAX { UPSCALE_DEPTH_INVERTED } else { title & 0x1ff };
+    base | UPSCALE_DYNAMIC_RESOLUTION
+}
+
+/// The textures the title hands its upscale, as host resources.
+pub(crate) struct Inputs<'a> {
+    pub colour: &'a ID3D12Resource,
+    pub depth: Option<&'a ID3D12Resource>,
+    pub motion: Option<&'a ID3D12Resource>,
+    pub exposure: Option<&'a ID3D12Resource>,
+    pub reactive: Option<&'a ID3D12Resource>,
+    pub composition: Option<&'a ID3D12Resource>,
+    pub output: &'a ID3D12Resource,
+}
+
+/// Records FSR's upscale of `i` into `list`. The inputs must be in the
+/// non-pixel shader resource state and the output in unordered access.
+/// False if nothing was recorded (no DLL, no context, a refused dispatch).
+pub(crate) fn record(
+    device: &ID3D12Device,
+    list: &ID3D12GraphicsCommandList,
+    i: &Inputs<'_>,
+    t: &TitleParams,
+) -> bool {
+    let Some(api) = api() else { return false };
+    if i.depth.is_none() || i.motion.is_none() {
+        static TOLD: std::sync::Once = std::sync::Once::new();
+        TOLD.call_once(|| tracing::warn!("the title's upscale came without depth or motion: stretched instead"));
+        return false;
+    }
+    // SAFETY: live resources.
+    let (cd, od) = unsafe { (i.colour.GetDesc(), i.output.GetDesc()) };
+    let colour_size = [cd.Width as u32, cd.Height];
+    let output_size = [od.Width as u32, od.Height];
+    let mut guard = STATE.lock().unwrap_or_else(|e| e.into_inner());
+    let st = guard.get_or_insert_with(State::default);
+    let switched = victory_core::upscale::take_reset();
+    let h = st.plumbing.host(t, colour_size, output_size, victory_core::upscale::live_sharpness(), switched);
+    match st.plumbing.watch.see(h.jitter) {
+        victory_core::upscale::JitterVerdict::Fine => {}
+        v => {
+            static TOLD: std::sync::Once = std::sync::Once::new();
+            TOLD.call_once(|| tracing::warn!(verdict = ?v, jitter = ?h.jitter, "the title's camera jitter looks wrong: FSR will blur"));
+        }
+    }
+    let flags = context_flags(TITLE_FLAGS.load(Ordering::Relaxed));
+    let fits = st.upscale.as_ref().is_some_and(|c| {
+        c.flags == flags
+            && c.max_upscale == output_size
+            && c.max_render[0] >= colour_size[0]
+            && c.max_render[1] >= colour_size[1]
+    });
+    if !fits {
+        if let Some(mut old) = st.upscale.take() {
+            // SAFETY: our context; the frames using it were recorded, and
+            // the API waits for the GPU on destruction.
+            unsafe { (api.destroy)(&mut old.ctx, std::ptr::null()) };
+        }
+        let backend = CreateBackendDx12 { header: Header::new(CREATE_BACKEND_DX12), device: device.as_raw() };
+        let mut desc = CreateUpscale {
+            header: Header::new(CREATE_UPSCALE),
+            flags,
+            max_render: colour_size,
+            max_upscale: output_size,
+            message: Some(message),
+        };
+        desc.header.next = std::ptr::from_ref(&backend).cast();
+        let mut ctx = std::ptr::null_mut();
+        // SAFETY: descriptions that live through the call.
+        let rc = unsafe { (api.create)(&mut ctx, std::ptr::from_ref(&desc).cast(), std::ptr::null()) };
+        if rc != OK || ctx.is_null() {
+            static TOLD: std::sync::Once = std::sync::Once::new();
+            TOLD.call_once(|| tracing::error!(rc, ?colour_size, ?output_size, "FSR context not made: stretched instead"));
+            return false;
+        }
+        tracing::info!(?colour_size, ?output_size, flags = format_args!("{flags:#x}"), "FSR upscale context made");
+        st.upscale = Some(Context { ctx, max_render: colour_size, max_upscale: output_size, flags });
+    }
+    let opt = |r: Option<&ID3D12Resource>| r.map_or(Resource::NONE, |r| resource(r, STATE_COMPUTE_READ));
+    let desc = DispatchUpscale {
+        header: Header::new(DISPATCH_UPSCALE),
+        list: list.as_raw(),
+        colour: resource(i.colour, STATE_COMPUTE_READ),
+        depth: opt(i.depth),
+        motion: opt(i.motion),
+        exposure: opt(i.exposure),
+        reactive: opt(i.reactive),
+        composition: opt(i.composition),
+        output: resource(i.output, STATE_UNORDERED),
+        jitter: h.jitter,
+        motion_scale: h.motion_scale,
+        render: h.render,
+        upscale: h.upscale,
+        sharpening: h.sharpening,
+        sharpness: h.sharpness,
+        frame_ms: h.frame_ms,
+        pre_exposure: h.pre_exposure,
+        reset: h.reset,
+        near: h.near,
+        far: h.far,
+        fov_y: h.fov_y,
+        meters: h.meters,
+        flags: h.flags & 0x7,
+    };
+    let Some(c) = st.upscale.as_mut() else { return false };
+    // SAFETY: our context and a description that lives through the call.
+    let rc = unsafe { (api.dispatch)(&mut c.ctx, std::ptr::from_ref(&desc).cast()) };
+    if rc != OK {
+        static TOLD: std::sync::Once = std::sync::Once::new();
+        TOLD.call_once(|| tracing::error!(rc, "FSR dispatch refused: stretched instead"));
+        return false;
+    }
+    framegen_frame(api, device, list, st, i, &h, flags);
+    victory_core::upscale::status::set_answered(1, h.render, h.upscale);
+    true
+}
+
+// ---------------------------------------------------------------------------
+// Frame generation
+// ---------------------------------------------------------------------------
+
+/// The frame-generation swap chain, once made: its raw pointer (the
+/// presenter holds a reference).
+static FG_SWAP_CHAIN: AtomicPtr<c_void> = AtomicPtr::new(std::ptr::null_mut());
+static FG_SWAP_FORMAT: AtomicU64 = AtomicU64::new(0);
+/// Our frame-generation context, for the dispatch callback.
+static FG_CONTEXT: AtomicPtr<c_void> = AtomicPtr::new(std::ptr::null_mut());
+/// Generated frames are being presented now.
+static FG_ACTIVE: AtomicBool = AtomicBool::new(false);
+
+/// Presents per rendered frame now: 2 while frame generation runs, else 1.
+/// The pacer (`VICTORY_PACE_FPS`, an output rate) holds base frames this
+/// many periods.
+pub(crate) fn framegen_factor() -> u64 {
+    if FG_ACTIVE.load(Ordering::Relaxed) { 2 } else { 1 }
+}
+
+/// With `VICTORY_FRAMEGEN=1` and the API at hand: the API's
+/// frame-generation swap chain for `hwnd`, made in place of a plain one.
+/// None otherwise (the caller makes its own).
+pub(crate) fn framegen_swap_chain(
+    factory: &IDXGIFactory2,
+    queue: &ID3D12CommandQueue,
+    hwnd: windows::Win32::Foundation::HWND,
+    desc: &DXGI_SWAP_CHAIN_DESC1,
+) -> Option<IDXGISwapChain3> {
+    if !victory_core::upscale::switches().framegen {
+        return None;
+    }
+    let Some(api) = api() else {
+        victory_core::upscale::status::set_framegen(3);
+        tracing::warn!("VICTORY_FRAMEGEN=1 but no FidelityFX DLL: no frame generation");
+        return None;
+    };
+    let mut sc: *mut c_void = std::ptr::null_mut();
+    let d = FgSwapChainForHwnd {
+        header: Header::new(CREATE_FGSWAPCHAIN_FOR_HWND_DX12),
+        swap_chain: &mut sc,
+        hwnd: hwnd.0,
+        desc,
+        fullscreen: std::ptr::null(),
+        factory: factory.as_raw(),
+        queue: queue.as_raw(),
+    };
+    let mut ctx = std::ptr::null_mut();
+    // SAFETY: descriptions that live through the call; the API returns a
+    // swap chain with one reference we take.
+    let rc = unsafe { (api.create)(&mut ctx, std::ptr::from_ref(&d).cast(), std::ptr::null()) };
+    if rc != OK || sc.is_null() {
+        victory_core::upscale::status::set_framegen(3);
+        tracing::error!(rc, "frame-generation swap chain not made: presenting without frame generation");
+        return None;
+    }
+    // SAFETY: an IDXGISwapChain4 whose reference is ours.
+    let chain = unsafe { IDXGISwapChain4::from_raw(sc) };
+    FG_SWAP_CHAIN.store(sc, Ordering::Relaxed);
+    FG_SWAP_FORMAT.store(desc.Format.0 as u64, Ordering::Relaxed);
+    tracing::info!("frame-generation swap chain made (FSR 3); generation starts with the first upscale at >= 15 fps");
+    chain.cast::<IDXGISwapChain3>().ok()
+}
+
+extern "C" fn framegen_dispatch(params: *mut c_void, _user: *mut c_void) -> u32 {
+    let Some(api) = api() else { return 1 };
+    let mut ctx = FG_CONTEXT.load(Ordering::Relaxed);
+    if ctx.is_null() {
+        return 1;
+    }
+    // SAFETY: the API hands its own dispatch description back.
+    unsafe { (api.dispatch)(&mut ctx, params.cast()) }
+}
+
+fn framegen_frame(
+    api: &Api,
+    device: &ID3D12Device,
+    list: &ID3D12GraphicsCommandList,
+    st: &mut State,
+    i: &Inputs<'_>,
+    h: &HostParams,
+    upscale_flags: u32,
+) {
+    let wanted = victory_core::upscale::live_framegen();
+    let swap_chain = FG_SWAP_CHAIN.load(Ordering::Relaxed);
+    let now = std::time::Instant::now();
+    let base_ms = st.last.map_or(0.0, |l| (now - l).as_secs_f32() * 1000.0);
+    st.last = Some(now);
+    if swap_chain.is_null() || st.framegen_failed {
+        FG_ACTIVE.store(false, Ordering::Relaxed);
+        if wanted {
+            victory_core::upscale::status::set_framegen(3);
+        }
+        return;
+    }
+    if st.framegen.as_ref().is_some_and(|f| f.display != h.upscale) {
+        if let Some(mut old) = st.framegen.take() {
+            FG_CONTEXT.store(std::ptr::null_mut(), Ordering::Relaxed);
+            // SAFETY: our context.
+            unsafe { (api.destroy)(&mut old.ctx, std::ptr::null()) };
+        }
+    }
+    if st.framegen.is_none() {
+        let backbuffer = ffx_format(FG_SWAP_FORMAT.load(Ordering::Relaxed) as i32);
+        // SAFETY: a live resource.
+        let hudless_format = ffx_format(unsafe { i.output.GetDesc() }.Format.0);
+        let mut flags = 0;
+        if upscale_flags & UPSCALE_DEPTH_INVERTED != 0 {
+            flags |= FG_DEPTH_INVERTED;
+        }
+        if upscale_flags & UPSCALE_DEPTH_INFINITE != 0 {
+            flags |= FG_DEPTH_INFINITE;
+        }
+        if upscale_flags & UPSCALE_JITTER_CANCELLATION != 0 {
+            flags |= FG_JITTER_CANCELLATION;
+        }
+        if upscale_flags & UPSCALE_HDR != 0 {
+            flags |= FG_HDR;
+        }
+        let backend = CreateBackendDx12 { header: Header::new(CREATE_BACKEND_DX12), device: device.as_raw() };
+        let mut hudless = CreateFramegenHudless { header: Header::new(CREATE_FRAMEGEN_HUDLESS), hudless_format };
+        hudless.header.next = std::ptr::from_ref(&backend).cast();
+        let mut desc = CreateFramegen {
+            header: Header::new(CREATE_FRAMEGEN),
+            flags,
+            display: h.upscale,
+            max_render: st.upscale.as_ref().map_or(h.render, |c| c.max_render),
+            back_buffer_format: backbuffer,
+        };
+        desc.header.next = if hudless_format != backbuffer {
+            std::ptr::from_ref(&hudless).cast()
+        } else {
+            std::ptr::from_ref(&backend).cast()
+        };
+        let mut ctx = std::ptr::null_mut();
+        // SAFETY: descriptions that live through the call.
+        let rc = unsafe { (api.create)(&mut ctx, std::ptr::from_ref(&desc).cast(), std::ptr::null()) };
+        if rc != OK || ctx.is_null() {
+            tracing::error!(rc, "frame-generation context not made: no frame generation");
+            st.framegen_failed = true;
+            victory_core::upscale::status::set_framegen(3);
+            return;
+        }
+        FG_CONTEXT.store(ctx, Ordering::Relaxed);
+        st.framegen = Some(Framegen { ctx, display: h.upscale, gate: FramegenGate::default(), frame_id: 0 });
+    }
+    let Some(fg) = st.framegen.as_mut() else { return };
+    // The base rate is measured with generation running too: these are
+    // the title's frames, one per upscale.
+    let on = fg.gate.frame(wanted, base_ms);
+    FG_ACTIVE.store(on, Ordering::Relaxed);
+    victory_core::upscale::status::set_framegen(match (wanted, on) {
+        (_, true) => 1,
+        (true, false) => 2,
+        _ => 0,
+    });
+    fg.frame_id += 1;
+    // SAFETY: a live resource.
+    let od = unsafe { i.output.GetDesc() };
+    let cfg = ConfigureFramegen {
+        header: Header::new(CONFIGURE_FRAMEGEN),
+        swap_chain,
+        present_callback: std::ptr::null(),
+        present_context: std::ptr::null_mut(),
+        framegen_callback: Some(framegen_dispatch),
+        framegen_context: std::ptr::null_mut(),
+        enabled: on,
+        allow_async: false,
+        // The upscaled image is the frame before the title's UI is drawn.
+        hudless: resource(i.output, STATE_UNORDERED),
+        flags: 0,
+        only_generated: false,
+        rect: [0, 0, od.Width as i32, od.Height as i32],
+        frame_id: fg.frame_id,
+    };
+    // SAFETY: our context and a description that lives through the call.
+    let rc = unsafe { (api.configure)(&mut fg.ctx, std::ptr::from_ref(&cfg).cast()) };
+    if rc != OK {
+        static TOLD: std::sync::Once = std::sync::Once::new();
+        TOLD.call_once(|| tracing::error!(rc, "frame-generation configure refused"));
+        return;
+    }
+    if !on {
+        return;
+    }
+    let (Some(depth), Some(motion)) = (i.depth, i.motion) else { return };
+    let prep = DispatchFramegenPrepare {
+        header: Header::new(DISPATCH_FRAMEGEN_PREPARE),
+        frame_id: fg.frame_id,
+        flags: 0,
+        list: list.as_raw(),
+        render: h.render,
+        jitter: h.jitter,
+        motion_scale: h.motion_scale,
+        frame_ms: h.frame_ms,
+        unused_reset: h.reset,
+        near: h.near,
+        far: h.far,
+        fov_y: h.fov_y,
+        meters: h.meters,
+        depth: resource(depth, STATE_COMPUTE_READ),
+        motion: resource(motion, STATE_COMPUTE_READ),
+    };
+    // SAFETY: as above.
+    let rc = unsafe { (api.dispatch)(&mut fg.ctx, std::ptr::from_ref(&prep).cast()) };
+    if rc != OK {
+        static TOLD: std::sync::Once = std::sync::Once::new();
+        TOLD.call_once(|| tracing::error!(rc, "frame-generation prepare refused"));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_formats_the_title_feeds_map_as_the_api_maps_them() {
+        assert_eq!(ffx_format(10), 4); // HDR colour, R16G16B16A16_FLOAT
+        assert_eq!(ffx_format(28), 10); // LDR colour
+        assert_eq!(ffx_format(24), 17); // R10G10B10A2_UNORM
+        assert_eq!(ffx_format(34), 18); // velocity, R16G16_FLOAT
+        assert_eq!(ffx_format(19), 28); // main depth R32G8X24 reads as R32_FLOAT
+        assert_eq!(ffx_format(20), 28);
+        assert_eq!(ffx_format(40), 28);
+        assert_eq!(ffx_format(41), 28); // linear depth
+        assert_eq!(ffx_format(87), 14);
+        assert_eq!(ffx_format(999), 0);
+    }
+
+    #[test]
+    fn descriptions_are_the_helper_s() {
+        let d = describe(20, 1280, 720, 1, 1, false);
+        assert_eq!(d, [TYPE_TEXTURE2D, 28, 1280, 720, 1, 1, 0, USAGE_DEPTH | USAGE_STENCIL]);
+        let d = describe(10, 1920, 1080, 1, 1, true);
+        assert_eq!(d[1], 4);
+        assert_eq!(d[7], USAGE_UAV);
+    }
+
+    #[test]
+    fn context_flags_follow_the_title_and_allow_resizing() {
+        assert_eq!(context_flags(u32::MAX), UPSCALE_DEPTH_INVERTED | UPSCALE_DYNAMIC_RESOLUTION);
+        assert_eq!(context_flags(0x1), UPSCALE_HDR | UPSCALE_DYNAMIC_RESOLUTION);
+        // Debug bits past the known ones are dropped.
+        assert_eq!(context_flags(0xffff_0000), UPSCALE_DYNAMIC_RESOLUTION);
+    }
+
+    #[test]
+    fn the_dispatch_types_are_the_api_s() {
+        // FFX_API_MAKE_EFFECT_SUB_ID(effect, sub).
+        let make = |effect: u64, sub: u64| (effect & 0x00ff_0000) | (sub & !0x00ff_0000);
+        assert_eq!(CREATE_UPSCALE, make(0x0001_0000, 0));
+        assert_eq!(DISPATCH_UPSCALE, make(0x0001_0000, 1));
+        assert_eq!(CREATE_FRAMEGEN, make(0x0002_0000, 1));
+        assert_eq!(CONFIGURE_FRAMEGEN, make(0x0002_0000, 2));
+        assert_eq!(DISPATCH_FRAMEGEN_PREPARE, make(0x0002_0000, 4));
+        assert_eq!(CREATE_FRAMEGEN_HUDLESS, make(0x0002_0000, 9));
+        assert_eq!(CREATE_FGSWAPCHAIN_FOR_HWND_DX12, make(0x0003_0000, 6));
+    }
+
+    #[test]
+    fn framegen_doubles_the_pacing_period_only_while_it_runs() {
+        assert_eq!(framegen_factor(), 1);
+        FG_ACTIVE.store(true, Ordering::Relaxed);
+        assert_eq!(framegen_factor(), 2);
+        FG_ACTIVE.store(false, Ordering::Relaxed);
+    }
+}
diff --git a/crates/victory-gpu/src/fxprof.rs b/crates/victory-gpu/src/fxprof.rs
new file mode 100644
index 0000000..2a1a94e
--- /dev/null
+++ b/crates/victory-gpu/src/fxprof.rs
@@ -0,0 +1,2965 @@
+//! (fx-up1: fxceless f85101b's profiler, renamed from `profile` to `fxprof` and its
+//! switch from `VICTORY_PROFILE` to `VICTORY_FX_PROFILE`: fx-final's own
+//! `profile.rs` reads `VICTORY_PROFILE=<ms>`.)
+//!
+//! Where the layer's threads spend their time: a sampling profiler
+//! (`VICTORY_FX_PROFILE=1`, diagnostics builds; off otherwise).
+//!
+//! The log's own counters say how long the phases of a frame take, not
+//! what a thread does inside them: in the graphics driver, in a kernel
+//! call, waiting for a lock. A thread of ours ([`run`]) looks, a thousand
+//! times a second (`VICTORY_PROFILE_HZ`), at the threads that matter:
+//!
+//! * the submitting thread and the recording threads, which name
+//!   themselves by what they call ([`seen`]: [`crate::host::Host`]'s
+//!   submissions, the list calls);
+//! * our workers, by the names we start them with (`victory-pipelines-N`,
+//!   `victory-wide-N`, `victory-late-wait`) and the title's main thread;
+//! * the busiest of the other threads (the title's own).
+//!
+//! A look ([`Sampler::capture`]) suspends the thread, reads its registers
+//! and copies the used part of its stack with the kernel's own read, and
+//! lets it go: between the two nothing of ours takes a lock, allocates or
+//! reads memory that may be gone. The stack is walked afterwards, in the
+//! copy ([`Sampler::walk`]), by each image's unwind data (the Windows
+//! loader registered it for title images too), every read checked to stay
+//! inside the copy. A thread that has used no processor cycles since the
+//! last look is where it was: it is not suspended again.
+//!
+//! Names are found when the report is written, not when a sample is
+//! taken ([`Symbols`]): our executable through its PDB (inlined calls
+//! too), system and driver code by export or `module+offset`, title code
+//! as `title+offset` of the function's start.
+//!
+//! The report is written every `VICTORY_PROFILE_EVERY` seconds (30) and at
+//! exit to `VICTORY_PROFILE_OUT` (`%TEMP%\victory_profile_<pid>.txt`), the
+//! stacks for a flame graph beside it (`.folded`). Per kind of thread:
+//! time by module, by function (own and with what it calls), where it
+//! waited and for which of our functions, the hottest lines of ours. Times
+//! are milliseconds per presented frame ([`frame`]).
+
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::ffi::c_void;
+use std::fmt::Write as _;
+use std::hash::{BuildHasherDefault, Hasher};
+use std::path::PathBuf;
+use std::ptr::{null, null_mut};
+use std::sync::atomic::{AtomicBool, AtomicU8, AtomicU32, AtomicU64, Ordering::Relaxed};
+use std::time::{Duration, Instant};
+
+use windows_sys::Win32::Foundation::{
+    CloseHandle, DUPLICATE_SAME_ACCESS, DuplicateHandle, HANDLE, HMODULE, LocalFree,
+};
+use windows_sys::Win32::System::Diagnostics::Debug::{
+    CONTEXT, CONTEXT_CONTROL_AMD64, CONTEXT_INTEGER_AMD64, GetThreadContext, IMAGEHLP_LINEW64,
+    IMAGEHLP_MODULEW64, ReadProcessMemory, RtlLookupFunctionEntry, RtlVirtualUnwind, SYMBOL_INFOW,
+    UNW_FLAG_NHANDLER,
+};
+use windows_sys::Win32::System::LibraryLoader::{
+    GetModuleFileNameW, GetModuleHandleW, GetProcAddress, LOAD_LIBRARY_SEARCH_SYSTEM32,
+    LoadLibraryExA,
+};
+use windows_sys::Win32::System::Memory::{MEM_COMMIT, MEM_RESERVE, PAGE_READWRITE, VirtualAlloc};
+use windows_sys::Win32::System::ProcessStatus::{
+    K32EnumProcessModules, K32GetModuleInformation, MODULEINFO,
+};
+use windows_sys::Win32::System::Threading::{
+    GetCurrentProcess, GetCurrentThread, GetCurrentThreadId, GetThreadDescription, GetThreadId,
+    GetThreadTimes, OpenThread, ResumeThread, SetThreadPriority, SuspendThread, THREAD_GET_CONTEXT,
+    THREAD_PRIORITY_TIME_CRITICAL, THREAD_QUERY_INFORMATION, THREAD_QUERY_LIMITED_INFORMATION,
+    THREAD_SUSPEND_RESUME, WaitForSingleObject,
+};
+
+#[link(name = "kernel32", kind = "raw-dylib")]
+unsafe extern "system" {
+    /// The processor cycles a thread has used so far.
+    fn QueryThreadCycleTime(thread: HANDLE, cycles: *mut u64) -> i32;
+}
+
+#[link(name = "ntdll", kind = "raw-dylib")]
+unsafe extern "system" {
+    /// The thread of `process` after `thread` (null: the first), opened
+    /// with `access`; an NTSTATUS, not zero after the last.
+    fn NtGetNextThread(
+        process: HANDLE,
+        thread: HANDLE,
+        access: u32,
+        attributes: u32,
+        flags: u32,
+        next: *mut HANDLE,
+    ) -> i32;
+    /// `(thread, class, out, size, written)`: an NTSTATUS.
+    fn NtQueryInformationThread(
+        thread: HANDLE,
+        class: i32,
+        information: *mut c_void,
+        size: u32,
+        written: *mut u32,
+    ) -> i32;
+}
+
+// ---------------------------------------------------------------------
+// What the layer's threads tell the profiler.
+// ---------------------------------------------------------------------
+
+/// 0: not asked yet, [`OFF`], [`ON`].
+static STATE: AtomicU8 = AtomicU8::new(0);
+const OFF: u8 = 1;
+const ON: u8 = 2;
+
+/// Frames presented since the profiler started.
+static FRAMES: AtomicU64 = AtomicU64::new(0);
+
+/// What a thread was seen doing.
+#[derive(Clone, Copy)]
+pub(crate) enum Seen {
+    /// It called a submission ([`crate::host::Host`]).
+    Submit = 0,
+    /// It made a list call.
+    Record = 1,
+}
+
+/// A thread that called [`seen`], and how often for each [`Seen`]. A line
+/// of the cache each: the recording threads count here at every list call.
+#[repr(align(64))]
+struct Known {
+    thread: AtomicU32,
+    seen: [AtomicU64; 2],
+}
+
+const KNOWN: usize = 64;
+static KNOWN_THREADS: [Known; KNOWN] = [const {
+    Known {
+        thread: AtomicU32::new(0),
+        seen: [const { AtomicU64::new(0) }; 2],
+    }
+}; KNOWN];
+
+/// Submissions after which a thread is a submitting thread, and list calls
+/// after which it is a recording thread: a thread that reads a texture
+/// back once while the world loads is neither.
+const SUBMITS: u64 = 8;
+const LIST_CALLS: u64 = 64;
+
+thread_local! {
+    /// This thread's place in [`KNOWN_THREADS`], plus one; 0 before it has
+    /// one, 255 if there was none left.
+    static MINE: Cell<u8> = const { Cell::new(0) };
+}
+
+/// Whether the profiler runs; the first call reads `VICTORY_FX_PROFILE` and
+/// starts it.
+#[inline]
+fn on() -> bool {
+    match STATE.load(Relaxed) {
+        ON => true,
+        OFF => false,
+        _ => decide(),
+    }
+}
+
+#[cold]
+fn decide() -> bool {
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    ONCE.call_once(|| {
+        let started = Config::from_env().is_some_and(start);
+        let state = if started { ON } else { OFF };
+        STATE.store(state, Relaxed);
+    });
+    STATE.load(Relaxed) == ON
+}
+
+/// The calling thread was seen doing `what`: it is followed once it has
+/// done so often enough. Costs a load when the profiler is off.
+#[inline]
+pub(crate) fn seen(what: Seen) {
+    if !on() {
+        return;
+    }
+    let mine = MINE.with(Cell::get);
+    let known = match mine {
+        0 => match claim() {
+            Some(known) => known,
+            None => return,
+        },
+        255 => return,
+        at => &KNOWN_THREADS[usize::from(at) - 1],
+    };
+    known.seen[what as usize].fetch_add(1, Relaxed);
+}
+
+/// A place in [`KNOWN_THREADS`] for the calling thread.
+#[cold]
+fn claim() -> Option<&'static Known> {
+    // SAFETY: a plain query.
+    let id = unsafe { GetCurrentThreadId() };
+    for (at, known) in KNOWN_THREADS.iter().enumerate() {
+        if known
+            .thread
+            .compare_exchange(0, id, Relaxed, Relaxed)
+            .is_ok()
+        {
+            known.seen[0].store(0, Relaxed);
+            known.seen[1].store(0, Relaxed);
+            MINE.with(|m| m.set(at as u8 + 1));
+            return Some(known);
+        }
+    }
+    MINE.with(|m| m.set(255));
+    None
+}
+
+/// A frame was presented.
+#[inline]
+pub(crate) fn frame() {
+    if on() {
+        FRAMES.fetch_add(1, Relaxed);
+    }
+}
+
+// ---------------------------------------------------------------------
+// The switches.
+// ---------------------------------------------------------------------
+
+/// The kinds of thread followed.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum Role {
+    Submit,
+    Record,
+    Late,
+    Wide,
+    Pipelines,
+    TitleMain,
+    Busy,
+}
+
+impl Role {
+    const ALL: [Role; 7] = [
+        Role::Submit,
+        Role::Record,
+        Role::Late,
+        Role::Wide,
+        Role::Pipelines,
+        Role::TitleMain,
+        Role::Busy,
+    ];
+
+    /// As `VICTORY_PROFILE_THREADS` and the stacks file name it.
+    fn name(self) -> &'static str {
+        match self {
+            Role::Submit => "submit",
+            Role::Record => "record",
+            Role::Late => "late-wait",
+            Role::Wide => "wide",
+            Role::Pipelines => "pipelines",
+            Role::TitleMain => "title-main",
+            Role::Busy => "busy",
+        }
+    }
+
+    fn says(self) -> &'static str {
+        match self {
+            Role::Submit => "SUBMITTING (threads that send lists to the card: Host::submit)",
+            Role::Record => "RECORDING (threads that make list calls and do not submit)",
+            Role::Late => "LATE WAIT (victory-late-wait: settles submissions sent ahead)",
+            Role::Wide => "WIDE WORKERS (victory-wide-N: copies and compares of title memory)",
+            Role::Pipelines => "PIPELINE WORKERS (victory-pipelines-N)",
+            Role::TitleMain => "TITLE MAIN (title-main)",
+            Role::Busy => "OTHER BUSY THREADS (the busiest threads with none of the roles above)",
+        }
+    }
+
+    /// The role of a thread we named.
+    fn of_name(name: &str) -> Option<Role> {
+        if name.starts_with("victory-pipelines-") {
+            Some(Role::Pipelines)
+        } else if name.starts_with("victory-wide-") {
+            Some(Role::Wide)
+        } else if name == "victory-late-wait" {
+            Some(Role::Late)
+        } else if name == "title-main" {
+            Some(Role::TitleMain)
+        } else {
+            None
+        }
+    }
+}
+
+/// Frames kept of a stack at most (`VICTORY_PROFILE_DEPTH` asks for fewer).
+const MAX_DEPTH: usize = 96;
+
+#[derive(Clone)]
+struct Config {
+    /// Looks per second.
+    hz: u32,
+    /// The report.
+    out: PathBuf,
+    /// Seconds between reports.
+    every: f64,
+    /// Seconds before the first look, and after how many more the last.
+    after: f64,
+    length: Option<f64>,
+    /// Frames kept of a stack, from the innermost.
+    depth: usize,
+    /// Bytes copied of a stack at most.
+    stack: usize,
+    /// Threads followed at most, and of those the busy ones with no role.
+    most: usize,
+    busy: usize,
+    /// The roles followed, by `Role as usize`.
+    roles: [bool; 7],
+    /// Whether calls the compiler inlined are shown as frames of their own.
+    inline: bool,
+    /// Whether a thread that used no cycles since the last look is taken
+    /// to be where it was.
+    reuse: bool,
+    /// The share of a thread's time it may stand still for our looks
+    /// (0: no limit): a thread whose looks cost more is looked at less
+    /// often.
+    budget: f64,
+    /// Microseconds a tick is put off by at most, a different time each
+    /// tick ([`Pace::wait`]).
+    jitter: u64,
+}
+
+fn env_number(name: &str) -> Option<f64> {
+    std::env::var(name).ok()?.trim().parse().ok()
+}
+
+impl Config {
+    fn new(hz: u32, out: PathBuf) -> Config {
+        Config {
+            hz,
+            out,
+            every: 30.0,
+            after: 0.0,
+            length: None,
+            depth: 48,
+            stack: 128 << 10,
+            most: 24,
+            busy: 6,
+            roles: [true; 7],
+            inline: true,
+            reuse: true,
+            budget: 0.03,
+            jitter: 250,
+        }
+    }
+
+    /// `VICTORY_FX_PROFILE=1` and the switches beside it; `None` without it.
+    fn from_env() -> Option<Config> {
+        if !std::env::var_os("VICTORY_FX_PROFILE").is_some_and(|v| v == "1") {
+            return None;
+        }
+        let out = std::env::var_os("VICTORY_PROFILE_OUT").map_or_else(
+            || std::env::temp_dir().join(format!("victory_profile_{}.txt", std::process::id())),
+            PathBuf::from,
+        );
+        let hz = env_number("VICTORY_PROFILE_HZ").map_or(1000.0, |v| v.clamp(1.0, 4000.0));
+        let mut config = Config::new(hz as u32, out);
+        let seconds = |name: &str, least: f64| env_number(name).map(|v| v.max(least));
+        config.every = seconds("VICTORY_PROFILE_EVERY", 1.0).unwrap_or(config.every);
+        config.after = seconds("VICTORY_PROFILE_AFTER", 0.0).unwrap_or(0.0);
+        config.length = seconds("VICTORY_PROFILE_FOR", 1.0);
+        let count = |name: &str, usual: usize, most: usize| {
+            env_number(name).map_or(usual, |v| (v.max(0.0) as usize).min(most))
+        };
+        config.depth = count("VICTORY_PROFILE_DEPTH", config.depth, MAX_DEPTH).max(4);
+        config.stack = count("VICTORY_PROFILE_STACK_KB", 128, 1024).max(4) << 10;
+        config.most = count("VICTORY_PROFILE_MAX_THREADS", config.most, 64).max(1);
+        config.busy = count("VICTORY_PROFILE_BUSY", config.busy, 32);
+        config.inline = std::env::var_os("VICTORY_PROFILE_INLINE").is_none_or(|v| v != "0");
+        config.reuse = std::env::var_os("VICTORY_PROFILE_REUSE").is_none_or(|v| v != "0");
+        config.budget = env_number("VICTORY_PROFILE_BUDGET")
+            .map_or(config.budget, |v| v.clamp(0.0, 100.0) / 100.0);
+        config.jitter = count("VICTORY_PROFILE_JITTER_US", 250, 2000) as u64;
+        if let Ok(list) = std::env::var("VICTORY_PROFILE_THREADS") {
+            let named: Vec<&str> = list.split(',').map(str::trim).collect();
+            for role in Role::ALL {
+                config.roles[role as usize] = named.contains(&role.name());
+            }
+        }
+        Some(config)
+    }
+}
+
+// ---------------------------------------------------------------------
+// Samples: a tree of calls per thread.
+// ---------------------------------------------------------------------
+
+/// A hash for small keys of ours (addresses and indices), not for
+/// anything a stranger chooses.
+#[derive(Default, Clone, Copy)]
+struct Fast(u64);
+
+impl Hasher for Fast {
+    fn write(&mut self, bytes: &[u8]) {
+        for &b in bytes {
+            self.write_u64(u64::from(b));
+        }
+    }
+    fn write_u8(&mut self, v: u8) {
+        self.write_u64(u64::from(v));
+    }
+    fn write_u32(&mut self, v: u32) {
+        self.write_u64(u64::from(v));
+    }
+    fn write_u64(&mut self, v: u64) {
+        self.0 = (self.0.rotate_left(5) ^ v).wrapping_mul(0x517c_c1b7_2722_0a95);
+    }
+    fn write_usize(&mut self, v: usize) {
+        self.write_u64(v as u64);
+    }
+    fn finish(&self) -> u64 {
+        self.0
+    }
+}
+
+type FastMap<K, V> = HashMap<K, V, BuildHasherDefault<Fast>>;
+
+/// A frame as called from its parent's: `address` is the instruction the
+/// thread was at (an innermost frame) or a byte inside the call that has
+/// not returned (the others), so both lie in the function they belong to.
+struct Node {
+    parent: u32,
+    address: u64,
+    /// Of the samples that ended here: microseconds of wall clock they
+    /// stand for, microseconds of those the thread was on a processor (by
+    /// its cycle counter), and how many they were.
+    wall: u64,
+    cpu: u64,
+    hits: u32,
+}
+
+/// The address of the node that stands for the frames not kept, between
+/// the thread's first frame and the outermost one kept.
+const CUT: u64 = 1;
+/// The address of the node samples go to once the trees are full.
+const FULL: u64 = 2;
+
+/// The calls of one thread, each sample at the node of its innermost frame.
+struct Tree {
+    nodes: Vec<Node>,
+    children: FastMap<(u32, u64), u32>,
+}
+
+impl Tree {
+    fn new() -> Tree {
+        Tree {
+            nodes: vec![Node {
+                parent: 0,
+                address: 0,
+                wall: 0,
+                cpu: 0,
+                hits: 0,
+            }],
+            children: FastMap::default(),
+        }
+    }
+
+    fn child(&mut self, parent: u32, address: u64) -> u32 {
+        *self.children.entry((parent, address)).or_insert_with(|| {
+            self.nodes.push(Node {
+                parent,
+                address,
+                wall: 0,
+                cpu: 0,
+                hits: 0,
+            });
+            self.nodes.len() as u32 - 1
+        })
+    }
+
+    /// The node of a stack, `frames` from the innermost; `whole` if they
+    /// reach the thread's first frame. With `room` false no node is made:
+    /// what is new goes to the [`FULL`] node.
+    fn place(&mut self, frames: &[u64], whole: bool, room: bool) -> u32 {
+        let mut at = 0;
+        if !whole {
+            at = self.child(0, CUT);
+        }
+        for &address in frames.iter().rev() {
+            at = match self.children.get(&(at, address)) {
+                Some(&next) => next,
+                None if room => self.child(at, address),
+                None => return self.child(0, FULL),
+            };
+        }
+        at
+    }
+}
+
+/// The trees' nodes together, at most (56 bytes each with their index).
+const MOST_NODES: usize = 1_500_000;
+
+// ---------------------------------------------------------------------
+// Looking at a thread.
+// ---------------------------------------------------------------------
+
+/// `GetThreadContext` and `RtlVirtualUnwind` want the context 16-byte
+/// aligned, and windows-sys declares it without that alignment.
+#[repr(C, align(16))]
+struct Aligned(CONTEXT);
+
+/// Zeroed bytes kept after the room for a stack's copy: what a frame's
+/// unwinding reads past the copied part (a frame cut by the limit, a
+/// return address that was none) is read from here.
+const SLACK: usize = 2 << 20;
+/// Copied of a stack that is not the thread's own (a fiber's) at most.
+const FOREIGN: usize = 32 << 10;
+/// What a thread needs open for [`Sampler::capture`], and to be asked
+/// whether it has ended (`SYNCHRONIZE`).
+const ACCESS: u32 =
+    THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION | 0x0010_0000;
+/// Microseconds of processor time a waiting thread is taken to use at
+/// most for being suspended and resumed (the kernel wakes it for both):
+/// about 6 were measured. A thread that used no more since a look that
+/// suspended it has not left its wait.
+const SETTLING_US: f64 = 30.0;
+/// The share of a suspension, as we time it (from asking for it to having
+/// let go), that the thread really stands still: the rest is the kernel
+/// reaching the thread and returning to us. Measured with threads whose
+/// work is counted, eight of them always running: about 20 us of work
+/// lost a look (1.8 to 2.1 % at 960 looks a second) for 25 to 28 us held.
+const STOOD: f64 = 0.8;
+/// A suspension counted as no longer than this in a thread's running
+/// average (nanoseconds): the long ones are a thread that was not on a
+/// processor when we asked, which costs it nothing.
+const COST_MOST: f64 = 250_000.0;
+
+struct Thread {
+    id: u32,
+    handle: HANDLE,
+    name: String,
+    /// Where it started: what a thread without a name is told by.
+    start: u64,
+    role: Role,
+    /// Its stack's reservation: a stack pointer inside is the thread's own.
+    low: usize,
+    high: usize,
+    /// Its cycle counter at the last look, the node of that look, and
+    /// whether the thread was suspended for it.
+    cycles: u64,
+    last: Option<u32>,
+    stood: bool,
+    /// It is looked at every `every` ticks ([`Config::budget`]), next in
+    /// `turn` ticks; `owed` is the time since its last look
+    /// (microseconds), `cost` what a suspension of it takes (nanoseconds,
+    /// a running average).
+    every: u32,
+    turn: u32,
+    owed: u64,
+    cost: f64,
+    /// Bytes of its stack copied at a look; 0: all of it. Less once a
+    /// walk has shown how many the kept frames take.
+    want: usize,
+    tree: Tree,
+    /// Still running, as of the last [`Sampler::rescan`].
+    alive: bool,
+    round: u64,
+    /// Looks: all, those answered without suspending it, those that
+    /// failed, and those whose stack did not reach its first frame.
+    looks: u64,
+    reused: u64,
+    missed: u64,
+    cut: u64,
+}
+
+/// A thread with no role, watched for how busy it is.
+struct Other {
+    handle: HANDLE,
+    cycles: u64,
+    name: String,
+    round: u64,
+}
+
+struct Sampler {
+    config: Config,
+    me: u32,
+    threads: Vec<Thread>,
+    others: FastMap<u32, Other>,
+    round: u64,
+    scanned: Instant,
+    context: Box<Aligned>,
+    /// The copy of a stack: `config.stack + 16` bytes, then [`SLACK`].
+    copy: *mut u8,
+    room: usize,
+    /// How far the copy has bytes that are not zero.
+    dirty: usize,
+    frames: [u64; MAX_DEPTH],
+    /// Cycles of the processor's counter per microsecond.
+    cycles_per_us: f64,
+    /// The cycles a waiting thread uses at most to be suspended and let
+    /// go again ([`SETTLING_US`]).
+    settling: u64,
+    clock: Instant,
+    /// The count of frames presented ([`FRAMES`]; a test's own).
+    presents: &'static AtomicU64,
+    /// The last tick, on `clock`, and the frame count then.
+    last: Duration,
+    frames_then: u64,
+    /// Since the start: ticks, late ones, microseconds they stand for,
+    /// frames presented meanwhile.
+    ticks: u64,
+    late: u64,
+    wall: u64,
+    presented: u64,
+    /// Suspensions: how many, their time together and the longest
+    /// (nanoseconds), and how many by length ([`held_class`]).
+    held: u64,
+    held_ns: u64,
+    held_longest: u64,
+    held_by: [u64; 256],
+    nodes: usize,
+    symbols: Option<Symbols>,
+}
+
+impl Sampler {
+    fn new(config: Config) -> Sampler {
+        let room = config.stack + 16 + SLACK;
+        // SAFETY: fresh zeroed memory of ours, kept for the process's life.
+        let copy = unsafe { VirtualAlloc(null(), room, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE) };
+        assert!(!copy.is_null(), "no memory for the profiler's stack copy");
+        let clock = Instant::now();
+        let cycles_per_us = cycles_per_us();
+        // SAFETY: a zeroed CONTEXT is valid.
+        let context = Box::new(Aligned(unsafe { std::mem::zeroed() }));
+        Sampler {
+            config,
+            // SAFETY: a plain query.
+            me: unsafe { GetCurrentThreadId() },
+            threads: Vec::new(),
+            others: FastMap::default(),
+            round: 0,
+            scanned: clock,
+            context,
+            copy: copy.cast(),
+            room,
+            dirty: 0,
+            frames: [0; MAX_DEPTH],
+            cycles_per_us,
+            settling: (SETTLING_US * cycles_per_us) as u64,
+            clock,
+            presents: &FRAMES,
+            last: clock.elapsed(),
+            frames_then: FRAMES.load(Relaxed),
+            ticks: 0,
+            late: 0,
+            wall: 0,
+            presented: 0,
+            held: 0,
+            held_ns: 0,
+            held_longest: 0,
+            held_by: [0; 256],
+            nodes: 0,
+            symbols: None,
+        }
+    }
+
+    /// The time under which `share` of the suspensions stayed, in
+    /// microseconds (to a quarter of a power of two).
+    fn held_within(&self, share: f64) -> f64 {
+        let mut left = (self.held as f64 * share) as u64;
+        for (class, &count) in self.held_by.iter().enumerate() {
+            if count > left {
+                // The class's upper end: its lower end as [`held_class`]
+                // gives it, plus its width.
+                let (bits, quarter) = (class / 4, class as u64 % 4);
+                let under = if bits < 2 {
+                    class as u64 + 1
+                } else {
+                    (5 + quarter) << (bits - 2)
+                };
+                return under as f64 / 1000.0;
+            }
+            left -= count;
+        }
+        self.held_longest as f64 / 1000.0
+    }
+
+    /// Time that passed while the sampler did something else (a report) is
+    /// nobody's: the next tick counts from now.
+    fn resync(&mut self) {
+        self.last = self.clock.elapsed();
+        self.frames_then = self.presents.load(Relaxed);
+    }
+
+    /// One look at every followed thread.
+    fn tick(&mut self) {
+        let now = self.clock.elapsed();
+        let passed = now.saturating_sub(self.last).as_micros() as u64;
+        self.last = now;
+        let period = 1_000_000 / u64::from(self.config.hz.max(1));
+        // A stall of ours is not the threads' time.
+        let weight = passed.min(20 * period);
+        self.late += u64::from(passed > 2 * period);
+        let frames = self.presents.load(Relaxed);
+        self.presented += frames.saturating_sub(self.frames_then);
+        self.frames_then = frames;
+        self.wall += weight;
+        self.ticks += 1;
+        for at in 0..self.threads.len() {
+            let thread = &mut self.threads[at];
+            if !thread.alive {
+                continue;
+            }
+            // A thread looked at every few ticks: its look stands for all
+            // the time since its last one.
+            thread.owed += weight;
+            thread.turn = thread.turn.saturating_sub(1);
+            if thread.turn == 0 {
+                thread.turn = thread.every;
+                let weight = std::mem::take(&mut thread.owed);
+                self.look(at, weight);
+            }
+        }
+    }
+
+    fn look(&mut self, at: usize, weight: u64) {
+        let reuse = self.config.reuse;
+        let thread = &mut self.threads[at];
+        thread.looks += 1;
+        let mut cycles = 0;
+        // SAFETY: a thread handle of ours and a valid out pointer.
+        if unsafe { QueryThreadCycleTime(thread.handle, &mut cycles) } == 0 {
+            thread.missed += 1;
+            return;
+        }
+        let ran = cycles.saturating_sub(thread.cycles);
+        thread.cycles = cycles;
+        // It has not run since the last look: it is where it was. A
+        // thread that was suspended for that look ran to be suspended and
+        // let go, which is not running its own code.
+        let still = ran == 0 || thread.stood && ran <= self.settling;
+        let last = thread.last;
+        let node = match last {
+            Some(node) if still && reuse => {
+                thread.reused += 1;
+                thread.stood = false;
+                node
+            }
+            _ => {
+                let Some((got, held)) = self.capture(at) else {
+                    self.threads[at].missed += 1;
+                    self.threads[at].last = None;
+                    return;
+                };
+                let (frames, whole, used) = self.walk(at, got);
+                let room = self.nodes < MOST_NODES;
+                let (hz, budget) = (f64::from(self.config.hz), self.config.budget);
+                let deep = frames >= self.config.depth.min(MAX_DEPTH);
+                let thread = &mut self.threads[at];
+                thread.stood = true;
+                // The kept frames took `used` bytes: that and a quarter more
+                // next time. A walk that ran out of copy first: all again.
+                thread.want = if deep { used + used / 4 + 1024 } else { 0 };
+                // What a look costs the thread: about [`STOOD`] of the time we
+                // hold it (the rest is the kernel reaching it). Over the
+                // budget, it is looked at less often.
+                let held = (held as f64).min(COST_MOST);
+                thread.cost = if thread.cost == 0.0 {
+                    held
+                } else {
+                    thread.cost + (held - thread.cost) / 16.0
+                };
+                thread.every = if budget > 0.0 {
+                    (STOOD * thread.cost * hz / 1e9 / budget)
+                        .ceil()
+                        .clamp(1.0, 32.0) as u32
+                } else {
+                    1
+                };
+                let before = thread.tree.nodes.len();
+                let node = thread.tree.place(&self.frames[..frames], whole, room);
+                self.nodes += thread.tree.nodes.len() - before;
+                thread.cut += u64::from(!whole);
+                node
+            }
+        };
+        let cpu = ((ran as f64 / self.cycles_per_us) as u64).min(weight);
+        let thread = &mut self.threads[at];
+        thread.last = Some(node);
+        let node = &mut thread.tree.nodes[node as usize];
+        node.wall += weight;
+        node.cpu += cpu;
+        node.hits += 1;
+    }
+
+    /// Suspends the thread, reads its registers into `self.context` and
+    /// copies its stack from the stack pointer up into `self.copy`, and
+    /// resumes it; the bytes copied, or `None` if it could not be looked
+    /// at (it ended).
+    ///
+    /// While the thread stands still it may hold any lock of the process
+    /// (the heap's, the loader's, the unwinder's tables'): nothing here
+    /// between the suspension and the resumption takes one or allocates.
+    /// The stack is read by the kernel (`ReadProcessMemory`), which fails
+    /// where a plain read would fault (a thread that is ending).
+    fn capture(&mut self, at: usize) -> Option<(usize, u64)> {
+        let thread = &self.threads[at];
+        let (handle, low, high) = (thread.handle, thread.low, thread.high);
+        let context = &mut self.context.0;
+        context.ContextFlags = CONTEXT_CONTROL_AMD64 | CONTEXT_INTEGER_AMD64;
+        let limit = match thread.want {
+            0 => self.config.stack,
+            want => want.min(self.config.stack),
+        };
+        let began = Instant::now();
+        // SAFETY: a thread of this process that is not this one; the
+        // context is aligned and ours; the copy has `limit + 16` bytes.
+        let (read, offset, got) = unsafe {
+            if SuspendThread(handle) == u32::MAX {
+                return None;
+            }
+            let read = GetThreadContext(handle, context) != 0;
+            let (mut offset, mut got) = (0, 0);
+            if read {
+                let rsp = context.Rsp as usize;
+                let want = if rsp >= low && rsp < high {
+                    (high - rsp).min(limit)
+                } else {
+                    limit.min(FOREIGN)
+                };
+                // The copy keeps the stack's alignment: unwinding loads
+                // saved vector registers with aligned moves.
+                offset = rsp & 15;
+                ReadProcessMemory(
+                    GetCurrentProcess(),
+                    rsp as *const c_void,
+                    self.copy.add(offset).cast(),
+                    want,
+                    &mut got,
+                );
+                got = got.min(want);
+            }
+            ResumeThread(handle);
+            (read, offset, got)
+        };
+        let held = began.elapsed().as_nanos() as u64;
+        self.held += 1;
+        self.held_ns += held;
+        self.held_longest = self.held_longest.max(held);
+        self.held_by[held_class(held).0] += 1;
+        if !read {
+            return None;
+        }
+        // What an earlier, longer copy left behind it.
+        let end = offset + got;
+        if end < self.dirty {
+            // SAFETY: inside the copy.
+            unsafe { self.copy.add(end).write_bytes(0, self.dirty - end) };
+        }
+        self.dirty = end;
+        Some((got, held))
+    }
+
+    /// Walks the stack copied by [`Sampler::capture`] (`got` bytes from
+    /// the stack pointer in `self.context`) into `self.frames`, from the
+    /// innermost: the count, whether the thread's first frame was
+    /// reached, and the bytes of the copy the frames took.
+    ///
+    /// The thread runs again, so the walk reads the copy: the stack
+    /// pointer and every saved register that points into the copied part
+    /// of the stack are moved into the copy before each step (frame
+    /// pointers are such registers), and a step is taken only if all it
+    /// can read lies in the copy or the zeroes after it ([`frame_fits`]).
+    fn walk(&mut self, at: usize, got: usize) -> (usize, bool, usize) {
+        let (low, high) = (self.threads[at].low, self.threads[at].high);
+        let depth = self.config.depth.min(MAX_DEPTH);
+        let context = &mut self.context.0;
+        let lo = context.Rsp as usize;
+        let start = self.copy as usize + (lo & 15);
+        let end = start + got;
+        let limit = self.copy as usize + self.room;
+        let top = if lo >= low && lo < high {
+            high
+        } else {
+            lo + got
+        };
+        let mut clipped = false;
+        self.frames[0] = context.Rip;
+        let mut frames = 1;
+        let (mut blind, mut last) = (0, 0);
+        while frames < depth {
+            // Into the copy: what points into the stack as it was.
+            for register in [
+                &mut context.Rsp,
+                &mut context.Rbx,
+                &mut context.Rbp,
+                &mut context.Rsi,
+                &mut context.Rdi,
+                &mut context.R12,
+                &mut context.R13,
+                &mut context.R14,
+                &mut context.R15,
+            ] {
+                let value = *register as usize;
+                if value >= lo && value < top {
+                    if value - lo < got {
+                        *register = (start + (value - lo)) as u64;
+                    } else {
+                        // Above what was copied: reads there find zeroes.
+                        *register = end as u64;
+                        clipped = true;
+                    }
+                }
+            }
+            let rsp = context.Rsp as usize;
+            // Out of the copy, or not upwards: the walk ends.
+            if rsp < start || rsp + 8 > end || rsp <= last {
+                break;
+            }
+            last = rsp;
+            let mut image = 0;
+            // SAFETY: looks up the unwind data covering `Rip`, if any.
+            let entry = unsafe { RtlLookupFunctionEntry(context.Rip, &mut image, null_mut()) };
+            if entry.is_null() {
+                // Code without unwind data is a leaf function (the
+                // system's call stubs are): its return address is at
+                // `rsp`. Twice in a row it is no stack of calls.
+                blind += 1;
+                if blind > 2 {
+                    break;
+                }
+                // SAFETY: `rsp..rsp + 8` is inside the copy.
+                context.Rip = unsafe { (rsp as *const u64).read_unaligned() };
+                context.Rsp += 8;
+            } else {
+                blind = 0;
+                // SAFETY: `entry` is `image`'s, as just looked up.
+                if !unsafe { frame_fits(image, entry.cast(), context, start, end, limit) } {
+                    break;
+                }
+                let (mut data, mut frame) = (null_mut(), 0);
+                // SAFETY: `entry` belongs to `image`; the context is our
+                // aligned copy, and what the step reads is in our copy of
+                // the stack (checked above).
+                unsafe {
+                    RtlVirtualUnwind(
+                        UNW_FLAG_NHANDLER,
+                        image,
+                        context.Rip,
+                        entry,
+                        context,
+                        &mut data,
+                        &mut frame,
+                        null_mut(),
+                    )
+                };
+            }
+            if context.Rip == 0 {
+                // The first frame's caller: none. (Zeroes read above a
+                // clipped copy look the same.)
+                return (frames, !clipped, last + 8 - start);
+            }
+            self.frames[frames] = context.Rip - 1;
+            frames += 1;
+        }
+        (frames, false, (last + 8).saturating_sub(start))
+    }
+
+    /// Follows the thread `id` as `role`; `handle`, if not null, is open
+    /// with [`ACCESS`] and becomes ours.
+    fn follow(&mut self, id: u32, role: Role, handle: HANDLE, name: Option<String>) {
+        if let Some(thread) = self.threads.iter_mut().find(|t| t.alive && t.id == id) {
+            // Seen doing more than it was followed for.
+            if (role as usize) < thread.role as usize {
+                thread.role = role;
+            }
+            thread.round = self.round;
+            if !handle.is_null() {
+                // SAFETY: ours, as the caller says.
+                unsafe { CloseHandle(handle) };
+            }
+            return;
+        }
+        let handle = if handle.is_null() {
+            // SAFETY: opens a thread of this process by its id.
+            unsafe { OpenThread(ACCESS, 0, id) }
+        } else {
+            handle
+        };
+        if handle.is_null() {
+            return;
+        }
+        if self.threads.iter().filter(|t| t.alive).count() >= self.config.most {
+            // SAFETY: opened above or given to us.
+            unsafe { CloseHandle(handle) };
+            return;
+        }
+        let (low, high) = stack_of(handle);
+        let mut cycles = 0;
+        // SAFETY: a thread handle of ours and a valid out pointer.
+        unsafe { QueryThreadCycleTime(handle, &mut cycles) };
+        self.threads.push(Thread {
+            id,
+            handle,
+            name: name.unwrap_or_else(|| thread_name(handle)),
+            start: start_of(handle),
+            role,
+            low,
+            high,
+            cycles,
+            last: None,
+            stood: false,
+            every: 1,
+            turn: 1,
+            owed: 0,
+            cost: 0.0,
+            want: 0,
+            tree: Tree::new(),
+            alive: true,
+            round: self.round,
+            looks: 0,
+            reused: 0,
+            missed: 0,
+            cut: 0,
+        });
+    }
+
+    /// Finds the threads to follow: those the hooks have seen, those with
+    /// a name of ours, and the busiest of the rest; and notes the ones
+    /// that ended.
+    fn rescan(&mut self) {
+        let passed = self.scanned.elapsed();
+        self.scanned = Instant::now();
+        self.round += 1;
+        let wanted = self.config.roles;
+        for known in &KNOWN_THREADS {
+            let id = known.thread.load(Relaxed);
+            if id == 0 || id == self.me {
+                continue;
+            }
+            let role = if known.seen[Seen::Submit as usize].load(Relaxed) >= SUBMITS {
+                Role::Submit
+            } else if known.seen[Seen::Record as usize].load(Relaxed) >= LIST_CALLS {
+                Role::Record
+            } else {
+                continue;
+            };
+            if wanted[role as usize] {
+                self.follow(id, role, null_mut(), None);
+            }
+        }
+        // Every thread of the process: (cycles since the last scan, id) of
+        // those with no role.
+        let mut busy: Vec<(u64, u32)> = Vec::new();
+        let mut previous: HANDLE = null_mut();
+        loop {
+            let mut next = null_mut();
+            // SAFETY: our own process; `previous` is null or a thread
+            // handle the last pass gave us, closed once passed on.
+            let status = unsafe {
+                let status = NtGetNextThread(
+                    GetCurrentProcess(),
+                    previous,
+                    THREAD_QUERY_LIMITED_INFORMATION,
+                    0,
+                    0,
+                    &mut next,
+                );
+                if !previous.is_null() {
+                    CloseHandle(previous);
+                }
+                status
+            };
+            if status != 0 || next.is_null() {
+                break;
+            }
+            previous = next;
+            // SAFETY: a thread handle just opened.
+            let id = unsafe { GetThreadId(next) };
+            if id == 0 || id == self.me {
+                continue;
+            }
+            if let Some(thread) = self.threads.iter_mut().find(|t| t.alive && t.id == id) {
+                thread.round = self.round;
+                continue;
+            }
+            let round = self.round;
+            let other = match self.others.entry(id) {
+                std::collections::hash_map::Entry::Occupied(o) => o.into_mut(),
+                std::collections::hash_map::Entry::Vacant(v) => {
+                    // SAFETY: opens a thread of this process by its id.
+                    let handle = unsafe { OpenThread(ACCESS, 0, id) };
+                    if handle.is_null() {
+                        continue;
+                    }
+                    let mut cycles = 0;
+                    // SAFETY: a thread handle of ours, a valid out pointer.
+                    unsafe { QueryThreadCycleTime(handle, &mut cycles) };
+                    v.insert(Other {
+                        handle,
+                        cycles,
+                        name: String::new(),
+                        round,
+                    })
+                }
+            };
+            other.round = round;
+            if other.name.is_empty() {
+                other.name = thread_name(other.handle);
+            }
+            if other.name == "victory-profile" {
+                continue;
+            }
+            // SAFETY: a thread handle of ours, opened with `SYNCHRONIZE`.
+            if unsafe { WaitForSingleObject(other.handle, 0) } == 0 {
+                continue;
+            }
+            if let Some(role) = Role::of_name(&other.name) {
+                if wanted[role as usize]
+                    && let Some(other) = self.others.remove(&id)
+                {
+                    self.follow(id, role, other.handle, Some(other.name));
+                }
+                continue;
+            }
+            let mut cycles = 0;
+            // SAFETY: a thread handle of ours and a valid out pointer.
+            unsafe { QueryThreadCycleTime(other.handle, &mut cycles) };
+            busy.push((cycles.saturating_sub(other.cycles), id));
+            other.cycles = cycles;
+        }
+        // Threads that ended: no longer looked at; what was sampled stays.
+        // (A thread we hold a handle to is still listed after its end.)
+        let round = self.round;
+        // SAFETY: a thread handle of ours, opened with `SYNCHRONIZE`.
+        let ended = |handle: HANDLE| unsafe { WaitForSingleObject(handle, 0) } == 0;
+        for thread in self
+            .threads
+            .iter_mut()
+            .filter(|t| t.alive && (t.round != round || ended(t.handle)))
+        {
+            thread.alive = false;
+            // SAFETY: ours.
+            unsafe { CloseHandle(thread.handle) };
+            thread.handle = null_mut();
+            for known in &KNOWN_THREADS {
+                let _ = known
+                    .thread
+                    .compare_exchange(thread.id, 0, Relaxed, Relaxed);
+            }
+        }
+        self.others.retain(|_, other| {
+            let gone = other.round != round || ended(other.handle);
+            if gone {
+                // SAFETY: ours.
+                unsafe { CloseHandle(other.handle) };
+            }
+            !gone
+        });
+        // The busiest of the rest: a quarter of a processor or more.
+        if wanted[Role::Busy as usize] {
+            let least = (0.25 * passed.as_micros() as f64 * self.cycles_per_us) as u64;
+            busy.sort_unstable_by(|a, b| b.cmp(a));
+            for (ran, id) in busy {
+                let followed = self
+                    .threads
+                    .iter()
+                    .filter(|t| t.alive && t.role == Role::Busy)
+                    .count();
+                if ran < least.max(1) || followed >= self.config.busy {
+                    break;
+                }
+                if let Some(other) = self.others.remove(&id) {
+                    self.follow(id, Role::Busy, other.handle, Some(other.name));
+                }
+            }
+        }
+    }
+}
