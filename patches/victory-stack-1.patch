+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::kbm::key_code;
+    use crate::overlay::gui::MAX_VERTS;
+
+    const SIZE: (f32, f32) = (1920.0, 1080.0);
+
+    fn model() -> Model {
+        Model {
+            controls: Settings::default(),
+            display: Display::default(),
+            pace: PaceModel::default(),
+            upscale: UpscaleModel::default(),
+        }
+    }
+
+    struct Rig {
+        menu: Menu,
+        perf: Perf,
+        sys: SysInfo,
+        env: Vec<(String, String)>,
+        now: u64,
+    }
+
+    impl Rig {
+        fn new() -> Rig {
+            let mut perf = Perf::default();
+            for i in 0..300u64 {
+                perf.present(i * 16_666_667 + (i % 17) * 400_000);
+            }
+            let sys = SysInfo {
+                ram_working_set: 9 << 30,
+                ram_private: 12 << 30,
+                ram_available: 20 << 30,
+                ram_total: 32 << 30,
+                vram_used: 5 << 30,
+                vram_budget: 10 << 30,
+                shared_used: 2 << 30,
+                shared_budget: 16 << 30,
+                vram_known: true,
+            };
+            Rig {
+                menu: Menu::new(model(), PaceModel::default(), true),
+                perf,
+                sys,
+                env: Vec::new(),
+                now: 0,
+            }
+        }
+
+        fn frame(&mut self, input: Input) -> Effects {
+            let env = self.env.clone();
+            let get = move |n: &str| env.iter().find(|(k, _)| k == n).map(|(_, v)| v.clone());
+            let ctx = Ctx {
+                size: SIZE,
+                perf: &self.perf,
+                sys: &self.sys,
+                env: &get,
+                now_ms: self.now,
+            };
+            self.now += 16;
+            let fx = self.menu.frame(&ctx, input);
+            let n = self.menu.draw_list().verts.len();
+            assert!(n > 0 && n <= MAX_VERTS && n.is_multiple_of(6));
+            fx
+        }
+
+        /// A click at the centre of the first drawn button-like rectangle
+        /// whose text is `label`, found by drawing and reading the layout
+        /// back from where the widgets put it.
+        fn click(&mut self, at: (f32, f32)) -> Effects {
+            let down = Input {
+                mouse: at,
+                left_down: true,
+                left_pressed: true,
+                ..Default::default()
+            };
+            let up = Input {
+                mouse: at,
+                left_released: true,
+                ..Default::default()
+            };
+            let mut fx = self.frame(down);
+            let second = self.frame(up);
+            merge(&mut fx, second);
+            fx
+        }
+
+        fn key(&mut self, vk: u8) -> Effects {
+            self.frame(Input {
+                keys_pressed: vec![vk],
+                mouse: (5.0, 5.0),
+                ..Default::default()
+            })
+        }
+    }
+
+    fn merge(into: &mut Effects, from: Effects) {
+        into.controls = from.controls.or(into.controls.take());
+        into.display = from.display.or(into.display.take());
+        into.pace = from.pace.or(into.pace.take());
+        into.save |= from.save;
+        into.close |= from.close;
+    }
+
+    // The layout at 1080p (scale 2): panel 1280 x 840 centred; tabs start at
+    // x = 320 + 16, y = 120 + 36 + 10; content below.
+    const TAB_Y: f32 = 120.0 + 36.0 + 10.0 + 16.0;
+    fn tab(i: usize) -> (f32, f32) {
+        (320.0 + 16.0 + 100.0 * 2.0 / 2.0 + i as f32 * 208.0, TAB_Y)
+    }
+
+    #[test]
+    fn it_opens_on_controls_and_the_tabs_switch_pages() {
+        let mut rig = Rig::new();
+        rig.frame(Input::default());
+        assert_eq!(rig.menu.page(), Page::Controls);
+        rig.click(tab(1));
+        assert_eq!(rig.menu.page(), Page::Display);
+        rig.click(tab(2));
+        assert_eq!(rig.menu.page(), Page::Performance);
+        rig.click(tab(0));
+        assert_eq!(rig.menu.page(), Page::Controls);
+    }
+
+    #[test]
+    fn esc_closes_unless_a_binding_waits_for_a_key() {
+        let mut rig = Rig::new();
+        assert!(rig.key(0x1B).close);
+        rig.menu.capture = Some(Capture {
+            out: Output::Walk,
+            old: None,
+        });
+        let fx = rig.key(0x1B);
+        assert!(!fx.close);
+        assert!(!rig.menu.waiting_for_key(), "Esc cancels the binding");
+        assert!(!fx.save && fx.controls.is_none());
+    }
+
+    #[test]
+    fn a_binding_waits_for_a_key_and_takes_it_from_what_had_it() {
+        let mut rig = Rig::new();
+        let walk = Output::Walk;
+        let z = key_code("Z").unwrap();
+        rig.menu.capture = Some(Capture {
+            out: walk,
+            old: Some(z),
+        });
+        // Space is X (jump): binding it to Walk takes it from X.
+        let fx = rig.key(key_code("Space").unwrap());
+        let c = fx.controls.expect("published at once");
+        assert!(fx.save);
+        assert_eq!(c.on_foot.keys_of(walk), vec![key_code("Space").unwrap()]);
+        assert!(c.on_foot.keys_of(Output::Button(crate::kbm::X)).is_empty());
+        assert!(rig.menu.status_text().unwrap().contains("Space now does"));
+        assert!(rig.menu.status_text().unwrap().contains("no longer does"));
+        assert_eq!(rig.menu.model.controls, c);
+        // The vehicle layout is untouched.
+        assert_eq!(c.vehicle, Settings::default().vehicle);
+    }
+
+    #[test]
+    fn delete_clears_and_the_wheel_and_mouse_buttons_bind() {
+        let mut rig = Rig::new();
+        let a = Output::Button(crate::kbm::A);
+        let shift = key_code("LShift").unwrap();
+        rig.menu.capture = Some(Capture {
+            out: a,
+            old: Some(shift),
+        });
+        let fx = rig.key(0x2E);
+        assert_eq!(
+            fx.controls.unwrap().on_foot.keys_of(a),
+            vec![key_code("Enter").unwrap(), key_code("RShift").unwrap()]
+        );
+        rig.menu.capture = Some(Capture { out: a, old: None });
+        let fx = rig.frame(Input {
+            wheel: 1.0,
+            ..Default::default()
+        });
+        assert!(fx.controls.unwrap().on_foot.keys_of(a).contains(&WHEEL_UP));
+        rig.menu.capture = Some(Capture { out: a, old: None });
+        let fx = rig.key(0x05);
+        assert!(fx.controls.unwrap().on_foot.keys_of(a).contains(&0x05));
+        // Reserved keys do not bind: F1 and Windows keys are ignored.
+        rig.menu.capture = Some(Capture { out: a, old: None });
+        assert!(rig.key(0x70).controls.is_none() && rig.key(0x5B).controls.is_none());
+        assert!(rig.menu.waiting_for_key());
+    }
+
+    #[test]
+    fn clicking_a_key_box_waits_for_a_key_and_the_rest_of_the_menu_stops_answering() {
+        let mut rig = Rig::new();
+        rig.frame(Input::default());
+        // Find a key box by drawing: the first row of bindings sits below the
+        // sliders; click far to the right where the boxes are, scanning down.
+        let mut waiting = false;
+        'scan: for y in (300..900).step_by(8) {
+            for x in [1320.0f32, 1190.0, 1090.0] {
+                rig.click((x, y as f32));
+                if rig.menu.waiting_for_key() {
+                    waiting = true;
+                    break 'scan;
+                }
+            }
+        }
+        assert!(waiting, "a click on a key box starts a binding");
+        // A click on a tab while waiting does nothing.
+        rig.click(tab(1));
+        assert_eq!(rig.menu.page(), Page::Controls);
+    }
+
+    #[test]
+    fn restart_is_noted_for_swap_chain_settings_only() {
+        let mut rig = Rig::new();
+        rig.menu.set_page(Page::Display);
+        rig.menu.model.pace.pace = true;
+        rig.menu.model.pace.fps = Some(60);
+        assert!(rig.menu.restart_needed().is_empty());
+        rig.menu.model.pace.latency = 1;
+        rig.menu.model.pace.tearing = true;
+        assert_eq!(rig.menu.restart_needed(), vec!["frame latency", "tearing"]);
+        rig.frame(Input::default());
+    }
+
+    #[test]
+    fn reset_needs_two_clicks_and_keeps_what_the_page_does_not_show() {
+        let mut rig = Rig::new();
+        rig.menu.model.controls.sensitivity = 3.0;
+        rig.menu.model.controls.capture = false;
+        rig.menu
+            .model
+            .controls
+            .on_foot
+            .rebind(Output::Walk, None, key_code("X"));
+        rig.frame(Input::default());
+        // The reset button is at the right of the footer.
+        let at = (320.0 + 1280.0 - 16.0 - 100.0, 120.0 + 840.0 - 60.0 + 20.0);
+        let fx = rig.click(at);
+        assert!(fx.controls.is_none(), "the first click only arms it");
+        let fx = rig.click(at);
+        let c = fx.controls.expect("the second resets");
+        assert_eq!(c.sensitivity, 1.0);
+        assert!(!c.capture, "what the page does not show stays");
+        assert_eq!(c.on_foot, Settings::default().on_foot);
+        assert!(fx.save);
+    }
+
+    #[test]
+    fn pages_draw_inside_the_window_whatever_the_size() {
+        for size in [
+            (1920.0, 1080.0),
+            (1280.0, 720.0),
+            (3840.0, 2160.0),
+            (800.0, 600.0),
+        ] {
+            for page in [Page::Controls, Page::Display, Page::Performance] {
+                let mut rig = Rig::new();
+                rig.menu.set_page(page);
+                let env = |_: &str| None;
+                let ctx = Ctx {
+                    size,
+                    perf: &rig.perf,
+                    sys: &rig.sys,
+                    env: &env,
+                    now_ms: 0,
+                };
+                rig.menu.frame(&ctx, Input::default());
+                let list = rig.menu.draw_list();
+                assert!(!list.verts.is_empty());
+                for v in &list.verts {
+                    assert!(
+                        v.pos[0] >= 0.0
+                            && v.pos[0] <= size.0
+                            && v.pos[1] >= 0.0
+                            && v.pos[1] <= size.1,
+                        "{page:?} {size:?} {:?}",
+                        v.pos
+                    );
+                    assert!(v.uv[0] >= 0.0 && v.uv[0] <= 1.0 && v.uv[1] >= 0.0 && v.uv[1] <= 1.0);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn the_hud_draws_only_when_asked() {
+        let mut rig = Rig::new();
+        let env = |_: &str| None;
+        let ctx = Ctx {
+            size: SIZE,
+            perf: &rig.perf,
+            sys: &rig.sys,
+            env: &env,
+            now_ms: 0,
+        };
+        rig.menu.hud(&ctx);
+        assert!(rig.menu.draw_list().verts.is_empty());
+        rig.menu.model.display.graph = true;
+        rig.menu.hud(&ctx);
+        let n = rig.menu.draw_list().verts.len();
+        assert!(n > 100 && n < 6000, "{n}");
+    }
+
+    #[test]
+    fn the_hints_draw_inside_the_window_wrapped_and_alone() {
+        let mut rig = Rig::new();
+        let env = |_: &str| None;
+        let hints = crate::hints::legend(&Settings::default());
+        for size in [(1280.0, 720.0), (320.0, 240.0)] {
+            let ctx = Ctx {
+                size,
+                perf: &rig.perf,
+                sys: &rig.sys,
+                env: &env,
+                now_ms: 0,
+            };
+            rig.menu.hud_with(&ctx, Some(&hints));
+            let verts = &rig.menu.draw_list().verts;
+            assert!(verts.len() > 100, "{}", verts.len());
+            for v in verts.iter() {
+                assert!(v.pos[0] >= 0.0 && v.pos[0] <= size.0 + 0.5, "x {}", v.pos[0]);
+                assert!(v.pos[1] >= 0.0 && v.pos[1] <= size.1 + 0.5, "y {}", v.pos[1]);
+            }
+        }
+    }
+
+    #[test]
+    fn a_frame_cap_turns_pacing_on_and_title_leaves_it() {
+        use super::super::store::{FRAME_CAPS, with_frame_cap};
+        let p = PaceModel::default();
+        let capped = with_frame_cap(p, Some(60));
+        assert!(capped.pace && capped.fps == Some(60));
+        let back = with_frame_cap(capped, None);
+        assert!(back.pace && back.fps.is_none(), "pacing stays as it was");
+        assert!(FRAME_CAPS.contains(&Some(30)) && FRAME_CAPS[0].is_none());
+    }
+
+    #[test]
+    fn env_set_pacing_is_tagged_and_speed_switches_are_listed() {
+        let mut rig = Rig::new();
+        rig.env = vec![
+            ("VICTORY_PACE".into(), "1".into()),
+            ("VICTORY_GROUP_SYNC".into(), "3".into()),
+        ];
+        rig.menu.set_page(Page::Display);
+        rig.frame(Input::default());
+        rig.menu.set_page(Page::Performance);
+        rig.frame(Input::default());
+    }
+
+    /// Writes the pages as pictures: `VICTORY_OVERLAY_PREVIEW=<dir> cargo test
+    /// -p victory-core --lib overlay_previews -- --ignored`.
+    #[test]
+    #[ignore = "writes pictures to the directory named by VICTORY_OVERLAY_PREVIEW"]
+    fn overlay_previews() {
+        let Some(dir) = std::env::var_os("VICTORY_OVERLAY_PREVIEW") else {
+            return;
+        };
+        let dir = std::path::PathBuf::from(dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let backdrop = |w: u32, h: u32| -> Vec<u8> {
+            // A stand-in for the game: a sky-to-ground gradient.
+            let mut px = vec![0u8; (w * h * 4) as usize];
+            for y in 0..h {
+                for x in 0..w {
+                    let f = y as f32 / h as f32;
+                    let i = ((y * w + x) * 4) as usize;
+                    px[i] = (60.0 + 90.0 * f) as u8;
+                    px[i + 1] = (110.0 + 40.0 * (1.0 - f)) as u8;
+                    px[i + 2] = (170.0 - 90.0 * f) as u8;
+                    px[i + 3] = 255;
+                }
+            }
+            px
+        };
+        let (w, h) = (1920u32, 1080u32);
+        let mut rig = Rig::new();
+        rig.menu.model.display.graph = true;
+        rig.menu.model.pace.latency = 1;
+        let env = rig.env.clone();
+        let _ = env;
+        let shot = |rig: &mut Rig, name: &str| {
+            let list = rig.menu.draw_list();
+            let mut px = backdrop(w, h);
+            crate::overlay::preview::rasterize(&list.verts, (w, h), &mut px);
+            crate::overlay::preview::write_ppm(&dir.join(name), (w, h), &px);
+        };
+        let get = |_: &str| None;
+        {
+            let ctx = Ctx {
+                size: (w as f32, h as f32),
+                perf: &rig.perf,
+                sys: &rig.sys,
+                env: &get,
+                now_ms: 0,
+            };
+            rig.menu.hud(&ctx);
+        }
+        shot(&mut rig, "hud.ppm");
+        for (page, name) in [
+            (Page::Controls, "controls.ppm"),
+            (Page::Display, "display.ppm"),
+            (Page::Performance, "performance.ppm"),
+        ] {
+            rig.menu.set_page(page);
+            rig.frame(Input::default());
+            shot(&mut rig, name);
+        }
+        rig.menu.set_page(Page::Controls);
+        rig.menu.capture = Some(Capture {
+            out: Output::Walk,
+            old: Some(key_code("Z").unwrap()),
+        });
+        rig.menu.status = None;
+        rig.frame(Input::default());
+        shot(&mut rig, "controls-capture.ppm");
+    }
+}
diff --git a/crates/victory-core/src/overlay/mod.rs b/crates/victory-core/src/overlay/mod.rs
new file mode 100644
index 0000000..81bc6d6
--- /dev/null
+++ b/crates/victory-core/src/overlay/mod.rs
@@ -0,0 +1,336 @@
+//! The in-game settings overlay: F1 opens a menu drawn by the runtime over
+//! the game (controls and key bindings, display and pacing, performance),
+//! and the game's input stops while it is open.
+//!
+//! * [`font`], [`gui`]: a bitmap font and a small immediate-mode GUI that
+//!   produces textured triangles.
+//! * [`menu`]: the pages, as a state machine over plain data.
+//! * [`store`]: what is saved where; [`perf`]: frame times and memory.
+//! * This module: the one overlay of the process, the input it is given
+//!   each present and the effects it has on the rest of the runtime.
+//!
+//! The window side lives in `victory-gpu` (it samples the keyboard and
+//! mouse each present, draws the triangles into the present's copy list and
+//! changes the window's mode); `victory-hle` pauses the title's input while
+//! [`is_open`].
+
+pub mod font;
+pub mod gui;
+pub mod menu;
+pub mod perf;
+#[cfg(test)]
+pub mod preview;
+pub mod store;
+
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicBool, AtomicI32, AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+use gui::{Input, Vertex};
+use menu::{Ctx, Menu};
+use perf::{Perf, SysInfo};
+use store::{Display, Model, PaceModel, SaveJob, UpscaleModel};
+
+/// The key that opens and closes the overlay: F1.
+pub const TOGGLE_KEY: u8 = 0x70;
+
+static OPEN: AtomicBool = AtomicBool::new(false);
+static WHEEL: AtomicI32 = AtomicI32::new(0);
+
+/// Whether the overlay is open: the title's input is paused meanwhile.
+pub fn is_open() -> bool {
+    OPEN.load(Ordering::Acquire)
+}
+
+/// Wheel steps (away from the user positive) the input thread saw while
+/// the overlay was open; they scroll its lists.
+pub fn add_wheel(steps: i32) {
+    WHEEL.fetch_add(steps, Ordering::Relaxed);
+}
+
+struct Paths {
+    settings: PathBuf,
+}
+
+static PATHS: OnceLock<Paths> = OnceLock::new();
+static DISPLAY: Mutex<Option<(u64, Display)>> = Mutex::new(None);
+static DISPLAY_VERSION: AtomicU64 = AtomicU64::new(0);
+static HINTS: OnceLock<crate::hints::Mode> = OnceLock::new();
+
+fn hints_mode() -> crate::hints::Mode {
+    HINTS.get().copied().unwrap_or_default()
+}
+
+/// `[display]` as it is now with a count of changes (the window side acts
+/// on a new one).
+pub fn display() -> (u64, Display) {
+    let g = DISPLAY.lock().unwrap_or_else(|e| e.into_inner());
+    g.unwrap_or((0, Display::default()))
+}
+
+fn set_display(d: Display) {
+    let v = DISPLAY_VERSION.fetch_add(1, Ordering::AcqRel) + 1;
+    *DISPLAY.lock().unwrap_or_else(|e| e.into_inner()) = Some((v, d));
+}
+
+/// Takes `[display]`, `[pace]` and the places of the settings and key map
+/// files from the configuration. Call it before `kbm::configure`. Returns
+/// what could not be read.
+pub fn configure(cfg: &crate::Config) -> Vec<String> {
+    let mut problems = Vec::new();
+    crate::pace::configure(cfg.pace.as_ref());
+    crate::upscale::configure(cfg.upscale.as_ref());
+    crate::kbm::set_keymap_file(cfg.data_dir.join("keymap.txt"));
+    let settings = cfg.source.clone().unwrap_or_else(|| {
+        let p = std::env::var_os("VICTORY_CONFIG")
+            .map_or_else(|| PathBuf::from("victory.toml"), PathBuf::from);
+        std::path::absolute(&p).unwrap_or(p)
+    });
+    let _ = PATHS.set(Paths { settings });
+    let (mode, p) = crate::hints::Mode::from_sources(cfg.game.as_ref(), &|n| std::env::var(n).ok());
+    problems.extend(p);
+    let _ = HINTS.set(mode);
+    problems.extend(crate::rumble::configure(cfg.game.as_ref()));
+    if let Some(t) = &cfg.display {
+        let (d, p) = Display::parse(t);
+        problems.extend(p);
+        set_display(d);
+    }
+    problems
+}
+
+/// What the window side gives the overlay each present.
+pub struct Raw<'a> {
+    /// A steady clock, nanoseconds.
+    pub now_ns: u64,
+    /// The window's client size, pixels.
+    pub size: (u32, u32),
+    /// The pointer in the client area, pixels.
+    pub mouse: (f32, f32),
+    /// Every key and mouse button (1, 2, 4, 5, 6) held now. Empty while
+    /// the window is not the one in front.
+    pub down: &'a [u8],
+}
+
+struct Overlay {
+    menu: Menu,
+    perf: Perf,
+    sys: SysInfo,
+    down: Vec<u8>,
+    open: bool,
+    /// The left button was down at the last present (for its release).
+    prev_left: bool,
+    /// When the keyboard hints show (`hints`).
+    hints: crate::hints::Tracker,
+}
+
+static OVERLAY: Mutex<Option<Overlay>> = Mutex::new(None);
+static SAVE_RESULT: Mutex<Option<Result<(), String>>> = Mutex::new(None);
+static SAVE_PENDING: Mutex<Option<SaveJob>> = Mutex::new(None);
+static SAVE_LOCK: Mutex<()> = Mutex::new(());
+
+fn lock<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// Writes the files, off the present thread; of several saves asked for
+/// in a row the newest wins.
+fn save(job: SaveJob) {
+    *lock(&SAVE_PENDING) = Some(job);
+    let spawned = std::thread::Builder::new()
+        .name("victory-save".into())
+        .spawn(|| {
+            let _one_at_a_time = lock(&SAVE_LOCK);
+            if let Some(job) = lock(&SAVE_PENDING).take() {
+                let result = store::save(&job);
+                if let Err(e) = &result {
+                    tracing::warn!("settings not saved: {e}");
+                } else {
+                    tracing::info!(file = %job.settings_path.display(), "settings saved");
+                }
+                *lock(&SAVE_RESULT) = Some(result);
+            }
+        });
+    if spawned.is_err() {
+        *lock(&SAVE_RESULT) = Some(Err("no thread to save on".into()));
+    }
+}
+
+impl Overlay {
+    fn new() -> Overlay {
+        let controls = crate::kbm::current();
+        let kbm_on = crate::kbm::settings().enabled;
+        let model = Model {
+            controls,
+            display: display().1,
+            pace: PaceModel::current(),
+            upscale: UpscaleModel::current(),
+        };
+        Overlay {
+            menu: Menu::new(model, PaceModel::at_start(), kbm_on),
+            perf: Perf::default(),
+            sys: SysInfo::default(),
+            down: Vec::new(),
+            open: false,
+            prev_left: false,
+            hints: crate::hints::Tracker::new(hints_mode()),
+        }
+    }
+
+    fn apply(&mut self, fx: menu::Effects) {
+        if let Some(c) = fx.controls {
+            crate::kbm::publish(c);
+        }
+        if let Some(d) = fx.display {
+            set_display(d);
+        }
+        if let Some(p) = fx.pace {
+            crate::pace::set_live(p.pace, p.fps, p.input);
+        }
+        if let Some(u) = fx.upscale {
+            crate::upscale::set_live(u.upscaler, u.framegen, u.sharpness);
+        }
+        if fx.save {
+            match PATHS.get() {
+                Some(paths) => save(SaveJob {
+                    settings_path: paths.settings.clone(),
+                    edits: store::edits(&self.menu.model),
+                    keymap_path: crate::kbm::keymap_file(),
+                    keymap_text: self.menu.model.controls.keymap_text(),
+                }),
+                None => *lock(&SAVE_RESULT) = Some(Err("no settings file is configured".into())),
+            }
+        }
+        if fx.close {
+            self.set_open(false);
+        }
+    }
+
+    fn set_open(&mut self, open: bool) {
+        if self.open && !open {
+            self.menu.cancel_capture();
+        }
+        self.open = open;
+        OPEN.store(open, Ordering::Release);
+        tracing::info!(open, "settings overlay");
+    }
+
+    fn frame(&mut self, raw: &Raw, sys: Option<SysInfo>, draw: &mut dyn FnMut(&[Vertex])) {
+        self.perf.present(raw.now_ns);
+        if let Some(s) = sys {
+            self.sys = s;
+        }
+        if let Some(result) = lock(&SAVE_RESULT).take() {
+            self.menu.saved(result);
+        }
+        let pressed: Vec<u8> = raw
+            .down
+            .iter()
+            .copied()
+            .filter(|k| !self.down.contains(k))
+            .collect();
+        let held = |k: u8| raw.down.contains(&k);
+        let left = held(0x01);
+        let wheel = WHEEL.swap(0, Ordering::Relaxed);
+        let mut pressed = pressed;
+        if pressed.contains(&TOGGLE_KEY) {
+            self.set_open(!self.open);
+            pressed.retain(|&k| k != TOGGLE_KEY);
+        }
+        let input = Input {
+            mouse: raw.mouse,
+            left_down: left,
+            left_pressed: pressed.contains(&0x01),
+            left_released: self.prev_left && !left,
+            right_pressed: pressed.contains(&0x02),
+            wheel: wheel as f32,
+            keys_pressed: pressed,
+        };
+        self.prev_left = left;
+        self.down = raw.down.to_vec();
+        let get = |n: &str| crate::env::env(n);
+        let ctx = Ctx {
+            size: (raw.size.0 as f32, raw.size.1 as f32),
+            perf: &self.perf,
+            sys: &self.sys,
+            env: &get,
+            now_ms: raw.now_ns / 1_000_000,
+        };
+        if self.open {
+            let fx = self.menu.frame(&ctx, input);
+            self.apply(fx);
+            draw(&self.menu.draw_list().verts);
+        } else {
+            let show = self.hints.update(raw.now_ns / 1_000_000, raw.down);
+            if show || self.menu.model.display.graph {
+                let legend = show.then(|| crate::hints::legend(&self.menu.model.controls));
+                self.menu.hud_with(&ctx, legend.as_deref());
+                draw(&self.menu.draw_list().verts);
+            }
+        }
+    }
+}
+
+/// One present's worth of overlay: reads `raw`, runs the menu (or the hud
+/// graph) and hands the triangles to `draw` when there is something to draw.
+/// `sys` is new memory figures, when the caller has them.
+pub fn frame(raw: &Raw, sys: Option<SysInfo>, mut draw: impl FnMut(&[Vertex])) {
+    let mut guard = lock(&OVERLAY);
+    guard
+        .get_or_insert_with(Overlay::new)
+        .frame(raw, sys, &mut draw);
+}
+
+/// Whether the caller should read the memory figures this present: they
+/// cost a few system calls, so only while something shows them.
+pub fn wants_sys() -> bool {
+    is_open()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn raw<'a>(now_ms: u64, down: &'a [u8]) -> Raw<'a> {
+        Raw {
+            now_ns: now_ms * 1_000_000,
+            size: (1280, 720),
+            mouse: (10.0, 10.0),
+            down,
+        }
+    }
+
+    // One test: the overlay is the process's, and open/closed is global.
+    #[test]
+    fn f1_opens_and_closes_it_and_esc_closes_it() {
+        let run = |ms: u64, down: &[u8]| {
+            let mut n = 0;
+            frame(&raw(ms, down), None, |v| n = v.len());
+            n
+        };
+        assert_eq!(run(0, &[]), 0, "closed and no graph: nothing drawn");
+        assert!(!is_open());
+        // F1 goes down: it opens, and draws that same frame.
+        assert!(run(16, &[TOGGLE_KEY]) > 0);
+        assert!(is_open());
+        // Held, it does not toggle again.
+        assert!(run(32, &[TOGGLE_KEY]) > 0);
+        assert!(is_open());
+        run(48, &[]);
+        assert!(is_open());
+        // Esc closes (after drawing the frame it was pressed in).
+        run(64, &[0x1B]);
+        assert!(!is_open());
+        assert_eq!(run(80, &[]), 0);
+        // F1 again, then F1 closes.
+        run(96, &[TOGGLE_KEY]);
+        assert!(is_open());
+        run(112, &[]);
+        run(128, &[TOGGLE_KEY]);
+        assert!(!is_open());
+        // Wheel steps are taken, not kept for later.
+        add_wheel(3);
+        run(144, &[]);
+        assert_eq!(WHEEL.load(Ordering::Relaxed), 0);
+    }
+}
diff --git a/crates/victory-core/src/overlay/perf.rs b/crates/victory-core/src/overlay/perf.rs
new file mode 100644
index 0000000..54a9084
--- /dev/null
+++ b/crates/victory-core/src/overlay/perf.rs
@@ -0,0 +1,279 @@
+//! What the performance page shows: frame times, memory, and which speed
+//! switches the environment has on.
+
+use std::collections::VecDeque;
+
+/// Frames of history the graph keeps.
+pub const HISTORY: usize = 240;
+
+/// Present-to-present times, newest last.
+#[derive(Default)]
+pub struct Perf {
+    ms: VecDeque<f32>,
+    /// Present times of the last second, nanoseconds.
+    recent: VecDeque<u64>,
+}
+
+impl Perf {
+    /// A frame was presented at `now` (nanoseconds on any steady clock).
+    pub fn present(&mut self, now: u64) {
+        if let Some(&last) = self.recent.back()
+            && now > last
+        {
+            self.ms.push_back((now - last) as f32 / 1e6);
+            if self.ms.len() > HISTORY {
+                self.ms.pop_front();
+            }
+        }
+        self.recent.push_back(now);
+        while self.recent.len() > 2 && now.saturating_sub(self.recent[0]) > 1_000_000_000 {
+            self.recent.pop_front();
+        }
+    }
+
+    /// Frames a second over the last second (0 with fewer than two frames).
+    pub fn fps(&self) -> f32 {
+        let (Some(&first), Some(&last)) = (self.recent.front(), self.recent.back()) else {
+            return 0.0;
+        };
+        if self.recent.len() < 2 || last <= first {
+            return 0.0;
+        }
+        (self.recent.len() - 1) as f32 * 1e9 / (last - first) as f32
+    }
+
+    /// The mean frame time of the last second, ms.
+    pub fn frame_ms(&self) -> f32 {
+        match self.fps() {
+            f if f > 0.0 => 1000.0 / f,
+            _ => 0.0,
+        }
+    }
+
+    /// The slowest frame in the last `n`, ms.
+    pub fn worst_ms(&self, n: usize) -> f32 {
+        self.ms.iter().rev().take(n).copied().fold(0.0, f32::max)
+    }
+
+    /// The frame time 99% of the last `HISTORY` frames beat, ms.
+    pub fn p99_ms(&self) -> f32 {
+        if self.ms.is_empty() {
+            return 0.0;
+        }
+        let mut sorted: Vec<f32> = self.ms.iter().copied().collect();
+        sorted.sort_by(f32::total_cmp);
+        sorted[((sorted.len() - 1) as f32 * 0.99).round() as usize]
+    }
+
+    /// The last `n` frame times, oldest first.
+    pub fn samples(&self, n: usize) -> Vec<f32> {
+        let skip = self.ms.len().saturating_sub(n);
+        self.ms.iter().skip(skip).copied().collect()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.ms.is_empty()
+    }
+}
+
+/// Memory, as the host reports it now (bytes; 0 where unknown).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct SysInfo {
+    /// This process's working set and private bytes.
+    pub ram_working_set: u64,
+    pub ram_private: u64,
+    /// The PC's memory: free and all of it.
+    pub ram_available: u64,
+    pub ram_total: u64,
+    /// The card's own memory: used by this process and its budget.
+    pub vram_used: u64,
+    pub vram_budget: u64,
+    /// The PC's memory the card shares: used by this process and its budget.
+    pub shared_used: u64,
+    pub shared_budget: u64,
+    pub vram_known: bool,
+}
+
+/// How a speed switch is changed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Change {
+    /// In the overlay, at once.
+    Live,
+    /// By the environment or the config file, at the next start.
+    Restart,
+}
+
+/// The environment switches that make the runtime faster (or trade one
+/// cost for another), as the performance page lists them. They are read at
+/// start, so changing one needs a restart; the pacing ones are read live
+/// from the pacing state instead.
+pub const SPEED_SWITCHES: &[&str] = &[
+    "VICTORY_PSO_SHARE",
+    "VICTORY_PSO_CACHE",
+    "VICTORY_PRECOMPILED_PSO",
+    "VICTORY_SHADER_OPT",
+    "VICTORY_GROUP_SYNC",
+    "VICTORY_JOIN_COPIES",
+    "VICTORY_COPY_FAST",
+    "VICTORY_FAST_HASH",
+    "VICTORY_DIRECT_WRITES",
+    "VICTORY_CUT_WAITS",
+    "VICTORY_CUT_WRITES",
+    "VICTORY_LATE_WAITS",
+    "VICTORY_SPLIT_WAITS",
+    "VICTORY_QUEUE_WAIT",
+    "VICTORY_BARRIER_MERGE",
+    "VICTORY_INDIRECT_MERGE",
+    "VICTORY_INDIRECT_WINDOW",
+    "VICTORY_INPLACE",
+    "VICTORY_LAZY_TEXTURES",
+    "VICTORY_TABLED_TEXTURES",
+    "VICTORY_HEAP_TEXTURES",
+    "VICTORY_TEXTURE_NO_WAIT",
+    "VICTORY_MAPPING_RANGES",
+    "VICTORY_LIST_POOL",
+    "VICTORY_SCRATCH_POOL",
+    "VICTORY_CARD_REHASH_RUNS",
+    "VICTORY_WINDOW_TAILS",
+    "VICTORY_DEPTH_TWINS",
+    "VICTORY_DS_UNBUFFERED",
+    "VICTORY_EARLY_WORKERS",
+    "VICTORY_REBAR",
+    "VICTORY_RENDER_SCALE",
+];
+
+/// One row of the switch list.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SwitchRow {
+    pub name: String,
+    pub on: bool,
+    /// What the variable says ("-" when unset).
+    pub value: String,
+    pub change: Change,
+}
+
+/// Whether a variable's value means on: set, and not a spelling of off.
+pub fn means_on(value: &str) -> bool {
+    !matches!(
+        value.trim().to_ascii_lowercase().as_str(),
+        "" | "0" | "false" | "off" | "no"
+    )
+}
+
+/// The switch rows for a variable lookup (`SCARLETT_` spellings count, as
+/// everywhere), with the pacing switches from `pace` (their state now).
+pub fn switch_rows(
+    get: &dyn Fn(&str) -> Option<String>,
+    pace: &[(&str, String, bool, Change)],
+) -> Vec<SwitchRow> {
+    let mut rows: Vec<SwitchRow> = pace
+        .iter()
+        .map(|(name, value, on, change)| SwitchRow {
+            name: (*name).to_string(),
+            on: *on,
+            value: value.clone(),
+            change: *change,
+        })
+        .collect();
+    for &name in SPEED_SWITCHES {
+        let value = get(name);
+        let on = value.as_deref().is_some_and(means_on);
+        let shown = match value {
+            Some(v) if v.chars().count() > 12 => "set".to_string(),
+            Some(v) if v.trim().is_empty() => "-".to_string(),
+            Some(v) => v.trim().to_string(),
+            None => "-".to_string(),
+        };
+        rows.push(SwitchRow {
+            name: name.to_string(),
+            on,
+            value: shown,
+            change: Change::Restart,
+        });
+    }
+    rows
+}
+
+/// Bytes as a short size: `812 MB`, `1.4 GB`.
+pub fn size(bytes: u64) -> String {
+    let mb = bytes as f64 / (1024.0 * 1024.0);
+    if mb >= 1024.0 {
+        format!("{:.1} GB", mb / 1024.0)
+    } else {
+        format!("{mb:.0} MB")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fps_and_percentiles_follow_the_presents() {
+        let mut p = Perf::default();
+        assert_eq!(p.fps(), 0.0);
+        // 60 frames of 16.667 ms, then one of 100 ms.
+        let mut t = 0u64;
+        for _ in 0..60 {
+            p.present(t);
+            t += 16_666_667;
+        }
+        p.present(t + 83_333_333);
+        assert!((p.worst_ms(5) - 100.0).abs() < 0.1);
+        assert!(p.fps() > 50.0 && p.fps() < 65.0, "{}", p.fps());
+        assert!((p.p99_ms() - 100.0).abs() < 0.2 || (p.p99_ms() - 16.7).abs() < 0.2);
+        assert_eq!(p.samples(10).len(), 10);
+        assert!(p.samples(10_000).len() <= HISTORY);
+    }
+
+    #[test]
+    fn history_is_bounded_and_the_second_window_slides() {
+        let mut p = Perf::default();
+        for i in 0..1000u64 {
+            p.present(i * 10_000_000);
+        }
+        assert_eq!(p.samples(10_000).len(), HISTORY);
+        assert!((p.fps() - 100.0).abs() < 1.0);
+        assert!((p.frame_ms() - 10.0).abs() < 0.2);
+    }
+
+    #[test]
+    fn switches_read_as_on_unless_off_spelled() {
+        for off in ["", "0", "false", "OFF", " no "] {
+            assert!(!means_on(off), "{off:?}");
+        }
+        for on in ["1", "3", "true", "yes", "C:\\path"] {
+            assert!(means_on(on), "{on:?}");
+        }
+    }
+
+    #[test]
+    fn rows_list_the_pacing_switches_first_and_every_speed_switch() {
+        let get = |n: &str| match n {
+            "VICTORY_GROUP_SYNC" => Some("3".to_string()),
+            "VICTORY_PSO_CACHE" => Some("0".to_string()),
+            "VICTORY_PSO_SHARE" => Some("C:\\a\\very\\long\\path".to_string()),
+            _ => None,
+        };
+        let pace = [("VICTORY_PACE", "on".to_string(), true, Change::Live)];
+        let rows = switch_rows(&get, &pace);
+        assert_eq!(rows[0].name, "VICTORY_PACE");
+        assert_eq!(rows[0].change, Change::Live);
+        assert_eq!(rows.len(), SPEED_SWITCHES.len() + 1);
+        let row = |n: &str| rows.iter().find(|r| r.name == n).unwrap();
+        assert!(row("VICTORY_GROUP_SYNC").on);
+        assert_eq!(row("VICTORY_GROUP_SYNC").value, "3");
+        assert!(!row("VICTORY_PSO_CACHE").on);
+        assert_eq!(row("VICTORY_PSO_CACHE").value, "0");
+        assert_eq!(row("VICTORY_PSO_SHARE").value, "set");
+        assert!(row("VICTORY_PSO_SHARE").on);
+        assert_eq!(row("VICTORY_JOIN_COPIES").value, "-");
+        assert_eq!(row("VICTORY_JOIN_COPIES").change, Change::Restart);
+    }
+
+    #[test]
+    fn sizes_are_short() {
+        assert_eq!(size(812 << 20), "812 MB");
+        assert_eq!(size(3 << 29), "1.5 GB");
+    }
+}
