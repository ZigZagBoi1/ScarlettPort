diff --git a/crates/victory-core/src/env.rs b/crates/victory-core/src/env.rs
new file mode 100644
index 0000000..7dff557
--- /dev/null
+++ b/crates/victory-core/src/env.rs
@@ -0,0 +1,47 @@
+﻿//! Environment switches: every `VICTORY_*` variable can also be given as
+//! `SCARLETT_*` (the `VICTORY_` name wins when both are set).
+
+use std::env::VarError;
+use std::ffi::OsString;
+
+fn alias(name: &str) -> Option<String> {
+    name.strip_prefix("VICTORY_").map(|rest| format!("SCARLETT_{rest}"))
+}
+
+/// `std::env::var`, also trying the `SCARLETT_` spelling of a `VICTORY_` name.
+pub fn var(name: &str) -> Result<String, VarError> {
+    match std::env::var(name) {
+        Err(VarError::NotPresent) => match alias(name) {
+            Some(a) => std::env::var(a),
+            None => Err(VarError::NotPresent),
+        },
+        other => other,
+    }
+}
+
+/// `std::env::var_os`, also trying the `SCARLETT_` spelling.
+pub fn var_os(name: &str) -> Option<OsString> {
+    std::env::var_os(name).or_else(|| alias(name).and_then(|a| std::env::var_os(a)))
+}
+
+/// The variable's value when it is set (the name `env(name)` of the spec).
+pub fn env(name: &str) -> Option<String> {
+    var(name).ok()
+}
+
+/// At startup, before any thread: every `SCARLETT_*` variable is copied to
+/// its `VICTORY_*` name unless that is set, so code reading `std::env`
+/// directly sees the alias too.
+pub fn alias_scarlett() {
+    let pairs: Vec<(OsString, OsString)> = std::env::vars_os()
+        .filter_map(|(k, v)| {
+            let rest = k.to_str()?.strip_prefix("SCARLETT_")?;
+            let name = OsString::from(format!("VICTORY_{rest}"));
+            std::env::var_os(&name).is_none().then_some((name, v))
+        })
+        .collect();
+    for (k, v) in pairs {
+        // SAFETY: called first thing in `main`, before other threads exist.
+        unsafe { std::env::set_var(k, v) };
+    }
+}
diff --git a/crates/victory-core/src/fastboot.rs b/crates/victory-core/src/fastboot.rs
new file mode 100644
index 0000000..fd7d089
--- /dev/null
+++ b/crates/victory-core/src/fastboot.rs
@@ -0,0 +1,166 @@
+//! `VICTORY_FAST_BOOT=1` (testing only, off by default): press through the
+//! title's logos and menus as fast as possible, then stop for good once the
+//! title is in the world.
+//!
+//! "In the world" is read from the render targets the title binds per
+//! presented frame: menus and loading bind a handful, the world a hundred or
+//! more. [`THRESHOLD`] binds on [`SUSTAIN`] consecutive frames ends the mode;
+//! The fallback is a time limit, `VICTORY_FAST_BOOT_MAX_S` (default [`MAX_SECONDS`]):
+//! a frame count ran out in 45 s of 165 fps menus, before the account
+//! prompt (`VICTORY_FAST_BOOT_MAX_FRAMES` still sets one). After the world
+//! is detected, with `VICTORY_SKIP_CUTSCENES=1`, A is still pressed for
+//! [`SKIP_SECONDS`] so the intro cutscene's prompt skips it.
+//! Only our synthetic keys depend on this by default; the title's clocks
+//! are never touched. Skipping our own frame-pacing sleep (the frame clock's
+//! waits and the present hold) is its own switch,
+//! `VICTORY_FAST_BOOT_UNTHROTTLE=1`: with it every 3060 run hung the card
+//! (TDR, 0x887A0004) 30-50 s in, on the logo/legal screens, so it is off.
+
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+use std::sync::OnceLock;
+use std::time::Instant;
+
+/// Render-target binds in one frame that mark a world frame.
+pub const THRESHOLD: u32 = 100;
+/// Consecutive world frames needed.
+pub const SUSTAIN: u32 = 3;
+/// Fallback: fast boot ends this long after the start at the latest.
+pub const MAX_SECONDS: u64 = 420;
+/// After the world is detected: seconds A is still pressed (cutscene skip).
+pub const SKIP_SECONDS: u64 = 25;
+static WORLD_AT: OnceLock<Instant> = OnceLock::new();
+static MAX_S: OnceLock<u64> = OnceLock::new();
+
+static ENABLED: OnceLock<bool> = OnceLock::new();
+static START: OnceLock<Instant> = OnceLock::new();
+static IN_WORLD: AtomicBool = AtomicBool::new(false);
+static BINDS: AtomicU32 = AtomicU32::new(0);
+static FRAME: AtomicU64 = AtomicU64::new(0);
+static MAX: OnceLock<u64> = OnceLock::new();
+static RUN: AtomicU32 = AtomicU32::new(0);
+
+fn truthy(v: Option<String>) -> bool {
+    v.is_some_and(|v| !matches!(v.trim(), "" | "0" | "false" | "off"))
+}
+
+/// Fast boot was asked for.
+pub fn enabled() -> bool {
+    *ENABLED.get_or_init(|| {
+        let on = truthy(crate::env::env("VICTORY_FAST_BOOT"));
+        if on {
+            START.get_or_init(Instant::now);
+        }
+        on
+    })
+}
+
+/// Fast boot is on and the title is not in the world yet: synthetic input
+/// and the un-throttled frame clock apply.
+pub fn active() -> bool {
+    enabled() && !IN_WORLD.load(Ordering::Relaxed)
+}
+
+/// Fast boot is active and `VICTORY_FAST_BOOT_UNTHROTTLE=1`: our own
+/// pacing sleeps are skipped (off by default: it hung the card at boot).
+pub fn unthrottled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    active() && *ON.get_or_init(|| truthy(crate::env::env("VICTORY_FAST_BOOT_UNTHROTTLE")))
+}
+
+/// The world was detected less than [`SKIP_SECONDS`] ago: A is still
+/// pressed so the intro cutscene's skip prompt takes it.
+pub fn skipping() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| truthy(crate::env::env("VICTORY_SKIP_CUTSCENES")))
+        && WORLD_AT.get().is_some_and(|t| t.elapsed().as_secs() < SKIP_SECONDS)
+}
+
+/// The detector saw the world (or gave up waiting: time or frame limit).
+/// Without fast boot this is always false.
+pub fn in_world() -> bool {
+    IN_WORLD.load(Ordering::Relaxed)
+}
+
+/// Presented frames seen so far (while fast boot is on).
+pub fn frame() -> u64 {
+    FRAME.load(Ordering::Relaxed)
+}
+
+/// A frame bound render targets (called per bind).
+pub fn note_render_targets() {
+    if enabled() {
+        BINDS.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Pure rule: whether a frame with `binds` binds extends the world run to
+/// `SUSTAIN`; returns the new run length.
+pub fn next_run(run: u32, binds: u32) -> u32 {
+    if binds >= THRESHOLD { run + 1 } else { 0 }
+}
+
+/// A frame was presented: updates the detector; returns the log line once,
+/// when fast boot ends.
+pub fn frame_presented() -> Option<String> {
+    if !active() {
+        return None;
+    }
+    let frame = FRAME.fetch_add(1, Ordering::Relaxed) + 1;
+    let binds = BINDS.swap(0, Ordering::Relaxed);
+    let run = next_run(RUN.load(Ordering::Relaxed), binds);
+    RUN.store(run, Ordering::Relaxed);
+    let max = *MAX.get_or_init(|| {
+        crate::env::env("VICTORY_FAST_BOOT_MAX_FRAMES")
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(u64::MAX)
+    });
+    let max_s = *MAX_S.get_or_init(|| {
+        crate::env::env("VICTORY_FAST_BOOT_MAX_S")
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(MAX_SECONDS)
+    });
+    let elapsed = START.get().map_or(0, |s| s.elapsed().as_secs());
+    let why = if run >= SUSTAIN {
+        WORLD_AT.get_or_init(Instant::now);
+        "render targets"
+    } else if frame >= max {
+        "frame limit"
+    } else if elapsed >= max_s {
+        "time limit"
+    } else {
+        return None;
+    };
+    if IN_WORLD.swap(true, Ordering::Relaxed) {
+        return None;
+    }
+    let secs = START.get().map_or(0.0, |s| s.elapsed().as_secs_f64());
+    Some(format!("fast boot: in world after {frame} frames, {secs:.1} s ({why})"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn world_needs_sustained_many_binds() {
+        let mut run = 0;
+        for binds in [3, 8, 5] {
+            run = next_run(run, binds);
+        }
+        assert_eq!(run, 0);
+        run = next_run(run, 200);
+        run = next_run(run, 12); // a loading blip resets it
+        assert_eq!(run, 0);
+        for _ in 0..SUSTAIN {
+            run = next_run(run, 200);
+        }
+        assert!(run >= SUSTAIN);
+    }
+
+    #[test]
+    fn switch_parsing() {
+        assert!(!truthy(None));
+        assert!(!truthy(Some("0".into())));
+        assert!(truthy(Some("1".into())));
+    }
+}
diff --git a/crates/victory-core/src/friendly.rs b/crates/victory-core/src/friendly.rs
new file mode 100644
index 0000000..208664d
--- /dev/null
+++ b/crates/victory-core/src/friendly.rs
@@ -0,0 +1,241 @@
+//! Sharing the PC with the desktop while a title runs.
+//!
+//! Defaults (always on): background pools never take every logical
+//! processor ([`background_cap`]: at most N-2), and the threads that do
+//! background work (decoding, pipeline making, loading) run below normal
+//! ([`background_thread`]) so the title's own threads, our render and
+//! submit threads, and the desktop come first.
+//!
+//! `VICTORY_FRIENDLY=1` goes further, for a PC that is also used for
+//! other things while a title runs:
+//! * the process's default CPU sets leave out the last two logical
+//!   processors (one SMT core pair), so the title's own threads (which
+//!   call Windows directly) cannot take them either; explicit affinity the
+//!   title sets still wins;
+//! * background pools at most half the logical processors;
+//! * a memory line every 30 s: working set, private bytes, the PC's free
+//!   memory and commit left, page faults a second.
+//!
+//! The process priority class is left at Normal on purpose: Above Normal
+//! raises every thread of the process (the title's dozens of workers
+//! too), which is exactly what starves the desktop.
+
+use std::sync::OnceLock;
+
+/// `VICTORY_FRIENDLY=1`.
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_FRIENDLY").is_ok_and(|v| v.trim() == "1"))
+}
+
+/// Logical processors.
+pub fn logical() -> usize {
+    std::thread::available_parallelism().map_or(4, usize::from)
+}
+
+/// The most threads a background pool may have: N-2 (at least 1); with
+/// `VICTORY_FRIENDLY=1`, N/2.
+pub fn background_cap() -> usize {
+    cap_for(logical(), enabled())
+}
+
+fn cap_for(n: usize, friendly: bool) -> usize {
+    if friendly { (n / 2).max(1) } else { n.saturating_sub(2).max(1) }
+}
+
+/// `wanted` held to [`background_cap`].
+pub fn background_threads(wanted: usize) -> usize {
+    wanted.clamp(1, background_cap())
+}
+
+/// The calling thread below normal priority (background work).
+pub fn background_thread() {
+    #[cfg(windows)]
+    // SAFETY: a plain call on our own thread's pseudo handle.
+    unsafe {
+        sys::SetThreadPriority(sys::GetCurrentThread(), -1);
+    }
+}
+
+/// The calling thread below normal only with `VICTORY_FRIENDLY=1` (pools
+/// that sit near the frame path by default).
+pub fn background_thread_if_friendly() {
+    if enabled() {
+        background_thread();
+    }
+}
+
+/// Once at startup: with `VICTORY_FRIENDLY=1`, the CPU sets and the memory
+/// line. Logs what it did either way.
+pub fn start() {
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    ONCE.call_once(|| {
+        let n = logical();
+        if !enabled() {
+            tracing::info!(logical = n, background_cap = background_cap(), "friendly: off (VICTORY_FRIENDLY=1 leaves two logical processors to the desktop)");
+            return;
+        }
+        #[cfg(windows)]
+        {
+            let left_out = sys::leave_out_last(2);
+            tracing::info!(logical = n, background_cap = background_cap(), left_out = ?left_out, "friendly: on: the process's default CPU sets leave out the last logical processors, background pools capped, process priority class left Normal");
+            let _ = std::thread::Builder::new().name("victory-friendly-memory".into()).spawn(|| {
+                sys::background();
+                let mut faults = sys::memory().map_or(0, |m| m.faults);
+                loop {
+                    std::thread::sleep(std::time::Duration::from_secs(30));
+                    if let Some(m) = sys::memory() {
+                        let mb = |b: u64| b >> 20;
+                        tracing::info!(
+                            "friendly memory: working set {} MB, private {} MB; the PC: {} MB of {} MB free, {} MB commit left; {:.0} page faults/s",
+                            mb(m.working), mb(m.private), mb(m.free), mb(m.total), mb(m.commit_left),
+                            m.faults.saturating_sub(faults) as f64 / 30.0
+                        );
+                        faults = m.faults;
+                    }
+                }
+            });
+        }
+    });
+}
+
+#[cfg(windows)]
+mod sys {
+    use std::ffi::c_void;
+
+    #[repr(C)]
+    #[derive(Default)]
+    struct ProcessMemoryCounters {
+        cb: u32,
+        page_fault_count: u32,
+        peak_working_set: usize,
+        working_set: usize,
+        quota_peak_paged: usize,
+        quota_paged: usize,
+        quota_peak_nonpaged: usize,
+        quota_nonpaged: usize,
+        pagefile_usage: usize,
+        peak_pagefile_usage: usize,
+    }
+
+    #[repr(C)]
+    struct MemoryStatusEx {
+        length: u32,
+        load: u32,
+        total_phys: u64,
+        avail_phys: u64,
+        total_page_file: u64,
+        avail_page_file: u64,
+        total_virtual: u64,
+        avail_virtual: u64,
+        avail_extended_virtual: u64,
+    }
+
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        pub(super) fn GetCurrentThread() -> *mut c_void;
+        pub(super) fn SetThreadPriority(thread: *mut c_void, priority: i32) -> i32;
+        fn GetCurrentProcess() -> *mut c_void;
+        fn GetSystemCpuSetInformation(info: *mut u8, len: u32, returned: *mut u32, process: *mut c_void, flags: u32) -> i32;
+        fn SetProcessDefaultCpuSets(process: *mut c_void, ids: *const u32, count: u32) -> i32;
+        fn K32GetProcessMemoryInfo(process: *mut c_void, counters: *mut ProcessMemoryCounters, cb: u32) -> i32;
+        fn GlobalMemoryStatusEx(status: *mut MemoryStatusEx) -> i32;
+    }
+
+    /// Lowest priority and background mode for a watcher thread.
+    pub(super) fn background() {
+        // SAFETY: our own thread.
+        unsafe { SetThreadPriority(GetCurrentThread(), -2) };
+    }
+
+    /// The process's default CPU sets: every set but the `k` with the
+    /// highest logical processor index in group 0. Returns the logical
+    /// processors left out, or None when nothing was changed.
+    pub(super) fn leave_out_last(k: usize) -> Option<Vec<u8>> {
+        let mut len = 0u32;
+        // SAFETY: a size query.
+        unsafe { GetSystemCpuSetInformation(std::ptr::null_mut(), 0, &mut len, GetCurrentProcess(), 0) };
+        if len == 0 {
+            return None;
+        }
+        let mut buf = vec![0u8; len as usize];
+        // SAFETY: a buffer of the size asked for.
+        if unsafe { GetSystemCpuSetInformation(buf.as_mut_ptr(), len, &mut len, GetCurrentProcess(), 0) } == 0 {
+            return None;
+        }
+        // SYSTEM_CPU_SET_INFORMATION: Size u32, Type u32, Id u32, Group u16,
+        // LogicalProcessorIndex u8, ...
+        let mut sets = Vec::new();
+        let mut at = 0usize;
+        while at + 15 <= len as usize {
+            let size = u32::from_le_bytes(buf[at..at + 4].try_into().ok()?) as usize;
+            let kind = u32::from_le_bytes(buf[at + 4..at + 8].try_into().ok()?);
+            if size == 0 {
+                break;
+            }
+            if kind == 0 {
+                let id = u32::from_le_bytes(buf[at + 8..at + 12].try_into().ok()?);
+                let group = u16::from_le_bytes(buf[at + 12..at + 14].try_into().ok()?);
+                sets.push((group, buf[at + 14], id));
+            }
+            at += size;
+        }
+        if sets.len() <= k + 2 {
+            return None;
+        }
+        sets.sort();
+        let (kept, out) = sets.split_at(sets.len() - k);
+        if out.iter().any(|s| s.0 != 0) {
+            return None;
+        }
+        let ids: Vec<u32> = kept.iter().map(|s| s.2).collect();
+        // SAFETY: ids the system gave us.
+        let ok = unsafe { SetProcessDefaultCpuSets(GetCurrentProcess(), ids.as_ptr(), ids.len() as u32) } != 0;
+        ok.then(|| out.iter().map(|s| s.1).collect())
+    }
+
+    pub(super) struct Memory {
+        pub working: u64,
+        pub private: u64,
+        pub faults: u64,
+        pub free: u64,
+        pub total: u64,
+        pub commit_left: u64,
+    }
+
+    pub(super) fn memory() -> Option<Memory> {
+        let mut c = ProcessMemoryCounters { cb: size_of::<ProcessMemoryCounters>() as u32, ..Default::default() };
+        // SAFETY: our own process and a sized structure.
+        if unsafe { K32GetProcessMemoryInfo(GetCurrentProcess(), &mut c, c.cb) } == 0 {
+            return None;
+        }
+        // SAFETY: plain data the call fills in.
+        let mut m: MemoryStatusEx = unsafe { std::mem::zeroed() };
+        m.length = size_of::<MemoryStatusEx>() as u32;
+        // SAFETY: a sized structure.
+        if unsafe { GlobalMemoryStatusEx(&mut m) } == 0 {
+            return None;
+        }
+        Some(Memory {
+            working: c.working_set as u64,
+            private: c.pagefile_usage as u64,
+            faults: u64::from(c.page_fault_count),
+            free: m.avail_phys,
+            total: m.total_phys,
+            commit_left: m.avail_page_file,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::cap_for;
+
+    #[test]
+    fn caps_leave_the_desktop_room() {
+        assert_eq!(cap_for(12, false), 10);
+        assert_eq!(cap_for(12, true), 6);
+        assert_eq!(cap_for(2, false), 1);
+        assert_eq!(cap_for(1, true), 1);
+    }
+}
diff --git a/crates/victory-core/src/gpuown.rs b/crates/victory-core/src/gpuown.rs
new file mode 100644
index 0000000..b867f7c
--- /dev/null
+++ b/crates/victory-core/src/gpuown.rs
@@ -0,0 +1,415 @@
+//! Bookkeeping for `VICTORY_COPY_BACK_ONLY_READBACK=1` (`victory-gpu`): what
+//! shaders wrote into a host copy of title memory and was not copied back.
+//!
+//! With the switch, only the title's read-back buffers get what shaders
+//! wrote copied back into title memory. Everywhere else the host copy holds
+//! the truth and title memory holds the bytes from before: those bytes are
+//! "owned" by the copy. Title memory is still where the runtime looks in
+//! several places, and each of them put the stale bytes back (run R2a: the
+//! world drawn, the picture black):
+//!
+//! - the copy's own refresh copies 64 KiB pages from title memory: a page
+//!   the title wrote anywhere, and every page only partly inside a refreshed
+//!   range, which is never noted as copied and so is copied every time;
+//! - the title's buffer copies (`CopyBufferRegion`) run on the CPU, from
+//!   title memory: a shader's result copied into a read-back buffer, or into
+//!   another buffer shaders read, was copied stale;
+//! - other host copies of the same memory, and textures in it, are filled
+//!   from title memory.
+//!
+//! [`Owned`] keeps, per host copy, the owned byte ranges, each with the
+//! write-watch asking it was declared after (its mark). A refresh leaves
+//! them out; a page the title wrote after the mark gives the owned bytes on
+//! it to the title (the title's bytes win, the page is "demoted": ranges
+//! declared there are copied back from then on); a reader of title memory
+//! gets the owned bytes written there first ("materialized"). [`Spans`]
+//! finds the copies with owned bytes in a range. Platform-neutral, so it is
+//! tested on any host.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+/// The pages (of `page` bytes) `[start, end)` touches: first and one past
+/// the last.
+pub fn pages(start: usize, end: usize, page: usize) -> (usize, usize) {
+    (start / page, end.div_ceil(page))
+}
+
+/// The parts of `[start, end)` that none of `ranges` holds, in order.
+pub fn subtract(start: usize, end: usize, ranges: impl IntoIterator<Item = (usize, usize)>) -> Vec<(usize, usize)> {
+    let mut parts = vec![(start, end)];
+    for (a, e) in ranges {
+        if a >= e {
+            continue;
+        }
+        let mut rest = Vec::with_capacity(parts.len() + 1);
+        for (from, to) in parts {
+            if e <= from || a >= to {
+                rest.push((from, to));
+                continue;
+            }
+            if from < a {
+                rest.push((from, a));
+            }
+            if e < to {
+                rest.push((e, to));
+            }
+        }
+        parts = rest;
+    }
+    parts.retain(|&(a, e)| a < e);
+    parts.sort_unstable();
+    parts
+}
+
+/// Owned byte ranges of title memory of one host copy (see the module).
+#[derive(Debug)]
+pub struct Owned {
+    /// Start → (end, mark); the ranges do not overlap.
+    ranges: BTreeMap<usize, (usize, u64)>,
+    /// Pages where the title wrote over owned bytes.
+    demoted: BTreeSet<usize>,
+    page: usize,
+}
+
+impl Owned {
+    /// Nothing owned; `page` is the write-watch unit (a power of two).
+    pub fn new(page: usize) -> Owned {
+        Owned {
+            ranges: BTreeMap::new(),
+            demoted: BTreeSet::new(),
+            page: page.max(1),
+        }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.ranges.is_empty()
+    }
+
+    /// Owned bytes.
+    pub fn bytes(&self) -> usize {
+        self.ranges.iter().map(|(&a, &(e, _))| e - a).sum()
+    }
+
+    /// The owned ranges (start, end, mark), in order.
+    pub fn ranges(&self) -> Vec<(usize, usize, u64)> {
+        self.ranges.iter().map(|(&a, &(e, m))| (a, e, m)).collect()
+    }
+
+    /// `[start, end)` is owned from now on, declared after asking `mark`
+    /// (a later declaration of bytes owned already takes its mark).
+    pub fn own(&mut self, start: usize, end: usize, mark: u64) {
+        if start >= end {
+            return;
+        }
+        self.release(start, end);
+        self.ranges.insert(start, (end, mark));
+    }
+
+    /// The owned ranges meeting `[start, end)`, cut to it, with their marks.
+    pub fn within(&self, start: usize, end: usize) -> Vec<(usize, usize, u64)> {
+        if start >= end {
+            return Vec::new();
+        }
+        let first = self.ranges.range(..=start).next_back().map_or(start, |(&a, _)| a);
+        self.ranges
+            .range(first..end)
+            .filter(|&(_, &(e, _))| e > start)
+            .map(|(&a, &(e, m))| (a.max(start), e.min(end), m))
+            .collect()
+    }
+
+    /// Whether an owned byte lies in `[start, end)`.
+    pub fn overlaps(&self, start: usize, end: usize) -> bool {
+        !self.within(start, end).is_empty()
+    }
+
+    /// `[start, end)` is owned no more; the bytes that were, in order.
+    pub fn release(&mut self, start: usize, end: usize) -> Vec<(usize, usize)> {
+        let hit = self.within(start, end);
+        for &(a, e, _) in &hit {
+            // The whole range that holds `[a, e)`: cut around it.
+            let Some((&s, &(t, m))) = self.ranges.range(..=a).next_back() else {
+                continue;
+            };
+            self.ranges.remove(&s);
+            if s < a {
+                self.ranges.insert(s, (a, m));
+            }
+            if e < t {
+                self.ranges.insert(e, (t, m));
+            }
+        }
+        hit.into_iter().map(|(a, e, _)| (a, e)).collect()
+    }
+
+    /// The title wrote: `written` holds pages and the asking that last
+    /// found each written (as the write-watch journal gives them), for the
+    /// pages of `[start, end)`. The owned bytes in `[start, end)` on a page
+    /// written after their mark are the title's again: released and
+    /// returned, and their pages demoted.
+    pub fn title_wrote(&mut self, start: usize, end: usize, written: &[(usize, u64)]) -> Vec<(usize, usize)> {
+        let mut out = Vec::new();
+        for &(page, write) in written {
+            let (lo, hi) = ((page * self.page).max(start), ((page + 1) * self.page).min(end));
+            if lo >= hi {
+                continue;
+            }
+            let stale: Vec<(usize, usize)> = self
+                .within(lo, hi)
+                .into_iter()
+                .filter(|&(_, _, mark)| write > mark)
+                .map(|(a, e, _)| (a, e))
+                .collect();
+            if stale.is_empty() {
+                continue;
+            }
+            self.demoted.insert(page);
+            for (a, e) in stale {
+                out.extend(self.release(a, e));
+            }
+        }
+        out
+    }
+
+    /// Owned bytes in `[start, end)` count from asking `mark` on (if later
+    /// than their own): a write of ours there, asked about at `mark`, is
+    /// not the title's.
+    pub fn remark(&mut self, start: usize, end: usize, mark: u64) {
+        for (a, e, m) in self.within(start, end) {
+            if m < mark {
+                self.own(a, e, mark);
+            }
+        }
+    }
+
+    /// Ranges declared on the pages of `[start, end)` are copied back.
+    pub fn demote(&mut self, start: usize, end: usize) {
+        let (first, last) = pages(start, end, self.page);
+        self.demoted.extend(first..last);
+    }
+
+    /// Whether a page of `[start, end)` was demoted.
+    pub fn demoted(&self, start: usize, end: usize) -> bool {
+        if start >= end {
+            return false;
+        }
+        let (first, last) = pages(start, end, self.page);
+        self.demoted.range(first..last).next().is_some()
+    }
+}
+
+/// Spans `[start, end)` of title memory, each named by a key (a host copy's
+/// number) with a value; overlaps allowed, one span per key.
+#[derive(Debug)]
+pub struct Spans<V> {
+    map: BTreeMap<(usize, u64), (usize, V)>,
+    keys: BTreeMap<u64, usize>,
+    /// The longest span ever held: an overlap query looks back that far.
+    longest: usize,
+}
+
+impl<V> Default for Spans<V> {
+    fn default() -> Self {
+        Spans {
+            map: BTreeMap::new(),
+            keys: BTreeMap::new(),
+            longest: 0,
+        }
+    }
+}
+
+impl<V> Spans<V> {
+    pub const fn new() -> Spans<V> {
+        Spans {
+            map: BTreeMap::new(),
+            keys: BTreeMap::new(),
+            longest: 0,
+        }
+    }
+
+    /// Notes `key` over `[start, end)` (once: a key held already stays).
+    pub fn insert(&mut self, start: usize, end: usize, key: u64, value: V) {
+        if start >= end || self.keys.contains_key(&key) {
+            return;
+        }
+        self.keys.insert(key, start);
+        self.map.insert((start, key), (end, value));
+        self.longest = self.longest.max(end - start);
+    }
+
+    pub fn contains(&self, key: u64) -> bool {
+        self.keys.contains_key(&key)
+    }
+
+    pub fn remove(&mut self, key: u64) -> Option<V> {
+        let start = self.keys.remove(&key)?;
+        self.map.remove(&(start, key)).map(|(_, v)| v)
+    }
+
+    pub fn len(&self) -> usize {
+        self.map.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.map.is_empty()
+    }
+
+    /// The keys and values of the spans meeting `[start, end)`.
+    pub fn overlapping(&self, start: usize, end: usize) -> Vec<(u64, &V)> {
+        if start >= end {
+            return Vec::new();
+        }
+        let from = start.saturating_sub(self.longest);
+        self.map
+            .range((from, 0)..(end, 0))
+            .filter(|&(&(a, _), &(e, _))| a < end && start < e)
+            .map(|(&(_, key), (_, v))| (key, v))
+            .collect()
+    }
+
+    /// Every key and value.
+    pub fn all(&self) -> Vec<(u64, &V)> {
+        self.map.iter().map(|(&(_, key), (_, v))| (key, v)).collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const P: usize = 0x10000;
+
+    #[test]
+    fn owning_splits_and_releases() {
+        let mut o = Owned::new(P);
+        o.own(0x1000, 0x3000, 5);
+        o.own(0x8000, 0x9000, 6);
+        assert_eq!(o.bytes(), 0x3000);
+        assert!(o.overlaps(0x2fff, 0x4000));
+        assert!(!o.overlaps(0x3000, 0x8000), "ends are exclusive");
+        assert_eq!(o.release(0x1800, 0x2000), vec![(0x1800, 0x2000)]);
+        assert_eq!(o.ranges(), vec![(0x1000, 0x1800, 5), (0x2000, 0x3000, 5), (0x8000, 0x9000, 6)]);
+        // Across two ranges and a gap.
+        assert_eq!(o.release(0x1400, 0x8800), vec![(0x1400, 0x1800), (0x2000, 0x3000), (0x8000, 0x8800)]);
+        assert_eq!(o.ranges(), vec![(0x1000, 0x1400, 5), (0x8800, 0x9000, 6)]);
+        assert!(o.release(0x5000, 0x6000).is_empty());
+        assert!(o.release(7, 7).is_empty());
+    }
+
+    #[test]
+    fn a_later_declaration_takes_its_mark() {
+        let mut o = Owned::new(P);
+        o.own(0x1000, 0x3000, 5);
+        o.own(0x2000, 0x4000, 9);
+        assert_eq!(o.ranges(), vec![(0x1000, 0x2000, 5), (0x2000, 0x4000, 9)]);
+        assert_eq!(o.within(0x1800, 0x2800), vec![(0x1800, 0x2000, 5), (0x2000, 0x2800, 9)]);
+        o.own(0, 0x10000, 10);
+        assert_eq!(o.ranges(), vec![(0, 0x10000, 10)]);
+        o.own(5, 5, 11);
+        assert_eq!(o.ranges().len(), 1, "empty ranges are not owned");
+    }
+
+    /// The case that blacked the picture: a small range shaders write
+    /// (exposure, a few words) inside a 64 KiB page the refresh never takes
+    /// whole. The refresh must leave the owned bytes alone, every time,
+    /// until the title writes the page.
+    #[test]
+    fn a_refresh_leaves_owned_bytes_until_the_title_writes_their_page() {
+        let mut o = Owned::new(P);
+        let (a, e) = (0x2_1010, 0x2_1020);
+        o.own(a, e, 7);
+        // Refreshing the view [0x2_1000, 0x2_2000): what is copied.
+        let refreshed = |o: &Owned| subtract(0x2_1000, 0x2_2000, o.within(0x2_1000, 0x2_2000).into_iter().map(|(a, e, _)| (a, e)));
+        assert_eq!(refreshed(&o), vec![(0x2_1000, a), (e, 0x2_2000)]);
+        // The journal found the page written at asking 7 (before the
+        // declaration's refresh, or at it): not over the owned bytes.
+        assert!(o.title_wrote(0x2_1000, 0x2_2000, &[(2, 7)]).is_empty());
+        assert_eq!(refreshed(&o), vec![(0x2_1000, a), (e, 0x2_2000)]);
+        assert!(!o.demoted(a, e));
+        // Another page written later: nothing here.
+        assert!(o.title_wrote(0x2_1000, 0x2_2000, &[(3, 9)]).is_empty());
+        // The title writes the page after the declaration: its bytes win,
+        // and ranges there go back from now on.
+        assert_eq!(o.title_wrote(0x2_1000, 0x2_2000, &[(2, 8)]), vec![(a, e)]);
+        assert_eq!(refreshed(&o), vec![(0x2_1000, 0x2_2000)]);
+        assert!(o.demoted(a, e));
+        assert!(o.demoted(0x2_0000, 0x2_0001), "the whole page");
+        assert!(!o.demoted(0x3_0000, 0x3_1000));
+    }
+
+    #[test]
+    fn a_title_write_takes_only_its_pages() {
+        let mut o = Owned::new(P);
+        // Owned across three pages, declared after asking 4.
+        o.own(0x1_8000, 0x3_8000, 4);
+        let back = o.title_wrote(0x1_0000, 0x4_0000, &[(1, 3), (2, 5)]);
+        assert_eq!(back, vec![(0x2_0000, 0x3_0000)], "page 1's write came before");
+        assert_eq!(o.ranges(), vec![(0x1_8000, 0x2_0000, 4), (0x3_0000, 0x3_8000, 4)]);
+        // Asked over part of page 3 only: only that part is given back.
+        assert_eq!(o.title_wrote(0x3_0000, 0x3_4000, &[(3, 6)]), vec![(0x3_0000, 0x3_4000)]);
+        assert_eq!(o.ranges(), vec![(0x1_8000, 0x2_0000, 4), (0x3_4000, 0x3_8000, 4)]);
+    }
+
+    #[test]
+    fn a_redeclared_range_is_not_given_back_for_an_older_write() {
+        let mut o = Owned::new(P);
+        o.own(0x1000, 0x2000, 4);
+        // Declared again after asking 9 (the refresh before it saw the
+        // page written at 6 and found nothing owned to give back then).
+        o.own(0x1000, 0x2000, 9);
+        assert!(o.title_wrote(0, P, &[(0, 6)]).is_empty());
+        assert_eq!(o.title_wrote(0, P, &[(0, 10)]), vec![(0x1000, 0x2000)]);
+    }
+
+    /// Our own write into title memory (owned bytes put there for a reader)
+    /// shows as a title write of the page at the next asking. Asked right
+    /// after it, the bytes still owned on the page count from that asking,
+    /// so it is not taken for the title's; a later title write still is.
+    #[test]
+    fn a_write_of_ours_is_not_the_titles() {
+        let mut o = Owned::new(P);
+        o.own(0x1000, 0x2000, 3);
+        o.own(0x8000, 0x1_8000, 3);
+        // Our write on page 0 was asked about at 6.
+        o.remark(0, P, 6);
+        assert_eq!(o.ranges(), vec![(0x1000, 0x2000, 6), (0x8000, 0x1_0000, 6), (0x1_0000, 0x1_8000, 3)]);
+        assert!(o.title_wrote(0, 2 * P, &[(0, 6)]).is_empty(), "our own write");
+        assert_eq!(o.title_wrote(0, 2 * P, &[(1, 6)]), vec![(0x1_0000, 0x1_8000)], "page 1 was not remarked");
+        assert_eq!(o.title_wrote(0, 2 * P, &[(0, 7)]), vec![(0x1000, 0x2000), (0x8000, 0x1_0000)]);
+        // Never moves a mark back.
+        let mut o = Owned::new(P);
+        o.own(0x1000, 0x2000, 9);
+        o.remark(0, P, 4);
+        assert_eq!(o.ranges(), vec![(0x1000, 0x2000, 9)]);
+    }
+
+    #[test]
+    fn subtract_cuts_pieces_around_ranges() {
+        assert_eq!(subtract(0, 100, []), vec![(0, 100)]);
+        assert_eq!(subtract(0, 100, [(10, 20), (50, 60)]), vec![(0, 10), (20, 50), (60, 100)]);
+        assert_eq!(subtract(0, 100, [(50, 60), (10, 20)]), vec![(0, 10), (20, 50), (60, 100)], "any order");
+        assert_eq!(subtract(0, 100, [(0, 100)]), Vec::<(usize, usize)>::new());
+        assert_eq!(subtract(10, 20, [(0, 15), (18, 30)]), vec![(15, 18)]);
+        assert_eq!(subtract(10, 20, [(20, 30), (0, 10), (5, 5)]), vec![(10, 20)], "touching is not holding");
+    }
+
+    #[test]
+    fn spans_find_overlaps_and_let_go() {
+        let mut s: Spans<&str> = Spans::new();
+        s.insert(0x1000, 0x2000, 1, "small");
+        s.insert(0x10_0000, 0x50_0000, 2, "big");
+        s.insert(0x1800, 0x1900, 3, "inside");
+        s.insert(0, 0x10, 1, "again");
+        assert_eq!(s.len(), 3, "one span per key");
+        let keys = |v: Vec<(u64, &&str)>| v.into_iter().map(|(k, _)| k).collect::<Vec<_>>();
+        assert_eq!(keys(s.overlapping(0x1850, 0x1851)), vec![1, 3]);
+        assert_eq!(keys(s.overlapping(0x20_0000, 0x20_0001)), vec![2], "far inside a long span");
+        assert!(s.overlapping(0x2000, 0x10_0000).is_empty());
+        assert!(s.overlapping(5, 5).is_empty());
+        assert_eq!(s.remove(1), Some("small"));
+        assert_eq!(s.remove(1), None);
+        assert!(!s.contains(1));
+        assert_eq!(keys(s.overlapping(0, u64::MAX as usize)), vec![3, 2]);
+        assert_eq!(s.all().len(), 2);
+    }
+}
diff --git a/crates/victory-core/src/hints.rs b/crates/victory-core/src/hints.rs
new file mode 100644
index 0000000..0328a5e
--- /dev/null
+++ b/crates/victory-core/src/hints.rs
@@ -0,0 +1,258 @@
+//! Keyboard hints for the title's button prompts.
+//!
+//! The title draws Xbox button icons from its own UI data and has no query
+//! for the kind of device in use (MENUS.md section 4.2: the icon builder at
+//! 0x2A52D80 formats a constant `platform_xbsx...Main_Button_%d` class name;
+//! no path reads a last-input device), so the icons cannot be switched from
+//! here. This module makes the hint layer the overlay draws instead: a small
+//! legend in a corner that says which key does what the icons show, built from
+//! the keymap in force (so rebinding is reflected).
+//!
+//! The runtime does not know which buttons the current screen asks for (that
+//! needs a hook on the icon builder), so the legend lists the buttons menus
+//! use. When it shows:
+//!
+//! * `VICTORY_KBM_HINTS=auto` (default): for a few seconds when the keyboard
+//!   or mouse is used after a quiet spell (and at first use);
+//! * `always`: until F2 hides it; `off`: never.
+//!
+//! F2 pins the legend on or takes it off in `auto` and `always`.
+
+use crate::kbm::{Output, Settings, WHEEL_DOWN, WHEEL_UP, key_name};
+
+/// The key that pins the legend on screen or removes it: F2.
+pub const TOGGLE_KEY: u8 = 0x71;
+
+/// How long the legend shows after the keyboard is picked up.
+pub const SHOW_MS: u64 = 8_000;
+/// How long the keyboard must have been unused for its next use to show it.
+pub const IDLE_MS: u64 = 20_000;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum Mode {
+    Off,
+    #[default]
+    Auto,
+    Always,
+}
+
+impl Mode {
+    /// `VICTORY_KBM_HINTS` (`0`/`off`, `auto`, `1`/`always`/`on`).
+    pub fn parse(text: &str) -> Option<Mode> {
+        match text.trim().to_ascii_lowercase().as_str() {
+            "0" | "off" | "no" | "false" => Some(Mode::Off),
+            "" | "auto" => Some(Mode::Auto),
+            "1" | "on" | "always" | "yes" | "true" => Some(Mode::Always),
+            _ => None,
+        }
+    }
+
+    /// The mode from the environment and `[game] kbm_hints` (a string or
+    /// bool); what cannot be read is returned in the second place.
+    pub fn from_sources(
+        file: Option<&toml::Table>,
+        get: &dyn Fn(&str) -> Option<String>,
+    ) -> (Mode, Vec<String>) {
+        let mut mode = Mode::Auto;
+        let mut problems = Vec::new();
+        if let Some(v) = file.and_then(|t| t.get("kbm_hints")) {
+            let text = match v {
+                toml::Value::String(s) => s.clone(),
+                toml::Value::Boolean(b) => b.to_string(),
+                _ => String::new(),
+            };
+            match Mode::parse(&text) {
+                Some(m) if !text.is_empty() => mode = m,
+                _ => problems.push(format!("[game] kbm_hints = {v}: expected off, auto or always")),
+            }
+        }
+        if let Some(v) = get("VICTORY_KBM_HINTS") {
+            match Mode::parse(&v) {
+                Some(m) => mode = m,
+                None => problems.push(format!("VICTORY_KBM_HINTS={v}: expected off, auto or always")),
+            }
+        }
+        (mode, problems)
+    }
+}
+
+/// One line of the legend: the pad button the icons show, and the keys.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Hint {
+    pub button: &'static str,
+    pub keys: String,
+}
+
+/// The buttons the legend lists, by their name in key map files.
+const BUTTONS: [&str; 8] = ["A", "B", "X", "Y", "LB", "RB", "View", "Menu"];
+const DPAD: [&str; 4] = ["DpadUp", "DpadDown", "DpadLeft", "DpadRight"];
+
+/// Keys in the order to show them: the wheel, which is no key, last.
+fn shown_order(vks: &[u8]) -> Vec<u8> {
+    let mut v = vks.to_vec();
+    v.sort_by_key(|&k| k == WHEEL_UP || k == WHEEL_DOWN);
+    v
+}
+
+fn keys_text(vks: &[u8]) -> String {
+    shown_order(vks).iter().take(2).map(|&k| key_name(k)).collect::<Vec<_>>().join("/")
+}
+
+/// The legend for the on-foot layout of `s` (menus read the same keys in
+/// either layout): a hint for each button that has a key. The direction pad
+/// comes last, as its keys in up, down, left, right order.
+pub fn legend(s: &Settings) -> Vec<Hint> {
+    let by_name = |name: &str| Output::all().find(|o| o.name() == name);
+    let mut out = Vec::new();
+    for name in BUTTONS {
+        let Some(o) = by_name(name) else { continue };
+        let keys = s.on_foot.keys_of(o);
+        if !keys.is_empty() {
+            out.push(Hint {
+                button: name,
+                keys: keys_text(&keys),
+            });
+        }
+    }
+    let dpad: Vec<String> = DPAD
+        .iter()
+        .filter_map(|n| by_name(n))
+        .filter_map(|o| shown_order(&s.on_foot.keys_of(o)).first().map(|&k| key_name(k)))
+        .collect();
+    if dpad.len() == 4 {
+        out.push(Hint {
+            button: "Dpad",
+            keys: dpad.join(" "),
+        });
+    }
+    out
+}
+
+fn is_activity(vk: u8) -> bool {
+    // Mouse buttons (1, 2, 4, 5, 6) and the keys, but not the function keys
+    // (F1 is the overlay's and F2 this layer's) or the lock and modifier
+    // keys that are held by habit.
+    !matches!(vk, 0x70..=0x87 | 0x14 | 0x90 | 0x91)
+}
+
+/// When the legend shows, from the keys held each present.
+#[derive(Debug)]
+pub struct Tracker {
+    mode: Mode,
+    pinned: bool,
+    shown_until: u64,
+    last_activity: Option<u64>,
+    prev: Vec<u8>,
+}
+
+impl Tracker {
+    pub fn new(mode: Mode) -> Tracker {
+        Tracker {
+            mode,
+            pinned: mode == Mode::Always,
+            shown_until: 0,
+            last_activity: None,
+            prev: Vec::new(),
+        }
+    }
+
+    pub fn mode(&self) -> Mode {
+        self.mode
+    }
+
+    /// One present: `down` is every key and mouse button held now, `now_ms`
+    /// a steady clock. Returns whether to draw the legend.
+    pub fn update(&mut self, now_ms: u64, down: &[u8]) -> bool {
+        let pressed: Vec<u8> = down.iter().copied().filter(|k| !self.prev.contains(k)).collect();
+        self.prev = down.to_vec();
+        if self.mode == Mode::Off {
+            return false;
+        }
+        if pressed.contains(&TOGGLE_KEY) {
+            self.pinned = !self.pinned;
+        }
+        if down.iter().any(|&k| is_activity(k)) {
+            let quiet = self.last_activity.is_none_or(|t| now_ms.saturating_sub(t) >= IDLE_MS);
+            if quiet {
+                self.shown_until = now_ms + SHOW_MS;
+            }
+            self.last_activity = Some(now_ms);
+        }
+        self.pinned || (self.mode == Mode::Auto && now_ms < self.shown_until)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_legend_follows_the_keymap() {
+        let s = Settings::default();
+        let l = legend(&s);
+        let a = l.iter().find(|h| h.button == "A").expect("A has a key");
+        assert!(a.keys.contains(&key_name(0x0D)), "Enter does A: {}", a.keys);
+        let b = l.iter().find(|h| h.button == "B").unwrap();
+        assert!(!b.keys.is_empty());
+        assert_eq!(l.last().unwrap().button, "Dpad");
+        assert_eq!(l.last().unwrap().keys, "Up Down Left Right");
+        // Rebinding is reflected; an unbound button is left out.
+        let mut s = Settings::default();
+        let problems = s.apply_keymap("Enter=\nB=A\n");
+        assert!(problems.is_empty(), "{problems:?}");
+        let l = legend(&s);
+        assert!(l.iter().find(|h| h.button == "A").unwrap().keys.contains('B'));
+    }
+
+    #[test]
+    fn modes_parse() {
+        assert_eq!(Mode::parse("auto"), Some(Mode::Auto));
+        assert_eq!(Mode::parse("0"), Some(Mode::Off));
+        assert_eq!(Mode::parse("ALWAYS"), Some(Mode::Always));
+        assert_eq!(Mode::parse("sometimes"), None);
+        let none = |_: &str| None;
+        assert_eq!(Mode::from_sources(None, &none).0, Mode::Auto);
+        let file: toml::Table = toml::from_str("kbm_hints = \"always\"").unwrap();
+        assert_eq!(Mode::from_sources(Some(&file), &none).0, Mode::Always);
+        let env = |n: &str| (n == "VICTORY_KBM_HINTS").then(|| "off".to_string());
+        assert_eq!(Mode::from_sources(Some(&file), &env).0, Mode::Off);
+        let bad: toml::Table = toml::from_str("kbm_hints = 3").unwrap();
+        assert_eq!(Mode::from_sources(Some(&bad), &none).1.len(), 1);
+    }
+
+    #[test]
+    fn auto_shows_on_first_use_then_after_a_quiet_spell() {
+        let mut t = Tracker::new(Mode::Auto);
+        assert!(!t.update(0, &[]));
+        assert!(t.update(100, &[b'W']));
+        assert!(t.update(100 + SHOW_MS - 1, &[]));
+        assert!(!t.update(100 + SHOW_MS, &[]));
+        // Playing on does not bring it back...
+        assert!(!t.update(10_000, &[b'W']));
+        assert!(!t.update(25_000, &[b'W']));
+        // ...a quiet spell does.
+        assert!(!t.update(25_000 + IDLE_MS - 1, &[]));
+        assert!(t.update(60_000, &[0x01]));
+    }
+
+    #[test]
+    fn function_keys_are_not_use_and_f2_pins() {
+        let mut t = Tracker::new(Mode::Auto);
+        assert!(!t.update(0, &[0x70]));
+        assert!(t.update(10, &[TOGGLE_KEY]), "F2 pins it");
+        assert!(t.update(10_000_000, &[]), "pinned stays");
+        assert!(!t.update(10_000_001, &[TOGGLE_KEY]), "F2 again takes it off");
+        // Held F2 does not toggle again.
+        assert!(!t.update(10_000_002, &[TOGGLE_KEY]));
+    }
+
+    #[test]
+    fn always_starts_on_and_off_never_shows() {
+        let mut t = Tracker::new(Mode::Always);
+        assert!(t.update(0, &[]));
+        assert!(!t.update(1, &[TOGGLE_KEY]));
+        let mut t = Tracker::new(Mode::Off);
+        assert!(!t.update(0, &[b'W']));
+        assert!(!t.update(1, &[TOGGLE_KEY]));
+    }
+}
