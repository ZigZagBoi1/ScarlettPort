+        for _ in 0..100_000 {
+            let mut x = rng.next();
+            for b in 0..8 {
+                if rng.below(3) == 0 {
+                    x &= !(0xff << (b * 8));
+                }
+                if rng.below(5) == 0 {
+                    x |= 0x80 << (b * 8);
+                    x &= !(0x7f << (b * 8));
+                }
+            }
+            let want = (0..8).fold(0u64, |m, b| if (x >> (b * 8)) & 0xff == 0 { m | 0x80 << (b * 8) } else { m });
+            assert_eq!(zero_bytes(x), want, "{x:#x}");
+        }
+    }
