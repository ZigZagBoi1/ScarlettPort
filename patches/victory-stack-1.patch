+        let mut state = State::default();
+        state.set_heaps(&[heap_obj]);
+        // Entry 1 of the table: one descriptor past its start.
+        let used = [UsedResource {
+            kind: ResourceType::Srv,
+            root: RootType::Table,
+            table_offset_dwords: 8,
+            lower_bound: 0,
+            stride: 0,
+            dwords: 8,
+            user_data: 0,
+            slot: 0,
