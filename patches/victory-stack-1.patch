@@ -0,0 +1,305 @@
+//! Vibration settings and the mapping from what the title asks for to what
+//! a pad gets.
+//!
+//! The title calls `IGameInputDevice::SetRumbleState` with four levels
+//! (`GameInputRumbleParams`): low frequency, high frequency, left trigger,
+//! right trigger. XInput's left motor is the big low-frequency one and its
+//! right motor the small high-frequency one, so low goes left and high goes
+//! right. The trigger motors of Xbox One and Series pads exist only through
+//! Windows.Gaming.Input (`Gamepad.Vibration`).
+//!
+//! Switches (the environment wins over `[game]` of the config file):
+//!
+//! * `VICTORY_RUMBLE=0` turns vibration off (`rumble = false`);
+//! * `VICTORY_RUMBLE_STRENGTH=<0 to 2>` scales every level, 1.0 as the title
+//!   asks (`rumble_strength`); levels are clamped to the motors' range after
+//!   scaling, so above 1.0 weak rumble is boosted and strong rumble stays
+//!   at full.
+
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+
+/// Strength limit.
+pub const MAX_STRENGTH: f32 = 2.0;
+
+/// The vibration switches.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Settings {
+    pub enabled: bool,
+    pub strength: f32,
+}
+
+impl Default for Settings {
+    fn default() -> Settings {
+        Settings {
+            enabled: true,
+            strength: 1.0,
+        }
+    }
+}
+
+fn flag(v: &str) -> Option<bool> {
+    match v.trim().to_ascii_lowercase().as_str() {
+        "1" | "true" | "on" | "yes" => Some(true),
+        "0" | "false" | "off" | "no" => Some(false),
+        _ => None,
+    }
+}
+
+impl Settings {
+    /// `[game]` of the config file (`rumble`, `rumble_strength`), then the
+    /// environment over it. Returns what could not be used.
+    pub fn from_sources(
+        file: Option<&toml::Table>,
+        get: &dyn Fn(&str) -> Option<String>,
+    ) -> (Settings, Vec<String>) {
+        let mut s = Settings::default();
+        let mut problems = Vec::new();
+        if let Some(t) = file {
+            match t.get("rumble") {
+                Some(toml::Value::Boolean(b)) => s.enabled = *b,
+                Some(_) => problems.push("[game] rumble: expected true or false".into()),
+                None => {}
+            }
+            if let Some(v) = t.get("rumble_strength") {
+                let n = match v {
+                    toml::Value::Float(f) => Some(*f as f32),
+                    toml::Value::Integer(i) => Some(*i as f32),
+                    _ => None,
+                };
+                match n {
+                    Some(n) if (0.0..=MAX_STRENGTH).contains(&n) => s.strength = n,
+                    _ => problems.push(format!(
+                        "[game] rumble_strength = {v}: expected 0 to {MAX_STRENGTH}"
+                    )),
+                }
+            }
+        }
+        if let Some(v) = get("VICTORY_RUMBLE") {
+            match flag(&v) {
+                Some(on) => s.enabled = on,
+                None => problems.push(format!("VICTORY_RUMBLE={v}: expected 0 or 1")),
+            }
+        }
+        if let Some(v) = get("VICTORY_RUMBLE_STRENGTH") {
+            match v.trim().parse::<f32>() {
+                Ok(n) if (0.0..=MAX_STRENGTH).contains(&n) => s.strength = n,
+                _ => problems.push(format!(
+                    "VICTORY_RUMBLE_STRENGTH={v}: expected 0 to {MAX_STRENGTH}"
+                )),
+            }
+        }
+        (s, problems)
+    }
+}
+
+/// What a pad's motors are set to: the two main motors as XInput takes them
+/// and the trigger motors as levels from 0 to 1.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Motors {
+    /// XInput `wLeftMotorSpeed` (the low-frequency motor).
+    pub left: u16,
+    /// XInput `wRightMotorSpeed` (the high-frequency motor).
+    pub right: u16,
+    pub left_trigger: f32,
+    pub right_trigger: f32,
+}
+
+impl Motors {
+    pub fn is_off(&self) -> bool {
+        self.left == 0 && self.right == 0 && !self.has_triggers()
+    }
+
+    /// Whether a trigger motor is in use (only then does the pad need the
+    /// path that has them).
+    pub fn has_triggers(&self) -> bool {
+        self.left_trigger > 0.0 || self.right_trigger > 0.0
+    }
+}
+
+fn level(v: f32, strength: f32) -> f32 {
+    if v.is_nan() {
+        return 0.0;
+    }
+    (v.clamp(0.0, 1.0) * strength).clamp(0.0, 1.0)
+}
+
+/// The motors for the title's `params` (low, high, left trigger, right
+/// trigger) under `s`.
+pub fn plan(params: [f32; 4], s: &Settings) -> Motors {
+    if !s.enabled {
+        return Motors::default();
+    }
+    let st = if s.strength.is_nan() {
+        0.0
+    } else {
+        s.strength.clamp(0.0, MAX_STRENGTH)
+    };
+    let speed = |v: f32| (level(v, st) * f32::from(u16::MAX)).round() as u16;
+    Motors {
+        left: speed(params[0]),
+        right: speed(params[1]),
+        left_trigger: level(params[2], st),
+        right_trigger: level(params[3], st),
+    }
+}
+
+/// Which host API drives a pad.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Route {
+    /// `XInputSetState`: the two main motors.
+    XInput,
+    /// `Windows.Gaming.Input` `Gamepad.Vibration`: all four motors.
+    Gaming,
+}
+
+/// The API for `m`. The gaming API is used while a trigger motor is in use,
+/// and once more after it (`was_gaming`) to set the triggers back to rest
+/// and hand the main motors back to XInput; with no gaming pad to talk to
+/// (`gaming_pad`) it is XInput, whose main motors still work.
+pub fn route(m: &Motors, gaming_pad: bool, was_gaming: bool) -> Route {
+    if gaming_pad && (m.has_triggers() || was_gaming) {
+        Route::Gaming
+    } else {
+        Route::XInput
+    }
+}
+
+static LIVE_ON: AtomicBool = AtomicBool::new(true);
+static LIVE_STRENGTH: AtomicU32 = AtomicU32::new(0x3f80_0000); // 1.0
+
+/// Takes the settings at start (call once, before the title runs). Returns
+/// what could not be used.
+pub fn configure(file: Option<&toml::Table>) -> Vec<String> {
+    let (s, problems) = Settings::from_sources(file, &|n| std::env::var(n).ok());
+    set_live(s);
+    problems
+}
+
+/// The settings in force (the overlay can change them).
+pub fn current() -> Settings {
+    Settings {
+        enabled: LIVE_ON.load(Ordering::Relaxed),
+        strength: f32::from_bits(LIVE_STRENGTH.load(Ordering::Relaxed)),
+    }
+}
+
+/// Makes `s` the settings in force, now.
+pub fn set_live(s: Settings) {
+    LIVE_ON.store(s.enabled, Ordering::Relaxed);
+    LIVE_STRENGTH.store(
+        s.strength.clamp(0.0, MAX_STRENGTH).to_bits(),
+        Ordering::Relaxed,
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn get<'a>(pairs: &'a [(&'a str, &'a str)]) -> impl Fn(&str) -> Option<String> + 'a {
+        move |k| pairs.iter().find(|p| p.0 == k).map(|p| p.1.to_string())
+    }
+
+    #[test]
+    fn low_goes_to_the_left_motor_and_high_to_the_right() {
+        let m = plan([0.5, 1.0, 0.25, 0.75], &Settings::default());
+        assert_eq!((m.left, m.right), (32768, 65535));
+        assert_eq!((m.left_trigger, m.right_trigger), (0.25, 0.75));
+        let m = plan([1.0, 0.0, 0.0, 0.0], &Settings::default());
+        assert_eq!((m.left, m.right), (65535, 0));
+    }
+
+    #[test]
+    fn off_and_nonsense_levels_are_silent() {
+        let off = Settings {
+            enabled: false,
+            strength: 1.0,
+        };
+        assert!(plan([1.0; 4], &off).is_off());
+        let m = plan([f32::NAN, -3.0, f32::INFINITY, 7.0], &Settings::default());
+        assert_eq!(
+            (m.left, m.right, m.left_trigger, m.right_trigger),
+            (0, 0, 1.0, 1.0)
+        );
+        let zero = Settings {
+            enabled: true,
+            strength: 0.0,
+        };
+        assert!(plan([1.0; 4], &zero).is_off());
+    }
+
+    #[test]
+    fn strength_scales_and_clamps() {
+        let half = Settings {
+            enabled: true,
+            strength: 0.5,
+        };
+        let m = plan([1.0, 0.5, 1.0, 0.5], &half);
+        assert_eq!((m.left, m.right), (32768, 16384));
+        assert_eq!((m.left_trigger, m.right_trigger), (0.5, 0.25));
+        let more = Settings {
+            enabled: true,
+            strength: 2.0,
+        };
+        let m = plan([0.25, 0.75, 0.25, 0.75], &more);
+        assert_eq!((m.left, m.right), (32768, 65535));
+        assert_eq!((m.left_trigger, m.right_trigger), (0.5, 1.0));
+        let wild = Settings {
+            enabled: true,
+            strength: 99.0,
+        };
+        assert_eq!(plan([0.25; 4], &wild).left, 32768);
+    }
+
+    #[test]
+    fn the_gaming_api_is_used_for_triggers_and_to_release_them() {
+        let on = plan([0.5, 0.5, 0.0, 1.0], &Settings::default());
+        let main_only = plan([0.5, 0.5, 0.0, 0.0], &Settings::default());
+        assert_eq!(route(&on, true, false), Route::Gaming);
+        assert_eq!(route(&main_only, true, false), Route::XInput);
+        assert_eq!(route(&main_only, true, true), Route::Gaming, "the release");
+        assert_eq!(route(&on, false, false), Route::XInput, "no gaming pad");
+        assert_eq!(route(&main_only, false, true), Route::XInput);
+    }
+
+    #[test]
+    fn triggers_are_noted_only_when_used() {
+        assert!(!plan([1.0, 1.0, 0.0, 0.0], &Settings::default()).has_triggers());
+        assert!(plan([0.0, 0.0, 0.0, 0.1], &Settings::default()).has_triggers());
+    }
+
+    #[test]
+    fn the_environment_wins_over_the_file_and_bad_values_are_named() {
+        let file: toml::Table = toml::from_str("rumble = false\nrumble_strength = 0.5").unwrap();
+        let (s, p) = Settings::from_sources(Some(&file), &get(&[]));
+        assert_eq!(
+            s,
+            Settings {
+                enabled: false,
+                strength: 0.5
+            }
+        );
+        assert!(p.is_empty());
+        let (s, _) = Settings::from_sources(
+            Some(&file),
+            &get(&[("VICTORY_RUMBLE", "1"), ("VICTORY_RUMBLE_STRENGTH", "1.5")]),
+        );
+        assert_eq!(
+            s,
+            Settings {
+                enabled: true,
+                strength: 1.5
+            }
+        );
+        let (s, p) = Settings::from_sources(
+            None,
+            &get(&[("VICTORY_RUMBLE", "maybe"), ("VICTORY_RUMBLE_STRENGTH", "9")]),
+        );
+        assert_eq!(s, Settings::default());
+        assert_eq!(p.len(), 2);
+        let bad: toml::Table = toml::from_str("rumble = 1\nrumble_strength = \"x\"").unwrap();
+        assert_eq!(Settings::from_sources(Some(&bad), &get(&[])).1.len(), 2);
+        let (s, _) = Settings::from_sources(None, &get(&[("VICTORY_RUMBLE", "0")]));
+        assert!(!s.enabled);
+    }
+}
diff --git a/crates/victory-core/src/savecheck.rs b/crates/victory-core/src/savecheck.rs
new file mode 100644
index 0000000..b8017a8
--- /dev/null
+++ b/crates/victory-core/src/savecheck.rs
@@ -0,0 +1,235 @@
+//! Offline check of a provider's game-save folder (the layout written by
+//! `victory-hle`'s XGameSave module): each container's newest version must
+//! have a manifest, every blob it names, and, for the title's `ASAV` saves,
+//! a header blob that agrees with its data blob (size, timestamp, packed
+//! sizes). Leftovers a kill or a scanner left (`v<N>.new`, empty `v<N>`)
+//! are reported. Nothing is changed except by [`set_aside`], which renames
+//! a container away (undo: rename it back).
+
+use std::path::{Path, PathBuf};
+
+/// One problem found.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Finding {
+    pub path: PathBuf,
+    pub what: String,
+    /// The container cannot be read as saved (not just untidy).
+    pub fatal: bool,
+}
+
+fn u32_at(b: &[u8], at: usize) -> Option<u32> {
+    Some(u32::from_le_bytes(b.get(at..at + 4)?.try_into().ok()?))
+}
+
+fn u64_at(b: &[u8], at: usize) -> Option<u64> {
+    Some(u64::from_le_bytes(b.get(at..at + 8)?.try_into().ok()?))
+}
+
+fn parse_manifest(bytes: &[u8]) -> Option<Vec<String>> {
+    let mut out = Vec::new();
+    let mut rest = bytes;
+    while !rest.is_empty() {
+        let len = u32_at(rest, 0)? as usize;
+        out.push(String::from_utf8(rest.get(4..4 + len)?.to_vec()).ok()?);
+        rest = &rest[4 + len..];
+    }
+    (out.len() >= 2).then_some(out)
+}
+
+/// Checks an `ASAV` data blob against its `Save Game Header` blob.
+/// Layout (observed): data `ASAV`, u32 2, .., u32 packed size at 0x18
+/// (bytes after 0x28, 0 when unpacked), u32 unpacked size at 0x1c, u64
+/// unix time at 0x20, u32 size at 0x168; header u32 6, u32 data size,
+/// u64 checksum, u64 the same time, then 0x18 and 0x1c of the data.
+pub fn check_asav(data: &[u8], header: &[u8]) -> Vec<String> {
+    let mut bad = Vec::new();
+    if data.get(..4) != Some(b"ASAV") {
+        return bad; // not this title's format: nothing to say
+    }
+    let len = data.len() as u64;
+    if header.len() < 0x24 {
+        bad.push(format!("header blob is {} bytes", header.len()));
+        return bad;
+    }
+    if u32_at(header, 4).map(u64::from) != Some(len) {
+        bad.push(format!("header says {:?} bytes, data has {len}", u32_at(header, 4)));
+    }
+    if u64_at(header, 0x10) != u64_at(data, 0x20) {
+        bad.push("header and data times differ (from different saves)".into());
+    }
+    if header.get(0x1c..0x24) != data.get(0x18..0x20) {
+        bad.push("header and data packed sizes differ".into());
+    }
+    if let Some(size) = u32_at(data, 0x168).filter(|&s| s != 0 && u64::from(s) != len) {
+        bad.push(format!("data says {size} bytes at 0x168, has {len}"));
+    }
+    if let Some(packed) = u32_at(data, 0x18).filter(|&p| p != 0) {
+        if u64::from(packed) + 0x28 != len {
+            bad.push(format!("packed size {packed} + 0x28 != {len} (cut short?)"));
+        }
+    }
+    bad
+}
+
+/// Checks one container folder (`<name>~<hash>`).
+pub fn check_container(dir: &Path) -> Vec<Finding> {
+    let mut out = Vec::new();
+    let mut note = |path: PathBuf, what: String, fatal| out.push(Finding { path, what, fatal });
+    let mut versions = Vec::new();
+    for entry in std::fs::read_dir(dir).into_iter().flatten().flatten() {
+        let file = entry.file_name().to_string_lossy().into_owned();
+        if file.ends_with(".new") || file.ends_with(".bad") {
+            note(entry.path(), "leftover version folder".into(), false);
+        } else if let Some(n) = file.strip_prefix('v').and_then(|n| n.parse::<u64>().ok()) {
+            versions.push((n, entry.path()));
+        }
+    }
+    versions.sort();
+    let Some((_, newest)) = versions.pop() else {
+        note(dir.to_path_buf(), "no committed version".into(), true);
+        return out;
+    };
+    for (_, old) in versions {
+        let empty = std::fs::read_dir(&old).map_or(true, |mut d| d.next().is_none());
+        let what = if empty { "empty older version folder" } else { "older version folder" };
+        note(old, what.into(), false);
+    }
+    let Some(names) = std::fs::read(newest.join("manifest")).ok().and_then(|b| parse_manifest(&b)) else {
+        note(newest, "manifest missing or damaged".into(), true);
+        return out;
+    };
+    let blobs = &names[2..];
+    let mut read = Vec::new();
+    for (i, name) in blobs.iter().enumerate() {
+        match std::fs::read(newest.join(i.to_string())) {
+            Ok(b) if b.is_empty() => note(newest.join(i.to_string()), format!("blob {name:?} is empty"), true),
+            Ok(b) => read.push((name.as_str(), b)),
+            Err(e) => note(newest.join(i.to_string()), format!("blob {name:?}: {e}"), true),
+        }
+    }
+    let find = |n: &str| read.iter().find(|(b, _)| *b == n).map(|(_, d)| d);
+    if let (Some(data), Some(header)) = (find("Save Game Data"), find("Save Game Header")) {
+        for what in check_asav(data, header) {
+            note(newest.clone(), what, true);
+        }
+    }
+    out
+}
+
+/// Checks every container under a provider folder.
+pub fn check_provider(root: &Path) -> Vec<Finding> {
+    let mut dirs: Vec<_> = std::fs::read_dir(root)
+        .into_iter()
+        .flatten()
+        .flatten()
+        .map(|e| e.path())
+        .filter(|p| p.is_dir() && p.file_name().is_some_and(|f| f.to_string_lossy().contains('~')))
+        .filter(|p| !p.to_string_lossy().ends_with(".gone"))
+        .collect();
+    dirs.sort();
+    dirs.iter().flat_map(|d| check_container(d)).collect()
+}
+
+/// Moves a container folder out of the title's sight, into
+/// `<provider>/.aside/<folder>-<unix secs>` (the save module ignores names
+/// with a dot, as it does `.backups`). Returns the new path. Undo: move it
+/// back.
+pub fn set_aside(container: &Path, unix_secs: u64) -> std::io::Result<PathBuf> {
+    let name = container.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+    let aside = container.with_file_name(".aside");
+    std::fs::create_dir_all(&aside)?;
+    let to = aside.join(format!("{name}-{unix_secs}"));
+    std::fs::rename(container, &to)?;
+    Ok(to)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn manifest(names: &[&str]) -> Vec<u8> {
+        let mut out = Vec::new();
+        for s in names {
+            out.extend_from_slice(&(s.len() as u32).to_le_bytes());
+            out.extend_from_slice(s.as_bytes());
+        }
+        out
+    }
+
+    fn asav(len: usize, packed: bool) -> (Vec<u8>, Vec<u8>) {
+        let mut d = vec![0u8; len];
+        d[..4].copy_from_slice(b"ASAV");
+        if packed {
+            d[0x18..0x1c].copy_from_slice(&((len - 0x28) as u32).to_le_bytes());
+            d[0x1c..0x20].copy_from_slice(&900_000u32.to_le_bytes());
+        }
+        d[0x20..0x28].copy_from_slice(&1_795_546_298u64.to_le_bytes());
+        d[0x168..0x16c].copy_from_slice(&(len as u32).to_le_bytes());
+        let mut h = vec![0u8; 296];
+        h[..4].copy_from_slice(&6u32.to_le_bytes());
+        h[4..8].copy_from_slice(&(len as u32).to_le_bytes());
+        h[0x10..0x18].copy_from_slice(&d[0x20..0x28]);
+        h[0x1c..0x24].copy_from_slice(&d[0x18..0x20]);
+        (d, h)
+    }
+
+    fn container(root: &Path, data: &[u8], header: &[u8]) -> PathBuf {
+        let dir = root.join("SARC0015~f3ad35e1a05a7da0");
+        let v = dir.join("v1");
+        std::fs::create_dir_all(&v).unwrap();
+        std::fs::write(v.join("manifest"), manifest(&["SARC0015", "SARC0015", "Save Game Data", "Save Game Header"])).unwrap();
+        std::fs::write(v.join("0"), data).unwrap();
+        std::fs::write(v.join("1"), header).unwrap();
+        dir
+    }
+
+    #[test]
+    fn a_consistent_save_passes() {
+        let t = tempfile::tempdir().unwrap();
+        let (d, h) = asav(0x3bad0, true);
+        container(t.path(), &d, &h);
+        assert_eq!(check_provider(t.path()), vec![]);
+    }
+
+    #[test]
+    fn a_cut_short_save_is_fatal() {
+        let t = tempfile::tempdir().unwrap();
+        let (d, h) = asav(0x3bad0, true);
+        container(t.path(), &d[..0x20000], &h);
+        let f = check_provider(t.path());
+        assert!(f.iter().any(|f| f.fatal && f.what.contains("cut short")), "{f:?}");
+    }
+
+    #[test]
+    fn a_header_from_another_save_is_fatal() {
+        let t = tempfile::tempdir().unwrap();
+        let (d, mut h) = asav(0x7dc, false);
+        h[0x10] ^= 1;
+        container(t.path(), &d, &h);
+        assert!(check_provider(t.path()).iter().any(|f| f.fatal && f.what.contains("times")));
+    }
+
+    #[test]
+    fn leftovers_are_reported_not_fatal() {
+        let t = tempfile::tempdir().unwrap();
+        let (d, h) = asav(0x7dc, false);
+        let dir = container(t.path(), &d, &h);
+        std::fs::rename(dir.join("v1"), dir.join("v3")).unwrap();
+        std::fs::create_dir_all(dir.join("v2")).unwrap();
+        std::fs::create_dir_all(dir.join("v4.new")).unwrap();
+        let f = check_provider(t.path());
+        assert_eq!(f.len(), 2, "{f:?}");
+        assert!(f.iter().all(|f| !f.fatal));
+    }
+
+    #[test]
+    fn set_aside_hides_and_can_be_undone() {
+        let t = tempfile::tempdir().unwrap();
+        let (d, h) = asav(0x7dc, false);
+        let dir = container(t.path(), &d, &h);
+        let to = set_aside(&dir, 1).unwrap();
+        assert!(check_provider(t.path()).is_empty() && !dir.exists());
+        std::fs::rename(&to, &dir).unwrap();
+        assert!(dir.exists());
+    }
+}
diff --git a/crates/victory-core/src/saves.rs b/crates/victory-core/src/saves.rs
new file mode 100644
index 0000000..ddd280a
--- /dev/null
+++ b/crates/victory-core/src/saves.rs
@@ -0,0 +1,252 @@
+//! Save slots: `<data>/<TITLEID>/slots/<name>/{storage,saves}`.
+//!
+//! Each slot is a whole game: a new name starts fresh, an existing one
+//! continues. Saves made before slots existed live in `<TITLEID>/storage`
+//! and `<TITLEID>/saves`; they are slot `default` until a `slots/default`
+//! folder exists (nothing is moved, the old place is read in place).
+//! Deleting moves a slot to `<TITLEID>/trash/<name>-<unix seconds>`.
+
+use std::path::{Path, PathBuf};
+
+use anyhow::{Context, Result, bail};
+
+pub const DEFAULT: &str = "default";
+const SUBS: [&str; 2] = ["storage", "saves"];
+
+/// Where a slot keeps its files.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SlotPaths {
+    pub storage: PathBuf,
+    pub saves: PathBuf,
+    /// Reads the pre-slot location.
+    pub legacy: bool,
+}
+
+/// The slot name from `VICTORY_SAVE_SLOT` (default `default`), validated.
+pub fn slot_from_env() -> Result<String> {
+    let name = crate::env::env("VICTORY_SAVE_SLOT").filter(|s| !s.is_empty());
+    let name = name.unwrap_or_else(|| DEFAULT.to_owned());
+    validate(&name)?;
+    Ok(name)
+}
+
+/// Names are 1 to 64 of letters, digits, `-`, `_` and `.` (not leading), so
+/// they can never hold a path separator or climb out.
+pub fn validate(name: &str) -> Result<()> {
+    let ok = !name.is_empty()
+        && name.len() <= 64
+        && !name.starts_with('.')
+        && name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.'));
+    if !ok {
+        bail!(
+            "invalid save slot name {name:?}: use 1-64 letters, digits, '-', '_' or '.', \
+             not starting with '.'"
+        );
+    }
+    Ok(())
+}
+
+fn slots_dir(title: &Path) -> PathBuf {
+    title.join("slots")
+}
+
+fn has_legacy(title: &Path) -> bool {
+    SUBS.iter().any(|s| title.join(s).exists())
+}
+
+/// Paths of `slot` under a title folder, without creating anything.
+pub fn resolve(title: &Path, slot: &str) -> Result<SlotPaths> {
+    validate(slot)?;
+    let dir = slots_dir(title).join(slot);
+    if slot == DEFAULT && !dir.exists() && has_legacy(title) {
+        return Ok(SlotPaths {
+            storage: title.join("storage"),
+            saves: title.join("saves"),
+            legacy: true,
+        });
+    }
+    Ok(SlotPaths {
+        storage: dir.join("storage"),
+        saves: dir.join("saves"),
+        legacy: false,
+    })
+}
+
+/// Slot names present, sorted (`default` included when only legacy saves exist).
+pub fn list(title: &Path) -> Vec<String> {
+    let mut names: Vec<String> = std::fs::read_dir(slots_dir(title))
+        .into_iter()
+        .flatten()
+        .flatten()
+        .filter(|e| e.path().is_dir())
+        .filter_map(|e| e.file_name().into_string().ok())
+        .filter(|n| validate(n).is_ok())
+        .collect();
+    if has_legacy(title) && !names.iter().any(|n| n == DEFAULT) {
+        names.push(DEFAULT.to_owned());
+    }
+    names.sort();
+    names
+}
+
+fn exists(title: &Path, name: &str) -> bool {
+    list(title).iter().any(|n| n == name)
+}
+
+/// Creates an empty slot; it must not exist.
+pub fn create(title: &Path, name: &str) -> Result<()> {
+    validate(name)?;
+    if exists(title, name) {
+        bail!("save slot {name:?} already exists");
+    }
+    let dir = slots_dir(title).join(name);
+    for s in SUBS {
+        std::fs::create_dir_all(dir.join(s))
+            .with_context(|| format!("creating {}", dir.display()))?;
+    }
+    Ok(())
+}
+
+fn copy_tree(from: &Path, to: &Path) -> Result<()> {
+    std::fs::create_dir_all(to)?;
+    for e in std::fs::read_dir(from)? {
+        let e = e?;
+        let target = to.join(e.file_name());
+        if e.file_type()?.is_dir() {
+            copy_tree(&e.path(), &target)?;
+        } else {
+            std::fs::copy(e.path(), &target)?;
+        }
+    }
+    Ok(())
+}
+
+/// Copies slot `from` to a new slot `to`.
+pub fn copy(title: &Path, from: &str, to: &str) -> Result<()> {
+    validate(to)?;
+    if !exists(title, from) {
+        bail!("save slot {from:?} does not exist");
+    }
+    if exists(title, to) {
+        bail!("save slot {to:?} already exists");
+    }
+    let src = resolve(title, from)?;
+    let dst = slots_dir(title).join(to);
+    let done = (|| -> Result<()> {
+        for (a, name) in [(&src.storage, "storage"), (&src.saves, "saves")] {
+            if a.is_dir() {
+                copy_tree(a, &dst.join(name))?;
+            } else {
+                std::fs::create_dir_all(dst.join(name))?;
+            }
+        }
+        Ok(())
+    })();
+    if done.is_err() {
+        let _ = std::fs::remove_dir_all(&dst); // only our half-made copy
+    }
+    done
+}
+
+/// Moves a slot to the trash folder; returns where it went.
+pub fn delete(title: &Path, name: &str, unix_secs: u64) -> Result<PathBuf> {
+    validate(name)?;
+    if !exists(title, name) {
+        bail!("save slot {name:?} does not exist");
+    }
+    let mut dest = title.join("trash").join(format!("{name}-{unix_secs}"));
+    let mut n = 1;
+    while dest.exists() {
+        dest = title
+            .join("trash")
+            .join(format!("{name}-{unix_secs}-{n}"));
+        n += 1;
+    }
+    let p = resolve(title, name)?;
+    if p.legacy {
+        std::fs::create_dir_all(&dest)?;
+        for (a, s) in [(&p.storage, "storage"), (&p.saves, "saves")] {
+            if a.exists() {
+                std::fs::rename(a, dest.join(s))?;
+            }
+        }
+    } else {
+        std::fs::create_dir_all(title.join("trash"))?;
+        std::fs::rename(slots_dir(title).join(name), &dest)?;
+    }
+    Ok(dest)
+}
+
+/// Title folders under the data directory (8 hex digits).
+pub fn titles(data: &Path) -> Vec<PathBuf> {
+    let mut v: Vec<PathBuf> = std::fs::read_dir(data)
+        .into_iter()
+        .flatten()
+        .flatten()
+        .filter(|e| e.path().is_dir())
+        .filter(|e| {
+            let n = e.file_name();
+            let n = n.to_string_lossy();
+            n.len() == 8 && n.bytes().all(|b| b.is_ascii_hexdigit())
+        })
+        .map(|e| e.path())
+        .collect();
+    v.sort();
+    v
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn names_reject_separators_and_escapes() {
+        let long = "n".repeat(65);
+        for bad in ["", "a/b", "a\\b", "..", ".hidden", "a:b", "x y", long.as_str()] {
+            assert!(validate(bad).is_err(), "{bad:?}");
+        }
+        for good in ["default", "run-2", "A_b.1"] {
+            validate(good).unwrap();
+        }
+    }
+
+    #[test]
+    fn slot_paths_and_legacy_pickup() {
+        let t = tempfile::tempdir().unwrap();
+        let p = t.path();
+        let r = resolve(p, "default").unwrap();
+        assert!(!r.legacy && r.saves == p.join("slots/default/saves"));
+        assert!(list(p).is_empty());
+        // Old saves appear as default and are read in place.
+        std::fs::create_dir_all(p.join("saves")).unwrap();
+        std::fs::write(p.join("saves/x"), b"1").unwrap();
+        let r = resolve(p, "default").unwrap();
+        assert!(r.legacy && r.saves == p.join("saves"));
+        assert_eq!(list(p), ["default"]);
+        assert!(!resolve(p, "b").unwrap().legacy);
+        assert!(resolve(p, "../x").is_err());
+        create(p, "other").unwrap();
+        copy(p, "default", "copy").unwrap();
+        assert_eq!(std::fs::read(p.join("slots/copy/saves/x")).unwrap(), b"1");
+        assert_eq!(list(p), ["copy", "default", "other"]);
+        assert!(copy(p, "default", "copy").is_err());
+        assert!(create(p, "default").is_err());
+    }
+
+    #[test]
+    fn delete_moves_to_trash() {
+        let t = tempfile::tempdir().unwrap();
+        let p = t.path();
+        std::fs::create_dir_all(p.join("saves")).unwrap();
+        std::fs::write(p.join("saves/x"), b"1").unwrap();
+        let d = delete(p, "default", 5).unwrap();
+        assert_eq!(std::fs::read(d.join("saves/x")).unwrap(), b"1");
+        assert!(list(p).is_empty());
+        create(p, "a").unwrap();
+        let d = delete(p, "a", 5).unwrap();
+        assert!(d.join("saves").is_dir() && !p.join("slots/a").exists());
+        assert!(delete(p, "a", 5).is_err());
+    }
+}
diff --git a/crates/victory-core/src/splash.rs b/crates/victory-core/src/splash.rs
new file mode 100644
index 0000000..c17c53a
--- /dev/null
+++ b/crates/victory-core/src/splash.rs
@@ -0,0 +1,624 @@
+//! Boot splash logic that needs no operating system: the phases of a start, the state machine that
+//! decides when the splash fades, the bar, the letterbox and the image choice.
+//!
+//! Starting a title takes a long while (reading and patching the executable, mapping it, the
+//! caches, then menus that may present black frames). The window that shows the splash lives in
+//! `victory-gpu` (Windows only); everything it decides is here so that it is unit-tested anywhere.
+//!
+//! The picture is never part of this repository: it is read at run time from the user's own game
+//! folder (`MicrosoftGame.config`, see [`image_candidates`]). Without one the splash is a dark
+//! background and the progress bar.
+//!
+//! Environment: `VICTORY_SPLASH=0` turns the splash off, `VICTORY_SPLASH_MAX_S` is how long it may
+//! stay before it fades by itself (default 180).
+
+use std::sync::atomic::{AtomicU8, Ordering};
+
+/// Seconds the fade-out takes.
+pub const FADE_SECS: f64 = 0.6;
+/// Default seconds before the splash fades without any sign of content.
+pub const DEFAULT_MAX_SECS: f64 = 180.0;
+/// The presented frame is sampled on every n-th present.
+pub const SAMPLE_EVERY: u64 = 6;
+/// Consecutive bright samples that count as content.
+pub const NEEDED: u32 = 5;
+/// Mean luminance (0..1 as presented) above which a sample is bright.
+pub const LUMA_MIN: f32 = 0.03;
+
+// ---------------------------------------------------------------------------------------
+// settings
+// ---------------------------------------------------------------------------------------
+
+/// `VICTORY_SPLASH`'s value: everything but `0` (and `off`, `false`) leaves the splash on.
+pub fn parse_enabled(value: Option<&str>) -> bool {
+    !matches!(
+        value.map(|v| v.trim().to_ascii_lowercase()).as_deref(),
+        Some("0" | "off" | "false" | "no")
+    )
+}
+
+/// `VICTORY_SPLASH_MAX_S`'s value: a positive number of seconds, else the default.
+pub fn parse_max_secs(value: Option<&str>) -> f64 {
+    value
+        .and_then(|v| v.trim().parse::<f64>().ok())
+        .filter(|s| s.is_finite() && *s > 0.0)
+        .unwrap_or(DEFAULT_MAX_SECS)
+}
+
+/// Whether the splash is on, from the environment.
+pub fn enabled() -> bool {
+    parse_enabled(std::env::var("VICTORY_SPLASH").ok().as_deref())
+}
+
+/// Seconds the splash may stay, from the environment.
+pub fn max_secs() -> f64 {
+    parse_max_secs(std::env::var("VICTORY_SPLASH_MAX_S").ok().as_deref())
+}
+
+// ---------------------------------------------------------------------------------------
+// boot phases
+// ---------------------------------------------------------------------------------------
+
+/// Where the start is, in order. The runtime reports it with [`set_phase`]; the bar advances by it.
+#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Debug)]
+#[repr(u8)]
+pub enum BootPhase {
+    /// The process has begun.
+    Start = 0,
+    /// Reading and patching the title's executable.
+    Reading = 1,
+    /// Opening the shader and pipeline caches.
+    Cache = 2,
+    /// Mapping the program.
+    Mapping = 3,
+    /// Mapping the title's DLLs and binding imports.
+    Dlls = 4,
+    /// The title runs (its own startup, menus).
+    Starting = 5,
+}
+
+impl BootPhase {
+    fn from_u8(v: u8) -> BootPhase {
+        match v {
+            1 => BootPhase::Reading,
+            2 => BootPhase::Cache,
+            3 => BootPhase::Mapping,
+            4 => BootPhase::Dlls,
+            5 => BootPhase::Starting,
+            _ => BootPhase::Start,
+        }
+    }
+
+    /// The bar's range while in this phase, and the seconds it takes to cover most of it (the
+    /// time of a phase is not known, so the bar creeps towards the end of its range).
+    fn range(self) -> (f32, f32, f64) {
+        match self {
+            BootPhase::Start => (0.0, 0.03, 2.0),
+            BootPhase::Reading => (0.03, 0.30, 8.0),
+            BootPhase::Cache => (0.30, 0.35, 3.0),
+            BootPhase::Mapping => (0.35, 0.60, 8.0),
+            BootPhase::Dlls => (0.60, 0.70, 4.0),
+            BootPhase::Starting => (0.70, 0.97, 25.0),
+        }
+    }
+}
+
+static PHASE: AtomicU8 = AtomicU8::new(0);
+
+/// The runtime reports a phase of the start (never goes back).
+pub fn set_phase(phase: BootPhase) {
+    PHASE.fetch_max(phase as u8, Ordering::Relaxed);
+}
+
+/// The phase reported last.
+pub fn phase() -> BootPhase {
+    BootPhase::from_u8(PHASE.load(Ordering::Relaxed))
+}
+
+// ---------------------------------------------------------------------------------------
+// state machine
+// ---------------------------------------------------------------------------------------
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum State {
+    Showing,
+    /// Fading since this time.
+    Fading(f64),
+    Done,
+}
+
+/// What the window shows now.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct View {
+    /// Opacity of the whole splash, 1 shown .. 0 gone.
+    pub alpha: f32,
+    /// The bar's fill, 0..1.
+    pub progress: f32,
+}
+
+/// Why the splash began to fade.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Cause {
+    Content,
+    Input,
+    Timeout,
+}
+
+#[derive(Debug)]
+pub struct Splash {
+    state: State,
+    start: f64,
+    max_secs: f64,
+    streak: u32,
+    frames: u64,
+    phase: BootPhase,
+    phase_since: f64,
+    last_tick: f64,
+    shown: f32,
+    cause: Option<Cause>,
+}
+
+impl Splash {
+    pub fn new(now: f64, max_secs: f64) -> Self {
+        Splash {
+            state: State::Showing,
+            start: now,
+            max_secs,
+            streak: 0,
+            frames: 0,
+            phase: BootPhase::Start,
+            phase_since: now,
+            last_tick: now,
+            shown: 0.0,
+            cause: None,
+        }
+    }
+
+    /// A frame was presented: is its content to be sampled?
+    pub fn on_frame(&mut self) -> bool {
+        if self.state != State::Showing {
+            return false;
+        }
+        let due = self.frames % SAMPLE_EVERY == 0;
+        self.frames += 1;
+        due
+    }
+
+    /// The mean luminance of a sampled frame: [`NEEDED`] bright ones in a row fade the splash.
+    pub fn on_luma(&mut self, luma: f32, now: f64) {
+        if self.state != State::Showing {
+            return;
+        }
+        self.streak = if luma > LUMA_MIN { self.streak + 1 } else { 0 };
+        if self.streak >= NEEDED {
+            self.fade(now, Cause::Content);
+        }
+    }
+
+    /// A key or button was pressed.
+    pub fn on_input(&mut self, now: f64) {
+        if self.state == State::Showing {
+            self.fade(now, Cause::Input);
+        }
+    }
+
+    fn fade(&mut self, now: f64, cause: Cause) {
+        self.state = State::Fading(now);
+        self.cause = Some(cause);
+    }
+
+    /// Why it faded, once it has begun.
+    pub fn cause(&self) -> Option<Cause> {
+        self.cause
+    }
+
+    /// Advance to `now` with the runtime at `phase`; `None` once finished.
+    pub fn tick(&mut self, now: f64, phase: BootPhase) -> Option<View> {
+        if self.state == State::Showing && now - self.start >= self.max_secs {
+            self.fade(now, Cause::Timeout);
+        }
+        if phase > self.phase {
+            self.phase = phase;
+            self.phase_since = now;
+        }
+        let dt = (now - self.last_tick).max(0.0);
+        self.last_tick = now;
+        // the bar eases towards where the phase says it should be, and never goes back
+        let target = match self.state {
+            State::Showing => {
+                let (lo, hi, tau) = self.phase.range();
+                lo + (hi - lo) * 0.9 * (1.0 - (-(now - self.phase_since) / tau).exp() as f32)
+            }
+            _ => 1.0,
+        };
+        let follow = (dt * 6.0).min(1.0) as f32;
+        self.shown = self.shown.max(self.shown + (target - self.shown) * follow);
+        match self.state {
+            State::Showing => Some(View { alpha: 1.0, progress: self.shown }),
+            State::Fading(since) => {
+                let t = ((now - since) / FADE_SECS).clamp(0.0, 1.0) as f32;
+                if t >= 1.0 {
+                    self.state = State::Done;
+                    return None;
+                }
+                Some(View { alpha: 1.0 - t * t * (3.0 - 2.0 * t), progress: self.shown })
+            }
+            State::Done => None,
+        }
+    }
+
+    pub fn finished(&self) -> bool {
+        self.state == State::Done
+    }
+}
+
+/// Whether a key or button went down since the last poll: `now` and `before` are the state of each
+/// (the keyboard, the mouse buttons, a pad's buttons). Keys held at the start do not count.
+pub fn new_press(before: &mut [bool], now: &[bool]) -> bool {
+    let mut pressed = false;
+    for (b, &n) in before.iter_mut().zip(now) {
+        pressed |= n && !*b;
+        *b = n;
+    }
+    pressed
+}
+
+// ---------------------------------------------------------------------------------------
+// geometry
+// ---------------------------------------------------------------------------------------
+
+/// The largest rectangle of the image's aspect that fits the client area, centered:
+/// (x, y, width, height) in pixels.
+pub fn letterbox(img_w: u32, img_h: u32, dst_w: u32, dst_h: u32) -> (i32, i32, i32, i32) {
+    if img_w == 0 || img_h == 0 || dst_w == 0 || dst_h == 0 {
+        return (0, 0, dst_w as i32, dst_h as i32);
+    }
+    let scale = (dst_w as f64 / img_w as f64).min(dst_h as f64 / img_h as f64);
+    let w = ((img_w as f64 * scale).round() as i32).clamp(1, dst_w as i32);
+    let h = ((img_h as f64 * scale).round() as i32).clamp(1, dst_h as i32);
+    ((dst_w as i32 - w) / 2, (dst_h as i32 - h) / 2, w, h)
+}
+
+/// A rectangle as (left, top, right, bottom).
+pub type Rect = (i32, i32, i32, i32);
+
+/// The progress bar in a `w` x `h` window: the track, the filled part and a moving glint on the
+/// fill (so the bar shows life while a phase takes long). A thin bar low in the window.
+pub fn bar_rects(w: i32, h: i32, progress: f32, t: f64) -> (Rect, Rect, Rect) {
+    let thick = (h / 180).clamp(3, 8);
+    let left = w / 5;
+    let right = w - w / 5;
+    let top = h - h / 12 - thick;
+    let track = (left, top, right, top + thick);
+    let fill_to = left + ((right - left) as f32 * progress.clamp(0.0, 1.0)).round() as i32;
+    let fill = (left, top, fill_to, top + thick);
+    // the glint sweeps across the fill once every 1.6 s
+    let width = ((right - left) / 8).max(8);
+    let phase = (t / 1.6).fract() as f32;
+    let at = left - width + ((fill_to - left + width) as f32 * phase) as i32;
+    let glint = (at.max(left), top, (at + width).min(fill_to), top + thick);
+    let glint = if glint.2 > glint.0 { glint } else { (left, top, left, top + thick) };
+    (track, fill, glint)
+}
+
+// ---------------------------------------------------------------------------------------
+// the picture
+// ---------------------------------------------------------------------------------------
+
+/// `name="value"` in the config's text (the attribute after a space).
+fn attribute<'a>(text: &'a str, name: &str) -> Option<&'a str> {
+    let key = format!(" {name}=\"");
+    let i = text.find(&key)? + key.len();
+    let v = &text[i..i + text[i..].find('"')?];
+    (!v.is_empty()).then_some(v)
+}
+
+/// Image files of `MicrosoftGame.config`'s `ShellVisuals`, best first: the splash screen, then the
+/// logos from largest to smallest.
+pub fn image_candidates(config: &str) -> Vec<String> {
+    ["SplashScreenImage", "Square480x480Logo", "StoreLogo", "Square150x150Logo", "Square44x44Logo"]
+        .iter()
+        .filter_map(|n| attribute(config, n))
+        .map(str::to_string)
+        .collect()
+}
