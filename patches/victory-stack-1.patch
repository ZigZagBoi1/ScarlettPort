+        s.vehicle.rebind(Output::RightTrigger, Some(vk("W")), Some(WHEEL_UP));
+        s.vehicle.rebind(Output::Button(B), None, Some(vk("Mouse4")));
+        let text = s.keymap_text();
+        assert!(text.contains("[on_foot]") && text.contains("[vehicle]"));
