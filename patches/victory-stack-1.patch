+/// Measures what the profiler costs the threads it looks at. Not a test
+/// of anything: run it by name, in a release build:
+/// `cargo test --profile diag -p victory-gpu --features diagnostics
+/// fxprof::tests::what_looking_costs -- --ignored --nocapture`.
+///
+/// Eight threads do work that is counted, one to a core and above the
+/// priority other programs run at, so that a busy machine does not
+/// decide the result; rounds with and without the profiler alternate.
+#[test]
+#[ignore = "a measurement, not a test"]
+fn what_looking_costs() {
+    use windows_sys::Win32::System::Threading::{SetThreadAffinityMask, THREAD_PRIORITY_HIGHEST};
+    #[repr(align(128))]
+    struct Count(AtomicU64);
+    const THREADS: usize = 8;
+    static COUNTS: [Count; THREADS] = [const { Count(AtomicU64::new(0)) }; THREADS];
+    static STOP: AtomicBool = AtomicBool::new(false);
+    static WAITS: AtomicBool = AtomicBool::new(false);
+
+    #[inline(never)]
+    fn profile_cost_work(depth: u32, count: &AtomicU64, seed: u64) -> u64 {
+        if depth > 0 {
+            return std::hint::black_box(profile_cost_work(
+                depth - 1,
+                count,
+                seed ^ u64::from(depth),
+            )) + 1;
+        }
+        let mut x = seed | 1;
+        while !STOP.load(Relaxed) {
+            for _ in 0..4096 {
+                x ^= x << 13;
+                x ^= x >> 7;
+                x ^= x << 17;
+            }
+            count.fetch_add(1, Relaxed);
+            if WAITS.load(Relaxed) && x.is_multiple_of(64) {
+                // Now and then a wait, as a thread that waits for the card has.
+                std::thread::sleep(Duration::from_micros(500));
+            }
+        }
+        x
+    }
+
+    let pinned = std::thread::available_parallelism().map_or(1, |n| n.get()) >= 2 * THREADS;
+    let mut running = Vec::new();
+    let mut ids = Vec::new();
+    for (i, count) in COUNTS.iter().enumerate() {
+        let (id, thread) = thread(move || {
+            // SAFETY: plain calls on our own thread.
+            unsafe {
+                if pinned {
+                    SetThreadAffinityMask(GetCurrentThread(), 1 << (2 * i));
+                }
+                SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
+            }
+            std::hint::black_box(profile_cost_work(30, &count.0, i as u64 + 1));
+        });
+        ids.push(id);
+        running.push(thread);
+    }
+    std::thread::sleep(Duration::from_millis(200));
+    // The parts of a look at a running thread, each timed on its own.
+    {
+        // SAFETY: a thread of this test, suspended and resumed in turn; the
+        // context is aligned; the copy is ours.
+        unsafe {
+            SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+            let thread = OpenThread(ACCESS, 0, ids[0]);
+            let mut context = Box::new(Aligned(std::mem::zeroed()));
+            let mut copy = vec![0u8; 256 << 10];
+            let mut parts: [Vec<u64>; 5] = Default::default();
+            for _ in 0..3000 {
+                std::thread::sleep(Duration::from_micros(300));
+                context.0.ContextFlags = CONTEXT_CONTROL_AMD64 | CONTEXT_INTEGER_AMD64;
+                let mut got = 0;
+                let t0 = Instant::now();
+                SuspendThread(thread);
+                let t1 = Instant::now();
+                GetThreadContext(thread, &mut context.0);
+                let t2 = Instant::now();
+                ReadProcessMemory(
+                    GetCurrentProcess(),
+                    context.0.Rsp as *const c_void,
+                    copy.as_mut_ptr().cast(),
+                    4096,
+                    &mut got,
+                );
+                let t3 = Instant::now();
+                ResumeThread(thread);
+                let t4 = Instant::now();
+                for (part, time) in
+                    parts
+                        .iter_mut()
+                        .zip([t1 - t0, t2 - t1, t3 - t2, t4 - t3, t4 - t0])
+                {
+                    part.push(time.as_nanos() as u64);
+                }
+            }
+            CloseHandle(thread);
+            SetThreadPriority(GetCurrentThread(), 0);
+            let median = |part: &mut Vec<u64>| {
+                part.sort_unstable();
+                (
+                    part[part.len() / 2] as f64 / 1000.0,
+                    part[part.len() * 9 / 10] as f64 / 1000.0,
+                )
+            };
+            let [a, b, c, d, e] = parts.each_mut().map(median);
+            println!(
+                "a look at a running thread, 3000 of them, median (and 9 in 10 under), microseconds: \
+                 suspend {:.1} ({:.1}), read its registers {:.1} ({:.1}), copy 4 KB of stack {:.1} ({:.1}), \
+                 resume {:.1} ({:.1}), all {:.1} ({:.1})",
+                a.0, a.1, b.0, b.1, c.0, c.1, d.0, d.1, e.0, e.1
+            );
+            // The kernel's copy against a plain one, by size.
+            let source = vec![7u8; 256 << 10];
+            for size in [4usize << 10, 16 << 10, 64 << 10, 128 << 10, 256 << 10] {
+                let (mut kernel, mut plain) = (Vec::new(), Vec::new());
+                for _ in 0..400 {
+                    let mut got = 0;
+                    let t0 = Instant::now();
+                    ReadProcessMemory(
+                        GetCurrentProcess(),
+                        source.as_ptr().cast(),
+                        copy.as_mut_ptr().cast(),
+                        size,
+                        &mut got,
+                    );
+                    let t1 = Instant::now();
+                    std::ptr::copy_nonoverlapping(
+                        source.as_ptr(),
+                        std::hint::black_box(copy.as_mut_ptr()),
+                        size,
+                    );
+                    let t2 = Instant::now();
+                    kernel.push((t1 - t0).as_nanos() as u64);
+                    plain.push((t2 - t1).as_nanos() as u64);
+                }
+                println!(
+                    "a copy of {} KB: the kernel's {:.1} us, a plain one {:.1} us (medians of 400)",
+                    size >> 10,
+                    median(&mut kernel).0,
+                    median(&mut plain).0
+                );
+            }
+        }
+    }
+    let total = || COUNTS.iter().map(|c| c.0.load(Relaxed)).sum::<u64>();
+    let round = Duration::from_millis(1000);
+    let rounds = 9;
+    // The timer the sampler ticks by.
+    {
+        let mut pace = Pace::new(1000, 0);
+        let (began, mut longest, mut last) = (Instant::now(), Duration::ZERO, Instant::now());
+        for _ in 0..2000 {
+            pace.wait();
+            longest = longest.max(last.elapsed());
+            last = Instant::now();
+        }
+        println!(
+            "the timer: 2000 ticks of a millisecond took {:.1} ms, the longest {:.2} ms (repeating: {})",
+            began.elapsed().as_secs_f64() * 1000.0,
+            longest.as_secs_f64() * 1000.0,
+            pace.repeats
+        );
+    }
+    for (what, waits, reuse, budget) in [
+        (
+            "8 threads always running, no limit on what looks may cost (VICTORY_PROFILE_BUDGET=0)",
+            false,
+            true,
+            0.0,
+        ),
+        (
+            "8 threads always running, the usual limit of 3 %",
+            false,
+            true,
+            0.03,
+        ),
+        (
+            "8 threads that run and wait, the usual limit",
+            true,
+            true,
+            0.03,
+        ),
+        (
+            "8 threads that run and wait, every look a suspension (VICTORY_PROFILE_REUSE=0), no limit",
+            true,
+            false,
+            0.0,
+        ),
+    ] {
+        WAITS.store(waits, Relaxed);
+        std::thread::sleep(Duration::from_millis(300));
+        for hz in [1000u32, 4000] {
+            let (mut without, mut with) = (Vec::new(), Vec::new());
+            let (mut half, mut most, mut longest, mut looks, mut reused, mut late, mut used) =
+                (0.0f64, 0.0f64, 0.0f64, 0, 0, 0, 0.0);
+            let (mut ticks, mut every) = (0, 1);
+            for _ in 0..rounds {
+                // Without the profiler.
+                let (from, began) = (total(), Instant::now());
+                std::thread::sleep(round);
+                without.push((total() - from) as f64 / began.elapsed().as_secs_f64());
+                // With it, on a thread of its own as in the game.
+                let ids = ids.clone();
+                let measured = std::thread::spawn(move || {
+                    // SAFETY: a plain call on our own thread.
+                    unsafe { SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL) };
+                    let mut settings = config(hz);
+                    settings.reuse = reuse;
+                    settings.budget = budget;
+                    let mut sampler = Sampler::new(settings);
+                    for &id in &ids {
+                        sampler.follow(id, Role::Record, null_mut(), None);
+                    }
+                    sampler.resync();
+                    let mut pace = Pace::new(hz, 250);
+                    let (cpu, from, began) = (own_cpu(), total(), Instant::now());
+                    while began.elapsed() < round {
+                        pace.wait();
+                        sampler.tick();
+                    }
+                    let rate = (total() - from) as f64 / began.elapsed().as_secs_f64();
+                    let used = (own_cpu() - cpu).as_secs_f64() / began.elapsed().as_secs_f64();
+                    let threads = &sampler.threads;
+                    (
+                        rate,
+                        used,
+                        sampler.held_within(0.5),
+                        sampler.held_within(0.99),
+                        sampler.held_longest as f64 / 1000.0,
+                        threads.iter().map(|t| t.looks).sum::<u64>(),
+                        threads.iter().map(|t| t.reused).sum::<u64>(),
+                        sampler.late,
+                        threads.iter().map(|t| t.missed).sum::<u64>(),
+                        sampler.ticks,
+                        threads.iter().map(|t| t.every).max().unwrap_or(1),
+                    )
+                })
+                .join()
+                .unwrap();
+                with.push(measured.0);
+                used += measured.1 / rounds as f64;
+                half = half.max(measured.2);
+                most = most.max(measured.3);
+                longest = longest.max(measured.4);
+                looks += measured.5;
+                reused += measured.6;
+                late += measured.7;
+                assert_eq!(measured.8, 0, "looks that failed");
+                ticks += measured.9;
+                every = every.max(measured.10);
+            }
+            let median = |values: &mut Vec<f64>| {
+                values.sort_by(f64::total_cmp);
+                values[values.len() / 2]
+            };
+            let spread = |values: &[f64]| {
+                100.0 * (values[values.len() - 1] - values[0]) / values[values.len() / 2]
+            };
+            let (off, on) = (median(&mut without), median(&mut with));
+            println!(
+                "{what}, {hz} looks a second: work done {:.2} % less with the profiler (medians of {rounds} \
+                 rounds of 1 s: {off:.0} against {on:.0} a second; the rounds without it differ by {:.1} %, \
+                 with it by {:.1} %); a suspension under {half:.0} us half the times, under {most:.0} us 99 \
+                 in 100, {longest:.0} us at longest; {ticks} ticks ({late} late), {looks} looks, {reused} \
+                 without a suspension, a thread looked at every {every} ticks at most; the sampler's \
+                 thread used {:.1} % of a processor",
+                100.0 * (off - on) / off,
+                spread(&without),
+                spread(&with),
+                100.0 * used,
+            );
+        }
+    }
+    STOP.store(true, Relaxed);
+    for thread in running {
+        thread.join().unwrap();
+    }
+}
diff --git a/crates/victory-gpu/src/gpuprof.rs b/crates/victory-gpu/src/gpuprof.rs
new file mode 100644
index 0000000..b323932
--- /dev/null
+++ b/crates/victory-gpu/src/gpuprof.rs
@@ -0,0 +1,274 @@
+//! The card's time by pipeline (`VICTORY_GPU_PROFILE=1`; off otherwise).
+//!
+//! The card meter (`crate::cardmeter`) says how long the title's lists
+//! took, not which shaders. Here every host list the title records gets a
+//! block of timestamps: one where the list begins, one each time a draw or
+//! dispatch binds another pipeline, one where the list ends, all resolved
+//! by the list itself into one mapped read-back buffer. The span between
+//! two stamps goes to the pipeline bound in it, with the draws and
+//! dispatches it held. Nothing waits for the card: a block is read
+//! [`AFTER`] its list closed, long after any flight of then has landed,
+//! and zeroed so a list that never ran is not counted.
+//!
+//! Every [`EVERY`], the log gets the title lists' total and the top
+//! [`TOP`] pipelines by card milliseconds a frame, named by their shaders'
+//! hashes (the first 16 hex digits of the container's BLAKE3: the
+//! translator cache's and shaders.rpf records' names).
+//!
+//! Spans are between the card's stamps at consecutive pipeline changes:
+//! with draws overlapping across a change, some of a pipeline's work lands
+//! in the next one's span. Good for ranking, not to the microsecond. The
+//! indirect-clamp passes the layer adds inside a group count toward that
+//! group's pipeline.
+
+#[path = "gpuprof/agg.rs"]
+mod agg;
+
+use std::collections::{HashMap, VecDeque};
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::DXGI_SAMPLE_DESC;
+use windows::core::Interface;
+
+use agg::{Agg, ListStamps, OVERFLOW, PRELUDE};
+
+/// Stamps a list may use.
+const SLOTS: u32 = 1024;
+/// Blocks of [`SLOTS`]: lists timed at once (recorded and not read yet).
+const BLOCKS: u32 = 1024;
+const AFTER: Duration = Duration::from_millis(750);
+const EVERY: Duration = Duration::from_secs(5);
+const TOP: usize = 25;
+
+pub(crate) fn on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_GPU_PROFILE").is_some_and(|v| v != "0"))
+}
+
+struct Open {
+    block: u32,
+    /// Per span (stamps - 1 of them while open): pipeline key, draws.
+    keys: Vec<u32>,
+    draws: Vec<u32>,
+}
+
+struct Prof {
+    heap: ID3D12QueryHeap,
+    back: ID3D12Resource,
+    mapped: usize,
+    frequency: u64,
+    free: Vec<u32>,
+    open: HashMap<usize, Open>,
+    pending: VecDeque<(Open, Instant)>,
+    /// Host pipeline (kept alive so its address names it alone) to key.
+    keys: HashMap<usize, (u32, ID3D12PipelineState)>,
+    names: Vec<String>,
+    agg: Agg,
+    since: Instant,
+    /// Lists not timed: no free block.
+    untimed: u64,
+}
+
+// SAFETY: free-threaded host objects and a mapping, behind a lock.
+unsafe impl Send for Prof {}
+
+static PROF: Mutex<Option<Option<Prof>>> = Mutex::new(None);
+
+fn make() -> Option<Prof> {
+    let host = crate::host::host()?;
+    let device = host.device();
+    let count = SLOTS * BLOCKS;
+    let mut heap: Option<ID3D12QueryHeap> = None;
+    let mut back: Option<ID3D12Resource> = None;
+    let readback = D3D12_HEAP_PROPERTIES { Type: D3D12_HEAP_TYPE_READBACK, ..Default::default() };
+    let desc = D3D12_RESOURCE_DESC {
+        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+        Width: u64::from(count) * 8,
+        Height: 1,
+        DepthOrArraySize: 1,
+        MipLevels: 1,
+        SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+        ..Default::default()
+    };
+    // SAFETY: plain object creation; the buffer is mapped once and stays so.
+    unsafe {
+        device
+            .CreateQueryHeap(&D3D12_QUERY_HEAP_DESC { Type: D3D12_QUERY_HEAP_TYPE_TIMESTAMP, Count: count, NodeMask: 0 }, &mut heap)
+            .ok()?;
+        device
+            .CreateCommittedResource(&readback, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST, None, &mut back)
+            .ok()?;
+        let (heap, back) = (heap?, back?);
+        let mut mapped = std::ptr::null_mut();
+        back.Map(0, None, Some(&mut mapped)).ok()?;
+        let frequency = host.timestamp_frequency();
+        if mapped.is_null() || frequency == 0 {
+            return None;
+        }
+        std::ptr::write_bytes(mapped.cast::<u8>(), 0, count as usize * 8);
+        tracing::info!(
+            "VICTORY_GPU_PROFILE: the card's time by pipeline, a timestamp at each pipeline change; top {TOP} every {}s",
+            EVERY.as_secs()
+        );
+        Some(Prof {
+            heap,
+            back,
+            mapped: mapped as usize,
+            frequency,
+            free: (0..BLOCKS).rev().collect(),
+            open: HashMap::new(),
+            pending: VecDeque::new(),
+            keys: HashMap::new(),
+            names: Vec::new(),
+            agg: Agg::default(),
+            since: Instant::now(),
+            untimed: 0,
+        })
+    }
+}
+
+fn with<R>(f: impl FnOnce(&mut Prof) -> R) -> Option<R> {
+    let mut g = PROF.lock().unwrap_or_else(|e| e.into_inner());
+    g.get_or_insert_with(make).as_mut().map(f)
+}
+
+impl Prof {
+    fn stamp(&self, list: &ID3D12GraphicsCommandList, slot: u32) {
+        // SAFETY: an open list and our heap.
+        unsafe { list.EndQuery(&self.heap, D3D12_QUERY_TYPE_TIMESTAMP, slot) };
+    }
+
+    fn begin(&mut self, list: &ID3D12GraphicsCommandList) -> bool {
+        let at = list.as_raw() as usize;
+        if let Some(old) = self.open.remove(&at) {
+            // Reset without a close: its stamps were never resolved.
+            self.free.push(old.block);
+        }
+        let Some(block) = self.free.pop() else {
+            self.untimed += 1;
+            return false;
+        };
+        self.stamp(list, block * SLOTS);
+        self.open.insert(at, Open { block, keys: vec![PRELUDE], draws: vec![0] });
+        true
+    }
+}
+
+/// A host list begins (or was reset to begin again).
+pub(crate) fn begin(list: &ID3D12GraphicsCommandList) {
+    if on() {
+        with(|p| p.begin(list));
+    }
+}
+
+/// A draw or dispatch with `pso` bound is recorded into `list`; `name`
+/// names the pipeline by its shaders the first time it is seen.
+pub(crate) fn draw(list: &ID3D12GraphicsCommandList, pso: &ID3D12PipelineState, name: impl FnOnce() -> String) {
+    if !on() {
+        return;
+    }
+    with(|p| {
+        let at = list.as_raw() as usize;
+        if !p.open.contains_key(&at) && !p.begin(list) {
+            return;
+        }
+        let key = match p.keys.get(&(pso.as_raw() as usize)) {
+            Some(&(k, _)) => k,
+            None => {
+                let k = p.names.len() as u32;
+                p.names.push(name());
+                p.keys.insert(pso.as_raw() as usize, (k, pso.clone()));
+                k
+            }
+        };
+        let o = p.open.get_mut(&at).expect("just opened");
+        let last = o.keys.len() - 1;
+        if o.keys[last] == key || o.keys[last] == OVERFLOW {
+            o.draws[last] += 1;
+            return;
+        }
+        // Stamps used so far: keys.len(). This change takes one, the end one more.
+        if o.keys.len() as u32 + 2 > SLOTS {
+            // Out of stamps: the rest of the list is one span.
+            let slot = o.block * SLOTS + o.keys.len() as u32;
+            o.keys.push(OVERFLOW);
+            o.draws.push(1);
+            p.stamp(list, slot);
+            return;
+        }
+        let slot = o.block * SLOTS + o.keys.len() as u32;
+        o.keys.push(key);
+        o.draws.push(1);
+        p.stamp(list, slot);
+    });
+}
+
+/// The list closes: its last stamp, and all its stamps are resolved.
+pub(crate) fn end(list: &ID3D12GraphicsCommandList) {
+    if !on() {
+        return;
+    }
+    with(|p| {
+        let Some(o) = p.open.remove(&(list.as_raw() as usize)) else {
+            return;
+        };
+        let n = o.keys.len() as u32 + 1;
+        let base = o.block * SLOTS;
+        p.stamp(list, base + n - 1);
+        // SAFETY: an open list, our heap and read-back buffer, the block's own bytes.
+        unsafe {
+            list.ResolveQueryData(&p.heap, D3D12_QUERY_TYPE_TIMESTAMP, base, n, &p.back, u64::from(base) * 8);
+        }
+        p.pending.push_back((o, Instant::now()));
+    });
+}
+
+/// Once a frame: blocks old enough are read, and the report is logged
+/// every [`EVERY`].
+pub(crate) fn frame() {
+    if !on() {
+        return;
+    }
+    with(|p| {
+        p.agg.frame();
+        let now = Instant::now();
+        let cap = p.frequency;
+        while p.pending.front().is_some_and(|(_, at)| now.duration_since(*at) >= AFTER) {
+            let (o, _) = p.pending.pop_front().expect("front");
+            let n = o.keys.len() + 1;
+            // SAFETY: the block's stamps in the mapped read-back buffer;
+            // the card wrote them long ago or never.
+            let stamps: Vec<u64> = unsafe {
+                let ptr = (p.mapped as *mut u64).add((o.block * SLOTS) as usize);
+                let s = (0..n).map(|i| ptr.add(i).read_volatile()).collect();
+                std::ptr::write_bytes(ptr, 0, n);
+                s
+            };
+            p.agg.add_list(ListStamps { stamps: &stamps, keys: &o.keys, draws: &o.draws }, cap);
+            p.free.push(o.block);
+        }
+        if now.duration_since(p.since) >= EVERY {
+            let names = &p.names;
+            let report = p.agg.report(TOP, p.frequency, &|k| names.get(k as usize).cloned().unwrap_or_default());
+            tracing::info!(untimed_lists = p.untimed, "{report}");
+            p.agg = Agg::default();
+            p.since = now;
+        }
+    });
+}
+
+/// A host pipeline's name for the report: its stages and shader hashes.
+pub(crate) fn name(p: &crate::pipeline::host::HostPipeline) -> String {
+    let kind = if p.compute {
+        "compute"
+    } else if p.mesh {
+        "mesh"
+    } else {
+        "graphics"
+    };
+    let stages: Vec<String> = p.stages.iter().map(|s| format!("{} {}", s.shader.stage, s.shader.hash)).collect();
+    format!("{kind}: {}", stages.join(", "))
+}
diff --git a/crates/victory-gpu/src/gpuprof/agg.rs b/crates/victory-gpu/src/gpuprof/agg.rs
new file mode 100644
index 0000000..6da8c54
--- /dev/null
+++ b/crates/victory-gpu/src/gpuprof/agg.rs
@@ -0,0 +1,176 @@
+//! The sums behind `VICTORY_GPU_PROFILE`'s report: no host objects, so it
+//! is tested on its own (`rustc --test gpuprof/agg.rs`).
+
+use std::collections::HashMap;
+use std::fmt::Write as _;
+
+/// One timed list as read back: its timestamps (first where it began, one
+/// at each pipeline change, last where it ended) and, per span between two
+/// stamps, the pipeline key and the draws and dispatches in it.
+pub(crate) struct ListStamps<'a> {
+    pub(crate) stamps: &'a [u64],
+    pub(crate) keys: &'a [u32],
+    pub(crate) draws: &'a [u32],
+}
+
+/// Key of the span before a list's first pipeline (copies, barriers).
+pub(crate) const PRELUDE: u32 = u32::MAX;
+/// Key of what a list recorded after its stamps ran out.
+pub(crate) const OVERFLOW: u32 = u32::MAX - 1;
+
+#[derive(Default, Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Sum {
+    pub(crate) ticks: u64,
+    pub(crate) draws: u64,
+    pub(crate) groups: u64,
+}
+
+#[derive(Default)]
+pub(crate) struct Agg {
+    pub(crate) by_key: HashMap<u32, Sum>,
+    pub(crate) list_ticks: u64,
+    pub(crate) lists: u64,
+    /// Lists dropped: never ran, or stamps out of order.
+    pub(crate) unread: u64,
+    pub(crate) frames: u64,
+}
+
+/// Ticks between two stamps; 0 when the second is not after the first or
+/// the gap is beyond any frame's (`cap` ticks).
+pub(crate) fn span(begin: u64, end: u64, cap: u64) -> u64 {
+    if begin == 0 || end <= begin { 0 } else { (end - begin).min(cap) }
+}
+
+impl Agg {
+    /// Adds one list. `cap`: the most ticks one span may count (a second).
+    pub(crate) fn add_list(&mut self, l: ListStamps, cap: u64) {
+        let n = l.stamps.len();
+        if n < 2 || l.keys.len() != n - 1 || l.draws.len() != n - 1 || l.stamps[0] == 0 || l.stamps[n - 1] == 0 {
+            self.unread += 1;
+            return;
+        }
+        self.lists += 1;
+        self.list_ticks += span(l.stamps[0], l.stamps[n - 1], cap);
+        for i in 0..n - 1 {
+            let s = self.by_key.entry(l.keys[i]).or_default();
+            s.ticks += span(l.stamps[i], l.stamps[i + 1], cap);
+            s.draws += u64::from(l.draws[i]);
+            s.groups += 1;
+        }
+    }
+
+    pub(crate) fn frame(&mut self) {
+        self.frames += 1;
+    }
+
+    /// The `n` keys with most time, most first: (key, sum).
+    pub(crate) fn top(&self, n: usize) -> Vec<(u32, Sum)> {
+        let mut v: Vec<(u32, Sum)> = self.by_key.iter().map(|(&k, &s)| (k, s)).collect();
+        v.sort_by(|a, b| b.1.ticks.cmp(&a.1.ticks).then(a.0.cmp(&b.0)));
+        v.truncate(n);
+        v
+    }
+
+    /// The report: per frame, ms and draws of the top `n` pipelines.
+    pub(crate) fn report(&self, n: usize, frequency: u64, label: &dyn Fn(u32) -> String) -> String {
+        let frames = self.frames.max(1) as f64;
+        let ms = |t: u64| t as f64 * 1e3 / frequency.max(1) as f64 / frames;
+        let all: u64 = self.by_key.values().map(|s| s.ticks).sum();
+        let mut out = String::new();
+        let _ = writeln!(
+            out,
+            "GPU profile over {} frames: title lists {:.2} ms/frame ({:.1} lists/frame, {} unread), pipeline spans {:.2} ms/frame, {} pipelines",
+            self.frames,
+            ms(self.list_ticks),
+            self.lists as f64 / frames,
+            self.unread,
+            ms(all),
+            self.by_key.len()
+        );
+        for (i, (k, s)) in self.top(n).into_iter().enumerate() {
+            let name = match k {
+                PRELUDE => "(list start, before any pipeline)".to_owned(),
+                OVERFLOW => "(after the list's stamps ran out)".to_owned(),
+                k => label(k),
+            };
+            let _ = writeln!(
+                out,
+                "  #{:<2} {:>7.3} ms/frame {:>5.1}%  {:>7.1} draws/frame {:>6.1} groups/frame  {}",
+                i + 1,
+                ms(s.ticks),
+                if all == 0 { 0.0 } else { s.ticks as f64 * 100.0 / all as f64 },
+                s.draws as f64 / frames,
+                s.groups as f64 / frames,
+                name
+            );
+        }
+        out
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn list(stamps: &[u64], keys: &[u32], draws: &[u32]) -> ListStamps<'static> {
+        ListStamps {
+            stamps: Box::leak(stamps.to_vec().into_boxed_slice()),
+            keys: Box::leak(keys.to_vec().into_boxed_slice()),
+            draws: Box::leak(draws.to_vec().into_boxed_slice()),
+        }
+    }
+
+    #[test]
+    fn spans_go_to_their_pipeline_and_lists_to_the_total() {
+        let mut a = Agg::default();
+        a.add_list(list(&[100, 110, 150, 160], &[PRELUDE, 7, 9], &[0, 3, 1]), 1 << 40);
+        a.add_list(list(&[200, 240, 241], &[7, 9], &[2, 5]), 1 << 40);
+        a.frame();
+        assert_eq!(a.lists, 2);
+        assert_eq!(a.list_ticks, 60 + 41);
+        assert_eq!(a.by_key[&7], Sum { ticks: 40 + 40, draws: 5, groups: 2 });
+        assert_eq!(a.by_key[&9], Sum { ticks: 10 + 1, draws: 6, groups: 2 });
+        assert_eq!(a.by_key[&PRELUDE], Sum { ticks: 10, draws: 0, groups: 1 });
+        let top = a.top(2);
+        assert_eq!(top.iter().map(|t| t.0).collect::<Vec<_>>(), vec![7, 9]);
+    }
+
+    #[test]
+    fn lists_that_never_ran_or_are_malformed_are_not_counted() {
+        let mut a = Agg::default();
+        a.add_list(list(&[0, 0, 0], &[1, 2], &[1, 1]), 1000);
+        a.add_list(list(&[5, 9], &[1, 2], &[1, 1]), 1000);
+        a.add_list(list(&[5], &[], &[]), 1000);
+        assert_eq!((a.lists, a.unread), (0, 3));
+        assert!(a.by_key.is_empty());
+    }
+
+    #[test]
+    fn backwards_and_huge_spans_are_bounded() {
+        assert_eq!(span(10, 5, 100), 0);
+        assert_eq!(span(0, 5, 100), 0);
+        assert_eq!(span(1, u64::MAX, 100), 100);
+        let mut a = Agg::default();
+        a.add_list(list(&[10, 8, 20], &[1, 2], &[1, 1]), 1000);
+        assert_eq!(a.by_key[&1].ticks, 0);
+        assert_eq!(a.by_key[&2].ticks, 12);
+    }
+
+    #[test]
+    fn report_is_per_frame_and_names_the_top() {
+        let mut a = Agg::default();
+        // 1 MHz clock: 1 tick = 1 us.
+        for _ in 0..4 {
+            a.add_list(list(&[1_000, 9_000, 11_000], &[3, 4], &[10, 2]), 1 << 40);
+            a.frame();
+        }
+        let r = a.report(1, 1_000_000, &|k| format!("cs {k:016x}"));
+        let lines: Vec<&str> = r.lines().collect();
+        assert_eq!(lines.len(), 2);
+        assert!(lines[0].contains("title lists 10.00 ms/frame (1.0 lists/frame"), "{r}");
+        assert!(lines[1].contains("8.000 ms/frame"), "{r}");
+        assert!(lines[1].contains("10.0 draws/frame"), "{r}");
+        assert!(lines[1].contains("cs 0000000000000003"), "{r}");
+        assert!(lines[1].contains("80.0%"), "{r}");
+    }
+}
