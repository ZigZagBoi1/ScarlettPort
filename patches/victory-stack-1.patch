+        assert!(c.set(2, 101));
+        assert!(c.set(3, 101));
+        // A handle of 0 is a handle like any other once set.
+        assert!(c.set(0, 0));
+        assert!(!c.set(0, 0));
+        // Out of range: always recorded.
+        assert!(c.set(64, 1));
+        assert!(c.set(64, 1));
