index 0000000..c9cde5f
--- /dev/null
+++ b/crates/victory-core/src/overlay/preview.rs
@@ -0,0 +1,81 @@
+//! A software copy of the overlay's shader, for tests: draws a vertex list
+//! onto an RGBA picture the way the GPU does (the font atlas sampled with
+//! points, the premultiplied colour scaled by it, blended over what is
+//! there), so the pages can be looked at without a GPU.
+
+use std::path::Path;
+
+use super::font;
+use super::gui::Vertex;
+
+/// Draws `verts` (quads of six vertices, as `DrawList` makes them) over
+/// `px` (`size.0` by `size.1`, RGBA, opaque).
+pub fn rasterize(verts: &[Vertex], size: (u32, u32), px: &mut [u8]) {
+    let atlas = font::atlas();
+    for quad in verts.chunks_exact(6) {
+        let (a, c) = (quad[0], quad[2]);
+        let (x0, y0, x1, y1) = (a.pos[0], a.pos[1], c.pos[0], c.pos[1]);
+        let color = a.color;
+        let src = [
+            color & 0xFF,
+            color >> 8 & 0xFF,
+            color >> 16 & 0xFF,
+            color >> 24,
+        ]
+        .map(|b| b as f32 / 255.0);
+        for y in (y0.floor() as u32)..(y1.ceil() as u32).min(size.1) {
+            for x in (x0.floor() as u32)..(x1.ceil() as u32).min(size.0) {
+                let (cx, cy) = (x as f32 + 0.5, y as f32 + 0.5);
+                if cx < x0 || cx >= x1 || cy < y0 || cy >= y1 {
+                    continue;
+                }
+                let u = a.uv[0] + (cx - x0) / (x1 - x0) * (c.uv[0] - a.uv[0]);
+                let v = a.uv[1] + (cy - y0) / (y1 - y0) * (c.uv[1] - a.uv[1]);
+                let tx = ((u * font::ATLAS_W as f32) as u32).min(font::ATLAS_W - 1);
+                let ty = ((v * font::ATLAS_H as f32) as u32).min(font::ATLAS_H - 1);
+                let cover = atlas[(ty * font::ATLAS_W + tx) as usize] as f32 / 255.0;
+                let out = src.map(|s| s * cover);
+                let i = ((y * size.0 + x) * 4) as usize;
+                for k in 0..3 {
+                    let d = px[i + k] as f32 / 255.0;
+                    px[i + k] =
+                        ((out[k] + d * (1.0 - out[3])).clamp(0.0, 1.0) * 255.0).round() as u8;
+                }
+            }
+        }
+    }
+}
+
+/// Writes `px` (RGBA) as a binary PPM.
+pub fn write_ppm(path: &Path, size: (u32, u32), px: &[u8]) {
+    let mut out = format!("P6\n{} {}\n255\n", size.0, size.1).into_bytes();
+    for p in px.chunks_exact(4) {
+        out.extend_from_slice(&p[..3]);
+    }
+    std::fs::write(path, out).unwrap();
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::overlay::gui::{Color, DrawList, Rect};
+
+    #[test]
+    fn text_and_rectangles_land_where_they_were_drawn() {
+        let mut d = DrawList::default();
+        d.clear(Rect::new(0.0, 0.0, 64.0, 32.0));
+        d.rect(Rect::new(0.0, 0.0, 10.0, 10.0), Color(255, 0, 0, 255));
+        d.text(20.0, 4.0, "I", 2.0, Color(255, 255, 255, 255));
+        let mut px = vec![0u8; 64 * 32 * 4];
+        for p in px.chunks_exact_mut(4) {
+            p[3] = 255;
+        }
+        rasterize(&d.verts, (64, 32), &mut px);
+        let at = |x: usize, y: usize| &px[(y * 64 + x) * 4..(y * 64 + x) * 4 + 3];
+        assert_eq!(at(3, 3), &[255, 0, 0]);
+        assert_eq!(at(30, 20), &[0, 0, 0]);
+        // The stem of an `I` is its middle column: glyph column 2 of 5, scale 2.
+        assert_eq!(at(20 + 4, 4 + 2 * 2), &[255, 255, 255]);
+        assert_eq!(at(20 + 1, 4 + 2 * 2), &[0, 0, 0]);
+    }
+}
diff --git a/crates/victory-core/src/overlay/store.rs b/crates/victory-core/src/overlay/store.rs
new file mode 100644
index 0000000..2ec56c3
--- /dev/null
+++ b/crates/victory-core/src/overlay/store.rs
@@ -0,0 +1,670 @@
+//! What the overlay keeps: the settings it edits and how they are saved.
+//!
+//! Keys, mouse and controller settings go to `[controls]` of the config
+//! file (`victory.toml`), the window and the graph to `[display]` and the
+//! pacing switches to `[pace]`. The file is edited line by line, so its
+//! comments, its order and every other setting stay as the user left them;
+//! bindings go to the key map file (`VICTORY_KEYMAP`, else `keymap.txt`
+//! beside the config file) as the keys that differ from the defaults.
+//!
+//! Environment variables still win over the file at the next start.
+
+use std::path::{Path, PathBuf};
+
+use crate::kbm::Settings;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum WindowMode {
+    #[default]
+    Windowed,
+    /// A window without a frame the size of its monitor.
+    Borderless,
+}
+
+impl WindowMode {
+    pub fn name(self) -> &'static str {
+        match self {
+            WindowMode::Windowed => "windowed",
+            WindowMode::Borderless => "borderless",
+        }
+    }
+
+    pub fn parse(text: &str) -> Option<WindowMode> {
+        match text.trim().to_ascii_lowercase().as_str() {
+            "windowed" | "window" => Some(WindowMode::Windowed),
+            "borderless" | "fullscreen" => Some(WindowMode::Borderless),
+            _ => None,
+        }
+    }
+}
+
+/// `[display]`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Display {
+    pub window_mode: WindowMode,
+    /// The frame-time graph on screen while the menu is closed.
+    pub graph: bool,
+    /// Pixels to a font pixel (0: by the window's height).
+    pub ui_scale: u8,
+}
+
+impl Default for Display {
+    fn default() -> Display {
+        Display {
+            window_mode: WindowMode::Windowed,
+            graph: false,
+            ui_scale: 0,
+        }
+    }
+}
+
+impl Display {
+    /// `[display]` of the config file; what cannot be read is named in the
+    /// second result and left at its default.
+    pub fn parse(table: &toml::Table) -> (Display, Vec<String>) {
+        let mut d = Display::default();
+        let mut problems = Vec::new();
+        for (key, value) in table {
+            match (key.as_str(), value) {
+                ("window_mode", toml::Value::String(s)) => match WindowMode::parse(s) {
+                    Some(m) => d.window_mode = m,
+                    None => problems.push(format!(
+                        "[display] window_mode = \"{s}\": expected windowed or borderless"
+                    )),
+                },
+                ("fps_graph", toml::Value::Boolean(b)) => d.graph = *b,
+                ("ui_scale", toml::Value::Integer(n)) if (0..=6).contains(n) => {
+                    d.ui_scale = *n as u8
+                }
+                (k, _) => problems.push(format!("[display] {k}: not understood")),
+            }
+        }
+        (d, problems)
+    }
+}
+
+/// The frame caps the overlay offers: `None` is the title's own interval.
+pub const FRAME_CAPS: [Option<u32>; 8] = [
+    None,
+    Some(30),
+    Some(45),
+    Some(60),
+    Some(90),
+    Some(120),
+    Some(144),
+    Some(240),
+];
+
+/// `p` with the frame cap `cap` chosen. A cap is held by the pacer, so
+/// choosing one turns pacing on; "Title" leaves pacing as it was.
+pub fn with_frame_cap(mut p: PaceModel, cap: Option<u32>) -> PaceModel {
+    p.fps = cap;
+    if cap.is_some() {
+        p.pace = true;
+    }
+    p
+}
+
+/// The pacing switches as the overlay edits them (`victory_core::pace`).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct PaceModel {
+    pub pace: bool,
+    pub fps: Option<u32>,
+    pub input: bool,
+    pub latency: u32,
+    pub tearing: bool,
+    pub feedback: bool,
+}
+
+impl PaceModel {
+    /// The switches in force: the start-up ones with the live changes.
+    pub fn current() -> PaceModel {
+        let s = crate::pace::switches();
+        PaceModel {
+            pace: crate::pace::live_pace(),
+            fps: crate::pace::live_fps(),
+            input: crate::pace::live_input(),
+            latency: s.latency,
+            tearing: s.tearing,
+            feedback: s.feedback,
+        }
+    }
+
+    /// What the settings say at start, before any live change.
+    pub fn at_start() -> PaceModel {
+        let s = crate::pace::switches();
+        PaceModel {
+            pace: s.pace,
+            fps: s.fps,
+            input: s.input,
+            latency: s.latency,
+            tearing: s.tearing,
+            feedback: s.feedback,
+        }
+    }
+
+    /// Names of the settings that differ from `start` and need a restart.
+    pub fn restart_needed(&self, start: &PaceModel) -> Vec<&'static str> {
+        let mut v = Vec::new();
+        if self.latency != start.latency {
+            v.push("frame latency");
+        }
+        if self.tearing != start.tearing {
+            v.push("tearing");
+        }
+        if self.feedback != start.feedback {
+            v.push("display feedback");
+        }
+        v
+    }
+}
