@@ -0,0 +1,765 @@
+//! A small immediate-mode GUI: widgets are calls made every frame that draw
+//! and answer at once, and the result is a list of textured triangles for
+//! the renderer in `victory-gpu` (the font atlas of [`super::font`] is the
+//! only texture; rectangles sample its solid cell).
+//!
+//! Pure data and arithmetic, so the menu is tested (and its pictures drawn
+//! by `tools` in the tests) without a GPU.
+
+use std::collections::HashMap;
+
+use super::font;
+
+/// Most vertices one frame may hold; a list stops growing at it.
+pub const MAX_VERTS: usize = 49_152;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Rect {
+    pub x: f32,
+    pub y: f32,
+    pub w: f32,
+    pub h: f32,
+}
+
+impl Rect {
+    pub const fn new(x: f32, y: f32, w: f32, h: f32) -> Rect {
+        Rect { x, y, w, h }
+    }
+
+    pub fn right(&self) -> f32 {
+        self.x + self.w
+    }
+
+    pub fn bottom(&self) -> f32 {
+        self.y + self.h
+    }
+
+    pub fn contains(&self, (px, py): (f32, f32)) -> bool {
+        px >= self.x && px < self.right() && py >= self.y && py < self.bottom()
+    }
+
+    pub fn inset(&self, d: f32) -> Rect {
+        Rect::new(
+            self.x + d,
+            self.y + d,
+            (self.w - 2.0 * d).max(0.0),
+            (self.h - 2.0 * d).max(0.0),
+        )
+    }
+
+    pub fn intersect(&self, o: &Rect) -> Option<Rect> {
+        let (x0, y0) = (self.x.max(o.x), self.y.max(o.y));
+        let (x1, y1) = (self.right().min(o.right()), self.bottom().min(o.bottom()));
+        (x1 > x0 && y1 > y0).then(|| Rect::new(x0, y0, x1 - x0, y1 - y0))
+    }
+}
+
+/// Straight (not premultiplied) RGBA.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Color(pub u8, pub u8, pub u8, pub u8);
+
+impl Color {
+    pub fn with_alpha(self, a: u8) -> Color {
+        Color(self.0, self.1, self.2, a)
+    }
+
+    /// Premultiplied, as four bytes in memory order R, G, B, A.
+    pub fn packed(self) -> u32 {
+        let a = u32::from(self.3);
+        let p = |c: u8| (u32::from(c) * a + 127) / 255;
+        p(self.0) | p(self.1) << 8 | p(self.2) << 16 | a << 24
+    }
+
+    pub fn mix(self, o: Color, t: f32) -> Color {
+        let m = |a: u8, b: u8| (f32::from(a) + (f32::from(b) - f32::from(a)) * t).round() as u8;
+        Color(
+            m(self.0, o.0),
+            m(self.1, o.1),
+            m(self.2, o.2),
+            m(self.3, o.3),
+        )
+    }
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Vertex {
+    pub pos: [f32; 2],
+    pub uv: [f32; 2],
+    pub color: u32,
+}
+
+const _: () = assert!(size_of::<Vertex>() == 20);
+
+/// Triangles in pixels of the window (y down), clipped on the CPU to the
+/// current clip rectangle (scroll areas), six vertices a quad.
+pub struct DrawList {
+    pub verts: Vec<Vertex>,
+    clip: Rect,
+}
+
+impl Default for DrawList {
+    fn default() -> DrawList {
+        DrawList {
+            verts: Vec::new(),
+            clip: Rect::new(0.0, 0.0, f32::MAX / 4.0, f32::MAX / 4.0),
+        }
+    }
+}
+
+impl DrawList {
+    pub fn clear(&mut self, clip: Rect) {
+        self.verts.clear();
+        self.clip = clip;
+    }
+
+    pub fn clip(&self) -> Rect {
+        self.clip
+    }
+
+    pub fn set_clip(&mut self, clip: Rect) -> Rect {
+        std::mem::replace(&mut self.clip, clip)
+    }
+
+    /// A quad of `r` showing `uv` (texels of the atlas).
+    fn quad(&mut self, r: Rect, uv: Rect, c: Color) {
+        if c.3 == 0 || r.w <= 0.0 || r.h <= 0.0 || self.verts.len() + 6 > MAX_VERTS {
+            return;
+        }
+        let Some(v) = r.intersect(&self.clip) else {
+            return;
+        };
+        let (fx0, fy0) = ((v.x - r.x) / r.w, (v.y - r.y) / r.h);
+        let (fx1, fy1) = ((v.right() - r.x) / r.w, (v.bottom() - r.y) / r.h);
+        let (aw, ah) = (font::ATLAS_W as f32, font::ATLAS_H as f32);
+        let (u0, u1) = ((uv.x + uv.w * fx0) / aw, (uv.x + uv.w * fx1) / aw);
+        let (v0, v1) = ((uv.y + uv.h * fy0) / ah, (uv.y + uv.h * fy1) / ah);
+        let color = c.packed();
+        let p = |x: f32, y: f32, u: f32, w: f32| Vertex {
+            pos: [x, y],
+            uv: [u, w],
+            color,
+        };
+        let (a, b, c2, d) = (
+            p(v.x, v.y, u0, v0),
+            p(v.right(), v.y, u1, v0),
+            p(v.right(), v.bottom(), u1, v1),
+            p(v.x, v.bottom(), u0, v1),
+        );
+        self.verts.extend_from_slice(&[a, b, c2, a, c2, d]);
+    }
+
+    pub fn rect(&mut self, r: Rect, c: Color) {
+        let (sx, sy) = font::solid_cell();
+        self.quad(r, Rect::new(sx as f32 + 2.0, sy as f32 + 2.0, 4.0, 4.0), c);
+    }
+
+    /// The border of `r`, `t` pixels thick, inside it.
+    pub fn outline(&mut self, r: Rect, t: f32, c: Color) {
+        self.rect(Rect::new(r.x, r.y, r.w, t), c);
+        self.rect(Rect::new(r.x, r.bottom() - t, r.w, t), c);
+        self.rect(Rect::new(r.x, r.y + t, t, r.h - 2.0 * t), c);
+        self.rect(Rect::new(r.right() - t, r.y + t, t, r.h - 2.0 * t), c);
+    }
+
+    /// `text` with its top left at `x`, `y`, `scale` pixels to a font
+    /// pixel (whole numbers keep it sharp). Returns its width.
+    pub fn text(&mut self, x: f32, y: f32, text: &str, scale: f32, c: Color) -> f32 {
+        let mut pen = x;
+        for ch in text.chars() {
+            if ch != ' ' {
+                let (cx, cy) = font::cell_of(ch);
+                self.quad(
+                    Rect::new(pen, y, 5.0 * scale, 8.0 * scale),
+                    Rect::new(cx as f32, cy as f32, 5.0, 8.0),
+                    c,
+                );
+            }
+            pen += font::ADVANCE as f32 * scale;
+        }
+        pen - x
+    }
+}
+
+/// What the user did since the last frame.
+#[derive(Clone, Debug, Default)]
+pub struct Input {
+    /// The pointer, in pixels of the window.
+    pub mouse: (f32, f32),
+    pub left_down: bool,
+    pub left_pressed: bool,
+    pub left_released: bool,
+    pub right_pressed: bool,
+    /// Wheel steps, up positive.
+    pub wheel: f32,
+    /// Keys (virtual key codes; mouse buttons are keys 1, 2, 4, 5, 6) that
+    /// went down this frame.
+    pub keys_pressed: Vec<u8>,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct Theme {
+    pub dim: Color,
+    pub panel: Color,
+    pub bar: Color,
+    pub border: Color,
+    pub text: Color,
+    pub muted: Color,
+    pub button: Color,
+    pub hover: Color,
+    pub pressed: Color,
+    pub accent: Color,
+    pub good: Color,
+    pub warn: Color,
+    pub bad: Color,
+}
+
+impl Default for Theme {
+    fn default() -> Theme {
+        Theme {
+            dim: Color(0, 0, 0, 120),
+            panel: Color(18, 20, 26, 240),
+            bar: Color(30, 34, 44, 255),
+            border: Color(70, 78, 98, 255),
+            text: Color(232, 236, 244, 255),
+            muted: Color(140, 148, 166, 255),
+            button: Color(44, 50, 64, 255),
+            hover: Color(62, 72, 94, 255),
+            pressed: Color(36, 120, 200, 255),
+            accent: Color(36, 120, 200, 255),
+            good: Color(96, 200, 120, 255),
+            warn: Color(240, 180, 60, 255),
+            bad: Color(236, 90, 80, 255),
+        }
+    }
+}
+
+/// How a slider answered.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Moved {
+    /// The value changed this frame.
+    pub changed: bool,
+    /// The user let go of it: the change is final.
+    pub committed: bool,
+}
+
+fn hash(label: &str) -> u64 {
+    label.bytes().fold(0xcbf2_9ce4_8422_2325, |h, b| {
+        (h ^ u64::from(b)).wrapping_mul(0x100_0000_01b3)
+    })
+}
+
+/// Widgets and the state they keep between frames.
+pub struct Ui {
+    pub draw: DrawList,
+    pub theme: Theme,
+    /// Pixels to a font pixel.
+    pub scale: f32,
+    pub input: Input,
+    /// Nothing answers the pointer (a key is being waited for).
+    pub blocked: bool,
+    active: Option<u64>,
+    scroll: HashMap<u64, f32>,
+}
+
+impl Default for Ui {
+    fn default() -> Ui {
+        Ui {
+            draw: DrawList::default(),
+            theme: Theme::default(),
+            scale: 1.0,
+            input: Input::default(),
+            blocked: false,
+            active: None,
+            scroll: HashMap::new(),
+        }
+    }
+}
+
+impl Ui {
+    /// Starts a frame on a window of `size` pixels.
+    pub fn begin(&mut self, input: Input, scale: f32, size: (f32, f32)) {
+        self.input = input;
+        self.scale = scale;
+        self.blocked = false;
+        self.draw.clear(Rect::new(0.0, 0.0, size.0, size.1));
+        if !self.input.left_down && !self.input.left_released {
+            self.active = None;
+        }
+    }
+
+    /// A length of `n` font pixels.
+    pub fn u(&self, n: f32) -> f32 {
+        n * self.scale
+    }
+
+    pub fn hover(&self, r: Rect) -> bool {
+        !self.blocked && r.contains(self.input.mouse) && self.draw.clip().contains(self.input.mouse)
+    }
+
+    pub fn text(&mut self, x: f32, y: f32, text: &str, c: Color) -> f32 {
+        let s = self.scale;
+        self.draw.text(x, y, text, s, c)
+    }
+
+    /// `text` vertically centred in `r`, from its left (`align` 0), centre
+    /// (1) or right (2) edge.
+    pub fn text_in(&mut self, r: Rect, align: u8, text: &str, c: Color) {
+        let w = font::text_width(text, self.scale);
+        let x = match align {
+            0 => r.x,
+            1 => r.x + (r.w - w) / 2.0,
+            _ => r.right() - w,
+        };
+        let y = r.y + (r.h - 8.0 * self.scale) / 2.0;
+        self.text(x.floor(), y.floor(), text, c);
+    }
+
+    /// A button; true when it was clicked (pressed and released on it).
+    pub fn button(&mut self, id: &str, r: Rect, label: &str, selected: bool) -> bool {
+        let id = hash(id);
+        let hover = self.hover(r);
+        if hover && self.input.left_pressed {
+            self.active = Some(id);
+        }
+        let down = self.active == Some(id) && self.input.left_down && hover;
+        let t = self.theme;
+        let fill = if selected {
+            t.accent
+        } else if down {
+            t.pressed
+        } else if hover {
+            t.hover
+        } else {
+            t.button
+        };
+        self.draw.rect(r, fill);
+        self.draw.outline(
+            r,
+            1.0f32.max((self.scale / 2.0).floor()),
+            if hover { t.muted } else { t.border },
+        );
+        self.text_in(r, 1, label, t.text);
+        let clicked = self.input.left_released && self.active == Some(id) && hover;
+        if self.input.left_released && self.active == Some(id) {
+            self.active = None;
+        }
+        clicked
+    }
+
+    /// A row with `label` and an on/off switch; true when it was flipped.
+    pub fn toggle(&mut self, id: &str, r: Rect, label: &str, on: &mut bool) -> bool {
+        let sw = Rect::new(
+            r.right() - self.u(44.0),
+            r.y + self.u(1.0),
+            self.u(44.0),
+            r.h - self.u(2.0),
+        );
+        self.text_in(
+            Rect::new(r.x, r.y, r.w - self.u(50.0), r.h),
+            0,
+            label,
+            self.theme.text,
+        );
+        let flipped = self.button(id, sw, if *on { "ON" } else { "OFF" }, *on);
+        if flipped {
+            *on = !*on;
+        }
+        flipped
+    }
+
+    /// A row with `label` and one button for each of `options`; true when
+    /// another was chosen.
+    pub fn choice(
+        &mut self,
+        id: &str,
+        r: Rect,
+        label: &str,
+        options: &[&str],
+        chosen: &mut usize,
+    ) -> bool {
+        let widths: Vec<f32> = options
+            .iter()
+            .map(|o| font::text_width(o, self.scale) + self.u(12.0))
+            .collect();
+        let total: f32 =
+            widths.iter().sum::<f32>() + self.u(2.0) * options.len().saturating_sub(1) as f32;
+        self.text_in(
+            Rect::new(r.x, r.y, (r.w - total - self.u(6.0)).max(0.0), r.h),
+            0,
+            label,
+            self.theme.text,
+        );
+        let mut x = r.right() - total;
+        let mut picked = None;
+        for (i, o) in options.iter().enumerate() {
+            let b = Rect::new(x, r.y + self.u(1.0), widths[i], r.h - self.u(2.0));
+            if self.button(&format!("{id}#{i}"), b, o, i == *chosen) {
+                picked = Some(i);
+            }
+            x += widths[i] + self.u(2.0);
+        }
+        match picked {
+            Some(i) if i != *chosen => {
+                *chosen = i;
+                true
+            }
+            _ => false,
+        }
+    }
+
+    /// A row with `label`, a track dragged to set `value` between `lo` and
+    /// `hi` (in steps of `step`) and `shown` (its text) at the right.
+    pub fn slider(
+        &mut self,
+        id: &str,
+        r: Rect,
+        label: &str,
+        shown: &str,
+        value: &mut f32,
+        (lo, hi, step): (f32, f32, f32),
+    ) -> Moved {
+        let id = hash(id);
+        let t = self.theme;
+        let text_w = self.u(54.0);
+        let track = Rect::new(
+            r.x + r.w * 0.45,
+            r.y + (r.h - self.u(6.0)) / 2.0,
+            r.w * 0.55 - text_w - self.u(8.0),
+            self.u(6.0),
+        );
+        self.text_in(
+            Rect::new(r.x, r.y, r.w * 0.45 - self.u(6.0), r.h),
+            0,
+            label,
+            t.text,
+        );
+        self.text_in(
+            Rect::new(r.right() - text_w, r.y, text_w, r.h),
+            2,
+            shown,
+            t.muted,
+        );
+        let grab = Rect::new(track.x, r.y, track.w, r.h);
+        let hover = self.hover(grab);
+        if hover && self.input.left_pressed {
+            self.active = Some(id);
+        }
+        let mut moved = Moved::default();
+        if self.active == Some(id) && !self.blocked {
+            if self.input.left_down {
+                let f = ((self.input.mouse.0 - track.x) / track.w).clamp(0.0, 1.0);
+                let mut v = lo + f * (hi - lo);
+                if step > 0.0 {
+                    v = (lo + ((v - lo) / step).round() * step).clamp(lo, hi);
+                }
+                if (v - *value).abs() > f32::EPSILON {
+                    *value = v;
+                    moved.changed = true;
+                }
+            }
+            if self.input.left_released {
+                moved.committed = true;
+                self.active = None;
+            }
+        }
+        let f = if hi > lo {
+            ((*value - lo) / (hi - lo)).clamp(0.0, 1.0)
+        } else {
+            0.0
+        };
+        self.draw.rect(track, t.button);
+        self.draw
+            .rect(Rect::new(track.x, track.y, track.w * f, track.h), t.accent);
+        let knob = Rect::new(
+            track.x + track.w * f - self.u(2.0),
+            r.y + self.u(2.0),
+            self.u(4.0),
+            r.h - self.u(4.0),
+        );
+        self.draw.rect(
+            knob,
+            if hover || self.active == Some(id) {
+                t.text
+            } else {
+                t.muted
+            },
+        );
+        moved
+    }
+
+    /// Frame times in ms as bars, newest at the right, with guide lines at
+    /// `guides` ms; the top of the box is `top_ms`.
+    pub fn graph(&mut self, r: Rect, samples: &[f32], top_ms: f32, guides: &[f32]) {
+        let t = self.theme;
+        self.draw.rect(r, t.bar);
+        let n = samples.len();
+        if n > 0 {
+            let w = r.w / n as f32;
+            for (i, &ms) in samples.iter().enumerate() {
+                let h = (ms / top_ms).clamp(0.0, 1.0) * r.h;
+                let colour = if ms <= 17.5 {
+                    t.good
+                } else if ms <= 34.0 {
+                    t.warn
+                } else {
+                    t.bad
+                };
+                let x = (r.x + w * i as f32).floor();
+                let right = (r.x + w * (i + 1) as f32).floor().max(x + 1.0);
+                self.draw.rect(
+                    Rect::new(x, r.bottom() - h.max(1.0), right - x, h.max(1.0)),
+                    colour,
+                );
+            }
+        }
+        for &g in guides {
+            let y = r.bottom() - (g / top_ms).clamp(0.0, 1.0) * r.h;
+            self.draw
+                .rect(Rect::new(r.x, y.floor(), r.w, 1.0), t.muted.with_alpha(150));
+            let label = format!("{g:.1}");
+            self.text(
+                r.x + self.u(2.0),
+                (y - self.u(9.0)).max(r.y),
+                &label,
+                t.muted,
+            );
+        }
+        self.draw.outline(r, 1.0, t.border);
+    }
+
+    /// Starts a scrolling column in `r` whose content is `content_h`
+    /// tall: returns the clip it replaced and the scroll offset (move
+    /// content up by it). Draw the content, then call [`Ui::scroll_end`].
+    pub fn scroll_begin(&mut self, id: &str, r: Rect, content_h: f32, step: f32) -> (Rect, f32) {
+        let key = hash(id);
+        let range = (content_h - r.h).max(0.0);
+        let mut offset = *self.scroll.get(&key).unwrap_or(&0.0);
+        if self.hover(r) && self.input.wheel != 0.0 {
+            offset -= self.input.wheel * step;
+        }
+        offset = offset.clamp(0.0, range);
+        self.scroll.insert(key, offset);
+        let prev = self.draw.clip();
+        let clipped = prev.intersect(&r).unwrap_or_default();
+        self.draw.set_clip(clipped);
+        (prev, offset)
+    }
+
+    /// Ends a scrolling column: puts the clip back and draws the bar.
+    pub fn scroll_end(&mut self, (prev, offset): (Rect, f32), r: Rect, content_h: f32) {
+        self.draw.set_clip(prev);
+        if content_h > r.h + 0.5 {
+            let t = self.theme;
+            let track = Rect::new(r.right() - self.u(3.0), r.y, self.u(3.0), r.h);
+            self.draw.rect(track, t.button);
+            let thumb_h = (r.h / content_h * r.h).max(self.u(10.0));
+            let y = r.y + (r.h - thumb_h) * offset / (content_h - r.h);
+            self.draw
+                .rect(Rect::new(track.x, y, track.w, thumb_h), t.muted);
+        }
+    }
+
+    /// Sets a scroll offset (a page change goes back to the top).
+    pub fn scroll_to(&mut self, id: &str, offset: f32) {
+        self.scroll.insert(hash(id), offset);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn ui(input: Input) -> Ui {
+        let mut ui = Ui::default();
+        ui.begin(input, 2.0, (800.0, 600.0));
+        ui
+    }
+
+    fn click_at(x: f32, y: f32) -> (Input, Input) {
+        let at = |down, pressed, released| Input {
+            mouse: (x, y),
+            left_down: down,
+            left_pressed: pressed,
+            left_released: released,
+            ..Default::default()
+        };
+        (at(true, true, false), at(false, false, true))
+    }
+
+    #[test]
+    fn colours_are_premultiplied() {
+        assert_eq!(Color(255, 128, 0, 255).packed(), 0xFF00_80FF);
+        assert_eq!(Color(200, 200, 200, 0).packed(), 0);
+        let half = Color(255, 255, 255, 128).packed();
+        assert_eq!(half >> 24, 128);
+        assert_eq!(half & 0xFF, 128);
+    }
+
+    #[test]
+    fn a_quad_is_clipped_with_its_texture_coordinates() {
+        let mut d = DrawList::default();
+        d.clear(Rect::new(0.0, 0.0, 10.0, 10.0));
+        d.text(5.0, 0.0, "H", 2.0, Color(255, 255, 255, 255));
+        // The glyph is 10 wide and 16 tall at scale 2; half of it shows.
+        assert_eq!(d.verts.len(), 6);
+        let right = d.verts.iter().map(|v| v.pos[0]).fold(0.0, f32::max);
+        assert_eq!(right, 10.0);
+        let (cx, _) = font::cell_of('H');
+        let u_max = d.verts.iter().map(|v| v.uv[0]).fold(0.0, f32::max);
+        assert!((u_max - (cx as f32 + 2.5) / font::ATLAS_W as f32).abs() < 1e-6);
+        // Wholly outside: nothing.
+        let mut d = DrawList::default();
+        d.clear(Rect::new(0.0, 0.0, 10.0, 10.0));
+        d.rect(Rect::new(20.0, 20.0, 5.0, 5.0), Color(1, 2, 3, 255));
+        assert!(d.verts.is_empty());
+    }
+
+    #[test]
+    fn a_list_stops_at_its_limit() {
+        let mut d = DrawList::default();
+        for _ in 0..MAX_VERTS {
+            d.rect(Rect::new(0.0, 0.0, 1.0, 1.0), Color(1, 1, 1, 255));
+        }
+        assert!(d.verts.len() <= MAX_VERTS);
+        assert_eq!(d.verts.len() % 6, 0);
+    }
+
+    #[test]
+    fn a_button_clicks_on_release_over_it_only() {
+        let r = Rect::new(10.0, 10.0, 100.0, 30.0);
+        let (down, up) = click_at(20.0, 20.0);
+        let mut u = Ui::default();
+        u.begin(down, 2.0, (800.0, 600.0));
+        assert!(!u.button("b", r, "Go", false));
+        u.begin(up.clone(), 2.0, (800.0, 600.0));
+        assert!(u.button("b", r, "Go", false));
+        // Pressed on it, let go elsewhere: no click.
+        let (down, _) = click_at(20.0, 20.0);
+        u.begin(down, 2.0, (800.0, 600.0));
+        u.button("b", r, "Go", false);
+        let away = Input {
+            mouse: (400.0, 400.0),
+            left_released: true,
+            ..Default::default()
+        };
+        u.begin(away, 2.0, (800.0, 600.0));
+        assert!(!u.button("b", r, "Go", false));
+        // Blocked (waiting for a key): nothing answers.
+        let (down, up) = click_at(20.0, 20.0);
+        let mut u = Ui::default();
+        u.begin(down, 2.0, (800.0, 600.0));
+        u.blocked = true;
+        u.button("b", r, "Go", false);
+        u.begin(up, 2.0, (800.0, 600.0));
+        u.blocked = true;
+        assert!(!u.button("b", r, "Go", false));
+    }
+
+    #[test]
+    fn a_toggle_flips_and_a_choice_picks() {
+        let r = Rect::new(0.0, 0.0, 400.0, 30.0);
+        let mut on = false;
+        let (down, up) = click_at(400.0 - 20.0, 15.0);
+        let mut u = Ui::default();
+        u.begin(down, 2.0, (800.0, 600.0));
+        assert!(!u.toggle("t", r, "Thing", &mut on));
+        u.begin(up, 2.0, (800.0, 600.0));
+        assert!(u.toggle("t", r, "Thing", &mut on));
+        assert!(on);
+        // The last of three options sits at the right edge.
+        let mut chosen = 0;
+        let (down, up) = click_at(400.0 - 10.0, 15.0);
+        u.begin(down, 2.0, (800.0, 600.0));
+        u.choice("c", r, "Mode", &["A", "B", "C"], &mut chosen);
+        u.begin(up, 2.0, (800.0, 600.0));
+        assert!(u.choice("c", r, "Mode", &["A", "B", "C"], &mut chosen));
+        assert_eq!(chosen, 2);
+    }
+
+    #[test]
+    fn a_slider_follows_the_pointer_in_steps_and_commits_on_release() {
+        let r = Rect::new(0.0, 0.0, 400.0, 30.0);
+        let mut v = 1.0;
+        let mut u = Ui::default();
+        // The track runs from 45% of the row to the value text.
+        let track_x = 400.0 * 0.45;
+        let track_w = 400.0 * 0.55 - 2.0 * 54.0 - 16.0;
+        let press = Input {
+            mouse: (track_x + track_w * 0.5, 15.0),
+            left_down: true,
+            left_pressed: true,
+            ..Default::default()
+        };
+        u.begin(press, 2.0, (800.0, 600.0));
+        let m = u.slider("s", r, "Sens", "x", &mut v, (0.0, 2.0, 0.1));
+        assert!(!m.committed);
+        assert!(m.changed || (v - 1.0).abs() < 1e-6);
+        assert!((v - 1.0).abs() < 0.11, "{v}");
+        let drag = Input {
+            mouse: (track_x + track_w * 2.0, 15.0),
+            left_down: true,
+            ..Default::default()
+        };
+        u.begin(drag, 2.0, (800.0, 600.0));
+        let m = u.slider("s", r, "Sens", "x", &mut v, (0.0, 2.0, 0.1));
+        assert!(m.changed);
+        assert_eq!(v, 2.0, "clamped to the end");
+        let release = Input {
+            mouse: (0.0, 15.0),
+            left_released: true,
+            ..Default::default()
+        };
+        u.begin(release, 2.0, (800.0, 600.0));
+        let m = u.slider("s", r, "Sens", "x", &mut v, (0.0, 2.0, 0.1));
+        assert!(m.committed);
+    }
+
+    #[test]
+    fn a_scroll_area_scrolls_within_its_range_and_clips() {
+        let r = Rect::new(0.0, 0.0, 100.0, 100.0);
+        let mut u = ui(Input {
+            mouse: (50.0, 50.0),
+            wheel: -2.0,
+            ..Default::default()
+        });
+        let (prev, off) = u.scroll_begin("s", r, 300.0, 20.0);
+        assert_eq!(off, 40.0);
+        u.draw
+            .rect(Rect::new(0.0, 0.0, 100.0, 500.0), Color(1, 1, 1, 255));
+        assert!(u.draw.verts.iter().all(|v| v.pos[1] <= 100.0));
+        u.scroll_end((prev, off), r, 300.0);
+        // Scrolling past the end stops at it.
+        let mut u2 = Ui::default();
+        for _ in 0..20 {
+            u2.begin(
+                Input {
+                    mouse: (50.0, 50.0),
+                    wheel: -5.0,
+                    ..Default::default()
+                },
+                2.0,
+                (800.0, 600.0),
+            );
+            let s = u2.scroll_begin("s", r, 300.0, 20.0);
+            u2.scroll_end(s, r, 300.0);
+        }
+        u2.begin(
+            Input {
+                mouse: (50.0, 50.0),
+                ..Default::default()
+            },
+            2.0,
+            (800.0, 600.0),
+        );
+        let (_, off) = u2.scroll_begin("s", r, 300.0, 20.0);
+        assert_eq!(off, 200.0);
+        // The pointer elsewhere: no scrolling.
+        let mut u3 = ui(Input {
+            mouse: (500.0, 500.0),
+            wheel: -3.0,
+            ..Default::default()
+        });
+        assert_eq!(u3.scroll_begin("s", r, 300.0, 20.0).1, 0.0);
+    }
+}
diff --git a/crates/victory-core/src/overlay/menu.rs b/crates/victory-core/src/overlay/menu.rs
new file mode 100644
index 0000000..5721019
--- /dev/null
+++ b/crates/victory-core/src/overlay/menu.rs
@@ -0,0 +1,1531 @@
+//! The settings menu: three pages (controls, display, performance) drawn
+//! with [`super::gui`] over the game, and the hud graph shown while it is
+//! closed. Everything it changes is in [`Model`]; what a frame decided is
+//! handed back as [`Effects`] for the caller to apply and save.
+
+use super::font;
+use super::gui::{Color, DrawList, Input, Moved, Rect, Ui};
+use super::perf::{self, Change, Perf, SysInfo, switch_rows};
+use crate::hints::Hint;
+use super::store::{Display, Model, PaceModel, UpscaleModel, WindowMode};
+use crate::upscale::{Quality, Upscaler};
+use crate::kbm::{Output, Settings, WHEEL_DOWN, WHEEL_UP, key_name};
+
+/// What the menu needs to know about the world this frame.
+pub struct Ctx<'a> {
+    /// The window's client size, pixels.
+    pub size: (f32, f32),
+    pub perf: &'a Perf,
+    pub sys: &'a SysInfo,
+    /// Environment lookup (`VICTORY_*`).
+    pub env: &'a dyn Fn(&str) -> Option<String>,
+    /// Milliseconds on any steady clock (for blinking).
+    pub now_ms: u64,
+}
+
+/// What a frame decided.
+#[derive(Default, Debug)]
+pub struct Effects {
+    /// New control settings, to take effect now.
+    pub controls: Option<Settings>,
+    pub display: Option<Display>,
+    pub pace: Option<PaceModel>,
+    pub upscale: Option<UpscaleModel>,
+    /// Something was set for good: write the files.
+    pub save: bool,
+    /// Close the menu.
+    pub close: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Page {
+    Controls,
+    Display,
+    Performance,
+}
+
+const PAGES: [(Page, &str); 3] = [
+    (Page::Controls, "Controls"),
+    (Page::Display, "Display"),
+    (Page::Performance, "Performance"),
+];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Layer {
+    Foot,
+    Vehicle,
+}
+
+/// A binding waiting for its key.
+#[derive(Clone, Copy, Debug)]
+struct Capture {
+    out: Output,
+    /// The key the box held (None: an empty box).
+    old: Option<u8>,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Tone {
+    Good,
+    Warn,
+    Bad,
+}
+
+const SLOTS: usize = 3;
+
+pub struct Menu {
+    pub model: Model,
+    start_pace: PaceModel,
+    start_upscale: UpscaleModel,
+    /// Keyboard and mouse play is on (the bindings do something).
+    kbm_on: bool,
+    ui: Ui,
+    page: Page,
+    layer: Layer,
+    capture: Option<Capture>,
+    status: Option<(String, Tone)>,
+    armed: bool,
+    /// Each page's content height as last drawn (its scroll range).
+    heights: [f32; 3],
+}
+
+/// Whether a key can be bound: not the ones the menu keeps for itself
+/// (Esc, Delete, F1), the generic modifiers (only left and right ones are
+/// reported) and the Windows keys.
+pub fn bindable(vk: u8) -> bool {
+    matches!(vk, 0x01 | 0x02 | 0x04 | 0x05 | 0x06 | 0x08..=0xFE)
+        && !matches!(vk, 0x10..=0x12 | 0x1B | 0x2E | 0x5B | 0x5C | 0x70)
+}
+
+fn num(v: f32, places: usize) -> String {
+    format!("{v:.places$}")
+}
+
+impl Menu {
+    pub fn new(model: Model, start_pace: PaceModel, kbm_on: bool) -> Menu {
+        Menu {
+            model,
+            start_pace,
+            start_upscale: UpscaleModel::at_start(),
+            kbm_on,
+            ui: Ui::default(),
+            page: Page::Controls,
+            layer: Layer::Foot,
+            capture: None,
+            status: None,
+            armed: false,
+            heights: [0.0; 3],
+        }
+    }
+
+    /// The triangles of the last frame.
+    pub fn draw_list(&self) -> &DrawList {
+        &self.ui.draw
+    }
+
+    pub fn waiting_for_key(&self) -> bool {
+        self.capture.is_some()
+    }
+
+    /// Gives up a binding that waits for a key (the menu was closed).
+    pub fn cancel_capture(&mut self) {
+        self.capture = None;
+    }
+
+    pub fn restart_needed(&self) -> Vec<&'static str> {
+        let mut v = self.model.pace.restart_needed(&self.start_pace);
+        v.extend(self.model.upscale.restart_needed(&self.start_upscale));
+        v
+    }
+
+    fn scale(&self, size: (f32, f32)) -> f32 {
+        match self.model.display.ui_scale {
+            0 => (size.1 / 540.0).round().clamp(1.0, 6.0),
+            n => f32::from(n),
+        }
+    }
+
+    /// The hud: a small graph in a corner, while the menu is closed.
+    pub fn hud(&mut self, ctx: &Ctx) {
+        self.hud_with(ctx, None);
+    }
+
+    /// The graph (when on) and the keyboard hints (when given) over the game.
+    pub fn hud_with(&mut self, ctx: &Ctx, hints: Option<&[Hint]>) {
+        let scale = self.scale(ctx.size);
+        self.ui.begin(Input::default(), scale, ctx.size);
+        if self.model.display.graph {
+            self.graph_hud(ctx);
+        }
+        if let Some(h) = hints {
+            self.hints_hud(ctx, h);
+        }
+    }
+
+    /// The legend in the bottom left corner: one chip per button, wrapped
+    /// to the window's width.
+    fn hints_hud(&mut self, ctx: &Ctx, hints: &[Hint]) {
+        let ui = &mut self.ui;
+        let t = ui.theme;
+        let (m, pad, gap, row_h) = (ui.u(6.0), ui.u(3.0), ui.u(4.0), ui.u(13.0));
+        let max_w = (ctx.size.0 - 2.0 * m).max(ui.u(40.0));
+        let chips: Vec<(String, f32)> = hints
+            .iter()
+            .map(|h| {
+                let text = format!("{} {}", h.button, h.keys);
+                let w = font::text_width(&text, ui.scale) + 2.0 * pad;
+                (text, w)
+            })
+            .collect();
+        let mut rows: Vec<Vec<usize>> = vec![Vec::new()];
+        let mut used = 0.0;
+        for (i, (_, w)) in chips.iter().enumerate() {
+            if used > 0.0 && used + gap + w > max_w {
+                rows.push(Vec::new());
+                used = 0.0;
+            }
+            used += if used > 0.0 { gap + w } else { *w };
+            rows.last_mut().unwrap().push(i);
+        }
+        let total_h = rows.len() as f32 * (row_h + gap) - gap;
+        let mut y = (ctx.size.1 - m - total_h).max(0.0);
+        for row in rows {
+            let mut x = m;
+            for i in row {
+                let (text, w) = &chips[i];
+                ui.draw.rect(Rect::new(x, y, *w, row_h), t.dim.with_alpha(190));
+                ui.text(x + pad, y + ui.u(3.0), text, t.text);
+                x += w + gap;
+            }
+            y += row_h + gap;
+        }
+    }
+
+    fn graph_hud(&mut self, ctx: &Ctx) {
+        let ui = &mut self.ui;
+        let t = ui.theme;
+        let (m, w, h) = (ui.u(6.0), ui.u(132.0), ui.u(48.0));
+        let r = Rect::new(m, m, w, h);
+        ui.draw.rect(r, t.dim.with_alpha(170));
+        let line = format!("{:.0} fps  {:.1} ms", ctx.perf.fps(), ctx.perf.frame_ms());
+        ui.text(r.x + ui.u(4.0), r.y + ui.u(3.0), &line, t.text);
+        let g = Rect::new(
+            r.x + ui.u(4.0),
+            r.y + ui.u(15.0),
+            w - ui.u(8.0),
+            h - ui.u(19.0),
+        );
+        let samples = ctx.perf.samples(120);
+        ui.graph(g, &samples, 50.0, &[]);
+    }
+
+    /// One frame of the open menu.
+    pub fn frame(&mut self, ctx: &Ctx, input: Input) -> Effects {
+        let mut fx = Effects::default();
+        let keys = input.keys_pressed.clone();
+        let wheel = input.wheel;
+        let scale = self.scale(ctx.size);
+        self.ui.begin(input, scale, ctx.size);
+        self.ui.blocked = self.capture.is_some();
+        self.keys(&keys, wheel, &mut fx);
+        // A binding just made is not drawn as waiting.
+        self.ui.blocked = self.capture.is_some();
+
+        let t = self.ui.theme;
+        let size = ctx.size;
+        let u = |n: f32| n * scale;
+        let full = Rect::new(0.0, 0.0, size.0, size.1);
+        self.ui.draw.rect(full, t.dim);
+        let pw = (size.0 - u(16.0)).min(u(640.0));
+        let ph = (size.1 - u(16.0)).min(u(420.0));
+        let panel = Rect::new(
+            ((size.0 - pw) / 2.0).floor(),
+            ((size.1 - ph) / 2.0).floor(),
+            pw,
+            ph,
+        );
+        self.ui.draw.rect(panel, t.panel);
+        self.ui
+            .draw
+            .outline(panel, 1.0f32.max((scale / 2.0).floor()), t.border);
+        let bar = Rect::new(panel.x, panel.y, panel.w, u(18.0));
+        self.ui.draw.rect(bar, t.bar);
+        self.ui.text_in(
+            Rect::new(bar.x + u(6.0), bar.y, bar.w, bar.h),
+            0,
+            "VIctory settings",
+            t.text,
+        );
+        self.ui.text_in(
+            Rect::new(bar.x, bar.y, bar.w - u(6.0), bar.h),
+            2,
+            "F1 or Esc closes",
+            t.muted,
+        );
+
+        // Tabs.
+        let mut x = panel.x + u(8.0);
+        let ty = bar.bottom() + u(5.0);
+        for (page, name) in PAGES {
+            let r = Rect::new(x, ty, u(100.0), u(16.0));
+            if self
+                .ui
+                .button(&format!("tab {name}"), r, name, self.page == page)
+                && self.page != page
+            {
+                self.page = page;
+                self.armed = false;
+                self.ui.scroll_to("page", 0.0);
+            }
+            x += u(104.0);
+        }
+
+        let footer_h = u(30.0);
+        let content = Rect::new(
+            panel.x + u(8.0),
+            ty + u(22.0),
+            panel.w - u(16.0),
+            panel.bottom() - footer_h - (ty + u(22.0)) - u(4.0),
+        );
+        let index = PAGES.iter().position(|(p, _)| *p == self.page).unwrap_or(0);
+        let height = self.heights[index];
+        let scroll = self.ui.scroll_begin("page", content, height, u(24.0));
+        let mut body = Body {
+            x: content.x,
+            y: content.y - scroll.1,
+            w: content.w - u(8.0),
+            start: content.y - scroll.1,
+        };
+        match self.page {
+            Page::Controls => self.page_controls(&mut body, &mut fx),
+            Page::Display => self.page_display(&mut body, ctx, &mut fx),
+            Page::Performance => self.page_performance(&mut body, ctx),
+        }
+        self.heights[index] = body.y - body.start + u(4.0);
+        self.ui.scroll_end(scroll, content, self.heights[index]);
+
+        self.footer(panel, footer_h, &mut fx);
+        fx
+    }
+
+    /// Keys and the wheel: a binding waits for one, Esc closes.
+    fn keys(&mut self, keys: &[u8], wheel: f32, fx: &mut Effects) {
+        let Some(cap) = self.capture else {
+            if keys.contains(&0x1B) {
+                fx.close = true;
+            }
+            return;
+        };
+        if keys.contains(&0x1B) {
+            self.capture = None;
+            self.status = Some(("Binding cancelled.".into(), Tone::Warn));
+            return;
+        }
+        let new = if keys.contains(&0x2E) {
+            Some(None)
+        } else if wheel != 0.0 {
+            Some(Some(if wheel > 0.0 { WHEEL_UP } else { WHEEL_DOWN }))
+        } else {
+            keys.iter().copied().find(|&k| bindable(k)).map(Some)
+        };
+        let Some(new) = new else { return };
+        self.capture = None;
+        let layout = match self.layer {
+            Layer::Foot => &mut self.model.controls.on_foot,
+            Layer::Vehicle => &mut self.model.controls.vehicle,
+        };
+        let lost = layout.rebind(cap.out, cap.old, new);
+        self.status = Some(match new {
+            Some(k) => {
+                let mut text = format!("{} now does: {}.", key_name(k), cap.out.label());
+                if !lost.is_empty() {
+                    let names: Vec<&str> = lost.iter().map(|o| o.label()).collect();
+                    text.push_str(&format!(" It no longer does: {}.", names.join(", ")));
+                }
+                (text, Tone::Good)
+            }
+            None => (
+                format!("Cleared a key of: {}.", cap.out.label()),
+                Tone::Good,
+            ),
+        });
+        fx.controls = Some(self.model.controls.clone());
+        fx.save = true;
+    }
+
+    fn row(&self, body: &mut Body, h: f32) -> Rect {
+        let r = Rect::new(body.x, body.y, body.w, h);
+        body.y += h;
+        r
+    }
+
+    fn heading(&mut self, body: &mut Body, text: &str) {
+        let u = self.ui.scale;
+        body.y += 4.0 * u;
+        let r = self.row(body, 14.0 * u);
+        let t = self.ui.theme;
+        self.ui.text_in(r, 0, text, t.warn);
+        self.ui.draw.rect(
+            Rect::new(r.x, r.bottom() - u, r.w, 1.0f32.max(u / 2.0)),
+            t.border,
+        );
+    }
+
+    fn note(&mut self, body: &mut Body, text: &str, tone: Color) {
+        let u = self.ui.scale;
+        let r = self.row(body, 12.0 * u);
+        self.ui.text_in(r, 0, text, tone);
+    }
+
+    fn page_controls(&mut self, body: &mut Body, fx: &mut Effects) {
+        let u = self.ui.scale;
+        let muted = self.ui.theme.muted;
+        let warn = self.ui.theme.warn;
+        let row_h = 16.0 * u;
+        let mut changed = false;
+        let mut committed = false;
+        if !self.kbm_on {
+            self.note(
+                body,
+                "Keyboard and mouse play is off (VICTORY_KBM=0); changes are saved, not used.",
+                warn,
+            );
+        }
+        self.heading(body, "Mouse and controller");
+        {
+            let c = &mut self.model.controls;
+            let ui = &mut self.ui;
+            let mut moved = [Moved::default(); 4];
+            moved[0] = slider_row(
+                ui,
+                body,
+                row_h,
+                "sens",
+                "Mouse sensitivity",
+                &mut c.sensitivity,
+                (0.1, 5.0, 0.05),
+            );
+            moved[1] = slider_row(
+                ui,
+                body,
+                row_h,
+                "ysens",
+                "Vertical sensitivity",
+                &mut c.y_scale,
+                (0.25, 3.0, 0.05),
+            );
+            let r = Rect::new(body.x, body.y, body.w, row_h);
+            body.y += row_h;
+            if ui.toggle("invert", r, "Invert vertical look", &mut c.invert_y) {
+                changed = true;
+                committed = true;
+            }
+            moved[2] = slider_row(
+                ui,
+                body,
+                row_h,
+                "walk",
+                "Walk speed (Walk key)",
+                &mut c.walk_speed,
+                (0.1, 1.0, 0.05),
+            );
+            moved[3] = slider_row(
+                ui,
+                body,
+                row_h,
+                "dz",
+                "Controller dead zone",
+                &mut c.pad_deadzone,
+                (0.0, 0.5, 0.01),
+            );
+            for m in moved {
+                changed |= m.changed;
+                committed |= m.committed;
+            }
+        }
+        if changed || committed {
+            fx.controls = Some(self.model.controls.clone());
+            fx.save |= committed;
+        }
+
+        self.heading(body, "Key bindings");
+        {
+            let r = self.row(body, row_h);
+            let mut layer = usize::from(self.layer == Layer::Vehicle);
+            if self.ui.choice(
+                "layer",
+                r,
+                "Layout (G switches in game)",
+                &["On foot", "Vehicle"],
+                &mut layer,
+            ) {
+                self.layer = if layer == 0 {
+                    Layer::Foot
+                } else {
+                    Layer::Vehicle
+                };
+            }
+        }
+        self.note(
+            body,
+            "Click a box, then press the new key or mouse button. Esc cancels, Delete clears.",
+            muted,
+        );
+        let layout = match self.layer {
+            Layer::Foot => self.model.controls.on_foot.clone(),
+            Layer::Vehicle => self.model.controls.vehicle.clone(),
+        };
+        let slot_w = 100.0 * u;
+        let gap = 4.0 * u;
+        for out in Output::all() {
+            let r = self.row(body, row_h);
+            let keys = layout.keys_of(out);
+            let label_w = r.w - SLOTS as f32 * (slot_w + gap);
+            let text = self.ui.theme.text;
+            self.ui
+                .text_in(Rect::new(r.x, r.y, label_w, r.h), 0, out.label(), text);
+            for slot in 0..SLOTS {
+                let b = Rect::new(
+                    r.x + label_w + slot as f32 * (slot_w + gap),
+                    r.y + u * 1.0,
+                    slot_w,
+                    r.h - 2.0 * u,
+                );
+                let key = keys.get(slot).copied();
+                let waiting = self.capture.is_some_and(|c| {
+                    c.out == out
+                        && match c.old {
+                            Some(k) => key == Some(k),
+                            None => key.is_none() && slot == keys.len().min(SLOTS - 1),
+                        }
+                });
+                let label = if waiting {
+                    "press a key".to_string()
+                } else {
+                    key.map_or_else(|| "-".to_string(), key_name)
+                };
+                // Keys past the last box are kept, not shown.
+                let extra = slot == SLOTS - 1 && keys.len() > SLOTS;
+                let label = if extra {
+                    format!("{label} +{}", keys.len() - SLOTS)
+                } else {
+                    label
+                };
+                if self
+                    .ui
+                    .button(&format!("slot {} {slot}", out.name()), b, &label, waiting)
+                    && self.capture.is_none()
+                {
+                    self.capture = Some(Capture { out, old: key });
+                    self.status = None;
+                }
+            }
+        }
+    }
+
+    fn page_display(&mut self, body: &mut Body, ctx: &Ctx, fx: &mut Effects) {
+        let u = self.ui.scale;
+        let row_h = 16.0 * u;
+        let (muted, warn) = (self.ui.theme.muted, self.ui.theme.warn);
+        let env = |name: &str| (ctx.env)(name).is_some();
+        let mut display = self.model.display;
+        let mut pace = self.model.pace;
+        let (mut d_changed, mut p_changed) = (false, false);
+
+        self.heading(body, "Window");
+        let r = self.row(body, row_h);
+        let mut mode = usize::from(display.window_mode == WindowMode::Borderless);
+        if self.ui.choice(
+            "mode",
+            r,
+            "Window mode",
+            &["Windowed", "Borderless"],
+            &mut mode,
+        ) {
+            display.window_mode = if mode == 0 {
+                WindowMode::Windowed
+            } else {
+                WindowMode::Borderless
+            };
+            d_changed = true;
+        }
+        let r = self.row(body, row_h);
+        let mut scale = usize::from(display.ui_scale).min(6);
+        if self.ui.choice(
+            "scale",
+            r,
+            "Interface size",
+            &["Auto", "1", "2", "3", "4"],
+            &mut scale,
+        ) {
+            display.ui_scale = scale as u8;
+            d_changed = true;
+        }
+        let r = self.row(body, row_h);
+        if self.ui.toggle(
+            "graph",
+            r,
+            "Frame-time graph on screen (menu closed)",
+            &mut display.graph,
+        ) {
+            d_changed = true;
+        }
+
+        self.heading(body, "Frame pacing (VICTORY_PACE*)");
+        let tag = |name: &str, restart: bool| {
+            let mut t = if restart { " [restart]" } else { " [live]" }.to_string();
+            if env(name) {
+                t.push_str(" [env]");
+            }
+            t
+        };
+        let r = self.row(body, row_h);
+        if self.ui.toggle(
+            "pace",
+            r,
+            &format!("Even frame pacing{}", tag("VICTORY_PACE", false)),
+            &mut pace.pace,
+        ) {
+            p_changed = true;
+        }
+        let r = self.row(body, row_h);
+        let rates = super::store::FRAME_CAPS;
+        let mut rate = rates.iter().position(|x| *x == pace.fps).unwrap_or(0);
+        if self.ui.choice(
+            "fps",
+            r,
+            &format!("Frame cap{}", tag("VICTORY_PACE_FPS", false)),
+            &["Title", "30", "45", "60", "90", "120", "144", "240"],
+            &mut rate,
+        ) {
+            pace = super::store::with_frame_cap(pace, rates[rate]);
+            p_changed = true;
+        }
+        let r = self.row(body, row_h);
+        if self.ui.toggle(
+            "input",
+            r,
+            &format!("Read input late{}", tag("VICTORY_PACE_INPUT", false)),
+            &mut pace.input,
+        ) {
+            p_changed = true;
+        }
+        let r = self.row(body, row_h);
+        let mut latency = pace.latency.min(2) as usize;
+        if self.ui.choice(
+            "latency",
+            r,
+            &format!("Frames queued at most{}", tag("VICTORY_PACE_LATENCY", true)),
+            &["Off", "1", "2"],
+            &mut latency,
+        ) {
+            pace.latency = latency as u32;
+            p_changed = true;
+        }
+        let r = self.row(body, row_h);
+        if self.ui.toggle(
+            "tearing",
+            r,
+            &format!("Allow tearing (VRR){}", tag("VICTORY_PACE_TEARING", true)),
+            &mut pace.tearing,
+        ) {
+            p_changed = true;
+        }
+        let r = self.row(body, row_h);
+        if self.ui.toggle(
+            "feedback",
+            r,
+            &format!("Display feedback{}", tag("VICTORY_PACE_FEEDBACK", true)),
+            &mut pace.feedback,
+        ) {
+            p_changed = true;
+        }
+        self.note(
+            body,
+            "[live] applies at once. [restart] is saved and used at the next start.",
+            muted,
+        );
+        if [
+            "VICTORY_PACE",
+            "VICTORY_PACE_FPS",
+            "VICTORY_PACE_INPUT",
+            "VICTORY_PACE_LATENCY",
+            "VICTORY_PACE_TEARING",
+            "VICTORY_PACE_FEEDBACK",
+        ]
+        .iter()
+        .any(|n| env(n))
+        {
+            self.note(
+                body,
+                "[env]: the environment sets it at start and wins over the file.",
+                warn,
+            );
+        }
+        let mut upscale = self.model.upscale;
+        let mut u_changed = false;
+        self.heading(body, "Upscaling (VICTORY_UPSCALER)");
+        let r = self.row(body, row_h);
+        let mut which = Upscaler::ALL.iter().position(|x| *x == upscale.upscaler).unwrap_or(0);
+        if self.ui.choice(
+            "upscaler",
+            r,
+            &format!("Upscaler{}", tag("VICTORY_UPSCALER", false)),
+            &["FSR 3", "DLSS", "Title TAA", "Stretch"],
+            &mut which,
+        ) {
+            upscale.upscaler = Upscaler::ALL[which];
+            u_changed = true;
+        }
+        let r = self.row(body, row_h);
+        let mut q = Quality::ALL.iter().position(|x| *x == upscale.quality).unwrap_or(1);
+        if self.ui.choice(
+            "quality",
+            r,
+            &format!("Quality mode{}", tag("VICTORY_UPSCALE_QUALITY", true)),
+            &["Native AA", "Quality", "Balanced", "Perf.", "Ultra perf."],
+            &mut q,
+        ) {
+            upscale.quality = Quality::ALL[q];
+            u_changed = true;
+        }
+        let r = self.row(body, row_h);
+        let sharp = [0.0f32, 0.2, 0.5, 0.8];
+        let mut si = sharp
+            .iter()
+            .position(|x| (x - upscale.sharpness).abs() < 0.05)
+            .unwrap_or(1);
+        if self.ui.choice(
+            "sharpness",
+            r,
+            &format!("Sharpening{}", tag("VICTORY_UPSCALE_SHARPNESS", false)),
+            &["Off", "0.2", "0.5", "0.8"],
+            &mut si,
+        ) {
+            upscale.sharpness = sharp[si];
+            u_changed = true;
+        }
+        let r = self.row(body, row_h);
+        if self.ui.toggle(
+            "framegen",
+            r,
+            &format!("FSR 3 frame generation{}", tag("VICTORY_FRAMEGEN", false)),
+            &mut upscale.framegen,
+        ) {
+            u_changed = true;
+        }
+        self.note(body, &crate::upscale::status::text(), muted);
+        if upscale.upscaler == Upscaler::Dlss {
+            self.note(body, "DLSS is not wired yet: FSR 3 answers in its place.", warn);
+        }
+        if upscale.framegen {
+            self.note(
+                body,
+                "Frame generation needs a base rate of 15 fps or more; below that it holds off.",
+                warn,
+            );
+        }
+        if u_changed {
+            self.model.upscale = upscale;
+            fx.upscale = Some(upscale);
+            fx.save = true;
+        }
+        self.note(
+            body,
+            "Exclusive fullscreen is not offered: a borderless window presents the same way.",
+            muted,
+        );
+
+        if d_changed {
+            self.model.display = display;
+            fx.display = Some(display);
+            fx.save = true;
+        }
+        if p_changed {
+            self.model.pace = pace;
+            fx.pace = Some(pace);
+            fx.save = true;
+        }
+    }
+
+    fn page_performance(&mut self, body: &mut Body, ctx: &Ctx) {
+        let u = self.ui.scale;
+        let t = self.ui.theme;
+        let pf = ctx.perf;
+
+        let r = self.row(body, 22.0 * u);
+        let fps = pf.fps();
+        let tone = if fps >= 55.0 {
+            t.good
+        } else if fps >= 28.0 {
+            t.warn
+        } else {
+            t.bad
+        };
+        let big = format!("{fps:.0} FPS");
+        let w = self.ui.draw.text(r.x, r.y + 3.0 * u, &big, u * 2.0, tone);
+        let detail = format!(
+            "{:.1} ms average   {:.1} ms 99th percentile   {:.1} ms worst of the last 60",
+            pf.frame_ms(),
+            pf.p99_ms(),
+            pf.worst_ms(60)
+        );
+        self.ui
+            .text(r.x + w + 10.0 * u, r.y + 8.0 * u, &detail, t.text);
+
+        let samples = pf.samples(super::perf::HISTORY);
+        let top = [33.4_f32, 50.0, 100.0, 200.0, 500.0]
+            .into_iter()
+            .find(|&m| m >= pf.worst_ms(super::perf::HISTORY) * 1.05)
+            .unwrap_or(500.0);
+        let r = self.row(body, 64.0 * u);
+        self.ui.graph(
+            Rect::new(r.x, r.y + 2.0 * u, r.w, r.h - 4.0 * u),
+            &samples,
+            top,
+            &[16.7, 33.3],
+        );
+        self.note(body, "Frame time of each present, newest at the right. Bars: green 60 fps, amber 30 fps, red slower.", t.muted);
+
+        self.heading(body, "Memory");
+        let s = ctx.sys;
+        let line = |ui: &mut Ui, body: &mut Body, label: &str, text: &str, used: u64, of: u64| {
+            let r = Rect::new(body.x, body.y, body.w, 14.0 * u);
+            body.y += 14.0 * u;
+            ui.text_in(Rect::new(r.x, r.y, r.w * 0.28, r.h), 0, label, t.text);
+            let bar = Rect::new(r.x + r.w * 0.28, r.y + 3.0 * u, r.w * 0.24, r.h - 6.0 * u);
+            ui.draw.rect(bar, t.button);
+            if of > 0 {
+                let f = (used as f32 / of as f32).clamp(0.0, 1.0);
+                let fill = if f > 0.9 {
+                    t.bad
+                } else if f > 0.75 {
+                    t.warn
+                } else {
+                    t.accent
+                };
+                ui.draw
+                    .rect(Rect::new(bar.x, bar.y, bar.w * f, bar.h), fill);
+            }
+            ui.text_in(
+                Rect::new(r.x + r.w * 0.55, r.y, r.w * 0.45, r.h),
+                0,
+                text,
+                t.muted,
+            );
+        };
+        let ui = &mut self.ui;
+        line(
+            ui,
+            body,
+            "RAM, this program",
+            &format!(
+                "{} working set, {} private",
+                perf::size(s.ram_working_set),
+                perf::size(s.ram_private)
+            ),
+            s.ram_working_set,
+            s.ram_total,
+        );
+        line(
+            ui,
+            body,
+            "RAM, whole PC",
+            &format!(
+                "{} free of {}",
+                perf::size(s.ram_available),
+                perf::size(s.ram_total)
+            ),
+            s.ram_total.saturating_sub(s.ram_available),
+            s.ram_total,
+        );
+        if s.vram_known {
+            line(
+                ui,
+                body,
+                "VRAM, card",
+                &format!(
+                    "{} of {} budget",
+                    perf::size(s.vram_used),
+                    perf::size(s.vram_budget)
+                ),
+                s.vram_used,
+                s.vram_budget,
+            );
+            line(
+                ui,
+                body,
+                "VRAM, shared",
+                &format!(
+                    "{} of {} budget",
+                    perf::size(s.shared_used),
+                    perf::size(s.shared_budget)
+                ),
+                s.shared_used,
+                s.shared_budget,
+            );
+        } else {
+            line(ui, body, "VRAM", "not reported by this system", 0, 0);
+        }
+
+        self.heading(body, "Speed switches (read only)");
+        let pace = self.model.pace;
+        let on_off = |b: bool| if b { "on" } else { "off" };
+        let pace_rows = [
+            (
+                "VICTORY_PACE",
+                on_off(pace.pace).to_string(),
+                pace.pace,
+                Change::Live,
+            ),
+            (
+                "VICTORY_PACE_FPS",
+                pace.fps.map_or("title".to_string(), |f| f.to_string()),
+                pace.fps.is_some(),
+                Change::Live,
+            ),
+            (
+                "VICTORY_PACE_INPUT",
+                on_off(pace.input).to_string(),
+                pace.input,
+                Change::Live,
+            ),
+            (
+                "VICTORY_PACE_LATENCY",
+                pace.latency.to_string(),
+                pace.latency > 0,
+                Change::Restart,
+            ),
+            (
+                "VICTORY_PACE_TEARING",
+                on_off(pace.tearing).to_string(),
+                pace.tearing,
+                Change::Restart,
+            ),
+            (
+                "VICTORY_PACE_FEEDBACK",
+                on_off(pace.feedback).to_string(),
+                pace.feedback,
+                Change::Restart,
+            ),
+        ];
+        let up = self.model.upscale;
+        let pace_rows: Vec<_> = pace_rows
+            .into_iter()
+            .chain([
+                (
+                    "VICTORY_UPSCALER",
+                    up.upscaler.name().to_string(),
+                    true,
+                    Change::Live,
+                ),
+                (
+                    "VICTORY_UPSCALE_QUALITY",
+                    up.quality.name().to_string(),
+                    true,
+                    Change::Restart,
+                ),
+                (
+                    "VICTORY_FRAMEGEN",
+                    on_off(up.framegen).to_string(),
+                    up.framegen,
+                    Change::Live,
+                ),
+            ])
+            .collect();
+        let rows = switch_rows(ctx.env, &pace_rows);
+        let on_count = rows.iter().filter(|r| r.on).count();
+        self.note(body, &format!("{on_count} of {} on. [live]: change it on the Display page. [restart]: set the variable and restart.", rows.len()), t.muted);
+        for row in rows {
+            let r = self.row(body, 12.0 * u);
+            let (state, colour) = if row.on {
+                ("ON", t.good)
+            } else {
+                ("off", t.muted)
+            };
+            self.ui.text_in(
+                Rect::new(r.x, r.y, r.w * 0.5, r.h),
+                0,
+                &row.name,
+                if row.on { t.text } else { t.muted },
+            );
+            self.ui.text_in(
+                Rect::new(r.x + r.w * 0.5, r.y, r.w * 0.08, r.h),
+                0,
+                state,
+                colour,
+            );
+            self.ui.text_in(
+                Rect::new(r.x + r.w * 0.6, r.y, r.w * 0.16, r.h),
+                0,
+                &row.value,
+                t.muted,
+            );
+            let (tag, tone) = match row.change {
+                Change::Live => ("live", t.good),
+                Change::Restart => ("restart", t.warn),
+            };
+            self.ui.text_in(
+                Rect::new(r.x + r.w * 0.78, r.y, r.w * 0.22, r.h),
+                0,
+                tag,
+                tone,
+            );
+        }
+    }
+
+    fn footer(&mut self, panel: Rect, h: f32, fx: &mut Effects) {
+        let u = self.ui.scale;
+        let t = self.ui.theme;
+        let r = Rect::new(
+            panel.x + 8.0 * u,
+            panel.bottom() - h,
+            panel.w - 16.0 * u,
+            h - 3.0 * u,
+        );
+        self.ui.draw.rect(
+            Rect::new(r.x, r.y - 2.0 * u, r.w, 1.0f32.max(u / 2.0)),
+            t.border,
+        );
+        let restart = self.restart_needed();
+        let mut y = r.y + 2.0 * u;
+        let text_w = r.w - 110.0 * u;
+        let clip_text = |s: &str| {
+            let max = (text_w / (font::ADVANCE as f32 * u)) as usize;
+            s.chars().take(max).collect::<String>()
+        };
+        if !restart.is_empty() {
+            let s = clip_text(&format!("Restart required: {}.", restart.join(", ")));
+            self.ui.text(r.x, y, &s, t.warn);
+            y += 11.0 * u;
+        }
+        if self.capture.is_some() {
+            self.ui.text(
+                r.x,
+                y,
+                "Press the new key or mouse button. Esc cancels, Delete clears.",
+                t.warn,
+            );
+        } else if let Some((msg, tone)) = self.status.clone() {
+            let c = match tone {
+                Tone::Good => t.good,
+                Tone::Warn => t.warn,
+                Tone::Bad => t.bad,
+            };
+            self.ui.text(r.x, y, &clip_text(&msg), c);
+        }
+        if self.page != Page::Performance {
+            let b = Rect::new(r.right() - 100.0 * u, r.y + 2.0 * u, 100.0 * u, 16.0 * u);
+            let label = if self.armed {
+                "Click to confirm"
+            } else {
+                "Reset page"
+            };
+            if self.ui.button("reset", b, label, self.armed) {
+                if self.armed {
+                    self.reset_page(fx);
+                    self.armed = false;
+                } else {
+                    self.armed = true;
+                }
+            }
+        }
+    }
+
+    fn reset_page(&mut self, fx: &mut Effects) {
+        match self.page {
+            Page::Controls => {
+                let c = &self.model.controls;
+                self.model.controls = Settings {
+                    enabled: c.enabled,
+                    capture: c.capture,
+                    carry: c.carry,
+                    deadzone: c.deadzone,
+                    curve: c.curve,
+                    ..Settings::default()
+                };
+                fx.controls = Some(self.model.controls.clone());
+            }
+            Page::Display => {
+                self.model.display = Display::default();
+                self.model.pace = PaceModel::default();
+                self.model.upscale = UpscaleModel::default();
+                fx.display = Some(self.model.display);
+                fx.pace = Some(self.model.pace);
+                fx.upscale = Some(self.model.upscale);
+            }
+            Page::Performance => return,
+        }
+        fx.save = true;
+        self.status = Some(("Page reset to the defaults.".into(), Tone::Good));
+    }
+
+    /// Reports a save's outcome in the footer.
+    pub fn saved(&mut self, result: Result<(), String>) {
+        self.status = Some(match (result, self.status.take()) {
+            (Ok(()), Some((msg, Tone::Good))) if !msg.ends_with("Saved.") => {
+                (format!("{msg} Saved."), Tone::Good)
+            }
+            (Ok(()), Some((msg, Tone::Good))) => (msg, Tone::Good),
+            (Ok(()), _) => ("Saved.".to_string(), Tone::Good),
+            (Err(e), _) => (format!("Not saved: {e}"), Tone::Bad),
+        });
+    }
+
+    pub fn page(&self) -> Page {
+        self.page
+    }
+
+    pub fn set_page(&mut self, page: Page) {
+        self.page = page;
+    }
+
+    pub fn status_text(&self) -> Option<&str> {
+        self.status.as_ref().map(|(s, _)| s.as_str())
+    }
+}
+
+/// A row with a slider whose value is shown with two places.
+fn slider_row(
+    ui: &mut Ui,
+    body: &mut Body,
+    h: f32,
+    id: &str,
+    label: &str,
+    v: &mut f32,
+    range: (f32, f32, f32),
+) -> Moved {
+    let r = Rect::new(body.x, body.y, body.w, h);
+    body.y += h;
+    let shown = num(*v, 2);
+    ui.slider(id, r, label, &shown, v, range)
+}
