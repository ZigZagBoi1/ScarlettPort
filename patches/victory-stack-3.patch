+                                Bin::Sub => x.wrapping_sub(y),
+                                Bin::Mul => x.wrapping_mul(y),
+                                Bin::UDiv => x.checked_div(y).unwrap_or(0),
+                                Bin::URem => x.checked_rem(y).unwrap_or(0),
+                                Bin::SDiv => {
+                                    signed(bits, x).checked_div(signed(bits, y)).unwrap_or(0) as u64
