+                    // scalars: field k is scalar k.
+                    vec![eval(&vals, *agg)[*k as usize]]
+                }
+                Op::Call(f, args) => {
+                    let a: Vec<Vec<u64>> = args.iter().map(|&v| eval(&vals, v)).collect();
