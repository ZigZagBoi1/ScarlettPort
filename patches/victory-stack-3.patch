+                    }]
+                }
+                Op::Cmp(p, x, y) => {
+                    let wide = m.bits_of(m.type_of(*x));
+                    let (x, y) = (one(&vals, *x), one(&vals, *y));
+                    let holds = match wide {
+                        Some(bits) => {
+                            let (sx, sy) = (signed(bits, x), signed(bits, y));
+                            match *p {
+                                pred::EQ => x == y,
+                                pred::NE => x != y,
+                                pred::IUGT => x > y,
+                                pred::IUGE => x >= y,
+                                pred::IULT => x < y,
+                                pred::IULE => x <= y,
+                                pred::SGT => sx > sy,
+                                pred::SGE => sx >= sy,
+                                pred::SLT => sx < sy,
+                                _ => sx <= sy,
