+        }
+        cache.flush();
+        assert_eq!(cache.get(&key(3), None).unwrap(), bytes(3, 1039));
+        drop(cache);
+        let again = Cache::open(dir.path(), 1 << 30, 2, false).unwrap();
+        assert_eq!(again.entries(), 50);
+        for n in 0..50 {
+            assert_eq!(again.get(&key(n), None).unwrap(), bytes(n, 1000 + n as usize * 13));
