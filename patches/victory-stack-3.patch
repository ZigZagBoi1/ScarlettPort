+                        (Cast::Trunc, _, Some(t)) => x & mask(t),
+                        (Cast::UiToFp, _, None) => u64::from((x as f32).to_bits()),
+                        (Cast::SiToFp, Some(f), None) => u64::from((signed(f, x) as f32).to_bits()),
+                        (Cast::FpToUi, _, Some(t)) => float(x) as u64 & mask(t),
