+                                Bin::And => x & y,
+                                Bin::Or => x | y,
+                                Bin::Xor => x ^ y,
+                                Bin::Shl => x.checked_shl(y as u32).unwrap_or(0),
+                                Bin::LShr => x.checked_shr(y as u32).unwrap_or(0),
+                                Bin::AShr => (signed(bits, x) >> y.min(63)) as u64,
+                            };
+                            r & mask(bits)
+                        }
+                        None => {
+                            let (x, y) = (float(x), float(y));
+                            let r = match op {
+                                Bin::Add => x + y,
+                                Bin::Sub => x - y,
+                                Bin::Mul => x * y,
+                                Bin::SDiv | Bin::UDiv => x / y,
+                                _ => panic!("a float operation {op:?}"),
+                            };
